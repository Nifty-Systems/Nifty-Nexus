temIsMob(item) {\n  if (!item || !item.attrib) return false;\n  var a = String(item.attrib);\n  if (a.indexOf('m') < 0) return false;\n  if (a.indexOf('d') >= 0 || a.indexOf('x') >= 0) return false;\n  if (item.icon === 'pet' || item.icon === 'guard' || item.icon === 'beast') return false;\n  if (item.name && String(item.name).indexOf('the corpse of') === 0) return false;\n  return true;\n}\nfunction sa2ChGrimkeepItemIsGkMob(item) {\n  if (!sa2ChGrimkeepItemIsMob(item)) return false;\n  return sa2IsGrimkeepMobName(item.name);\n}\nfunction sa2ComputeRoomMobCountFromGmcpRoom() {\n  try {\n    if (typeof GMCP === 'undefined' || !GMCP || !GMCP.Items || !GMCP.Items.room) return null;\n    var count = 0;\n    for (var i = 0; i < GMCP.Items.room.length; i++) {\n      if (sa2ChGrimkeepItemIsGkMob(GMCP.Items.room[i])) count++;\n    }\n    return count;\n  } catch (e) { return null; }\n}\nfunction sa2ComputeRoomMobCount() {\n  var chCount = sa2ComputeRoomMobCountFromGmcpRoom();\n  if (chCount != null) return chCount;\n  var list = sa2GetItemsList();\n  var gkCount = 0;\n  for (var i = 0; i < list.length; i++) {\n    var entry = list[i];\n    if (!sa2IsRoomItem(entry)) continue;\n    if (sa2IsGrimkeepMobName(entry.name)) gkCount++;\n  }\n  return gkCount;\n}\nfunction sa2UpdateRoomMobsCache() {\n  var sa = sa2Soiled();\n  sa.roomMobs = sa2ComputeRoomMobCount();\n  return sa.roomMobs;\n}\nfunction sa2RoomMobCount() {\n  var sa = sa2Soiled();\n  if (sa.roomMobs != null && !isNaN(sa.roomMobs)) return sa.roomMobs;\n  return sa2UpdateRoomMobsCache();\n}\nfunction sa2CountArtificersInRoom() {\n  var n = 0;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Items && GMCP.Items.room) {\n      for (var i = 0; i < GMCP.Items.room.length; i++) {\n        var item = GMCP.Items.room[i];\n        if (sa2ChGrimkeepItemIsGkMob(item) && item.name && String(item.name).toLowerCase().indexOf('artificer') >= 0) n++;\n      }\n      return n;\n    }\n  } catch (e) {}\n  var list = sa2GetItemsList();\n  for (var j = 0; j < list.length; j++) {\n    var entry = list[j];\n    if (entry && entry.name && String(entry.name).toLowerCase().indexOf('artificer') >= 0) n++;\n  }\n  return n;\n}\nfunction sa2RefreshPanel() {\n  try { run_function('sa2_update_custom_tab', '', 'SoiledArmour2'); } catch (e) {}\n}\nfunction sa2ApplyTabIcon() {\n  if (typeof document === 'undefined') return false;\n  try {\n    var tab = document.querySelector('[title=\"SoiledArmour2\"]');\n    if (!tab || !tab.children || !tab.children[0]) return false;\n    var svg = tab.children[0].children[0].children[0].children[0];\n    if (!svg || !svg.children || !svg.children[0]) return false;\n    var path = svg.children[0];\n    path.setAttribute('d',\n      'M256 0c4.6 0 9.2 1 13.4 2.9L457.7 82.8c22 9.3 38.4 31 38.3 57.2-.5 99.2-41.2 193.1-114.4 263.2-41.2 38.6-86 67.7-122.5 87.2-9.7 5.3-21.1 5.3-30.8 0-36.5-19.5-81.3-48.6-122.5-87.2C94.1 333.1 53.5 239.2 54 140c-.1-26.2 16.3-47.9 38.3-57.2L242.6 2.9C246.8 1 251.4 0 256 0z'\n    );\n    path.setAttribute('fill', '#8B4513');\n    return true;\n  } catch (e) { return false; }\n}\nfunction sa2ChAreaAttackLabel() {\n  return sa2ChAreaAttackOn() ? 'Area Attack: On' : 'Area Attack: Off';\n}\nfunction sa2ChAreaAttackOn() {\n  try {\n    var aa = String(client.crystal.hunt.grimkeep.areaAttack || 'off').toLowerCase();\n    if (aa === 'off' || aa === '') return false;\n    return aa === 'on' || aa === 'auto' || aa.indexOf(' ') >= 0;\n  } catch (e) { return false; }\n}\nfunction sa2ChAreaAttackWouldFire() {\n  if (!sa2ChPresent() || !sa2InGrimkeep()) return false;\n  try {\n    var gk = client.crystal.hunt.grimkeep;\n    if (!gk || !gk.active) return false;\n    var beastCmd = String(get_variable('sCHCommandBeast') || '');\n    if (!beastCmd) return false;\n    var aa = String(gk.areaAttack || 'off').toLowerCase();\n    if (aa === 'off' || aa === '') return false;\n    return sa2CountGkMobsByType().sentinel === 0;\n  } catch (e) {}\n  return false;\n}\nfunction sa2SanctityAaAllowsHeal() {\n  if (!sa2ChPresent() || !sa2InGrimkeep()) return true;\n  try {\n    var aa = String(client.crystal.hunt.grimkeep.areaAttack || 'off').toLowerCase();\n    if (aa === 'off') return true;\n  } catch (e) { return true; }\n  return !sa2ChAreaAttackWouldFire();\n}\nfunction sa2SyncBeastHealOwner() {\n  if (!sa2MasterOn() || !sa2ChPresent()) return;\n  if (sa2ModuleOn('sanctity')) send_command('ch beastheal off', 0);\n  else send_command('ch beastheal on', 0);\n}\nfunction sa2LeanBeastOn() {\n  return sa2MasterOn() && sa2Bool('sa2_ch_armed') && sa2Bool('sa2_lean_beast');\n}\nfunction sa2GkMobTypeFromName(name) {\n  var n = String(name || '').toLowerCase();\n  if (n.indexOf('artificer') >= 0) return 'artificer';\n  if (n.indexOf('battlecharger') >= 0) return 'battlecharger';\n  if (n.indexOf('excoropox') >= 0) return 'excoropox';\n  if (n.indexOf('koirakko') >= 0) return 'koirakko';\n  if (n.indexOf('sentinel') >= 0) return 'sentinel';\n  return null;\n}\nfunction sa2GkItemIsAggressive(item) {\n  if (!item || typeof item !== 'object') return false;\n  var attrib = String(item.attrib || '').toLowerCase();\n  if (attrib.indexOf('d') >= 0) return false;\n  if (attrib.indexOf('m') >= 0 && attrib.indexOf('h') >= 0) return true;\n  if (item.icon === 'eye-evil') return true;\n  return false;\n}\nfunction sa2MobTypeStatsFromGmcp() {\n  var types = ['artificer', 'battlecharger', 'excoropox', 'koirakko', 'sentinel'];\n  var stats = { shieldDataAvailable: false, total: { count: 0, aggressive: 0 } };\n  for (var t = 0; t < types.length; t++) stats[types[t]] = { count: 0, aggressive: 0 };\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Items && GMCP.Items.room) {\n      for (var i = 0; i < GMCP.Items.room.length; i++) {\n        var item = GMCP.Items.room[i];\n        if (!sa2ChGrimkeepItemIsGkMob(item) || !item.name) continue;\n        var mobType = sa2GkMobTypeFromName(item.name);\n        if (!mobType || !stats[mobType]) continue;\n        stats[mobType].count++;\n        stats.total.count++;\n        if (sa2GkItemIsAggressive(item)) {\n          stats[mobType].aggressive++;\n          stats.total.aggressive++;\n        }\n      }\n    }\n  } catch (e) {}\n  return stats;\n}\nfunction sa2BreathPriorityOrder() {\n  try {\n    var tp = client.crystal.hunt.grimkeep.targetPriorities;\n    if (tp && tp.length > 1 && String(tp[1]).toLowerCase() === 'sentinel') {\n      return ['artificer', 'battlecharger', 'excoropox', 'sentinel', 'koirakko'];\n    }\n  } catch (e) {}\n  return ['artificer', 'battlecharger', 'excoropox', 'koirakko', 'sentinel'];\n}\nfunction sa2BreathCandidate(bucket, shieldAware) {\n  if (!bucket || typeof bucket !== 'object') return false;\n  var count = bucket.count || 0;\n  if (count <= 0) return false;\n  if (shieldAware && (bucket.shielded || 0) >= count) return false;\n  return true;\n}\nfunction sa2BreathPickTargetType(stats) {\n  if (!stats || typeof stats !== 'object') return null;\n  var shieldAware = stats.shieldDataAvailable === true;\n  var order = sa2BreathPriorityOrder();\n  for (var pass = 1; pass <= 2; pass++) {\n    for (var i = 0; i < order.length; i++) {\n      var mobType = order[i];\n      var bucket = stats[mobType];\n      if (sa2BreathCandidate(bucket, shieldAware) &&\n          (pass === 2 || (bucket.aggressive || 0) > 0)) {\n        return mobType;\n      }\n    }\n  }\n  return null;\n}\nfunction sa2BreathFallbackRank() {\n  return ['peppermint', 'divinus', 'fire', 'soot'];\n}\nfunction sa2BreathNormalizeType(type) {\n  type = String(type || '').toLowerCase();\n  if (type === 'pep') return 'peppermint';\n  if (type === 'div') return 'divinus';\n  var rank = sa2BreathFallbackRank();\n  for (var i = 0; i < rank.length; i++) {\n    if (rank[i] === type) return type;\n  }\n  return null;\n}\nfunction sa2BreathOwns(type) {\n  type = sa2BreathNormalizeType(type);\n  if (!type) return false;\n  return sa2Bool('sa2_breath_own_' + type);\n}\nfunction sa2BreathOwnedList() {\n  var all = sa2BreathFallbackRank();\n  var out = [];\n  for (var i = 0; i < all.length; i++) {\n    if (sa2BreathOwns(all[i])) out.push(all[i]);\n  }\n  return out;\n}\nfunction sa2BreathPreferredForType(mobType) {\n  if (mobType === 'sentinel') return 'divinus';\n  if (mobType === 'artificer' || mobType === 'battlecharger' ||\n      mobType === 'excoropox' || mobType === 'koirakko') return 'peppermint';\n  return null;\n}\nfunction sa2BreathSecondaryChain(mobType) {\n  if (mobType === 'battlecharger') return ['soot'];\n  return [];\n}\nfunction sa2BreathForTypeOwned(mobType) {\n  var preferred = sa2BreathPreferredForType(mobType);\n  if (preferred && sa2BreathOwns(preferred)) return preferred;\n  var sec = sa2BreathSecondaryChain(mobType);\n  for (var i = 0; i < sec.length; i++) {\n    if (sa2BreathOwns(sec[i])) return sec[i];\n  }\n  var rank = sa2BreathFallbackRank();\n  for (var j = 0; j < rank.length; j++) {\n    if (sa2BreathOwns(rank[j])) return rank[j];\n  }\n  return null;\n}\nfunction sa2BreathFallbackRankIndex(breath) {\n  var rank = sa2BreathFallbackRank();\n  for (var i = 0; i < rank.length; i++) {\n    if (rank[i] === breath) return i;\n  }\n  return 999;\n}\nfunction sa2BreathUnshieldedHits(bucket, shieldAware) {\n  if (!bucket || typeof bucket !== 'object') return 0;\n  var count = bucket.count || 0;\n  if (count <= 0) return 0;\n  if (shieldAware) return Math.max(0, count - (bucket.shielded || 0));\n  return count;\n}\nfunction sa2CountGkMobsByType() {\n  var counts = { artificer: 0, battlecharger: 0, excoropox: 0, koirakko: 0, sentinel: 0 };\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Items && GMCP.Items.room) {\n      for (var i = 0; i < GMCP.Items.room.length; i++) {\n        var item = GMCP.Items.room[i];\n        if (!sa2ChGrimkeepItemIsGkMob(item) || !item.name) continue;\n        var mobType = sa2GkMobTypeFromName(item.name);\n        if (mobType && counts[mobType] != null) counts[mobType]++;\n      }\n    }\n  } catch (e) {}\n  return counts;\n}\nfunction sa2SmartBreathPick() {\n  var stats = sa2MobTypeStatsFromGmcp();\n  var target = sa2BreathPickTargetType(stats);\n  if (target) {\n    var owned = sa2BreathForTypeOwned(target);\n    if (owned) return owned;\n  }\n  var shieldAware = stats.shieldDataAvailable === true;\n  var mobTypes = ['artificer', 'battlecharger', 'excoropox', 'koirakko', 'sentinel'];\n  var scores = {};\n  for (var i = 0; i < mobTypes.length; i++) {\n    var hits = sa2BreathUnshieldedHits(stats[mobTypes[i]], shieldAware);\n    if (hits > 0) {\n      var breath = sa2BreathForTypeOwned(mobTypes[i]);\n      if (breath) scores[breath] = (scores[breath] || 0) + hits;\n    }\n  }\n  var best = null, bestScore = 0;\n  for (var b in scores) {\n    var score = scores[b];\n    if (score > bestScore) {\n      best = b;\n      bestScore = score;\n    } else if (score === bestScore && score > 0) {\n      if (sa2BreathFallbackRankIndex(b) < sa2BreathFallbackRankIndex(best)) best = b;\n    }\n  }\n  if (bestScore > 0 && best) return best;\n  return null;\n}\nfunction sa2BreathFirstOwned() {\n  var rank = sa2BreathFallbackRank();\n  for (var r = 0; r < rank.length; r++) {\n    if (sa2BreathOwns(rank[r])) return rank[r];\n  }\n  return null;\n}\nfunction sa2BreathMode() {\n  var m = String(sa2Get('sa2_breath_mode', '') || '').toLowerCase();\n  if (m === 'smart' || m === 'peppermint' || m === 'fire' || m === 'divinus') return m;\n  if (sa2Bool('sa2_smart_breath')) return 'smart';\n  return 'smart';\n}\nfunction sa2BreathModeLabel() {\n  var m = sa2BreathMode();\n  if (m === 'peppermint') return 'Breath: Peppermint';\n  if (m === 'fire') return 'Breath: Fire';\n  if (m === 'divinus') return 'Breath: Divinus';\n  if (m === 'smart') return 'Breath: Smart';\n  return 'Breath: Smart';\n}\nfunction sa2BreathModeTip() {\n  var tip = 'Cycle beast breath: smart, peppermint, fire, divinus. Smart picks from owned types only.';\n  if (sa2BreathMode() === 'smart') {\n    va