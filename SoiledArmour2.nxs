;\n  } catch (e) { return false; }\n}\nfunction sa2GetVitals() {\n  try {\n    var raw = sa2Get('sa2_last_vitals', '{}');\n    return JSON.parse(raw);\n  } catch (e) { return {}; }\n}\nfunction sa2CacheVitals(v) {\n  try { sa2Set('sa2_last_vitals', JSON.stringify(v)); } catch (e) {}\n}\nfunction sa2HealthPct() {\n  var v = sa2GetVitals();\n  var maxhp = parseInt(v.maxhp || v.maxhealth, 10);\n  var hp = parseInt(v.hp || v.currenthealth, 10);\n  if (maxhp > 0 && !isNaN(hp)) return hp / maxhp;\n  return 1;\n}\nfunction sa2HasDef(name) {\n  var sa = sa2Soiled();\n  if (!sa.defCache) return false;\n  var n = String(name).toLowerCase();\n  for (var k in sa.defCache) {\n    if (sa.defCache[k] && k.indexOf(n) >= 0) return true;\n  }\n  return false;\n}\nfunction sa2UpdateDefCache() {\n  var sa = sa2Soiled();\n  if (!sa.defCache) sa.defCache = {};\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences) {\n      var D = GMCP.Char.Defences;\n      if (D.List && D.List.length) {\n        for (var i = 0; i < D.List.length; i++) {\n          if (D.List[i] && D.List[i].name) sa.defCache[String(D.List[i].name).toLowerCase()] = true;\n        }\n      }\n      if (D.Add && D.Add.name) sa.defCache[String(D.Add.name).toLowerCase()] = true;\n      if (D.Remove) {\n        var rem = Array.isArray(D.Remove) ? D.Remove : [D.Remove];\n        for (var j = 0; j < rem.length; j++) {\n          if (rem[j] && rem[j].name) delete sa.defCache[String(rem[j].name).toLowerCase()];\n        }\n      }\n    }\n  } catch (e) {}\n}\nfunction sa2AffCount() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Afflictions && GMCP.Char.Afflictions.List) {\n      return GMCP.Char.Afflictions.List.length;\n    }\n  } catch (e) {}\n  return 0;\n}\nsa2Set('sa2_master', '0');\n\n// Stop transmute interval\nvar txId = get_variable('sa2_transmute_interval_id');\nif (txId) { try { clearInterval(parseInt(txId, 10)); } catch (e) {} sa2Set('sa2_transmute_