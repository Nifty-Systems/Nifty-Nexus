      for (var i = 0; i < GMCP.Items.room.length; i++) {\n        var item = GMCP.Items.room[i];\n        if (!sa2ChGrimkeepItemIsGkMob(item) || !item.name) continue;\n        var mobType = sa2GkMobTypeFromName(item.name);\n        if (!mobType || !stats[mobType]) continue;\n        stats[mobType].count++;\n        stats.total.count++;\n        if (sa2GkItemIsAggressive(item)) {\n          stats[mobType].aggressive++;\n          stats.total.aggressive++;\n        }\n      }\n    }\n  } catch (e) {}\n  return stats;\n}\nfunction sa2BreathPriorityOrder() {\n  try {\n    var tp = client.crystal.hunt.grimkeep.targetPriorities;\n    if (tp && tp.length > 1 && String(tp[1]).toLowerCase() === 'sentinel') {\n      return ['artificer', 'battlecharger', 'excoropox', 'sentinel', 'koirakko'];\n    }\n  } catch (e) {}\n  return ['artificer', 'battlecharger', 'excoropox', 'koirakko', 'sentinel'];\n}\nfunction sa2BreathCandidate(bucket, shieldAware) {\n  if (!bucket || typeof bucket !== 'object') return false;\n  var count = bucket.count || 0;\n  if (count <= 0) return false;\n  if (shieldAware && (bucket.shielded || 0) >= count) return false;\n  return true;\n}\nfunction sa2BreathPickTargetType(stats) {\n  if (!stats || typeof stats !== 'object') return null;\n  var shieldAware = stats.shieldDataAvailable === true;\n  var order = sa2BreathPriorityOrder();\n  for (var pass = 1; pass <= 2; pass++) {\n    for (var i = 0; i < order.length; i++) {\n      var mobType = order[i];\n      var bucket = stats[mobType];\n      if (sa2BreathCandidate(bucket, shieldAware) &&\n          (pass === 2 || (bucket.aggressive || 0) > 0)) {\n        return mobType;\n      }\n    }\n  }\n  return null;\n}\nfunction sa2BreathFallbackRank() {\n  return ['peppermint', 'divinus', 'fire', 'soot'];\n}\nfunction sa2BreathNormalizeType(type) {\n  type = String(type || '').toLowerCase();\n  if (type === 'pep') return 'peppermint';\n  if (type === 'div') return 'divinus';\n  var rank = sa2BreathFallbackRank();\n  for (var i = 0; i < rank.length; i++) {\n    if (rank[i] === type) return type;\n  }\n  return null;\n}\nfunction sa2BreathOwns(type) {\n  type = sa2BreathNormalizeType(type);\n  if (!type) return false;\n  return sa2Bool('sa2_breath_own_' + type);\n}\nfunction sa2BreathOwnedList() {\n  var all = sa2BreathFallbackRank();\n  var out = [];\n  for (var i = 0; i < all.length; i++) {\n    if (sa2BreathOwns(all[i])) out.push(all[i]);\n  }\n  return out;\n}\nfunction sa2BreathPreferredForType(mobType) {\n  if (mobType === 'sentinel') return 'divinus';\n  if (mobType === 'artificer' || mobType === 'battlecharger' ||\n      mobType === 'excoropox' || mobType === 'koirakko') return 'peppermint';\n  return null;\n}\nfunction sa2BreathSecondaryChain(mobType) {\n  if (mobType === 'battlecharger') return ['soot'];\n  return [];\n}\nfunction sa2BreathForTypeOwned(mobType) {\n  var preferred = sa2BreathPreferredForType(mobType);\n  if (preferred && sa2BreathOwns(preferred)) return preferred;\n  var sec = sa2BreathSecondaryChain(mobType);\n  for (var i = 0; i < sec.length; i++) {\n    if (sa2BreathOwns(sec[i])) return sec[i];\n  }\n  var rank = sa2BreathFallbackRank();\n  for (var j = 0; j < rank.length; j++) {\n    if (sa2BreathOwns(rank[j])) return rank[j];\n  }\n  return null;\n}\nfunction sa2BreathFallbackRankIndex(breath) {\n  var rank = sa2BreathFallbackRank();\n  for (var i = 0; i < rank.length; i++) {\n    if (rank[i] === breath) return i;\n  }\n  return 999;\n}\nfunction sa2BreathUnshieldedHits(bucket, shieldAware) {\n  if (!bucket || typeof bucket !== 'object') return 0;\n  var count = bucket.count || 0;\n  if (count <= 0) return 0;\n  if (shieldAware) return Math.max(0, count - (bucket.shielded || 0));\n  return count;\n}\nfunction sa2CountGkMobsByType() {\n  var counts = { artificer: 0, battlecharger: 0, excoropox: 0, koirakko: 0, sentinel: 0 };\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Items && GMCP.Items.room) {\n      for (var i = 0; i < GMCP.Items.room.length; i++) {\n        var item = GMCP.Items.room[i];\n        if (!sa2ChGrimkeepItemIsGkMob(item) || !item.name) continue;\n        var mobType = sa2GkMobTypeFromName(item.name);\n        if (mobType && counts[mobType] != null) counts[mobType]++;\n      }\n    }\n  } catch (e) {}\n  return counts;\n}\nfunction sa2SmartBreathPick() {\n  var stats = sa2MobTypeStatsFromGmcp();\n  var target = sa2BreathPickTargetType(stats);\n  if (target) {\n    var owned = sa2BreathForTypeOwned(target);\n    if (owned) return owned;\n  }\n  var shieldAware = stats.shieldDataAvailable === true;\n  var mobTypes = ['artificer', 'battlecharger', 'excoropox', 'koirakko', 'sentinel'];\n  var scores = {};\n  for (var i = 0; i < mobTypes.length; i++) {\n    var hits = sa2BreathUnshieldedHits(stats[mobTypes[i]], shieldAware);\n    if (hits > 0) {\n      var breath = sa2BreathForTypeOwned(mobTypes[i]);\n      if (breath) scores[breath] = (scores[breath] || 0) + hits;\n    }\n  }\n  var best = null, bestScore = 0;\n  for (var b in scores) {\n    var score = scores[b];\n    if (score > bestScore) {\n      best = b;\n      bestScore = score;\n    } else if (score === bestScore && score > 0) {\n      if (sa2BreathFallbackRankIndex(b) < sa2BreathFallbackRankIndex(best)) best = b;\n    }\n  }\n  if (bestScore > 0 && best) return best;\n  return null;\n}\nfunction sa2BreathFirstOwned() {\n  var rank = sa2BreathFallbackRank();\n  for (var r = 0; r < rank.length; r++) {\n    if (sa2BreathOwns(rank[r])) return rank[r];\n  }\n  return null;\n}\nfunction sa2BreathMode() {\n  var m = String(sa2Get('sa2_breath_mode', '') || '').toLowerCase();\n  if (m === 'smart' || m === 'peppermint' || m === 'fire' || m === 'divinus') return m;\n  if (sa2Bool('sa2_smart_breath')) return 'smart';\n  return 'smart';\n}\nfunction sa2BreathModeLabel() {\n  var m = sa2BreathMode();\n  if (m === 'peppermint') return 'Breath: Peppermint';\n  if (m === 'fire') return 'Breath: Fire';\n  if (m === 'divinus') return 'Breath: Divinus';\n  if (m === 'smart') return 'Breath: Smart';\n  return 'Breath: Smart';\n}\nfunction sa2BreathModeTip() {\n  var tip = 'Cycle beast breath: smart, peppermint, fire, divinus. Smart picks from owned types only.';\n  if (sa2BreathMode() === 'smart') {\n    var pick = sa2SmartBreathPick() || sa2BreathFirstOwned();\n    if (pick) tip += ' Currently: ' + pick + '.';\n    var owned = sa2BreathOwnedList();\n    if (owned.length) tip += ' Owned: ' + owned.join(', ') + '.';\n  }\n  return tip;\n}\nfunction sa2BreathModeOn() {\n  return true;\n}\nfunction sa2BreathEnsureSaved() {\n  try {\n    if (!sa2Get('sa2_ch_saved_beast_cmd', '')) {\n      sa2Set('sa2_ch_saved_beast_cmd', String(get_variable('sCHCommandBeast') || ''));\n    }\n  } catch (e) {}\n}\nfunction sa2BreathCycle() {\n  var cur = sa2BreathMode();\n  var next = (cur === 'smart') ? 'peppermint' : (cur === 'peppermint') ? 'fire' : (cur === 'fire') ? 'divinus' : 'smart';\n  sa2BreathEnsureSaved();\n  sa2Set('sa2_breath_mode', next);\n  sa2Set('sa2_smart_breath', next === 'smart' ? '1' : '0');\n  return next;\n}\nfunction sa2BreathToggleOwn(type) {\n  type = sa2BreathNormalizeType(type);\n  if (!type) return false;\n  if (sa2BreathOwns(type) && sa2BreathOwnedList().length <= 1) {\n    display_notice('[SoiledArmour2] At least one breath type must be owned', 'grey');\n    return false;\n  }\n  sa2Set('sa2_breath_own_' + type, sa2BreathOwns(type) ? '0' : '1');\n  display_notice('[SoiledArmour2] Own ' + type + ': ' + (sa2BreathOwns(type) ? 'ON' : 'OFF'), sa2BreathOwns(type) ? 'lime' : 'grey');\n  sa2BreathApply(true);\n  return true;\n}\nfunction sa2BreathSetOwn(type, on) {\n  type = sa2BreathNormalizeType(type);\n  if (!type) return false;\n  var want = (on === true || on === 1 || String(on).toLowerCase() === 'on' || String(on) === '1');\n  if (!want && sa2BreathOwns(type) && sa2BreathOwnedList().length <= 1) {\n    display_notice('[SoiledArmour2] At least one breath type must be owned', 'grey');\n    return false;\n  }\n  sa2Set('sa2_breath_own_' + type, want ? '1' : '0');\n  sa2BreathApply(true);\n  return true;\n}\nfunction sa2BreathApply(refreshPanel) {\n  var breath = sa2SmartBreathPick() || sa2BreathFirstOwned();\n  if (!breath) {\n    var now = Date.now() / 1000;\n    var sa = sa2Soiled();\n    if (!sa.breath) sa.breath = {};\n    if ((now - (sa.breath.lastNoOwnNoticeAt || 0)) >= 8) {\n      sa.breath.lastNoOwnNoticeAt = now;\n      display_notice('[SoiledArmour2] No owned breath for smart mode \u2014 configure Own toggles', 'grey');\n    }\n    if (refreshPanel) sa2RefreshPanel();\n    return;\n  }\n  var last = sa2Get('sa2_smart_breath_last', 'peppermint');\n  if (breath === last) {\n    if (refreshPanel) sa2RefreshPanel();\n    return;\n  }\n  var cmd = 'beast order breathe ' + breath;\n  try {\n    var cur = String(get_variable('sCHCommandBeast') || '');\n    if (cur !== cmd) {\n      set_variable('sCHCommandBeast', cmd);\n    }\n  } catch (e) {}\n  sa2Set('sa2_smart_breath_last', breath);\n  if (refreshPanel) sa2RefreshPanel();\n}\nfunction sa2BashArmed() {\n  return sa2Bool('sa2_bash_armed');\n}\nfunction sa2SetBashArmed(on) {\n  sa2Set('sa2_bash_armed', on ? '1' : '0');\n}\nfunction sa2HasGkMobsInRoom() {\n  var c = sa2CountGkMobsByType();\n  return (c.artificer + c.battlecharger + c.excoropox + c.koirakko + c.sentinel) > 0;\n}\nfunction sa2BashTryStart() {\n  if (!sa2BashArmed() || !sa2ChPresent() || !sa2InGrimkeep() || !sa2HasGkMobsInRoom()) return false;\n  var heldSmnow = false;\n  try {\n    var gkHold = client.crystal.hunt.grimkeep;\n    if (sa2LeanBeastOn() && sa2BeastBalReady() && gkHold && !gkHold.smnow) {\n      gkHold.smnow = true;\n      heldSmnow = true;\n    }\n  } catch (eHold) {}\n  try { run_function('grimkeep_start', '', 'CrystalHunt'); } catch (e) {}\n  if (heldSmnow) {\n    try { client.crystal.hunt.grimkeep.smnow = false; } catch (eClear) {}\n    try { sa2_grimkeep_beast_actions(); } catch (eBeast) {}\n  }\n  return true;\n}\nfunction sa2ArtificerPriorityOn() {\n  return sa2Bool('sa2_artificer_priority');\n}\nfunction sa2AggroTapOn() {\n  return sa2Bool('sa2_aggrotap');\n}\nfunction sa2AggroTapBannerOn() {\n  return sa2Bool('sa2_aggrotap_banner');\n}\nfunction sa2AggroTapSlot() {\n  var n = parseInt(sa2Get('sa2_aggrotap_slot', '1'), 10);\n  if (isNaN(n)) n = 1;\n  if (n < 1) n = 1;\n  if (n > 20) n = 20;\n  return n;\n}\nfunction sa2SetAggroTapSlot(n) {\n  var v = parseInt(n, 10);\n  if (isNaN(v)) v = 1;\n  if (v < 1) v = 1;\n  if (v > 20) v = 20;\n  sa2Set('sa2_aggrotap_slot', String(v));\n}\nfunction sa2AggroTapArtificersInRoom() {\n  var arts = [];\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Items && GMCP.Items.room) {\n      for (var i = 0; i < GMCP.Items.room.length; i++) {\n        var item = GMCP.Items.room[i];\n        if (!sa2ChGrimkeepItemIsGkMob(item) || !item.name) continue;\n        if (String(item.name).toLowerCase().indexOf('artificer') < 0) continue;\n        arts.push({ id: item.id, name: item.name });\n      }\n    }\n  } catch (e) {}\n  return arts;\n}\nfunction sa2AggroTapTarget(slot) {\n  var arts = sa2AggroTapArtificersInRoom();\n  if (arts.length < 2) return null;\n  slot = parseInt(slot, 10);\n  if (isNaN(slot)) slot = 1;\n  if (slot < 1) slot = 1;\n  if (slot > 20) slot = 20;\n  var entry = arts[slot - 1];\n  if (!entry || entry.id == null) return null;\n  return { token: 'artificer' + String(entry.id), id: entry.id };\n}\nfunction sa2AggroTapIsHostile(id) {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Items && GMCP.Items.room) {\n      var key = String(id);\n      for (var i = 0; i < GMCP.Items.room.length; i++) {\n        var item = GMCP.Items.room[i];\n        if (item.id == null && item.id !== 0) continue;\n        if (String(item.id) !== key && item.id !== id) continue;\n        var attrib = String(item.attrib || '').toLowerCase();\n        if (attrib.indexOf('d') >= 0) return false;\n        if (attrib.indexOf('m') >= 0 && attrib.indexOf('h') >= 0) return true;\n        if (item.icon === 'eye-evil') return true;\n        return false;\n      }\n    }\n  } catch (e) {}\n  return null;\n}\nfunction sa2AggroTapFirstCalmArtificer() {\n  var arts = sa2AggroTapArtificersInRoom();\n  if (arts.length < 2) return null;\n  for (var i = 0; i < arts.length; i++) {\n    var entry = arts[i];\n    if (!entry || entry.id == null) continue;\n    if (sa2AggroTapIsHostile(entry.id) === false) {\n      return { token: 'artificer' + String(entry.id), id: entry.id };\n    }\n  }\n  return null;\n}\nfunction sa2AggroTapResolveTarget(slot) {\n  var priorityOn = sa2ArtificerPriorityOn();\n  var calmOn = sa2AggroTapOn();\n  if (!priorityOn && !calmOn) return null;\n  var slotTgt = sa2AggroTapTarget(slot);\n  if (priorityOn && !calmOn) {\n    return slotTgt ? { tgt: slotTgt, mode: 'slot', slot: slot } : null;\n  }\n  if (!priorityOn && calmOn) {\n    var calmOnly = sa2AggroTapFirstCalmArtificer();\n    return calmOnly ? { tgt: calmOnly, mode: 'calm' } : null;\n  }\n  if (slotTgt && sa2AggroTapIsHostile(slotTgt.id) === false) {\n    return { tgt: slotTgt, mode: 'slot', slot: slot };\n  }\n  var calmBoth = sa2AggroTapFirstCalmArtificer();\n  if (calmBoth) return { tgt: calmBoth, mode: 'calm' };\n  return slotTgt ? { tgt: slotTgt, mode: 'slot', slot: slot } : null;\n}\nfunction sa2ChArtificerGnomePrefix() {\n  try {\n    if (!sa2ChPresent()) return 'activate gnomeweapon';\n    var attack = client.crystal.hunt.grimkeep.targetAttackFor('artificer');\n    if (!attack) return 'activate gnomeweapon';\n    var m = String(attack).match(/activate\\s+(\\S+)/i);\n    if (m && m[1]) return 'activate ' + m[1];\n  } catch (e) {}\n  return 'activate gnomeweapon';\n}\nfunction sa2AggroTapTryFire() {\n  if (!sa2MasterOn() || !(sa2ArtificerPriorityOn() || sa2AggroTapOn())) return false;\n  if (!sa2ChPresent() || !sa2InGrimkeep() || !sa2BashArmed()) return false;\n  var sa = sa2Soiled();\n  var COOLDOWN = 3;\n  var now = Date.now() / 1000;