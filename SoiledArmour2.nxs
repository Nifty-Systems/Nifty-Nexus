fKey(n);\n        if (seen[key]) continue;\n        if ((key === 'deaf' || key === 'blind') && sa2AllhealeSensoryIgnored(key)) continue;\n        seen[key] = true;\n        count++;\n      }\n    }\n  } catch (e) {}\n  return count;\n}\nfunction sa2FocusShouldDeferAllheale() {\n  if (!sa2ModuleOn('focus')) return false;\n  var dm = sa2Soiled().deathmark;\n  if (sa2DmMarkCount() >= 1 || dm.markActive) return false;\n  if (sa2DmLingerArmed()) return false;\n  var urgent = sa2Num('sa2_focus_urgent_min', 6);\n  if (sa2DmMarkCount() < urgent) return false;\n  if (!sa2DustReady()) return false;\n  return sa2DmMarkCount() >= sa2Num('sa2_dm_focus_min', 2);\n}\nfunction sa2AllhealeShouldDefer() {\n  return sa2FocusShouldDeferAllheale();\n}\nfunction sa2AllhealeDebug(msg) {\n  if (!sa2Bool('sa2_debug_allheale')) return;\n  display_notice('[SoiledArmour2 AllHeale dbg] ' + msg, 'grey');\n}\nfunction sa2AllhealeReasonStillValid(reason) {\n  var r = String(reason || '');\n  switch (r) {\n    case 'low-hp':\n      return sa2HealthPct() < sa2Num('sa2_threshold_allheale', 0.7);\n    case 'death-mark': {\n      var dm = sa2Soiled().deathmark;\n      return sa2DmMarkCount() >= 1 || !!(dm && dm.markActive);\n    }\n    case 'mark-linger':\n      return sa2DmLingerArmed();\n    case 'aff-threshold':\n      return sa2AllhealeEffectiveAffCount() >= SA2_AFF_THRESHOLD;\n    case 'persistence':\n      return sa2AllhealeEffectiveAffCount() >= 1;\n    case 'missing-cure': {\n      var ah = sa2AllhealeState();\n      var now = Date.now() / 1000;\n      return sa2AllhealeEffectiveAffCount() >= 1 && (now - (ah.lastMissingTriggerAt || 0)) <= 15;\n    }\n    default:\n      return false;\n  }\n}\nfunction sa2AllhealeClearWantIfStale() {\n  var ah = sa2AllhealeState();\n  if (!ah._wantSip) return;\n  if (!sa2AllhealeReasonStillValid(ah._wantReason)) {\n    sa2AllhealeDebug('clear stale want reason=' + (ah._wantReason || '?'));\n    ah._wantSip = false;\n    ah._wantReason = '';\n  }\n}\nfunction sa2AllhealeTrySip(reason) {\n  if (!sa2ModuleOn('allheale')) {\n    sa2AllhealeDebug('TrySip fail: module off reason=' + (reason || 'auto'));\n    return false;\n  }\n  if (sa2AllhealeShouldDefer()) {\n    sa2AllhealeDebug('TrySip fail: defer reason=' + (reason || 'auto'));\n    return false;\n  }\n  var ah = sa2AllhealeState();\n  var now = Date.now() / 1000;\n  var interval = sa2Num('sa2_allheale_interval', 4);\n  if ((now - (ah.lastSipAt || 0)) < interval) {\n    sa2AllhealeDebug('TrySip fail: interval reason=' + (reason || 'auto'));\n    return false;\n  }\n  if (!sa2AllhealeReady()) {\n    sa2AllhealeDebug('TrySip fail: not-ready reason=' + (reason || 'auto'));\n    return false;\n  }\n  send_command('sip allheale', 0);\n  ah.lastSipAt = now;\n  ah._wantSip = false;\n  ah._wantReason = '';\n  display_notice('[SoiledArmour2] AllHeale sip (' + (reason || 'auto') + ')', 'yellow');\n  return true;\n}\nfunction sa2AllhealeRequest(reason) {\n  if (!sa2ModuleOn('allheale')) return false;\n  var ah = sa2AllhealeState();\n  ah._wantSip = true;\n  ah._wantReason = reason || 'request';\n  sa2AllhealeDebug('set want reason=' + ah._wantReason + ' hp=' + Math.floor(sa2HealthPct() * 100) + '% aff=' + sa2AllhealeEffectiveAffCount() + ' marks=' + sa2DmMarkCount());\n  return sa2AllhealeTrySip(ah._wantReason);\n}\nfunction sa2AllhealeAttemptPending() {\n  var ah = sa2AllhealeState();\n  if (!ah._wantSip) return false;\n  sa2AllhealeClearWantIfStale();\n  if (!ah._wantSip) return false;\n  sa2AllhealeDebug('AttemptPending retry reason=' + (ah._wantReason || 'pending'));\n  return sa2AllhealeTrySip(ah._wantReason || 'pending');\n}\nfunction sa2AllhealeNotify() {\n  if (!sa2ModuleOn('allheale')) return;\n  var dm = sa2Soiled().deathmark;\n  if (sa2DmLingerArmed()) {\n    sa2AllhealeRequest('mark-linger');\n    return;\n  }\n  if (sa2DmMarkCount() >= 1 || dm.markActive) {\n    sa2AllhealeRequest('death-mark');\n  }\n  sa2AllhealeAttemptPending();\n}\nfunction sa2AllhealeCheckAffThreshold() {\n  if (!sa2ModuleOn('allheale')) return;\n  if (sa2AllhealeEffectiveAffCount() >= SA2_AFF_THRESHOLD) {\n    sa2AllhealeRequest('aff-threshold');\n  }\n  sa2AllhealeClearWantIfStale();\n}\nfunction sa2AllhealeCheckPersistence() {\n  if (!sa2ModuleOn('allheale')) return;\n  var ah = sa2AllhealeState();\n  var count = sa2AllhealeEffectiveAffCount();\n  var now = Date.now() / 1000;\n  if (count !== ah.lastAffCount) {\n    ah.lastAffCount = count;\n    ah.affCountSameStartTime = now;\n    ah.persistenceSipRequested = false;\n    if (ah.persistTimerId) { try { clearTimeout(ah.persistTimerId); } catch (e) {} ah.persistTimerId = null; }\n    if (count >= 1) {\n      ah.persistTimerId = setTimeout(function () {\n        sa2AllhealeState().persistTimerId = null;\n        if (sa2AllhealeEffectiveAffCount() >= 1 && !sa2AllhealeState().persistenceSipRequested) {\n          sa2AllhealeState().persistenceSipRequested = true;\n          sa2AllhealeRequest('persistence');\n        }\n      }, SA2_PERSISTENCE_SEC * 1000);\n    }\n  }\n}\nfunction sa2AllhealeCheckLowHp() {\n  if (!sa2ModuleOn('allheale')) return;\n  if (sa2HealthPct() < sa2Num('sa2_threshold_allheale', 0.7)) {\n    sa2AllhealeRequest('low-hp');\n  }\n  sa2AllhealeClearWantIfStale();\n}\nfunction sa2AllhealeCheckDeathMark() {\n  if (!sa2ModuleOn('allheale')) return;\n  var dm = sa2Soiled().deathmark;\n  if (sa2DmMarkCount() >= 1 || dm.markActive) {\n    sa2AllhealeRequest('death-mark');\n  }\n  sa2AllhealeClearWantIfStale();\n}\nfunction sa2AllhealeOnMissingCure(msg) {\n  if (!sa2ModuleOn('allheale')) return;\n  var text = String(msg || '').toLowerCase();\n  var isMissing = text.indexOf('missing') >= 0 || text.indexOf(\"don't have\") >= 0 || text.indexOf('dont have') >= 0\n    || text.indexOf(\"aren't holding\") >= 0 || text.indexOf('arent holding') >= 0\n    || /no\\s+.+\\s+found/.test(text) || text.indexOf('cannot find') >= 0\n    || text.indexOf('unable to find') >= 0 || text.indexOf('not found') >= 0;\n  if (!isMissing) return;\n  var ah = sa2AllhealeState();\n  var now = Date.now() / 1000;\n  if ((now - (ah.lastMissingTriggerAt || 0)) < 2.5) return;\n  if (sa2AllhealeEffectiveAffCount() < 1) return;\n  ah.lastMissingTriggerAt = now;\n  sa2AllhealeRequest('missing-cure');\n}\nvar dm = sa2Soiled().deathmark;\nvar sh = sa2Soiled().shield;\nvar qs = sa2Soiled().quicksilver;\nvar tt = sa2Soiled().truetime;\nvar san = sa2Soiled().sanctity;\nvar tx = sa2Soiled().transmute;\nvar ah = sa2Soiled().allheale || {};\nvar pf = sa2Soiled().focus || {};\n\nvar on = function(id) { return sa2ModuleOn(id) ? 'ON ' : 'OFF'; };\nvar yn = function(b) { return b ? 'yes' : 'no'; };\nvar sipAge = ((Date.now() / 1000) - (ah.lastSipAt || 0)).toFixed(1);\nvar pfTier = sa2DmMarkCount() >= sa2Num('sa2_focus_urgent_min', 6) ? 'urgent' : (sa2DmMarkCount() >= sa2Num('sa2_dm_focus_min', 2) ? 'normal' : 'below');\nvar restraint = sa2Get('sa2_shield_mode', 'crisis') === 'crisis' && (sa2RoomMobCount() <= sa2Num('sa2_shield_mob_restraint_max', 9)) && (sa2HealthPct() * 100 >= sa2Num('sa2_shield_crisis_hp', 66));\n\ndisplay_notice('[SoiledArmour2 v' + sa2Get('sSoiledArmour2Version', '2.2.46') + ']  master: ' + (sa2MasterOn() ? 'ON' : 'OFF') + (sa2Bool('sa2_ch_armed') ? '  CH-linked' : ''), 'gold');\ndisplay_notice('  marks        ' + sa2DmMarkCount() + ' (source=' + (sa2ChMarkSource() ? 'CH' : 'SA2') + ')  mobs=' + sa2RoomMobCount() + ' art=' + sa2CountArtificersInRoom(), 'white');\ndisplay_notice('  transmute    ' + on('transmute') + '  (chain=' + yn(tx.chainActive) + ')          -> sld transmute on | off', 'cyan');\ndisplay_notice('  trueheal     ' + on('trueheal') + '  (threshold ' + Math.floor(sa2Num('sa2_threshold_trueheal', 0.35) * 100) + '%)     -> sld trueheal on | off', 'cyan');\ndisplay_notice('  focus        ' + on('focus') + '  (mark=' + (dm.markCount || 0) + ' tier=' + pfTier + ' art=' + sa2CountArtificersInRoom() + ') -> sld focus on | off', 'cyan');\ndisplay_notice('  allheale     ' + on('allheale') + '  (aff=' + sa2AllhealeEffectiveAffCount() + ' sip=' + sipAge + 's ago) -> sld allheale on | off', 'cyan');\ndisplay_notice('  allheale AHL ' + (sa2AllhealeReady() ? 'READY' : 'COOLDOWN'), 'white');\ndisplay_notice('  dustqueue    ' + on('dustqueue') + '  (mode=' + (dm.dustqueueMode || 'short') + ' elixir=' + (dm._elixirqueueMode || '?') + ') -> sld dustqueue on | off', 'cyan');\ndisplay_notice('  sanctity     ' + on('sanctity') + '  (def=' + yn(san.defenceActive) + ' hp<=' + Math.floor(sa2Num('sa2_sanctity_hp_threshold', 0.75) * 100) + '%) -> sld sanctity on | off', 'cyan');\ndisplay_notice('  shield       ' + on('shield') + '  (mode=' + sa2Get('sa2_shield_mode', 'crisis') + ' mobs=' + sa2RoomMobCount() + ' restraint=' + yn(restraint) + ') -> sld shield crisis | constant | off', 'cyan');\ndisplay_notice('  quicksilver  ' + on('quicksilver') + '  (def=' + yn(qs.defenceActive) + ')           -> sld quicksilver on | off', 'cyan');\ndisplay_notice('  truetime     ' + on('truetime') + '  (def=' + yn(tt.defenceActive) + ')           -> sld truetime on | off', 'cyan');\ndisplay_notice('  tea          ' + on('tea') + '  (greentea, belch trigger) -> sld tea on | off | sld tea green', 'cyan');\ndisplay_notice('  artpriority  ' + (sa2ArtificerPriorityOn() ? 'ON' : 'OFF') + '  (slot=' + sa2AggroTapSlot() + ' bash=' + (sa2BashArmed() ? 'ON' : 'OFF') + ') -> sld artpriority on | off  sld aggroslot <n>', 'cyan');\ndisplay_notice('  aggrotap     ' + (sa2AggroTapOn() ? 'ON' : 'OFF') + '  (calm preference) -> sld aggrotap on | off', 'cyan');\ndisplay_notice('  tapbanner    ' + (sa2AggroTapBannerOn() ? 'ON' : 'OFF') + '  (notice when tap queues) -> sld tapbanner on | off', 'cyan');\ndisplay_notice('  breath       own=' + sa2BreathOwnedList().join(',') + ' pick=' + (sa2SmartBreathPick() || sa2BreathFirstOwned() || 'none') + ' -> sld breath | sld breath own <type> on|off', 'cyan');\ndisplay_notice('  watchdog     linger=' + yn(dm.lingerArmed) + ' interval=' + sa2Num('sa2_dm_watchdog_sec', 5) + 's dustEdge=' + yn(pf._lastDustReady), 'white');\ndisplay_notice('Master: soiled armour | sld on | sld off    Menu: sld menu | status | help | Panel: sld panel', 'white');\nsa2RefreshPanel();\n"},{"type":"function","name":"sa2_help","enabled":true,"id":70,"code":"function sa2Get(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction sa2Set(k, v) { set_variable(k, String(v)); }\nfunction sa2Bool(k) {\n  var v = get_variable(k);\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  if (v === undefined || v === null || v === '') return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction sa2Def(k, v) {\n  if (get_variable(k) === undefined || get_variable(k) === null) set_variable(k, v);\n}\nfunction sa2Soiled() {\n  if (client.soiledarmour2 == undefined) client.soiledarmour2 = {};\n  return client.soiledarmour2;\n}\nfunction sa2MasterOn() {\n  return sa2Bool('sa2_master');\n}\nfunction sa2ModuleOn(id) {\n  if (!sa2MasterOn()) return false;\n  return sa2Bool('sa2_' + id);\n}\nfunction sa2Num(k, d) {\n  var n = parseFloat(sa2Get(k, String(d)));\n  return isNaN(n) ? d : n;\n}\nfunction sa2BalEqReady() {\n  var balReady = false, eqReady = false, hasAny = false;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char) {\n      if (GMCP.Char.Balance && GMCP.Char.Balance.List) {\n        hasAny = true;\n        balReady = (GMCP.Char.Balance.List.balance === '1' || GMCP.Char.Balance.List.balance === 1);\n        eqReady = (GMCP.Char.Balance.List.equilibrium === '1' || GMCP.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && GMCP.Char.Vitals) {\n        hasAny = true;\n        balReady = (GMCP.Char.Vitals.balance === '1' || GMCP.Char.Vitals.balance === 1);\n        eqReady = (GMCP.Char.Vitals.equilibrium === '1' || GMCP.Char.Vitals.equilibrium === 1);\n      }\n    }\n    if (!hasAny && typeof gmcp !== 'undefined' && gmcp && gmcp.Char) {\n      if (gmcp.Char.Balance && gmcp.Char.Balance.List) {\n        hasAny = true;\n        balReady = (gmcp.Char.Balance.List.balance === '1' || gmcp.Char.Balance.List.balance === 1);\n        eqReady = (gmcp.Char.Balance.List.equilibrium === '1' || gmcp.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && gmcp.Char.Vitals) {\n        hasAny = true;\n        balReady = (gmcp.Char.Vitals.balance === '1' || gmcp.Char.Vitals.balance === 1);\n        eqReady = (gmcp.Char.Vitals.equilibrium === '1' || gmcp.Char.Vitals.equilibrium === 1);\n      }\n    }\n  } catch (e) {}\n  if (!hasAny) return true;\n  return balReady && eqReady;\n}\nfunction sa2SipReady() {\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Balance && gmcp.Char.Balance.List) {\n      var sip = gmcp.Char.Balance.List.sip;\n      return sip === '1' || sip === 1 || sip === true;\n    }\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Balance && GMCP.Char.Balance.List) {\n      var sip2 = GMCP.Char.Balance.List.sip;\n      return sip2 === '1' || sip2 === 1 || sip2 === true;\n    }\n  } catch (e) {}\n  return true;\n}\nfunction sa2AllhealeReady() {\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Vitals) {\n      var ahl = parseInt(gmcp.Char.Vitals.allheale, 10);\n      if (!isNaN(ahl)) return ahl === 1;\n    }\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Vitals) {\n      var ahl2 = parseInt(GMCP.Char.Vitals.allheale, 10);\n      if (!isNaN(ahl2)) return ahl2 === 1;\n    }\n    var cached = sa2GetVitals();\n    var raw = parseInt(cached.allheale, 10);\n    return raw === 1;\n  } catch (e) { return false; }\n}\nfunction sa2DustReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.dust === 1 || v.dust === '1');\n  } catch (e) { return false; }\n}\nfunction sa2BeastBalSnapshot() {\n  var snap = { gmcp: '', my: '', cache: '', ready: false };\n  try { snap.gmcp = (GMCP && GMCP.Vitals) ? String(GMCP.Vitals.beastbal) : 'nogmcp'; } catch (e1) { snap.gmcp = 'err'; }\n  try { snap.my = String(get_variable('my_beastbal')); } catch (e2) { snap.my = 'err'; }\n  try {\n    var v = sa2GetVitals();\n    snap.cache = v ? String(v.beastbal) : '';\n  } catch (e3) { snap.cache = 'err'; }\n  snap.ready = (snap.gmcp === '1' || snap.my === '1' || snap.cache === '1');\n  return snap;\n}\nfunction sa2BeastMarkSpent() {\n  var sa = sa2Soiled();\n  sa.beast = sa.beast || {};\n  sa.beast.spent = true;\n  sa.beast.spentAt = Date.now() / 1000;\n  try { if (typeof GMCP !== 'undefined' && GMCP && GMCP.Vitals) GMCP.Vitals.beastbal = '0'; } catch (e1) {}\n  try { set_variable('my_beastbal', '0'); } catch (e2) {}\n  try {\n    var v = sa2GetVitals();\n    v.beastbal = '0';\n    sa2CacheVitals(v);\n  } catch (e3) {}\n}\nfunction sa2BeastClearSpent() {\n  var sa = sa2Soiled();\n  sa.beast = sa.beast || {};\n  sa.beast.spent = false;\n  try { set_variable('my_beastbal', '1'); } catch (e1) {}\n  try {\n    var v = sa2GetVitals();\n    v.beastbal = '1';\n    sa2CacheVitals(v);\n  } catch (e2) {}\n}\nfunction sa2BeastBalReady() {\n  var sa = sa2Soiled();\n  sa.beast = sa.beast || {};\n  if (sa.beast.spent) {\n    var now = Date.now() / 1000;\n    if ((now - (sa.beast.spentAt || 0)) > 20) sa.beast.spent = false;\n    else return false;\n  }\n  return sa2BeastBalSnapshot().ready;\n}\nfunction sa2GetVitals() {\n  try {\n    var raw = sa2Get('sa2_last_vitals', '{}');\n    return JSON.parse(raw);\n  } catch (e) { return {}; }\n}\nfunction sa2CacheVitals(v) {\n  try { sa2Set('sa2_last_vitals', JSON.stringify(v)); } catch (e) {}\n}\nfunction sa2HealthPct() {\n  var v = sa2GetVitals();\n  var maxhp = parseInt(v.maxhp || v.maxhealth, 10);\n  var hp = parseInt(v.hp || v.currenthealth, 10);\n  if (maxhp > 0 && !isNaN(hp)) return hp / maxhp;\n  return 1;\n}\nfunction sa2HasDef(name) {\n  var sa = sa2Soiled();\