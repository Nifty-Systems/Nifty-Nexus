a2DmShouldYieldShield() {\n  if (!sa2ModuleOn('powerfocus')) return false;\n  var dm = sa2Soiled().deathmark;\n  if (sa2DmMarkCount() >= 2) { dm.shieldYieldBelowSince = null; return true; }\n  var now = Date.now() / 1000;\n  if (!dm.shieldYieldBelowSince) return false;\n  return (now - dm.shieldYieldBelowSince) < 20;\n}\nfunction sa2DmStopRetry() {\n  var dm = sa2Soiled().deathmark;\n  dm.lingerArmed = false;\n  if (dm.retryTimerId) { try { clearTimeout(dm.retryTimerId); } catch (e) {} dm.retryTimerId = null; }\n}\nfunction sa2DmStopArm() {\n  var dm = sa2Soiled().deathmark;\n  if (dm.armTimerId) { try { clearTimeout(dm.armTimerId); } catch (e) {} dm.armTimerId = null; }\n  sa2DmStopRetry();\n}\nfunction sa2DmSendDustqueue(force) {\n  if (!sa2ModuleOn('dustqueue')) return;\n  var dm = sa2Soiled().deathmark;\n  var want = (sa2DmMarkCount() >= 3) ? 'full' : 'short';\n  var cmd = want === 'full' ? DUSTQUEUE_FULL : DUSTQUEUE_SHORT;\n  if (!force && dm.dustqueueMode === want && dm.dustqueueLastCmd === cmd) return;\n  dm.dustqueueMode = want; dm.dustqueueLastCmd = cmd;\n  send_command(cmd, 0);\n}\nfunction sa2DmScheduleRetry() {\n  var dm = sa2Soiled().deathmark;\n  if (!dm.lingerArmed || !dm.markActive) return;\n  var delay = sa2Num('sa2_dm_retry_sec', 1.3) * 1000;\n  if (delay < 50) delay = 50;\n  if (dm.retryTimerId) { try { clearTimeout(dm.retryTimerId); } catch (e) {} }\n  dm.retryTimerId = setTimeout(function () {\n    sa2Soiled().deathmark.retryTimerId = null;\n    try { run_function('sa2_dm_retry', '', 'SoiledArmour2'); } catch (e2) {}\n  }, delay);\n}\n\nsa2DmSendDustqueue(true);\n"},{"type":"function","name":"sa2_on_afflictions","enabled":true,"id":9,"code":"function sa2Get(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction sa2Set(k, v) { set_variable(k, String(v)); }\nfunction sa2Bool(k) {\n  var v = get_variable(k);\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  if (v === undefined || v === null || v === '') return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction sa2Def(k, v) {\n  if (get_variable(k) === undefined || get_variable(k) === null) set_variable(k, v);\n}\nfunction sa2Soiled() {\n  if (client.soiledarmour2 == undefined) client.soiledarmour2 = {};\n  return client.soiledarmour2;\n}\nfunction sa2MasterOn() {\n  return sa2Bool('sa2_master');\n}\nfunction sa2ModuleOn(id) {\n  if (!sa2MasterOn()) return false;\n  return sa2Bool('sa2_' + id);\n}\nfunction sa2Num(k, d) {\n  var n = parseFloat(sa2Get(k, String(d)));\n  return isNaN(n) ? d : n;\n}\nfunction sa2BalEqReady() {\n  var balReady = false, eqReady = false, hasAny = false;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char) {\n      if (GMCP.Char.Balance && GMCP.Char.Balance.List) {\n        hasAny = true;\n        balReady = (GMCP.Char.Balance.List.balance === '1' || GMCP.Char.Balance.List.balance === 1);\n        eqReady = (GMCP.Char.Balance.List.equilibrium === '1' || GMCP.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && GMCP.Char.Vitals) {\n        hasAny = true;\n        balReady = (GMCP.Char.Vitals.balance === '1' || GMCP.Char.Vitals.balance === 1);\n        eqReady = (GMCP.Char.Vitals.equilibrium === '1' || GMCP.Char.Vitals.equilibrium === 1);\n      }\n    }\n    if (!hasAny && typeof gmcp !== 'undefined' && gmcp && gmcp.Char) {\n      if (gmcp.Char.Balance && gmcp.Char.Balance.List) {\n        hasAny = true;\n        balReady = (gmcp.Char.Balance.List.balance === '1' || gmcp.Char.Balance.List.balance === 1);\n        eqReady = (gmcp.Char.Balance.List.equilibrium === '1' || gmcp.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && gmcp.Char.Vitals) {\n        hasAny = true;\n        balReady = (gmcp.Char.Vitals.balance === '1' || gmcp.Char.Vitals.balance === 1);\n        eqReady = (gmcp.Char.Vitals.equilibrium === '1' || gmcp.Char.Vitals.equilibrium === 1);\n      }\n    }\n  } catch (e) {}\n  if (!hasAny) return true;\n  return balReady && eqReady;\n}\nfunction sa2SipReady() {\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Balance && gmcp.Char.Balance.List) {\n      var sip = gmcp.Char.Balance.List.sip;\n      return sip === '1' || sip === 1 || sip === true;\n    }\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Balance && GMCP.Char.Balance.List) {\n      var sip2 = GMCP.Char.Balance.List.sip;\n      return sip2 === '1' || sip2 === 1 || sip2 === true;\n    }\n  } catch (e) {}\n  return true;\n}\nfunction sa2AllhealeReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.allheale === 1 || v.allheale === '1');\n  } catch (e) { return false; }\n}\nfunction sa2DustReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.dust === 1 || v.dust === '1');\n  } catch (e) { return false; }\n}\nfunction sa2BeastBalReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.beastbal === 1 || v.beastbal === '1');\n  } catch (e) { return false; }\n}\nfunction sa2GetVitals() {\n  try {\n    var raw = sa2Get('sa2_last_vitals', '{}');\n    return JSON.parse(raw);\n  } catch (e) { return {}; }\n}\nfunction sa2CacheVitals(v) {\n  try { sa2Set('sa2_last_vitals', JSON.stringify(v)); } catch (e) {}\n}\nfunction sa2HealthPct() {\n  var v = sa2GetVitals();\n  var maxhp = parseInt(v.maxhp || v.maxhealth, 10);\n  var hp = parseInt(v.hp || v.currenthealth, 10);\n  if (maxhp > 0 && !isNaN(hp)) return hp / maxhp;\n  return 1;\n}\nfunction sa2HasDef(name) {\n  var sa = sa2Soiled();\n  if (!sa.defCache) return false;\n  var n = String(name).toLowerCase();\n  for (var k in sa.defCache) {\n    if (sa.defCache[k] && k.indexOf(n) >= 0) return true;\n  }\n  return false;\n}\nfunction sa2UpdateDefCache() {\n  var sa = sa2Soiled();\n  if (!sa.defCache) sa.defCache = {};\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences) {\n      var D = GMCP.Char.Defences;\n      if (D.List && D.List.length) {\n        for (var i = 0; i < D.List.length; i++) {\n          if (D.List[i] && D.List[i].name) sa.defCache[String(D.List[i].name).toLowerCase()] = true;\n        }\n      }\n      if (D.Add && D.Add.name) sa.defCache[String(D.Add.name).toLowerCase()] = true;\n      if (D.Remove) {\n        var rem = Array.isArray(D.Remove) ? D.Remove : [D.Remove];\n        for (var j = 0; j < rem.length; j++) {\n          if (rem[j] && rem[j].name) delete sa.defCache[String(rem[j].name).toLowerCase()];\n        }\n      }\n    }\n  } catch (e) {}\n}\nfunction sa2AffCount() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Afflictions && GMCP.Char.Afflictions.List) {\n      return GMCP.Char.Afflictions.List.length;\n    }\n  } catch (e) {}\n  return 0;\n}\n// Optional: allheale based on aff count (threshold 3)\nif (!sa2ModuleOn('allheale')) return;\nvar affCount = sa2AffCount();\nif (affCount >= 3 && sa2AllhealeReady() && sa2SipReady()) {\n  send_command('sip allheale', 0);\n}\n\n"},{"type":"group","name":"Transmute","enabled":true,"id":83,"items":[{"type":"function","name":"sa2_transmute_tick","enabled":true,"id":10,"code":"function sa2Get(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction sa2Set(k, v) { set_variable(k, String(v)); }\nfunction sa2Bool(k) {\n  var v = get_variable(k);\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  if (v === undefined || v === null || v === '') return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction sa2Def(k, v) {\n  if (get_variable(k) === undefined || get_variable(k) === null) set_variable(k, v);\n}\nfunction sa2Soiled() {\n  if (client.soiledarmour2 == undefined) client.soiledarmour2 = {};\n  return client.soiledarmour2;\n}\nfunction sa2MasterOn() {\n  return sa2Bool('sa2_master');\n}\nfunction sa2ModuleOn(id) {\n  if (!sa2MasterOn()) return false;\n  return sa2Bool('sa2_' + id);\n}\nfunction sa2Num(k, d) {\n  var n = parseFloat(sa2Get(k, String(d)));\n  return isNaN(n) ? d : n;\n}\nfunction sa2BalEqReady() {\n  var balReady = false, eqReady = false, hasAny = false;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char) {\n      if (GMCP.Char.Balance && GMCP.Char.Balance.List) {\n        hasAny = true;\n        balReady = (GMCP.Char.Balance.List.balance === '1' || GMCP.Char.Balance.List.balance === 1);\n        eqReady = (GMCP.Char.Balance.List.equilibrium === '1' || GMCP.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && GMCP.Char.Vitals) {\n        hasAny = true;\n        balReady = (GMCP.Char.Vitals.balance === '1' || GMCP.Char.Vitals.balance === 1);\n        eqReady = (GMCP.Char.Vitals.equilibrium === '1' || GMCP.Char.Vitals.equilibrium === 1);\n      }\n    }\n    if (!hasAny && typeof gmcp !== 'undefined' && gmcp && gmcp.Char) {\n      if (gmcp.Char.Balance && gmcp.Char.Balance.List) {\n        hasAny = true;\n        balReady = (gmcp.Char.Balance.List.balance === '1' || gmcp.Char.Balance.List.balance === 1);\n        eqReady = (gmcp.Char.Balance.List.equilibrium === '1' || gmcp.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && gmcp.Char.Vitals) {\n        hasAny = true;\n        balReady = (gmcp.Char.Vitals.balance === '1' || gmcp.Char.Vitals.balance === 1);\n        eqReady = (gmcp.Char.Vitals.equilibrium === '1' || gmcp.Char.Vitals.equilibrium === 1);\n      }\n    }\n  } catch (e) {}\n  if (!hasAny) return true;\n  return balReady && eqReady;\n}\nfunction sa2SipReady() {\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Balance && gmcp.Char.Balance.List) {\n      var sip = gmcp.Char.Balance.List.sip;\n      return sip === '1' || sip === 1 || sip === true;\n    }\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Balance && GMCP.Char.Balance.List) {\n      var sip2 = GMCP.Char.Balance.List.sip;\n      return sip2 === '1' || sip2 === 1 || sip2 === true;\n    }\n  } catch (e) {}\n  return true;\n}\nfunction sa2AllhealeReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.allheale === 1 || v.allheale === '1');\n  } catch (e) { return false; }\n}\nfunction sa2DustReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.dust === 1 || v.dust === '1');\n  } catch (e) { return false; }\n}\nfunction sa2BeastBalReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.beastbal === 1 || v.beastbal === '1');\n  } catch (e) { return false; }\n}\nfunction sa2GetVitals() {\n  try {\n    var raw = sa2Get('sa2_last_vitals', '{}');\n    return JSON.parse(raw);\n  } catch (e) { return {}; }\n}\nfunction sa2CacheVitals(v) {\n  try { sa2Set('sa2_last_vitals', JSON.stringify(v)); } catch (e) {}\n}\nfunction sa2HealthPct() {\n  var v = sa2GetVitals();\n  var maxhp = parseInt(v.maxhp || v.maxhealth, 10);\n  var hp = parseInt(v.hp || v.currenthealth, 10);\n  if (maxhp > 0 && !isNaN(hp)) return hp / maxhp;\n  return 1;\n}\nfunction sa2HasDef(name) {\n  var sa = sa2Soiled();\n  if (!sa.defCache) return false;\n  var n = String(name).toLowerCase();\n  for (var k in sa.defCache) {\n    if (sa.defCache[k] && k.indexOf(n) >= 0) return true;\n  }\n  return false;\n}\nfunction sa2UpdateDefCache() {\n  var sa = sa2Soiled();\n  if (!sa.defCache) sa.defCache = {};\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences) {\n      var D = GMCP.Char.Defences;\n      if (D.List && D.List.length) {\n        for (var i = 0; i < D.List.length; i++) {\n          if (D.List[i] && D.List[i].name) sa.defCache[String(D.List[i].name).toLowerCase()] = true;\n        }\n      }\n      if (D.Add && D.Add.name) sa.defCache[String(D.Add.name).toLowerCase()] = true;\n      if (D.Remove) {\n        var rem = Array.isArray(D.Remove) ? D.Remove : [D.Remove];\n        for (var j = 0; j < rem.length; j++) {\n          if (rem[j] && rem[j].name) delete sa.defCache[String(rem[j].name).toLowerCase()];\n        }\n      }\n    }\n  } catch (e) {}\n}\nfunction sa2AffCount() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Afflictions && GMCP.Char.Afflictions.List) {\n      return GMCP.Char.Afflictions.List.length;\n    }\n  } catch (e) {}\n  return 0;\n}\nif (!sa2ModuleOn('transmute')) return;\n\nvar sa = sa2Soiled();\nvar tx = sa.transmute;\n\nfunction hasStupidity() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Afflictions && GMCP.Char.Afflictions.List) {\n      for (var i = 0; i < GMCP.Char.Afflictions.List.length; i++) {\n        var item = GMCP.Char.Afflictions.List[i];\n        if (item && item.name && String(item.name).toLowerCase() === 'stupidity') return true;\n      }\n    }\n  } catch (e) {}\n  return false;\n}\n\nfunction perCastAmount(missing) {\n  missing = parseInt(missing, 10) || 0;\n  if (missing < 1) return 1;\n  return Math.min(1000, Math.floor(missing));\n}\n\nfunction isRefreshAvailable() {\n  var cur = sa2Get('sa2_current_date', ''), last = sa2Get('sa2_refresh_last_used', '');\n  if (!cur) return false;\n  if (!last) return true;\n  return cur !== last;\n}\n\nfunction markRefreshUsed() {\n  var cur = sa2Get('sa2_current_date', '');\n  if (cur) { sa2Set('sa2_refresh_last_used', cur); display_notice('[SoiledArmour2] Refresh power used on ' + cur, 'yellow'); }\n}\n\nfunction endChain(VITS, skipSecondary) {\n  var pctStr = tx.pendingSecondaryPct;\n  tx.chainActive = false; tx.transmuting = false; tx.burstCasts = 0; tx.totalCasts = 0; tx.pendingSecondaryPct = null;\n  if (pctStr !== null && !skipSecondary) runSecondaries(pctStr, VITS);\n}\n\nfunction runSecondaries(healthPercent, VITS) {\n  healthPercent = parseFloat(healthPercent);\n  if (isNaN(healthPercent)) return;\n  \n  // Allheale sip at 70%\n  if (healthPercent < sa2Num('sa2_threshold_allheale', 0.7) && sa2ModuleOn('allheale')) {\n    if (sa2AllhealeReady() && sa2SipReady()) {\n      send_command('sip allheale', 0);\n    }\n  }\n  \n  // Trueheal at threshold\n  var thTrue = sa2Num('sa2_threshold_trueheal', 0.35);\n  if (healthPercent < thTrue && sa2ModuleOn('trueheal') && sa2BalEqReady()) {\n    var currentPower = parseInt((VITS.pow || VITS.power), 10) || 0;\n    if (currentPower >= 10) {\n      send_command('starchant trueheal', 0);\n    } else if (isRefreshAvailable()) {\n      send_command('refresh power', 0);\n      markRefreshUsed();\n      send_command('starchant trueheal', 0);\n    }\n  }\n}\n\nfunction fireTransmuteCast(maxhp, curhp, showBanner) {\n  var amt = perCastAmount(maxhp - curhp);\n  if (showBanner) {\n    display_notice('================================================================================', 'white');\n    display_notice('                         TRANSMUTE ACTIVATED                         ', 'cyan');\n    display_notice('================================================================================', 'white');\n  }\n  send_command('transmute ' + String(amt), 0);\n  tx.lastTransmuteTime = Date.now() / 1000;\n  tx.burstCasts++;\n  tx.totalCasts++;\n}\n\nfunction tryContinueChain(VITS) {\n  if (!tx.chainActive) return;\n  if (hasStupidity()) { endChain(VITS, false); return; }\n  \n  var maxhp = parseInt(VITS.maxhp || VITS.maxhealth, 10);\n  var curhp = parseInt(VITS.hp || VITS.currenthealth, 10);\n  if (!maxhp || !curhp || curhp >= maxhp) { endChain(VITS, false); return; }\n  if (tx.totalCasts >= sa2Num('sa2_max_total_casts', 12)) { endChain(VITS, false); return; }\n  if (!sa2BalEqReady()) return;\n  \n  var now = Date.now() / 1000;\n  if ((now - (tx.lastTransmuteTime || 0)) < sa2Num('sa2_transmute_cooldown', 0.7)) return;\n  if (tx.burstCasts >= sa2Num('sa2_max_burst_casts', 4)) tx.burstCasts = 0;\n  \n  fireTransmuteCast(maxhp, curhp, false);\n}\n\n// Request date if needed\nvar curDate = sa2Get('sa2_current_date', '');\nif (!curDate) {\n  var lastReq = parseFloat(sa2Get('sa2_last_date_request', '0')), nowReq = Date.now() / 1000;\n  if ((nowReq - lastReq) > 30) { sa2Set('sa2_last_date_request', String(nowReq)); send_command('date', 0); return; }\n}\n\nvar VITS = sa2GetVitals();\nif (!VITS || typeof VITS !== 'object') return;\n\nvar maxhp = parseInt(VITS.maxhp || VITS.maxhealth, 10);\nvar curhp = parseInt(VITS.hp || VITS.currenthealth, 10);\nif (!maxhp || !curhp || maxhp <= 0 || curhp <= 0) return;\n\nif (tx.chainActive) { tryContinueChain(VITS); return; }\nif (tx.transmuting) return;\n\nvar now = Date.now() / 1000;\nif ((now - (tx.lastTransmuteTime || 0)) < sa2Num('sa2_transmute_cooldown', 0.7)) return;\nif (hasStupidity()) return;\n\nvar healthPercent = curhp / maxhp;\nif (healthPercent >= sa2Num('sa2_threshold_transmute', 0.8)) return;\nif (!sa2BalEqReady()) return;\n\ntx.chainActive = true; tx.transmuting = true; tx.burstCasts = 0; tx.totalCasts = 0;\ntx.pendingSecondaryPct = healthPercent;\nfireTransmuteCast(maxhp, curhp, true);\n\n"},{"type":"function","name":"sa2_transmute_done","enabled":true,"id":11,"code":"function sa2Get(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction sa2Set(k, v) { set_variable(k, String(v)); }\nfunction sa2Bool(k) {\n  var v = get_variable(k);\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  if (v === undefined || v === null || v === '') return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction sa2Def(k, v) {\n  if (get_variable(k) === undefined || get_variable(k) === null) set_variable(k, v);\n}\nfunction sa2Soiled() {\n  if (client.soiledarmour2 == undefined) client.soiledarmour2 = {};\n  return client.soiledarmour2;\n}\nfunction sa2MasterOn() {\n  return sa2Bool('sa2_master');\n}\nfunction sa2ModuleOn(id) {\n  if (!sa2MasterOn()) return false;\n  return sa2Bool('sa2_' + id);\n}\nfunction sa2Num(k, d) {\n  var n = parseFloat(sa2Get(k, String(d)));\n  return isNaN(n) ? d : n;\n}\nfunction sa2BalEqReady() {\n  var balReady = false, eqReady = false, hasAny = false;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char) {\n      if (GMCP.Char.Balance && GMCP.Char.Balance.List) {\n        hasAny = true;\n        balReady = (GMCP.Char.Balance.List.balance === '1' || GMCP.Char.Balance.List.balance === 1);\n        eqReady = (GMCP.Char.Balance.List.equilibrium === '1' || GMCP.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && GMCP.Char.Vitals) {\n        hasAny = true;\n        balReady = (GMCP.Char.Vitals.balance === '1' || GMCP.Char.Vitals.balance === 1);\n        eqReady = (GMCP.Char.Vitals.equilibrium === '1' || GMCP.Char.Vitals.equilibrium === 1);\n      }\n    }\n    if (!hasAny && typeof gmcp !== 'undefined' && gmcp && gmcp.Char) {\n      if (gmcp.Char.Balance && gmcp.Char.Balance.List) {\n        hasAny = true;\n        balReady = (gmcp.Char.Balance.List.balance === '1' || gmcp.Char.Balance.List.balance === 1);\n        eqReady = (gmcp.Char.Balance.List.equilibrium === '1' || gmcp.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && gmcp.Char.Vitals) {\n        hasAny = true;\n        balReady = (gmcp.Char.Vitals.balance === '1' || gmcp.Char.Vitals.balance === 1);\n        eqReady = (gmcp.Char.Vitals.equilibrium === '1' || gmcp.Char.Vitals.equilibrium === 1);\n      }\n    }\n  } catch (e) {}\n  if (!hasAny) return true;\n  return balReady && eqReady;\n}\nfunction sa2SipReady() {\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Balance && gmcp.Char.Balance.List) {\n      var sip = gmcp.Char.Balance.List.sip;\n      return sip === '1' || sip === 1 || sip === true;\n    }\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Balance && GMCP.Char.Balance.List) {\n      var sip2 = GMCP.Char.Balance.List.sip;\n      return sip2 === '1' || sip2 === 1 || sip2 === true;\n    }\n  } catch (e) {}\n  return true;\n}\nfunction sa2AllhealeReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.allheale === 1 || v.allheale === '1');\n  } catch (e) { return false; }\n}\nfunction sa2DustReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.dust === 1 || v.dust === '1');\n  } catch (e) { return false; }\n}\nfunction sa2BeastBalReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.beastbal === 1 || v.beastbal === '1');\n  } catch (e) { return false; }\n}\nfunction sa2GetVitals() {\n  try {\n    var raw = sa2Get('sa2_last_vitals', '{}');\n    return JSON.parse(raw);\n  } catch (e) { return {}; }\n}\nfunction sa2CacheVitals(v) {\n  try { sa2Set('sa2_last_vitals', JSON.stringify(v)); } catch (e) {}\n}\nfunction sa2HealthPct() {\n  var v = sa2GetVitals();\n  var maxhp = parseInt(v.maxhp || v.maxhealth, 10);\n  var hp = parseInt(v.hp || v.currenthealth, 10);\n  if (maxhp > 0 && !isNaN(hp)) return hp / maxhp;\n  return 1;\n}\nfunction sa2HasDef(name) {\n  var sa = sa2Soiled();\n  if (!sa.defCache) return false;\n  var n = String(name).toLowerCase();\n  for (var k in sa.defCache) {\n    if (sa.defCache[k] && k.indexOf(n) >= 0) return true;\n  }\n  return false;\n}\nfunction sa2UpdateDefCache() {\n  var sa = sa2Soiled();\n  if (!sa.defCache) sa.defCache = {};\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences) {\n      var D = GMCP.Char.Defences;\n      if (D.List && D.List.length) {\n        for (var i = 0; i < D.List.length; i++) {\n          if (D.List[i] && D.List[i].name) sa.defCache[String(D.List[i].name).toLowerCase()] = true;\n        }\n      }\n      if (D.Add && D.Add.name) sa.defCache[String(D.Add.name).toLowerCase()] = true;\n      if (D.Remove) {\n        var rem = Array.isArray(D.Remove) ? D.Remove : [D.Remove];\n        for (var j = 0; j < rem.length; j++) {\n          if (rem[j] && rem[j].name) delete sa.defCache[String(rem[j].name).toLowerCase()];\n        }\n      }\n    }\n  } catch (e) {}\n}\nfunction sa2AffCount() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Afflictions && GMCP.Char.Afflictions.List) {\n      return GMCP.Char.Afflictions.List.length;\n    }\n  } catch (e) {}\n  return 0;\n}\nvar tx = sa2Soiled().transmute;\ntx.transmuting = false;\ntry { run_function('sa2_transmute_tick', '', 'SoiledArmour2'); } catch (e) {}\n\n"},{"type":"function","name":"sa2_date_trigger","enabled":true,"id":12,"code":"\nvar text = (typeof args === 'string' ? args : (args && args[0]) ? String(args[0]) : '') || '';\nvar match = text.match(/(\\d+)(?:st|nd|rd|th) of ([A-Za-z]+), (\\d+) years after the Coming of Estarra\\.?/i);\nif (match) {\n  var monthIndex = { estar:1, urlachmar:2, kiani:3, dioni:4, vestian:5, avechary:6, dvarsh:7, tzarin:8, klangiary:9, juliary:10, shanthin:11, roarkian:12 };\n  var month = monthIndex[match[2].toLowerCase()];\n  if (month) set_variable('sa2_current_date', parseInt(match[1],10) + '-' + month + '-' + parseInt(match[3],10));\n}\n\n"},{"type":"trigger","name":"","enabled":true,"id":13,"matching":"regexp","whole_words":false,"case_sensitive":false,"text":"(?:Today is the|It is now the)\\s+\\d+(?:st|nd|rd|th) of [A-Za-z]+, \\d+ years after the Coming of Estarra\\.?","actions":[{"action":"script","script":"run_function('sa2_date_trigger', (typeof current_text === 'function' ? current_text() : '') || '','SoiledArmour2');"}]},{"type":"trigger","name":"","enabled":true,"id":14,"matching":"regexp","whole_words":false,"case_sensitive":false,"text":"You call upon your physical training and transmute your mana into pure health\\.","actions":[{"action":"script","script":"try { run_function('sa2_transmute_done', '', 'SoiledArmour2'); } catch (e) {}"}]}]},{"type":"group","name":"DeathMark","enabled":true,"id":84,"items":[{"type":"function","name":"sa2_dm_retry","enabled":true,"id":15,"code":"function sa2Get(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction sa2Set(k, v) { set_variable(k, String(v)); }\nfunction sa2Bool(k) {\n  var v = get_variable(k);\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  if (v === undefined || v === null || v === '') return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction sa2Def(k, v) {\n  if (get_variable(k) === undefined || get_variable(k) === null) set_variable(k, v);\n}\nfunction sa2Soiled() {\n  if (client.soiledarmour2 == undefined) client.soiledarmour2 = {};\n  return client.soiledarmour2;\n}\nfunction sa2MasterOn() {\n  return sa2Bool('sa2_master');\n}\nfunction sa2ModuleOn(id) {\n  if (!sa2MasterOn()) return false;\n  return sa2Bool('sa2_' + id);\n}\nfunction sa2Num(k, d) {\n  var n = parseFloat(sa2Get(k, String(d)));\n  return isNaN(n) ? d : n;\n}\nfunction sa2BalEqReady() {\n  var balReady = false, eqReady = false, hasAny = false;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char) {\n      if (GMCP.Char.Balance && GMCP.Char.Balance.List) {\n        hasAny = true;\n        balReady = (GMCP.Char.Balance.List.balance === '1' || GMCP.Char.Balance.List.balance === 1);\n        eqReady = (GMCP.Char.Balance.List.equilibrium === '1' || GMCP.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && GMCP.Char.Vitals) {\n        hasAny = true;\n        balReady = (GMCP.Char.Vitals.balance === '1' || GMCP.Char.Vitals.balance === 1);\n        eqReady = (GMCP.Char.Vitals.equilibrium === '1' || GMCP.Char.Vitals.equilibrium === 1);\n      }\n    }\n    if (!hasAny && typeof gmcp !== 'undefined' && gmcp && gmcp.Char) {\n      if (gmcp.Char.Balance && gmcp.Char.Balance.List) {\n        hasAny = true;\n        balReady = (gmcp.Char.Balance.List.balance === '1' || gmcp.Char.Balance.List.balance === 1);\n        eqReady = (gmcp.Char.Balance.List.equilibrium === '1' || gmcp.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && gmcp.Char.Vitals) {\n        hasAny = true;\n        balReady = (gmcp.Char.Vitals.balance === '1' || gmcp.Char.Vitals.balance === 1);\n        eqReady = (gmcp.Char.Vitals.equilibrium === '1' || gmcp.Char.Vitals.equilibrium === 1);\n      }\n    }\n  } catch (e) {}\n  if (!hasAny) return true;\n  return balReady && eqReady;\n}\nfunction sa2SipReady() {\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Balance && gmcp.Char.Balance.List) {\n      var sip = gmcp.Char.Balance.List.sip;\n      return sip === '1' || sip === 1 || sip === true;\n    }\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Balance && GMCP.Char.Balance.List) {\n      var sip2 = GMCP.Char.Balance.List.sip;\n      return sip2 === '1' || sip2 === 1 || sip2 === true;\n    }\n  } catch (e) {}\n  return true;\n}\nfunction sa2AllhealeReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.allheale === 1 || v.allheale === '1');\n  } catch (e) { return false; }\n}\nfunction sa2DustReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.dust === 1 || v.dust === '1');\n  } catch (e) { return false; }\n}\nfunction sa2BeastBalReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.beastbal === 1 || v.beastbal === '1');\n  } catch (e) { return false; }\n}\nfunction sa2GetVitals() {\n  try {\n    var raw = sa2Get('sa2_last_vitals', '{}');\n    return JSON.parse(raw);\n  } catch (e) { return {}; }\n}\nfunction sa2CacheVitals(v) {\n  try { sa2Set('sa2_last_vitals', JSON.stringify(v)); } catch (e) {}\n}\nfunction sa2HealthPct() {\n  var v = sa2GetVitals();\n  var maxhp = parseInt(v.maxhp || v.maxhealth, 10);\n  var hp = parseInt(v.hp || v.currenthealth, 10);\n  if (maxhp > 0 && !isNaN(hp)) return hp / maxhp;\n  return 1;\n}\nfunction sa2HasDef(name) {\n  var sa = sa2Soiled();\n  if (!sa.defCache) return false;\n  var n = String(name).toLowerCase();\n  for (var k in sa.defCache) {\n    if (sa.defCache[k] && k.indexOf(n) >= 0) return true;\n  }\n  return false;\n}\nfunction sa2UpdateDefCache() {\n  var sa = sa2Soiled();\n  if (!sa.defCache) sa.defCache = {};\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences) {\n      var D = GMCP.Char.Defences;\n      if (D.List && D.List.length) {\n        for (var i = 0; i < D.List.length; i++) {\n          if (D.List[i] && D.List[i].name) sa.defCache[String(D.List[i].name).toLowerCase()] = true;\n        }\n      }\n      if (D.Add && D.Add.name) sa.defCache[String(D.Add.name).toLowerCase()] = true;\n      if (D.Remove) {\n        var rem = Array.isArray(D.Remove) ? D.Remove : [D.Remove];\n        for (var j = 0; j < rem.length; j++) {\n          if (rem[j] && rem[j].name) delete sa.defCache[String(rem[j].name).toLowerCase()];\n        }\n      }\n    }\n  } catch (e) {}\n}\nfunction sa2AffCount() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Afflictions && GMCP.Char.Afflictions.List) {\n      return GMCP.Char.Afflictions.List.length;\n    }\n  } catch (e) {}\n  return 0;\n}\nvar DUSTQUEUE_SHORT = 'ac mod dustqueue set deathmark3 beast, deathmark3 power 1, deathmark3 focus, deathmark2 beast, deathmark2 power 1, deathmark2 focus, aff';\nvar DUSTQUEUE_FULL = 'ac mod dustqueue set deathmark3 beast, deathmark3 power 1, deathmark3 focus, deathmark2 beast, deathmark2 power 1, deathmark2 focus, deathmark1 beast, deathmark1 power 1, deathmark1 focus, aff';\nfunction sa2DmMarkCount() {\n  return sa2Soiled().deathmark.markCount || 0;\n}\nfunction sa2DmShouldRun() {\n  return sa2ModuleOn('powerfocus') || sa2ModuleOn('allheale') || sa2ModuleOn('dustqueue');\n}\nfunction sa2DmShouldYieldShield() {\n  if (!sa2ModuleOn('powerfocus')) return false;\n  var dm = sa2Soiled().deathmark;\n  if (sa2DmMarkCount() >= 2) { dm.shieldYieldBelowSince = null; return true; }\n  var now = Date.now() / 1000;\n  if (!dm.shieldYieldBelowSince) return false;\n  return (now - dm.shieldYieldBelowSince) < 20;\n}\nfunction sa2DmStopRetry() {\n  var dm = sa2Soiled().deathmark;\n  dm.lingerArmed = false;\n  if (dm.retryTimerId) { try { clearTimeout(dm.retryTimerId); } catch (e) {} dm.retryTimerId = null; }\n}\nfunction sa2DmStopArm() {\n  var dm = sa2Soiled().deathmark;\n  if (dm.armTimerId) { try { clearTimeout(dm.armTimerId); } catch (e) {} dm.armTimerId = null; }\n  sa2DmStopRetry();\n}\nfunction sa2DmSendDustqueue(force) {\n  if (!sa2ModuleOn('dustqueue')) return;\n  var dm = sa2Soiled().deathmark;\n  var want = (sa2DmMarkCount() >= 3) ? 'full' : 'short';\n  var cmd = want === 'full' ? DUSTQUEUE_FULL : DUSTQUEUE_SHORT;\n  if (!force && dm.dustqueueMode === want && dm.dustqueueLastCmd === cmd) return;\n  dm.dustqueueMode = want; dm.dustqueueLastCmd = cmd;\n  send_command(cmd, 0);\n}\nfunction sa2DmScheduleRetry() {\n  var dm = sa2Soiled().deathmark;\n  if (!dm.lingerArmed || !dm.markActive) return;\n  var delay = sa2Num('sa2_dm_retry_sec', 1.3) * 1000;\n  if (delay < 50) delay = 50;\n  if (dm.retryTimerId) { try { clearTimeout(dm.retryTimerId); } catch (e) {} }\n  dm.retryTimerId = setTimeout(function () {\n    sa2Soiled().deathmark.retryTimerId = null;\n    try { run_function('sa2_dm_retry', '', 'SoiledArmour2'); } catch (e2) {}\n  }, delay);\n}\n\nif (!sa2DmShouldRun()) { sa2DmStopRetry(); return; }\nvar dm = sa2Soiled().deathmark;\nif (!dm.markActive || !dm.lingerArmed) { sa2DmStopRetry(); return; }\n\nvar markCnt = sa2DmMarkCount();\nsa2DmSendDustqueue(false);\n\n// Beastfocus at mark>=3\nif (sa2ModuleOn('powerfocus') && markCnt >= 3 && sa2BeastBalReady() && sa2DustReady()) {\n  var bcmd = 'eat dust beastfocus deathmark';\n  send_command(bcmd, 0);\n  display_notice('[SoiledArmour2] *** BEASTFOCUS *** ' + bcmd, 'yellow');\n  sa2DmScheduleRetry();\n  return;\n}\n\n// Allheale sip at mark>=3\nif (markCnt >= 3 && sa2ModuleOn('allheale') && sa2AllhealeReady() && sa2SipReady()) {\n  send_command(sa2Get('sa2_dm_sip_cmd', 'sip allheale;;sip quicksilver'), 0);\n  display_notice('[SoiledArmour2] *** ALLHEALE *** (mark>=' + markCnt + ')', 'yellow');\n  sa2DmScheduleRetry();\n  return;\n}\n\n// Powerfocus at mark>=2\nif (markCnt >= parseInt(sa2Get('sa2_dm_powerfocus_min', '2'), 10) && sa2ModuleOn('powerfocus') && sa2DustReady()) {\n  var pcmd = 'eat dust powerfocus';\n  send_command(pcmd, 0);\n  display_notice('[SoiledArmour2] *** POWERFOCUS *** ' + pcmd, 'yellow');\n  sa2DmScheduleRetry();\n  return;\n}\n\n// Fallback allheale\nif (sa2ModuleOn('allheale') && sa2AllhealeReady() && sa2SipReady()) {\n  send_command(sa2Get('sa2_dm_sip_cmd', 'sip allheale;;sip quicksilver'), 0);\n  display_notice('[SoiledArmour2] *** ALLHEALE ***', 'yellow');\n}\nsa2DmScheduleRetry();\n\n"},{"type":"function","name":"sa2_dm_arm","enabled":true,"id":16,"code":"function sa2Get(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction sa2Set(k, v) { set_variable(k, String(v)); }\nfunction sa2Bool(k) {\n  var v = get_variable(k);\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  if (v === undefined || v === null || v === '') return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction sa2Def(k, v) {\n  if (get_variable(k) === undefined || get_variable(k) === null) set_variable(k, v);\n}\nfunction sa2Soiled() {\n  if (client.soiledarmour2 == undefined) client.soiledarmour2 = {};\n  return client.soiledarmour2;\n}\nfunction sa2MasterOn() {\n  return sa2Bool('sa2_master');\n}\nfunction sa2ModuleOn(id) {\n  if (!sa2MasterOn()) return false;\n  return sa2Bool('sa2_' + id);\n}\nfunction sa2Num(k, d) {\n  var n = parseFloat(sa2Get(k, String(d)));\n  return isNaN(n) ? d : n;\n}\nfunction sa2BalEqReady() {\n  var balReady = false, eqReady = false, hasAny = false;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && 