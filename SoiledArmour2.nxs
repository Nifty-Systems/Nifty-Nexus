{"type":"group","name":"SoiledArmour2","enabled":true,"id":1,"items":[{"type":"function","name":"onLoad","enabled":true,"id":2,"code":"run_function(\"onInstall\",\"\",\"SoiledArmour2\");\n\n"},{"type":"function","name":"onInstall","enabled":true,"id":3,"code":"function sa2Get(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction sa2Set(k, v) { set_variable(k, String(v)); }\nfunction sa2Bool(k) {\n  var v = get_variable(k);\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  if (v === undefined || v === null || v === '') return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction sa2Def(k, v) {\n  if (get_variable(k) === undefined || get_variable(k) === null) set_variable(k, v);\n}\nfunction sa2Soiled() {\n  if (client.soiledarmour2 == undefined) client.soiledarmour2 = {};\n  return client.soiledarmour2;\n}\nfunction sa2MasterOn() {\n  return sa2Bool('sa2_master');\n}\nfunction sa2ModuleOn(id) {\n  if (!sa2MasterOn()) return false;\n  return sa2Bool('sa2_' + id);\n}\nfunction sa2Num(k, d) {\n  var n = parseFloat(sa2Get(k, String(d)));\n  return isNaN(n) ? d : n;\n}\nfunction sa2BalEqReady() {\n  var balReady = false, eqReady = false, hasAny = false;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char) {\n      if (GMCP.Char.Balance && GMCP.Char.Balance.List) {\n        hasAny = true;\n        balReady = (GMCP.Char.Balance.List.balance === '1' || GMCP.Char.Balance.List.balance === 1);\n        eqReady = (GMCP.Char.Balance.List.equilibrium === '1' || GMCP.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && GMCP.Char.Vitals) {\n        hasAny = true;\n        balReady = (GMCP.Char.Vitals.balance === '1' || GMCP.Char.Vitals.balance === 1);\n        eqReady = (GMCP.Char.Vitals.equilibrium === '1' || GMCP.Char.Vitals.equilibrium === 1);\n      }\n    }\n    if (!hasAny && typeof gmcp !== 'undefined' && gmcp && gmcp.Char) {\n      if (gmcp.Char.Balance && gmcp.Char.Balance.List) {\n        hasAny = true;\n        balReady = (gmcp.Char.Balance.List.balance === '1' || gmcp.Char.Balance.List.balance === 1);\n        eqReady = (gmcp.Char.Balance.List.equilibrium === '1' || gmcp.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && gmcp.Char.Vitals) {\n        hasAny = true;\n        balReady = (gmcp.Char.Vitals.balance === '1' || gmcp.Char.Vitals.balance === 1);\n        eqReady = (gmcp.Char.Vitals.equilibrium === '1' || gmcp.Char.Vitals.equilibrium === 1);\n      }\n    }\n  } catch (e) {}\n  if (!hasAny) return true;\n  return balReady && eqReady;\n}\nfunction sa2SipReady() {\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Balance && gmcp.Char.Balance.List) {\n      var sip = gmcp.Char.Balance.List.sip;\n      return sip === '1' || sip === 1 || sip === true;\n    }\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Balance && GMCP.Char.Balance.List) {\n      var sip2 = GMCP.Char.Balance.List.sip;\n      return sip2 === '1' || sip2 === 1 || sip2 === true;\n    }\n  } catch (e) {}\n  return true;\n}\nfunction sa2AllhealeReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.allheale === 1 || v.allheale === '1');\n  } catch (e) { return false; }\n}\nfunction sa2DustReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.dust === 1 || v.dust === '1');\n  } catch (e) { return false; }\n}\nfunction sa2BeastBalReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.beastbal === 1 || v.beastbal === '1');\n  } catch (e) { return false; }\n}\nfunction sa2GetVitals() {\n  try {\n    var raw = sa2Get('sa2_last_vitals', '{}');\n    return JSON.parse(raw);\n  } catch (e) { return {}; }\n}\nfunction sa2CacheVitals(v) {\n  try { sa2Set('sa2_last_vitals', JSON.stringify(v)); } catch (e) {}\n}\nfunction sa2HealthPct() {\n  var v = sa2GetVitals();\n  var maxhp = parseInt(v.maxhp || v.maxhealth, 10);\n  var hp = parseInt(v.hp || v.currenthealth, 10);\n  if (maxhp > 0 && !isNaN(hp)) return hp / maxhp;\n  return 1;\n}\nfunction sa2HasDef(name) {\n  var sa = sa2Soiled();\n  if (!sa.defCache) return false;\n  var n = String(name).toLowerCase();\n  for (var k in sa.defCache) {\n    if (sa.defCache[k] && k.indexOf(n) >= 0) return true;\n  }\n  return false;\n}\nfunction sa2UpdateDefCache() {\n  var sa = sa2Soiled();\n  if (!sa.defCache) sa.defCache = {};\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences) {\n      var D = GMCP.Char.Defences;\n      if (D.List && D.List.length) {\n        for (var i = 0; i < D.List.length; i++) {\n          if (D.List[i] && D.List[i].name) sa.defCache[String(D.List[i].name).toLowerCase()] = true;\n        }\n      }\n      if (D.Add && D.Add.name) sa.defCache[String(D.Add.name).toLowerCase()] = true;\n      if (D.Remove) {\n        var rem = Array.isArray(D.Remove) ? D.Remove : [D.Remove];\n        for (var j = 0; j < rem.length; j++) {\n          if (rem[j] && rem[j].name) delete sa.defCache[String(rem[j].name).toLowerCase()];\n        }\n      }\n    }\n  } catch (e) {}\n}\nfunction sa2AffCount() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Afflictions && GMCP.Char.Afflictions.List) {\n      return GMCP.Char.Afflictions.List.length;\n    }\n  } catch (e) {}\n  return 0;\n}\n\n// Version\nsa2Def('sSoiledArmour2Version', '2.0.0');\n\n// Master + all modules default ON\nsa2Def('sa2_master', '1');\nsa2Def('sa2_transmute', '1');\nsa2Def('sa2_trueheal', '1');\nsa2Def('sa2_powerfocus', '1');\nsa2Def('sa2_allheale', '1');\nsa2Def('sa2_dustqueue', '1');\nsa2Def('sa2_sanctity', '1');\nsa2Def('sa2_shield', '1');\nsa2Def('sa2_quicksilver', '1');\nsa2Def('sa2_truetime', '1');\nsa2Def('sa2_tea', '1');\n\n// Shield default mode\nsa2Def('sa2_shield_mode', 'crisis');\n\n// Tea default\nsa2Def('sa2_tea_kind', 'green');\n\n// Transmute settings\nsa2Def('sa2_transmute_cooldown', '0.7');\nsa2Def('sa2_check_interval_ms', '500');\nsa2Def('sa2_threshold_transmute', '0.8');\nsa2Def('sa2_threshold_allheale', '0.7');\nsa2Def('sa2_threshold_trueheal', '0.35');\nsa2Def('sa2_max_burst_casts', '4');\nsa2Def('sa2_max_total_casts', '12');\nsa2Def('sa2_current_date', '');\nsa2Def('sa2_refresh_last_used', '');\n\n// Deathmark settings\nsa2Def('sa2_dm_mark_sec', '4.5');\nsa2Def('sa2_dm_retry_sec', '1.3');\nsa2Def('sa2_dm_sip_cmd', 'sip allheale;;sip quicksilver');\nsa2Def('sa2_dm_powerfocus_min', '2');\n\n// Sanctity settings\nsa2Def('sa2_sanctity_hp_threshold', '0.75');\n\n// State bags\nvar sa = sa2Soiled();\nsa.deathmark = sa.deathmark || { markActive: false, markCount: 0, lingerArmed: false, shieldYieldBelowSince: null, dustqueueMode: '', dustqueueLastCmd: '', armTimerId: null, retryTimerId: null };\nsa.shield = sa.shield || { active: false, pendingPowerAt: 0, lastPowerBeforeSend: null };\nsa.transmute = sa.transmute || { chainActive: false, transmuting: false, burstCasts: 0, totalCasts: 0, pendingSecondaryPct: null };\nsa.quicksilver = sa.quicksilver || { defenceActive: false, pendingSip: false, lastSipAt: 0 };\nsa.truetime = sa.truetime || { defenceActive: false, pendingWind: false };\nsa.sanctity = sa.sanctity || { defenceActive: false };\nsa.tea = sa.tea || { timerId: null };\nsa.defCache = sa.defCache || {};\n\n// Clear old timers\n(function () {\n  var ids = ['sa2_transmute_interval_id', 'sa2_shield_interval_id', 'sa2_tea_timer_id'];\n  for (var i = 0; i < ids.length; i++) {\n    var old = get_variable(ids[i]);\n    if (old) { try { clearInterval(parseInt(old, 10)); } catch (e) {} try { clearTimeout(parseInt(old, 10)); } catch (e2) {} sa2Set(ids[i], ''); }\n  }\n})();\n\n// Start modules if master ON\nif (sa2MasterOn()) {\n  // Transmute interval\n  if (sa2ModuleOn('transmute')) {\n    var ms = parseInt(sa2Get('sa2_check_interval_ms', '500'), 10);\n    if (isNaN(ms) || ms < 100) ms = 500;\n    var tid = setInterval(function () {\n      try { run_function('sa2_transmute_tick', '', 'SoiledArmour2'); } catch (e) {}\n    }, ms);\n    sa2Set('sa2_transmute_interval_id', String(tid));\n  }\n  \n  // Shield interval\n  if (sa2ModuleOn('shield') && sa2Get('sa2_shield_mode', 'crisis') !== 'off') {\n    try { run_function('sa2_shield_start', '', 'SoiledArmour2'); } catch (e) {}\n  }\n  \n  // Tea timer\n  if (sa2ModuleOn('tea')) {\n    try { run_function('sa2_tea_schedule', '', 'SoiledArmour2'); } catch (e) {}\n  }\n}\n\n// Request date if missing\n(function () {\n  var cur = sa2Get('sa2_current_date', '');\n  if (!cur) {\n    display_notice('[SoiledArmour2] No date on file \u2014 requesting current date...', 'yellow');\n    send_command('date', 0);\n  }\n})();\n\ndisplay_notice('[SoiledArmour2] Loaded v2.0.0 \u2014 sld menu for all toggles.', 'lime');\n\n"},{"type":"function","name":"onGMCP","enabled":true,"id":4,"code":"\nif (!args || !args.gmcp_method) return;\nvar method = String(args.gmcp_method);\n\nif (method === 'Char.Vitals' && args.gmcp_args) {\n  try { set_variable('sa2_last_vitals', JSON.stringify(args.gmcp_args)); } catch (e) {}\n  try { run_function('sa2_on_vitals', '', 'SoiledArmour2'); } catch (e2) {}\n}\n\nif (method === 'Char.Balance') {\n  try { run_function('sa2_on_balance', '', 'SoiledArmour2'); } catch (e) {}\n}\n\nif (method.indexOf('Char.Defences') === 0) {\n  try { run_function('sa2_update_def_cache', '', 'SoiledArmour2'); } catch (e) {}\n}\n\nif (method === 'Room.Info') {\n  try { run_function('sa2_on_room_entry', '', 'SoiledArmour2'); } catch (e) {}\n}\n\nif (method === 'Char.Afflictions') {\n  try { run_function('sa2_on_afflictions', '', 'SoiledArmour2'); } catch (e) {}\n}\n\n"},{"type":"function","name":"sa2_on_vitals","enabled":true,"id":5,"code":"function sa2Get(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction sa2Set(k, v) { set_variable(k, String(v)); }\nfunction sa2Bool(k) {\n  var v = get_variable(k);\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  if (v === undefined || v === null || v === '') return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction sa2Def(k, v) {\n  if (get_variable(k) === undefined || get_variable(k) === null) set_variable(k, v);\n}\nfunction sa2Soiled() {\n  if (client.soiledarmour2 == undefined) client.soiledarmour2 = {};\n  return client.soiledarmour2;\n}\nfunction sa2MasterOn() {\n  return sa2Bool('sa2_master');\n}\nfunction sa2ModuleOn(id) {\n  if (!sa2MasterOn()) return false;\n  return sa2Bool('sa2_' + id);\n}\nfunction sa2Num(k, d) {\n  var n = parseFloat(sa2Get(k, String(d)));\n  return isNaN(n) ? d : n;\n}\nfunction sa2BalEqReady() {\n  var balReady = false, eqReady = false, hasAny = false;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char) {\n      if (GMCP.Char.Balance && GMCP.Char.Balance.List) {\n        hasAny = true;\n        balReady = (GMCP.Char.Balance.List.balance === '1' || GMCP.Char.Balance.List.balance === 1);\n        eqReady = (GMCP.Char.Balance.List.equilibrium === '1' || GMCP.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && GMCP.Char.Vitals) {\n        hasAny = true;\n        balReady = (GMCP.Char.Vitals.balance === '1' || GMCP.Char.Vitals.balance === 1);\n        eqReady = (GMCP.Char.Vitals.equilibrium === '1' || GMCP.Char.Vitals.equilibrium === 1);\n      }\n    }\n    if (!hasAny && typeof gmcp !== 'undefined' && gmcp && gmcp.Char) {\n      if (gmcp.Char.Balance && gmcp.Char.Balance.List) {\n        hasAny = true;\n        balReady = (gmcp.Char.Balance.List.balance === '1' || gmcp.Char.Balance.List.balance === 1);\n        eqReady = (gmcp.Char.Balance.List.equilibrium === '1' || gmcp.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && gmcp.Char.Vitals) {\n        hasAny = true;\n        balReady = (gmcp.Char.Vitals.balance === '1' || gmcp.Char.Vitals.balance === 1);\n        eqReady = (gmcp.Char.Vitals.equilibrium === '1' || gmcp.Char.Vitals.equilibrium === 1);\n      }\n    }\n  } catch (e) {}\n  if (!hasAny) return true;\n  return balReady && eqReady;\n}\nfunction sa2SipReady() {\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Balance && gmcp.Char.Balance.List) {\n      var sip = gmcp.Char.Balance.List.sip;\n      return sip === '1' || sip === 1 || sip === true;\n    }\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Balance && GMCP.Char.Balance.List) {\n      var sip2 = GMCP.Char.Balance.List.sip;\n      return sip2 === '1' || sip2 === 1 || sip2 === true;\n    }\n  } catch (e) {}\n  return true;\n}\nfunction sa2AllhealeReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.allheale === 1 || v.allheale === '1');\n  } catch (e) { return false; }\n}\nfunction sa2DustReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.dust === 1 || v.dust === '1');\n  } catch (e) { return false; }\n}\nfunction sa2BeastBalReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.beastbal === 1 || v.beastbal === '1');\n  } catch (e) { return false; }\n}\nfunction sa2GetVitals() {\n  try {\n    var raw = sa2Get('sa2_last_vitals', '{}');\n    return JSON.parse(raw);\n  } catch (e) { return {}; }\n}\nfunction sa2CacheVitals(v) {\n  try { sa2Set('sa2_last_vitals', JSON.stringify(v)); } catch (e) {}\n}\nfunction sa2HealthPct() {\n  var v = sa2GetVitals();\n  var maxhp = parseInt(v.maxhp || v.maxhealth, 10);\n  var hp = parseInt(v.hp || v.currenthealth, 10);\n  if (maxhp > 0 && !isNaN(hp)) return hp / maxhp;\n  return 1;\n}\nfunction sa2HasDef(name) {\n  var sa = sa2Soiled();\n  if (!sa.defCache) return false;\n  var n = String(name).toLowerCase();\n  for (var k in sa.defCache) {\n    if (sa.defCache[k] && k.indexOf(n) >= 0) return true;\n  }\n  return false;\n}\nfunction sa2UpdateDefCache() {\n  var sa = sa2Soiled();\n  if (!sa.defCache) sa.defCache = {};\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences) {\n      var D = GMCP.Char.Defences;\n      if (D.List && D.List.length) {\n        for (var i = 0; i < D.List.length; i++) {\n          if (D.List[i] && D.List[i].name) sa.defCache[String(D.List[i].name).toLowerCase()] = true;\n        }\n      }\n      if (D.Add && D.Add.name) sa.defCache[String(D.Add.name).toLowerCase()] = true;\n      if (D.Remove) {\n        var rem = Array.isArray(D.Remove) ? D.Remove : [D.Remove];\n        for (var j = 0; j < rem.length; j++) {\n          if (rem[j] && rem[j].name) delete sa.defCache[String(rem[j].name).toLowerCase()];\n        }\n      }\n    }\n  } catch (e) {}\n}\nfunction sa2AffCount() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Afflictions && GMCP.Char.Afflictions.List) {\n      return GMCP.Char.Afflictions.List.length;\n    }\n  } catch (e) {}\n  return 0;\n}\nif (!sa2MasterOn()) return;\ntry { run_function('sa2_shield_on_vitals', '', 'SoiledArmour2'); } catch (e) {}\ntry { run_function('sa2_quicksilver_try_sip', '', 'SoiledArmour2'); } catch (e2) {}\ntry { run_function('sa2_truetime_try_wind', '', 'SoiledArmour2'); } catch (e3) {}\ntry { run_function('sa2_sanctity_on_vitals', '', 'SoiledArmour2'); } catch (e4) {}\n\n"},{"type":"function","name":"sa2_on_balance","enabled":true,"id":6,"code":"function sa2Get(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction sa2Set(k, v) { set_variable(k, String(v)); }\nfunction sa2Bool(k) {\n  var v = get_variable(k);\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  if (v === undefined || v === null || v === '') return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction sa2Def(k, v) {\n  if (get_variable(k) === undefined || ge