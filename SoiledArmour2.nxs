on (id) {\n    if (!id) return;\n    try {\n      var reflex = sa2ChFindReflexById('CrystalHunt', id);\n      if (reflex) reflex_enable(reflex);\n    } catch (e) {}\n  });\n  sa2Set('sa2_ch_disabled_reflex_ids', '');\n}\nfunction sa2ChDisableBeastActions() {\n  if (!sa2ChPresent()) return;\n  if (sa2Get('sa2_ch_disabled_beast_reflex_ids', '')) return;\n  var ids = [];\n  try {\n    var fn = reflex_find_by_name('function', 'grimkeep_beastActions', false, false, 'CrystalHunt');\n    if (fn) {\n      reflex_disable(fn);\n      if (fn.id != null) ids.push(String(fn.id));\n    }\n  } catch (e1) {}\n  sa2ChWalkPackage('CrystalHunt', function (reflex) {\n    if (!reflex || reflex.type !== 'trigger') return;\n    var script = sa2ChReflexScript(reflex);\n    if (!script || script.indexOf('grimkeep_beastActions') < 0) return;\n    if (reflex.id != null && ids.indexOf(String(reflex.id)) >= 0) return;\n    try {\n      if (reflex.enabled !== false) {\n        reflex_disable(reflex);\n        if (reflex.id != null) ids.push(String(reflex.id));\n      }\n    } catch (e2) {}\n  });\n  if (ids.length) sa2Set('sa2_ch_disabled_beast_reflex_ids', ids.join(','));\n}\nfunction sa2ChRestoreBeastActions() {\n  var ids = sa2Get('sa2_ch_disabled_beast_reflex_ids', '');\n  if (!ids) return;\n  ids.split(',').forEach(function (id) {\n    if (!id) return;\n    try {\n      var reflex = sa2ChFindReflexById('CrystalHunt', id);\n      if (reflex) reflex_enable(reflex);\n    } catch (e) {}\n  });\n  sa2Set('sa2_ch_disabled_beast_reflex_ids', '');\n}\nfunction sa2_grimkeep_beast_actions() {\n  if (!sa2LeanBeastOn()) return;\n  if (!sa2InGrimkeep() || !sa2ChPresent()) return;\n  if (!sa2BeastBalReady()) return;\n  var sa = sa2Soiled();\n  sa.beast = sa.beast || {};\n  var now = Date.now() / 1000;\n  if ((now - (sa.beast.balHandledAt || 0)) < 0.5) {\n    return;\n  }\n  var gk;\n  try {\n    gk = client.crystal.hunt.grimkeep;\n    if (!gk || gk.divineFired) return;\n  } catch (e) { return; }\n  var hp = sa2HealthPct();\n  var pCHBeastHeal = get_variable('pCHBeastHeal');\n  if (pCHBeastHeal != 0 && hp < 0.85) {\n    if (sa2ModuleOn('sanctity')) return;\n    var healCmd = (pCHBeastHeal == 'life') ? 'beast order heal life' : 'beast order heal health';\n    send_command(healCmd, 0);\n    sa.beast.balHandledAt = now;\n    sa2BeastMarkSpent();\n    return;\n  }\n  sa2BreathApply(false);\n  var beastCmd = String(get_variable('sCHCommandBeast') || '');\n  if (!beastCmd || !gk.active) return;\n  var beastAttack = client.crystal.hunt.beastAttackForTarget(gk.target)\n    .replace('$', gk.target).replace('@', gk.target).replace('#', '');\n  if (sa2ChAreaAttackWouldFire()) {\n    if (gk.callsVerb && gk.callsArea === 'off') send_command(gk.callsVerb + ' beast areaattack on', 0);\n    gk.callsArea = 'on';\n    send_command('sm insert 1 free wondersaddle activate areaattack on | ' + beastAttack + ' | wondersaddle activate areaattack off', 0);\n    if (!gk.smnow) send_command('sm now', 0);\n  } else {\n    if (gk.callsVerb && gk.callsArea === 'on') send_command(gk.callsVerb + ' beast areaattack off', 0);\n    gk.callsArea = 'off';\n    send_command('sm insert 1 free ' + beastAttack, 0);\n    if (!gk.smnow) send_command('sm now', 0);\n  }\n  sa.beast.pending = false;\n  if (!gk.smnow) {\n    try {\n      gk.smnow = true;\n      setTimeout(function () { try { client.crystal.hunt.grimkeep.smnow = false; } catch (eSm) {} }, 1000);\n    } catch (eLock) {}\n  }\n  sa.beast.balHandledAt = now;\n  sa2BeastMarkSpent();\n}\nfunction sa2ChArm() {\n  if (!sa2ChPresent() || sa2Bool('sa2_ch_armed')) return;\n  sa2Set('sa2_ch_saved_iCHTransmute', sa2Get('iCHTransmute', ''));\n  sa2Set('sa2_ch_saved_pCHBeastHeal', sa2Get('pCHBeastHeal', '0'));\n  send_command('ch transmute 0 0 0', 0);\n  sa2SyncBeastHealOwner();\n  sa2ChDisableAllhealeTriggers();\n  if (sa2Bool('sa2_lean_beast')) sa2ChDisableBeastActions();\n  sa2Set('sa2_ch_armed', '1');\n}\nfunction sa2ChDisarm() {\n  if (!sa2Bool('sa2_ch_armed')) return;\n  var bh = sa2Get('sa2_ch_saved_pCHBeastHeal', '0');\n  if (bh === 'life') send_command('ch beastheal life', 0);\n  else if (bh === '1' || bh === 1) send_command('ch beastheal on', 0);\n  else send_command('ch beastheal off', 0);\n  var tx = sa2Get('sa2_ch_saved_iCHTransmute', '');\n  if (tx) {\n    var parts = String(tx).trim().split(/\\s+/);\n    if (parts.length >= 3) send_command('ch transmute ' + parts[0] + ' ' + parts[1] + ' ' + parts[2], 0);\n  }\n  sa2ChRestoreAllhealeTriggers();\n  sa2ChRestoreBeastActions();\n  sa2Set('sa2_ch_armed', '0');\n}\nfunction sa2DmReconcileFromGmcp() {\n  if (sa2ChMarkSource()) return;\n  try {\n    var hasMark = false;\n    var list = null;\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Afflictions && GMCP.Char.Afflictions.List) {\n      list = GMCP.Char.Afflictions.List;\n    } else if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Afflictions && gmcp.Char.Afflictions.List) {\n      list = gmcp.Char.Afflictions.List;\n    }\n    if (list) {\n      for (var i = 0; i < list.length; i++) {\n        var item = list[i];\n        var n = item && (item.name || item);\n        if (n && String(n).toLowerCase().indexOf('deathmark') >= 0) { hasMark = true; break; }\n      }\n    }\n    if (!hasMark) {\n      var dm = sa2Soiled().deathmark;\n      dm.markCount = 0;\n      dm.markActive = false;\n    }\n  } catch (e) {}\n}\nfunction sa2DmLingerArmed() {\n  var dm = sa2Soiled().deathmark;\n  return dm && dm.lingerArmed && (sa2DmMarkActive() || dm.markActive);\n}\nfunction sa2DmMarkCount() {\n  if (sa2ChPresent() && client.crystal.hunt.grimkeep) {\n    var ch = client.crystal.hunt.grimkeep.deathMarks;\n    if (ch != null && !isNaN(ch)) return parseInt(ch, 10);\n  }\n  return (sa2Soiled().deathmark && sa2Soiled().deathmark.markCount) || 0;\n}\nfunction sa2DmMarkActive() {\n  if (sa2ChPresent() && sa2InGrimkeep() && client.crystal.hunt.grimkeep) {\n    return sa2DmMarkCount() > 0;\n  }\n  var dm = sa2Soiled().deathmark;\n  return !!(dm && dm.markActive);\n}\n\nsa2TeaTrySip();\n"},{"type":"function","name":"sa2_tea_flat","enabled":true,"id":61,"code":"function sa2Get(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction sa2Set(k, v) { set_variable(k, String(v)); }\nfunction sa2Bool(k) {\n  var v = get_variable(k);\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  if (v === undefined || v === null || v === '') return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction sa2Def(k, v) {\n  if (get_variable(k) === undefined || get_variable(k) === null) set_variable(k, v);\n}\nfunction sa2Soiled() {\n  if (client.soiledarmour2 == undefined) client.soiledarmour2 = {};\n  return client.soiledarmour2;\n}\nfunction sa2MasterOn() {\n  return sa2Bool('sa2_master');\n}\nfunction sa2ModuleOn(id) {\n  if (!sa2MasterOn()) return false;\n  return sa2Bool('sa2_' + id);\n}\nfunction sa2Num(k, d) {\n  var n = parseFloat(sa2Get(k, String(d)));\n  return isNaN(n) ? d : n;\n}\nfunction sa2BalEqReady() {\n  var balReady = false, eqReady = false, hasAny = false;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char) {\n      if (GMCP.Char.Balance && GMCP.Char.Balance.List) {\n        hasAny = true;\n        balReady = (GMCP.Char.Balance.List.balance === '1' || GMCP.Char.Balance.List.balance === 1);\n        eqReady = (GMCP.Char.Balance.List.equilibrium === '1' || GMCP.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && GMCP.Char.Vitals) {\n        hasAny = true;\n        balReady = (GMCP.Char.Vitals.balance === '1' || GMCP.Char.Vitals.balance === 1);\n        eqReady = (GMCP.Char.Vitals.equilibrium === '1' || GMCP.Char.Vitals.equilibrium === 1);\n      }\n    }\n    if (!hasAny && typeof gmcp !== 'undefined' && gmcp && gmcp.Char) {\n      if (gmcp.Char.Balance && gmcp.Char.Balance.List) {\n        hasAny = true;\n        balReady = (gmcp.Char.Balance.List.balance === '1' || gmcp.Char.Balance.List.balance === 1);\n        eqReady = (gmcp.Char.Balance.List.equilibrium === '1' || gmcp.Char.Balance.List.equilibrium === 1);\n      }\n      if (!hasAny && gmcp.Char.Vitals) {\n        hasAny = true;\n        balReady = (gmcp.Char.Vitals.balance === '1' || gmcp.Char.Vitals.balance === 1);\n        eqReady = (gmcp.Char.Vitals.equilibrium === '1' || gmcp.Char.Vitals.equilibrium === 1);\n      }\n    }\n  } catch (e) {}\n  if (!hasAny) return true;\n  return balReady && eqReady;\n}\nfunction sa2SipReady() {\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Balance && gmcp.Char.Balance.List) {\n      var sip = gmcp.Char.Balance.List.sip;\n      return sip === '1' || sip === 1 || sip === true;\n    }\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Balance && GMCP.Char.Balance.List) {\n      var sip2 = GMCP.Char.Balance.List.sip;\n      return sip2 === '1' || sip2 === 1 || sip2 === true;\n    }\n  } catch (e) {}\n  return true;\n}\nfunction sa2AllhealeReady() {\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Vitals) {\n      var ahl = parseInt(gmcp.Char.Vitals.allheale, 10);\n      if (!isNaN(ahl)) return ahl === 1;\n    }\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Vitals) {\n      var ahl2 = parseInt(GMCP.Char.Vitals.allheale, 10);\n      if (!isNaN(ahl2)) return ahl2 === 1;\n    }\n    var cached = sa2GetVitals();\n    var raw = parseInt(cached.allheale, 10);\n    return raw === 1;\n  } catch (e) { return false; }\n}\nfunction sa2DustReady() {\n  try {\n    var v = sa2GetVitals();\n    return v && (v.dust === 1 || v.dust === '1');\n  } catch (e) { return false; }\n}\nfunction sa2BeastBalSnapshot() {\n  var snap = { gmcp: '', my: '', cache: '', ready: false };\n  try { snap.gmcp = (GMCP && GMCP.Vitals) ? String(GMCP.Vitals.beastbal) : 'nogmcp'; } catch (e1) { snap.gmcp = 'err'; }\n  try { snap.my = String(get_variable('my_beastbal')); } catch (e2) { snap.my = 'err'; }\n  try {\n    var v = sa2GetVitals();\n    snap.cache = v ? String(v.beastbal) : '';\n  } catch (e3) { snap.cache = 'err'; }\n  snap.ready = (snap.gmcp === '1' || snap.my === '1' || snap.cache === '1');\n  return snap;\n}\nfunction sa2BeastMarkSpent() {\n  var sa = sa2Soiled();\n  sa.beast = sa.beast || {};\n  sa.beast.spent = true;\n  sa.beast.spentAt = Date.now() / 1000;\n  try { if (typeof GMCP !== 'undefined' && GMCP && GMCP.Vitals) GMCP.Vitals.beastbal = '0'; } catch (e1) {}\n  try { set_variable('my_beastbal', '0'); } catch (e2) {}\n  try {\n    var v = sa2GetVitals();\n    v.beastbal = '0';\n    sa2CacheVitals(v);\n  } catch (e3) {}\n}\nfunction sa2BeastClearSpent() {\n  var sa = sa2Soiled();\n  sa.beast = sa.beast || {};\n  sa.beast.spent = false;\n  try { set_variable('my_beastbal', '1'); } catch (e1) {}\n  try {\n    var v = sa2GetVitals();\n    v.beastbal = '1';\n    sa2CacheVitals(v);\n  } catch (e2) {}\n}\nfunction sa2BeastBalReady() {\n  var sa = sa2Soiled();\n  sa.beast = sa.beast || {};\n  if (sa.beast.spent) {\n    var now = Date.now() / 1000;\n    if ((now - (sa.beast.spentAt || 0)) > 20) sa.beast.spent = false;\n    else return false;\n  }\n  return sa2BeastBalSnapshot().ready;\n}\nfunction sa2GetVitals() {\n  try {\n    var raw = sa2Get('sa2_last_vitals', '{}');\n    return JSON.parse(raw);\n  } catch (e) { return {}; }\n}\nfunction sa2CacheVitals(v) {\n  try { sa2Set('sa2_last_vitals', JSON.stringify(v)); } catch (e) {}\n}\nfunction sa2HealthPct() {\n  var v = sa2GetVitals();\n  var maxhp = parseInt(v.maxhp || v.maxhealth, 10);\n  var hp = parseInt(v.hp || v.currenthealth, 10);\n  if (maxhp > 0 && !isNaN(hp)) return hp / maxhp;\n  return 1;\n}\nfunction sa2HasDef(name) {\n  var sa = sa2Soiled();\n  if (!sa.defCache) return false;\n  var n = String(name).toLowerCase();\n  for (var k in sa.defCache) {\n    if (sa.defCache[k] && k.indexOf(n) >= 0) return true;\n  }\n  return false;\n}\nfunction sa2DefNameFromGmcp(entry) {\n  if (entry === undefined || entry === null) return '';\n  if (typeof entry === 'string') return entry.toLowerCase();\n  if (entry.name) return String(entry.name).toLowerCase();\n  return '';\n}\nfunction sa2IsQsDefName(name) {\n  var n = String(name || '').toLowerCase();\n  return n.indexOf('quicksilver') >= 0 || n.indexOf('timestream') >= 0;\n}\nfunction sa2QuicksilverOnDrop(source) {\n  var qs = sa2Soiled().quicksilver;\n  if (!sa2MasterOn() || !sa2ModuleOn('quicksilver')) return;\n  if (!qs.defenceActive && !qs.gmcpActive) return;\n  qs.defenceActive = false;\n  qs.gmcpActive = false;\n  try { run_function('sa2_quicksilver_try_sip', '', 'SoiledArmour2'); } catch (e) {}\n}\nfunction sa2UpdateDefCache() {\n  var sa = sa2Soiled();\n  if (!sa.defCache) sa.defCache = {};\n  var qsRemoved = false;\n  var listRebuild = false;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences) {\n      var D = GMCP.Char.Defences;\n      if (D.List && D.List.length) {\n        sa.defCache = {};\n        listRebuild = true;\n        for (var i = 0; i < D.List.length; i++) {\n          var dn = sa2DefNameFromGmcp(D.List[i]);\n          if (dn) sa.defCache[dn] = true;\n        }\n      }\n      if (D.Add) {\n        var adds = Array.isArray(D.Add) ? D.Add : [D.Add];\n        for (var a = 0; a < adds.length; a++) {\n          var an = sa2DefNameFromGmcp(adds[a]);\n          if (an) sa.defCache[an] = true;\n        }\n      }\n      if (D.Remove) {\n        var rem = Array.isArray(D.Remove) ? D.Remove : [D.Remove];\n        for (var j = 0; j < rem.length; j++) {\n          var name = sa2DefNameFromGmcp(rem[j]);\n          if (!name) continue;\n          if (sa2IsQsDefName(name)) qsRemoved = true;\n          delete sa.defCache[name];\n        }\n      }\n    }\n  } catch (e) {}\n  if (qsRemoved) {\n    sa2QuicksilverOnDrop('gmcp.Remove');\n  } else if (listRebuild) {\n    var qs = sa2Soiled().quicksilver;\n    if (qs.gmcpActive && !sa2HasDef('quicksilver') && !sa2HasDef('timestream')) {\n      sa2QuicksilverOnDrop('gmcp.List');\n    }\n  }\n}\nfunction sa2SyncDefenceModules() {\n  var qs = sa2Soiled().quicksilver;\n  if (qs.gmcpActive !== true) qs.gmcpActive = false;\n  var qsUp = sa2HasDef('quicksilver') || sa2HasDef('timestream');\n  if (qsUp) {\n    qs.defenceActive = true;\n    qs.gmcpActive = true;\n    qs.pendingSip = false;\n  }\n  var tt = sa2Soiled().truetime;\n  var hadTt = tt.defenceActive === true;\n  var ttUp = sa2HasDef('truetime');\n  if (ttUp) {\n    tt.defenceActive = true;\n    tt.pendingWind = false;\n  } else if (hadTt && sa2ModuleOn('truetime')) {\n    tt.defenceActive = false;\n    tt.pendingWind = true;\n    try { run_function('sa2_truetime_try_wind', '', 'SoiledArmour2'); } catch (e2) {}\n  } else if (sa2ModuleOn('truetime')) {\n    tt.defenceActive = false;\n  } else {\n    tt.defenceActive = ttUp;\n    tt.pendingWind = false;\n  }\n  var tea = sa2Soiled().tea;\n  if (!tea) { sa2Soiled().tea = { greenDefActive: false, lastSipAt: 0 }; tea = sa2Soiled().tea; }\n  var hadTea = tea.greenDefActive === true;\n  var teaUp = sa2HasDef('greentea');\n  if (teaUp) {\n    tea.greenDefActive = true;\n  } else if (hadTea && sa2ModuleOn('tea')) {\n    tea.greenDefActive = false;\n  }\n}\nfunction sa2GreenTeaDefUp() {\n  var tea = sa2Soiled().tea;\n  if (tea && tea.greenDefActive === true) return true;\n  return sa2HasDef('greentea');\n}\nfunction sa2TeaMarkGreenUp() {\n  var sa = sa2Soiled();\n  sa.tea = sa.tea || { greenDefActive: false, lastSipAt: 0 };\n  sa.tea.greenDefActive = true;\n}\nfunction sa2TeaMarkGreenDown() {\n  var sa = sa2Soiled();\n  sa.tea = sa.tea || { greenDefActive: false, lastSipAt: 0 };\n  sa.tea.greenDefActive = false;\n}\nfunction sa2TeaTrySip() {\n  if (!sa2ModuleOn('tea')) return;\n  if (sa2GreenTeaDefUp()) return;\n  var tea = sa2Soiled().tea;\n  if (!tea) return;\n  var now = Date.now() / 1000;\n  if ((now - (tea.lastSipAt || 0)) < 2) return;\n  tea.lastSipAt = now;\n  send_command('sip greentea', 0);\n}\nfunction sa2AffCount() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Afflictions && GMCP.Char.Afflictions.List) {\n      return GMCP.Char.Afflictions.List.length;\n    }\n  } catch (e) {}\n  return 0;\n}\nfunction sa2GetItemsList() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Items && GMCP.Char.Items.List) {\n      return GMCP.Char.Items.List;\n    }\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Items && gmcp.Char.Items.List) {\n      return gmcp.Char.Items.List;\n    }\n  } catch (e) {}\n  return [];\n}\nfunction sa2IsGrimkeepMobName(name) {\n  var n = String(name || '').toLowerCase();\n  return n.indexOf('artificer') >= 0 || n.indexOf('sentinel') >= 0 || n.indexOf('koirakko') >= 0\n    || n.indexOf('excoropox') >= 0 || n.indexOf('battlecharger') >= 0;\n}\nfunction sa2IsRoomItem(entry) {\n  if (!entry || !entry.name) return false;\n  if (entry.location) return String(entry.location).toLowerCase() === 'room';\n  if (entry.attrib) {\n    var a = String(entry.attrib).toLowerCase();\n    if (a === 'p' || a.indexOf('player') >= 0) return false;\n    return a === 'm' || a.indexOf('mon') >= 0 || a === 'dx' || a === 'di';\n  }\n  return true;\n}\nfunction sa2ChPresent() {\n  try {\n    return !!(typeof client !== 'undefined' && client && client.crystal && client.crystal.hunt);\n  } catch (e) { return false; }\n}\nfunction sa2InGrimkeep() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Location && GMCP.Location.area) {\n      return GMCP.Location.area === 'the Ruined City of Grimkeep';\n    }\n  } catch (e) {}\n  return false;\n}\nfunction sa2QlStop() {\n  var old = get_variable('sa2_ql_interval_id');\n  if (old) { try { clearInterval(parseInt(old, 10)); } catch (e) {} sa2Set('sa2_ql_interval_id', ''); }\n}\nfunction sa2QlEnsure() {\n  if (!sa2MasterOn() || !sa2InGrimkeep()) {\n    sa2QlStop();\n    return;\n  }\n  var old = get_variable('sa2_ql_interval_id');\n  if (old) return;\n  var id = setInterval(function () {\n    try {\n      if (!sa2MasterOn() || !sa2InGrimkeep()) { sa2QlStop(); return; }\n      send_command('ql', 0);\n    } catch (e2) {}\n  }, 600000);\n  sa2Set('sa2_ql_interval_id', String(id));\n}\nfunction sa2ChMarkSource() {\n  return sa2Bool('sa2_ch_armed') && sa2InGrimkeep() && sa2ChPresent();\n}\nfunction sa2ChGrimkeepItemIsMob(item) {\n  if (!item || !item.attrib) return false;\n  var a = String(item.attrib);\n  if (a.indexOf('m') < 0) return false;\n  if (a.indexOf('d') >= 0 || a.indexOf('x') >= 0) return false;\n  if (item.icon === 'pet' || item.icon === 'guard' || item.icon === 'beast') return false;\n  if (item.name && String(item.name).indexOf('the corpse of') === 0) return false;\n  return true;\n}\nfunction sa2ChGrimkeepItemIsGkMob(item) {\n  if (!sa2ChGrimkeepItemIsMob(item)) return false;\n  return sa2IsGrimkeepMobName(item.name);\n}\nfunction sa2ComputeRoomMobCountFromGmcpRoom() {\n  try {\n    if (typeof GMCP === 'undefined' || !GMCP || !GMCP.Items || !GMCP.Items.room) return null;\n    var count = 0;\n    for (var i = 0; i < GMCP.Items.room.length; i++) {\n      if (sa2ChGrimkeepItemIsGkMob(GMCP.Items.room[i])) count++;\n    }\n    return count;\n  } catch (e) { return null; }\n}\nfunction sa2ComputeRoomMobCount() {\n  var chCount = sa2ComputeRoomMobCountFromGmcpRoom();\n  if (chCount != null) return chCount;\n  var list = sa2GetItemsList();\n  var gkCount = 0;\n  for (var i = 0; i < list.length; i++) {\n    var entry = list[i];\n    if (!sa2IsRoomItem(entry)) continue;\n    if (sa2IsGrimkeepMobName(entry.name)) gkCount++;\n  }\n  return gkCount;\n}\nfunction sa2UpdateRoomMobsCache() {\n  var sa = sa2Soiled();\n  sa.roomMobs = sa2ComputeRoomMobCount();\n  return sa.roomMobs;\n}\nfunction sa2RoomMobCount() {\n  var sa = sa2Soiled();\n  if (sa.roomMobs != null && !isNaN(sa.roomMobs)) return sa.roomMobs;\n  return sa2UpdateRoomMobsCache();\n}\nfunction sa2CountArtificersInRoom() {\n  var n = 0;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Items && GMCP.Items.room) {\n      for (var i = 0; i < GMCP.Items.room.length; i++) {\n        var item = GMCP.Items.room[i];\n        if (sa2ChGrimkeepItemIsGkMob(item) && item.name && String(item.name).toLowerCase().indexOf('artificer') >= 0) n++;\n      }\n      return n;\n    }\n  } catch (e) {}\n  var list = sa2GetItemsList();\n  for (var j = 0; j < list.length; j++) {\n    var entry = list[j];\n    if (entry && entry.name && String(entry.name).toLowerCase().indexOf('artificer') >= 0) n++;\n  }\n  return n;\n}\nfunction sa2RefreshPanel() {\n  try { run_function('sa2_update_custom_tab', '', 'SoiledArmour2'); } catch (e) {}\n}\nfunction sa2ApplyTabIcon() {\n  if (typeof document === 'undefined') return false;\n  try {\n    var tab = document.querySelector('[title=\"SoiledArmour2\"]');\n    if (!tab || !tab.children || !tab.children[0]) return false;\n    var svg = tab.children[0].children[0].children[0].children[0];\n    if (!svg || !svg.children || !svg.children[0]) return false;\n    var path = svg.children[0];\n    path.setAttribute('d',\n      'M256 0c4.6 0 9.2 1 13.4 2.9L457.7 82.8c22 9.3 38.4 31 38.3 57.2-.5 99.2-41.2 193.1-114.4 263.2-41.2 38.6-86 67.7-122.5 87.2-9.7 5.3-21.1 5.3-30.8 0-36.5-19.5-81.3-48.6-122.5-87.2C94.1 333.1 53.5 239.2 54 140c-.1-26.2 16.3-47.9 38.3-57.2L242.6 2.9C246.8 1 251.4 0 256 0z'\n    );\n    path.setAttribute('fill', '#8B4513');\n    return true;\n  } catch (e) { return false; }\n}\nfunction sa2ChAreaAttackLabel() {\n  return sa2ChAreaAttackOn() ? 'Area Attack: On' : 'Area Attack: Off';\n}\nfunction sa2ChAreaAttackOn() {\n  try {\n    var aa = String(client.crystal.hunt.grimkeep.areaAttack || 'off').toLowerCase();\n    if (aa === 'off' || aa === '') return false;\n    return aa === 'on' || aa === 'auto' || aa.indexOf(' ') >= 0;\n  } catch (e) { return false; }\n}\nfunction sa2ChAreaAttackWouldFire() {\n  if (!sa2ChPresent() || !sa2InGrimkeep()) return false;\n  try {\n    var gk = client.crystal.hunt.grimkeep;\n    if (!gk || !gk.active) return false;\n    var beastCmd = String(get_variable('sCHCommandBeast') || '');\n    if (!beastCmd) return false;\n    var aa = String(gk.areaAttack || 'off').toLowerCase();\n    if (aa === 'off' || aa === '') return false;\n    return sa2CountGkMobsByType().sentinel === 0;\n  } catch (e) {}\n  return false;\n}\nfunction sa2SanctityAaAllowsHeal() {\n  if (!sa2ChPresent() || !sa2InGrimkeep()) return true;\n  try {\n    var aa = String(client.crystal.hunt.grimkeep.areaAttack || 'off').toLowerCase();\n    if (aa === 'off') return true;\n  } catch (e) { return true; }\n  return !sa2ChAreaAttackWouldFire();\n}\nfunction sa2SyncBeastHealOwner() {\n  if (!sa2MasterOn() || !sa2ChPresent()) return;\n  if (sa2ModuleOn('sanctity')) send_command('ch beastheal off', 0);\n  else send_command('ch beastheal on', 0);\n}\nfunction sa2LeanBeastOn() {\n  return sa2MasterOn() && sa2Bool('sa2_ch_armed') && sa2Bool('sa2_lean_beast');\n}\nfunction sa2GkMobTypeFromName(name) {\n  var n = String(name || '').toLowerCase();\n  if (n.indexOf('artificer') >= 0) return 'artificer';\n  if (n.indexOf('battlecharger') >= 0) return 'battlecharger';\n  if (n.indexOf('excoropox') >= 0) return 'excoropox';\n  if (n.indexOf('koirakko') >= 0) return 'koirakko';\n  if (n.indexOf('sentinel') >= 0) return 'sentinel';\n  return null;\n}\nfunction sa2GkItemIsAggressive(item) {\n  if (!item || typeof item !== 'object') return false;\n  var attrib = String(item.attrib || '').toLowerCase();\n  if (attrib.indexOf('d') >= 0) return false;\n  if (attrib.indexOf('m') >= 0 && attrib.indexOf('h') >= 0) return true;\n  if (item.icon === 'eye-evil') return true;\n  return false;\n}\nfunction sa2MobTypeStatsFromGmcp() {\n  var types = ['artificer', 'battlecharger', 'excoropox', 'koirakko', 'sentinel'];\n  var stats = { shieldDataAvailable: false, total: { count: 0, aggressive: 0 } };\n  for (var t = 0; t < types.length; t++) stats[types[t]] = { count: 0, aggressive: 0 };\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Items && GMCP.Items.room) {\n      for (var i = 0; i < GMCP.Items.room.length; i++) {\n        var item = GMCP.Items.room[i];\n        if (!sa2ChGrimkeepItemIsGkMob(item) || !item.name) continue;\n        var mobType = sa2GkMobTypeFromName(item.name);\n        if (!mobType || !stats[mobType]) continue;\n        stats[mobType].count++;\n        stats.total.count++;\n        if (sa2GkItemIsAggressive(item)) {\n          stats[mobType].aggressive++;\n          stats.total.aggressive++;\n        }\n      }\n    }\n  } catch (e) {}\n  return stats;\n}\nfunction sa2BreathPriorityOrder() {\n  try {\n    var tp = client.crystal.hunt.grimkeep.targetPriorities;\n    if (tp && tp.length > 1 && String(tp[1]).toLowerCase() === 'sentinel') {\n      return ['artificer', 'battlecharger', 'excoropox', 'sentinel', 'koirakko'];\n    }\n  } catch (e) {}\n  return ['artificer', 'battlecharger', 'excoropox', 'koirakko', 'sentinel'];\n}\nfunction sa2BreathCandidate(bucket, shieldAware) {\n  if (!bucket || typeof bucket !== 'object') return false;\n  var count = bucket.count || 0;\n  if (count <= 0) return false;\n  if (shieldAware && (bucket.shielded || 0) >= count) return false;\n  return true;\n}\nfunction sa2BreathPickTargetType(stats) {\n  if (!stats || typeof stats !== 'object') return null;\n  var shieldAware = stats.shieldDataAvailable === true;\n  var order = sa2BreathPriorityOrder();\n  for (var pass = 1; pass <= 2; pass++) {\n    for (var i = 0; i < order.length; i++) {\n      var mobType = order[i];\n      var bucket = stats[mobType];\n      if (sa2BreathCandidate(bucket, shieldAware) &&\n          (pass === 2 || (bucket.aggressive || 0) > 0)) {\n        return mobType;\n      }\n    }\n  }\n  return null;\n}\nfunction sa2BreathFallbackRank() {\n  return ['peppermint', 'divinus', 'fire', 'soot'];\n}\nfunction sa2BreathNormalizeType(type) {\n  type = String(type || '').toLowerCase();\n  if (type === 'pep') return 'peppermint';\n  if (type === 'div') return 'divinus';\n  var rank = sa2BreathFallbackRank();\n  for (var i = 0; i < rank.length; i++) {\n    if (rank[i] === type) return type;\n  }\n  return null;\n}\nfunction sa2BreathOwns(type) {\n  type = sa2BreathNormalizeType(type);\n  if (!type) return false;\n  return sa2Bool('sa2_breath_own_' + type);\n}\nfunction sa2BreathOwnedList() {\n  var all = sa2BreathFallbackRank();\n  var out = [];\n  for (var i = 0; i < all.length; i++) {\n    if (sa2BreathOwns(all[i])) out.push(all[i]);\n  }\n  return out;\n}\nfunction sa2BreathPreferredForType(mobType) {\n  if (mobType === 'sentinel') return 'divinus';\n  if (mobType === 'artificer' || mobType === 'battlecharger' ||\n      mobType === 'excoropox' || mobType === 'koirakko') return 'peppermint';\n  return null;\n}\nfunction sa2BreathSecondaryChain(mobType) {\n  if (mobType === 'battlecharger') return ['soot'];\n  return [];\n}\nfunction sa2BreathForTypeOwned(mobType) {\n  var preferred = sa2BreathPreferredForType(mobType);\n  if (preferred && sa2BreathOwns(preferred)) return preferred;\n  var sec = sa2BreathSecondaryChain(mobType);\n  for (var i = 0; i < sec.length; i++) {\n    if (sa2BreathOwns(sec[i])) return sec[i];\n  }\n  var rank = sa2BreathFallbackRank();\n  for (var j = 0; j < rank.length; j++) {\n    if (sa2BreathOwns(rank[j])) return rank[j];\n  }\n  return null;\n}\nfunction sa2BreathFallbackRankIndex(breath) {\n  var rank = sa2BreathFallbackRank();\n  for (var i = 0; i < rank.length; i++) {\n    if (rank[i] === breath) return i;\n  }\n  return 999;\n}\nfunction sa2BreathUnshieldedHits(bucket, shieldAware) {\n  if (!bucket || typeof bucket !== 'object') return 0;\n  var count = bucket.count || 0;\n  if (count <= 0) return 0;\n  if (shieldAware) return Math.max(0, count - (bucket.shielded || 0));\n  return count;\n}\nfunction sa2CountGkMobsByType() {\n  var counts = { artificer: 0, battlecharger: 0, excoropox: 0, koirakko: 0, sentinel: 0 };\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Items && GMCP.Items.room) {\n      for (var i = 0; i < GMCP.Items.room.length; i++) {\n        var item = GMCP.Items.room[i];\n        if (!sa2ChGrimkeepItemIsGkMob(item) || !item.name) continue;\n        var mobType = sa2GkMobTypeFromName(item.name);\n        if (mobType && counts[mobType] != null) counts[mobType]++;\n      }\n    }\n  } catch (e) {}\n  return counts;\n}\nfunction sa2SmartBreathPick() {\n  var stats = sa2MobTypeStatsFromGmcp();\n  var target = sa2BreathPickTargetType(stats);\n  if (target) {\n    var owned = sa2BreathForTypeOwned(target);\n    if (owned) return owned;\n  }\n  var shieldAware = stats.shieldDataAvailable === true;\n  var mobTypes = ['artificer', 'battlecharger', 'excoropox', 'koirakko', 'sentinel'];\n  var scores = {};\n  for (var i = 0; i < mobTypes.length; i++) {\n    var hits = sa2BreathUnshieldedHits(stats[mobTypes[i]], shieldAware);\n    if (hits > 0) {\n      var breath = sa2BreathForTypeOwned(mobTypes[i]);\n      if (breath) scores[breath] = (scores[breath] || 0) + hits;\n    }\n  }\n  var best = null, bestScore = 0;\n  for (var b in scores) {\n    var score = scores[b];\n    if (score > bestScore) {\n      best = b;\n      bestScore = score;\n    } else if (score === bestScore && score > 0) {\n      if (sa2BreathFallbackRankIndex(b) < sa2BreathFallbackRankIndex(best)) best = b;\n    }\n  }\n  if (bestScore > 0 && best) return best;\n  return null;\n}\nfunction sa2BreathFirstOwned() {\n  var rank = sa2BreathFallbackRank();\n  for (var r = 0; r < rank.length; r++) {\n    if (sa2BreathOwns(rank[r])) return rank[r];\n  }\n  return null;\n}\nfunction sa2BreathMode() {\n  var m = String(sa2Get('sa2_breath_mode', '') || '').toLowerCase();\n  if (m === 'smart' || m === 'peppermint' || m === 'fire' || m === 'divinus') return m;\n  if (sa2Bool('sa2_smart_breath')) return 'smart';\n  return 'smart';\n}\nfunction sa2BreathModeLabel() {\n  var m = sa2BreathMode();\n  if (m === 'peppermint') return 'Breath: Peppermint';\n  if (m === 'fire') return 'Breath: Fire';\n  if (m === 'divinus') return 'Breath: Divinus';\n  if (m === 'smart') return 'Breath: Smart';\n  return 'Breath: Smart';\n}\nfunction sa2BreathModeTip() {\n  var tip = 'Cycle beast breath: smart, peppermint, fire, divinus. Smart picks from owned types only.';\n  if (sa2BreathMode() === 'smart') {\n    var pick = sa2SmartBreathPick() || sa2BreathFirstOwned();\n    if (pick) tip += ' Currently: ' + pick + '.';\n    var owned = sa2BreathOwnedList();\n    if (owned.length) tip += ' Owned: ' + owned.join(', ') + '.';\n  }\n  return tip;\n}\nfunction sa2BreathModeOn() {\n  return true;\n}\nfunction sa2BreathEnsureSaved() {\n  try {\n    if (!sa2Get('sa2_ch_saved_beast_cmd', '')) {\n      sa2Set('sa2_ch_saved_beast_cmd', String(get_variable('sCHCommandBeast') || ''));\n    }\n  } catch (e) {}\n}\nfunction sa2BreathCycle() {\n  var cur = sa2BreathMode();\n  var next = (cur === 'smart') ? 'peppermint' : (cur === 'peppermint') ? 'fire' : (cur === 'fire') ? 'divinus' : 'smart';\n  sa2BreathEnsureSaved();\n  sa2Set('sa2_breath_mode', next);\n  sa2Set('sa2_smart_breath', next === 'smart' ? '1' : '0');\n  return next;\n}\nfunction sa2BreathToggleOwn(type) {\n  type = sa2BreathNormalizeType(type);\n  if (!type) return false;\n  if (sa2BreathOwns(type) && sa2BreathOwnedList().length <= 1) {\n    display_notice('[SoiledArmour2] At least one breath type must be owned', 'grey');\n    return false;\n  }\n  sa2Set('sa2_breath_own_' + type, sa2BreathOwns(type) ? '0' : '1');\n  display_notice('[SoiledArmour2] Own ' + type + ': ' + (sa2BreathOwns(type) ? 'ON' : 'OFF'), sa2BreathOwns(type) ? 'lime' : 'grey');\n  sa2BreathApply(true);\n  return true;\n}\nfunction sa2BreathSetOwn(type, on) {\n  type = sa2BreathNormalizeType(type);\n  if (!type) return false;\n  var want = (on =