"id":89,"matching":"exact","whole_words":true,"case_sensitive":false,"prefix_suffix":false,"actions":[{"action":"script","script":"run_function('bm_intel','show','BladeMaster Engine');"}],"text":"xintel"},{"type":"alias","name":"","enabled":true,"id":90,"matching":"exact","whole_words":true,"case_sensitive":false,"prefix_suffix":false,"actions":[{"action":"script","script":"run_function('bm_intel','show','BladeMaster Engine');"}],"text":"xspec"},{"type":"alias","name":"","enabled":true,"id":91,"matching":"regexp","whole_words":false,"case_sensitive":false,"prefix_suffix":true,"actions":[{"action":"script","script":"run_function('bm_intel','xspec|'+(args[1]||'').trim(),'BladeMaster Engine');"}],"text":"^xspec\\s+(.+)$"},{"type":"alias","name":"","enabled":true,"id":92,"matching":"regexp","whole_words":false,"case_sensitive":false,"prefix_suffix":false,"actions":[{"action":"script","script":"set_variable('evisc_weakblood','1');\nset_variable('bm_weakblood','1');\ndisplay_notice('[BM] Weakblood ON. Alt+limb-key base strikes append weakblood (main row or numpad per xnumpad). No instant game action.','cyan');\ntry { run_function('bm_tabs','','BladeMaster Engine'); } catch (e) {}"}],"text":"^evisc1$"},{"type":"alias","name":"","enabled":true,"id":93,"matching":"regexp","whole_words":false,"case_sensitive":false,"prefix_suffix":false,"actions":[{"action":"script","script":"set_variable('evisc_weakblood','0');\nset_variable('bm_weakblood','0');\ndisplay_notice('[BM] Weakblood OFF (eviscwb2). evisc2 alone starts the EVISC2 stratagem combo, not weakblood.','cyan');\ntry { run_function('bm_tabs','','BladeMaster Engine'); } catch (e) {}"}],"text":"^eviscwb2$"},{"type":"alias","name":"","enabled":true,"id":94,"matching":"exact","whole_words":true,"case_sensitive":false,"prefix_suffix":false,"actions":[{"action":"script","script":"var cur=get_variable('bm_weakblood');\nvar wasOn=(cur==='1'||cur===1||cur===true||String(cur).toLowerCase()==='true');\nvar v=wasOn?'0':'1';\nset_varia