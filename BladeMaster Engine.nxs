'BC', Axelord: 'AL', Cavalier: 'CV', Monk: 'MK', Mage: 'MG', Bard: 'BD' };\nvar specLabel = '--';\nif (specRaw && specRaw !== 'Unknown') {\n  specLabel = specShortMap[specRaw] || specRaw;\n  if (specFam && specFam !== 'unknown') specLabel += ' (' + specFam + ')';\n}\nvar clickMod = String(bmGet('bm_click_mod', 'base') || 'base').toLowerCase();\nif (['base', 'lunge', 'light', 'heavy', 'stab', 'crit'].indexOf(clickMod) < 0) clickMod = 'base';\nvar roleName = String(bmGet('bm_role', 'killer') || 'killer').toLowerCase() === 'support' ? 'Support' : 'Killer';\nvar ce = '<div style=\"' + wrap + '\">';\nce += '<div style=\"color:#ffd27a;font-weight:bold;margin-bottom:4px\" title=\"' + bmEscTip('Combat Engine: Master, KillMode, and the limb pad.') + '\">Combat Engine: BladeMaster</div>';\nce += bmChipRow([\n  bmChip(bmEngineOn() ? 'Master: On' : 'Master: Off', 'engine', bmEngineOn(), 'Master gate (default ON). Also runs survival (writhe/wake/stand/slush/steam/concentrate/scrub + crit re-raise). Off mutes kill/evisc/remiss/glow/intel/poison auto and survival. Keys, Stein, parry stay. Alias xmaster / xbmengine / xengine.'),\n  bmChip('KillMode', 'killmode', bmBool('bm_killmode'), 'Opener raze + chest, then each hand fires the instant its arm is back. Sticky primary vital; when it is parry-denied: lunge through (spare power above the evisc reserve), else build the other vital, else split-bait arms/legs -> legs fallback. Starts xevisc at C! chest/gut. Needs Master on; parry logic needs Always Assay. Tuning: xkillparry.'),\n  bmChip(roleName, 'role', roleName === 'Support', 'Killer = finish at C!. Support = keep wounding, no auto evisc. Click to toggle. Alias xsupport.'),\n  bmChip('Smart', 'xsmart', bmBool('bm_xsmart'), 'If assay says they parry this limb hard (default 90%+), hit a backup limb instead. Does not change your parry.')\n], true);\nce += bmChipRow([\n  bmActChip('Heretic', 'heretic', '3p STARCHANT HERETIC. Queues sm add; appends bmt target if set.'),\n  bmActChip('Infidel', 'infidel', '3p STARCHANT INFIDEL (plain form, not WITH HOLY LIGHT).'),\n  bmActChip('Infidel+', 'infidelplus', '3p STARCHANT INFIDEL WITH HOLY LIGHT. Queues sm add; appends bmt target if set. Plain Infidel chip stays.'),\n  bmActChip('Inquisition', 'inquisition', '6p STARCHANT INQUISITION. Queues sm add; appends bmt target if set.')\n], true);\nce += bmChipRow([\n  bmChip('Glow', 'glow', bmDefOn('bm_glow_brand', true), 'Auto-chain Infidel then Inquisition on the white-glow opening. Default ON. Alias xglowbrand. Off = no auto-chain. Line not confirmed yet.'),\n  bmChip('Bastard', 'bastard', bmBool('bm_use_bastard'), 'Use a two-hander. Off (default): Find skips bastard; smart poisons stay on rapiers.'),\n  bmChip('Remiss', 'remiss', bmBool('bm_next_remiss'), 'Next volley only: add Remiss (2p, delayed aff). Does not change the persistent remiss key. Alias xqueueremiss.'),\n  bmActChip('Impede', 'impede', '5p focus: IMPEDE <bmt target>. Sends now — same as ximpede / Ctrl+Alt+8. No target → notice.')\n], true);\nce += bmChipRow([\n  bmChip('Base', 'clickbase', clickMod === 'base', 'Same as Alt + limb key (1–7). Default click strike.'),\n  bmChip('Lunge', 'clicklunge', clickMod === 'lunge', 'Same as Ctrl + limb key. Wound lunge (base + lunge). Weakblood still applies.'),\n  bmChip('Light', 'clicklight', clickMod === 'light', 'Same as Ctrl+Shift + limb key.'),\n  bmChip('Heavy', 'clickheavy', clickMod === 'heavy', 'Same as Ctrl+Alt + limb key.'),\n  bmChip('Stab', 'clickstab', clickMod === 'stab', 'Same as Alt+Shift + limb key.')\n]);\nce += bmBodyPad();\nce += '</div>';\ntry { set_custom_tab_html('CE', ce); } catch (e1) {}\n\nvar hp = bmGet('bm_en_hp', '');\nvar ego = bmGet('bm_en_ego', '');\nvar mana = bmGet('bm_en_mana', '');\nvar pow = bmGet('bm_en_power', '');\nvar off = '<div style=\"' + wrap + '\">';\noff += '<div style=\"color:#ffd27a;font-weight:bold;margin-bottom:4px\" title=\"' + bmEscTip('Offence: foe vitals, wounds, and kill path.') + '\">Offence - Tar