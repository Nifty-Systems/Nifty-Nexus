deMaster Engine');"}],"text":"xhitrlegcrit"},{"type":"alias","name":"","enabled":true,"id":180,"matching":"exact","whole_words":true,"case_sensitive":false,"prefix_suffix":false,"actions":[{"action":"script","script":"display_notice('[BM] Tabs auto-create (CE, Offence, Defence). Click the chips to toggle. Drag one out if you want it floating.','gold');\ndisplay_notice('[BM] CE = Combat Engine: BladeMaster (Master + KillMode + Role + Smart + sacraments + Remiss + limb pad)  ·  Offence = Lunges/Candy/Cheeky/Blade/Poisons/Poisonist/WeakBlood/Beast/queues  ·  Defence = Reactive/Parry/Stance/Affs/Always Assess/Always Assay/Filter/Tea (Green/Black) + spec + Support + music boxes + Shield. xbeastpoison <name> sets Beast spit venom.','cyan');\ndisplay_notice('[BM] Weapons: xrapiers xbastard xcane/xgnome — smart switch. xshieldset [id] persist cane/gnome (default first gnomeweapon). xshield prints current shield. xshield <name> bladeshields.','cyan');\ntry { run_function('bm_tabs','','BladeMaster Engine'); } catch (e) {}"}],"text":"xce"},{"type":"alias","name":"","enabled":true,"id":181,"matching":"exact","whole_words":true,"case_sensitive":false,"prefix_suffix":false,"actions":[{"action":"script","script":"var tgt=(get_variable('bm_target')||'').trim();\nif(!tgt){ display_notice('[BM] No target','red'); return; }\nfunction bmOn(k){ var v=get_variable(k); return v===true||v===1||v==='1'; }\nvar prep=[];\nif (bmOn('bm_xassess')) {\n  prep.push('free assess '+tgt);\n  set_variable('bm_assess_consumed_tgt',tgt);\n  set_variable('bm_last_assess_time',String(Date.now()/1000));\n}\nif (bmOn('bm_xassay')) prep.push('assay '+tgt);\nif (prep.length) send_command('sm clear;;sm add '+prep.join('|'),0);\nelse display_notice('[BM] Enable xassess or xassay first.','yellow');"}],"text":"xass"},{"type":"alias","name":"","enabled":true,"id":182,"matching":"exact","whole_words":true,"case_sensitive":false,"prefix_suffix":false,"actions":[{"action":"script","script":"run_function('bm_try_auto_