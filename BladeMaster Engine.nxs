_lunge_left'), 'Next volley only: left hand lunges if power >= 2 or unknown (not evisc reserve). Not vital-gated. Applied at send. Stab on the same hand wins.'),\n  bmChip('R Lunge', 'lungeright', bmBool('bm_next_lunge_right'), 'Next volley only: right hand lunges if power >= 2 or unknown (not evisc reserve). Not vital-gated. Applied at send. Stab on the same hand wins.'),\n  bmChip('Stab L', 'stableft', bmBool('bm_next_stab_left'), 'Next volley only: that hand stabs (guaranteed venom). Wins over a queued lunge on the same hand. No power cost.'),\n  bmChip('Stab R', 'stabright', bmBool('bm_next_stab_right'), 'Next volley only: that hand stabs (guaranteed venom). Wins over a queued lunge on the same hand. No power cost.')\n], true);\noff += bmEnVitalsRow(hp, ego, mana, pow);\noff += bmKillHinderRow();\nvar wHead = bmGet('bm_w_head', '');\nvar wLarm = bmGet('bm_w_larm', '');\nvar wChest = bmGet('bm_w_chest', '');\nvar wRarm = bmGet('bm_w_rarm', '');\nvar wGut = bmGet('bm_w_gut', '');\nvar wLleg = bmGet('bm_w_lleg', '');\nvar wRleg = bmGet('bm_w_rleg', '');\noff += bmWoundGrid({\n  head: woundTag(wHead), headTip: foeWoundTip('head', wHead),\n  larm: woundTag(wLarm), larmTip: foeWoundTip('left arm', wLarm),\n  chest: woundTag(wChest), chestTip: foeWoundTip('chest', wChest),\n  rarm: woundTag(wRarm), rarmTip: foeWoundTip('right arm', wRarm),\n  gut: woundTag(wGut), gutTip: foeWoundTip('gut', wGut),\n  lleg: woundTag(wLleg), llegTip: foeWoundTip('left leg', wLleg),\n  rleg: woundTag(wRleg), rlegTip: foeWoundTip('right leg', wRleg)\n});\nvar st = bmGet('bm_en_style', '');\nvar sn = bmGet('bm_en_stance', '');\nvar offBoxes = [];\nif (st) offBoxes.push(bmInfoBox('Style:', esc(st), 'Foe combat style.'));\nif (sn) offBoxes.push(bmInfoBox('Stance:', esc(sn), 'Foe stance.'));\noff += bmInfoBoxRow(offBoxes);\noff += '</div>';\ntry { set_custom_tab_html('Offence', off); } catch (e2) {}\n\nvar v = null;\ntry { if (client.bm_vitals) v = client.bm_vitals; } catch (eV) {}\nif (!v) {\n  try { if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Vitals) v = GMCP.Char.Vitals; } catch (eV2) {}\n}\nvar hemo = 0, bruise = 0;\nif (v) {\n  var hemoKeys = ['headhemorrhaging', 'chesthemorrhaging', 'guthemorrhaging', 'leftarmhemorrhaging', 'rightarmhemorrhaging', 'leftleghemorrhaging', 'rightleghemorrhaging'];\n  var bruiseKeys = ['headbruising', 'chestbruising', 'gutbruising', 'leftarmbruising', 'rightarmbruising', 'leftlegbruising', 'rightlegbruising'];\n  var hi, bi;\n  for (hi = 0; hi < hemoKeys.length; hi++) hemo += Number(v[hemoKeys[hi]]) || 0;\n  for (bi = 0; bi < bruiseKeys.length; bi++) bruise += Number(v[bruiseKeys[bi]]) || 0;\n}\nvar df = '<div style=\"' + wrap + '\">';\ndf += '<div style=\"color:#ffd27a;font-weight:bold;margin-bottom:4px\" title=\"' + bmEscTip('Defence: your wounds, parry, and afflictions.') + '\">Defence - Hemo: ' + hemo + ' Bruise: ' + bruise + '</div>';\nvar psStance, psParries, hasPs = false, psAuto = '';\ntry {\n  psStance = get_variable('ps_stance');\n  psParries = get_variable('ps_parries');\n  psAuto = get_variable('ps_auto_mode');\n  if (psStance !== undefined || psParries !== undefined || psAuto !== undefined) hasPs = true;\n} catch (ePsPre) {}\ndf += bmChipRow([\n  bmChip('Reactive', 'smart', bmDefOn('bm_def_smart', false), 'Auto-cover via ParryStance. Uses opponent spec when known (Defence chips / xspec / hit guess if unlocked). Not the CE Smart chip.'),\n  bmChip('Parry', 'parry', bmDefOn('bm_def_parry', true), 'When Smart is on, send PARRY. Off = clear / do not keep parrying.'),\n  bmChip('Stance', 'stance', bmDefOn('bm_def_stance', true), 'When Smart is on, send STANCE. Off = leave stance alone.'),\n  bmChip('Affs', 'affs', bmDefOn('bm_show_affs', true), 'Show your GMCP afflictions. Not inferred / not click-to-cure.'),\n  bmChip('Always Assess', 'assess', bmBool('bm_xassess'), 'Free-assess before strikes (reuse timer). Can stay on with Assay; assess always goes first.'),\n  bmChip('Always Assay', 'assay', bmBool('bm_xassay'), 'Assay before strikes (eq). Can stay on with Assess; assess always precedes assay. Needed for xsmart.'),\n  bmChip('Filter', 'spam', bmSpamOn(), 'Hide stratagem chatter and the foe assess wound block (default ON). Needs Master on. Alias xbmspam.'),\n  bmChip(bmTeaLabel(), 'tea', true, 'Keep this tea defence up. Click Green/Black (your default). Spec lock may switch Black/Green. Sip when GMCP says it is down.')\n]);\ndf += bmChipRow([\n  bmChip('BM', 'specbm', specRaw === 'Blademaster', 'Blademaster. Lock foe as BM. Smart: 50 chest/gut (evisc C!), vitals if both open. Click again to clear.'),\n  bmChip('PB', 'specpb', specRaw === 'Pureblade', 'Pureblade. Lock foe as PB. Smart: 50 gut (impale/carve), 50 chest if that is live. Click again to clear.'),\n  bmChip('BC', 'specbc', specRaw === 'Bonecrusher', 'Bonecrusher. Lock foe as BC. Smart: 75 head, or 50 legs if they are chopping legs. Click again to clear.'),\n  bmChip('AL', 'specal', specRaw === 'Axelord', 'Axelord. Lock foe as AL. Smart: 75 head if they hit head / your head is worst vital; else vitals. Click again to clear.')\n], true);\ndf += bmChipRow([\n  bmChip('CV', 'speccv', specRaw === 'Cavalier', 'Cavalier. Lock foe as CV. Smart: 50 arms/legs if those are live; else chest/gut or vitals. Click again to clear.'),\n  bmChip('MK', 'specmk', specRaw === 'Monk', 'Monk. Lock foe as monk. Smart: vitals (25split). Kill is hemo/BURST, not wounds. Click again to clear.'),\n  bmChip('MG', 'specmg', specRaw === 'Mage', 'Mage. Lock foe as mage. Smart: vitals (25split). Staff/affs, no wound kill. Click again to clear.'),\n  bmChip('BD', 'specbd', specRaw === 'Bard', 'Bard. Lock foe as bard. Smart: vitals (25split). Kill songs are hear/room — parry does not stop them. Click again to clear.')\n], true);\ndf += bmChipRow([\n  bmChip(bmAssistChipLabel(), 'assistspec', assistOn, bmAssistRecipeTip())\n], true);\ndf += bmChipRow([\n  bmActChip('Emerald', 'emerald', 'CRANK emerald box — lessens enemy health regen. Auto-Find if the id is empty.'),\n  bmActChip('Azure', 'azure', 'CRANK azure box — lessens enemy mana regen. Auto-Find if the id is empty.'),\n  bmActChip('Golden', 'golden', 'CRANK golden box — lessens enemy ego regen. Auto-Find if the id is empty.'),\n  bmChip('Shield', 'shield', bmBool('bm_bladeshield'), '5p focus: BLADESHIELD ME (you). Sends now — not queued. Click while up only re-sends bladeshield me (never a strike). Kill/auto-evisc/haymaker pause while up. Ally: xshield <name>.')\n], true);\nif (!v) {\n  df += '<div style=\"color:#888\">Waiting for Char.Vitals (GMCP)…</div>';\n} else {\n  df += bmWoundGrid({\n    head: vitNum(v.headwounds), headTip: 'Your head wounds (GMCP).',\n    larm: vitNum(v.leftarmwounds), larmTip: 'Your left arm wounds (GMCP).',\n    chest: vitNum(v.chestwounds), chestTip: 'Your chest wounds (GMCP).',\n    rarm: vitNum(v.rightarmwounds), rarmTip: 'Your right arm wounds (GMCP).',\n    gut: vitNum(v.gutwounds), gutTip: 'Your gut wounds (GMCP).',\n    lleg: vitNum(v.leftlegwounds), llegTip: 'Your left leg wounds (GMCP).',\n    rleg: vitNum(v.rightlegwounds), rlegTip: 'Your right leg wounds (GMCP).'\n  }, '5px');\n}\nif (hasPs) {\n  var pobj = {};\n  try { pobj = JSON.parse(psParries || '{}'); } catch (eJ) { pobj = {}; }\n  var bits = [], pk, pkeys = ['head', 'chest', 'gut', 'leftarm', 'rightarm', 'leftleg', 'rightleg'];\n  for (var pi = 0; pi < pkeys.length; pi++) {\n    pk = pkeys[pi];\n    if (pobj[pk] != null && pobj[pk] !== '') bits.push(pk + ' ' + pobj[pk]);\n  }\n  df += bmInfoBoxRow([\n    bmInfoBox('Stance:', esc(psStance || '—'), 'Your ParryStance stance.'),\n    bmInfoBox('Parry:', esc(bits.length ? bits.join('  ') : '—'), 'Your parry weights.')\n  ]);\n}\nif (bmDefOn('bm_show_affs', true)) {\n  df += bmAffPillsHtml(bmAffNames());\n}\ndf += '</div>';\ntry { set_custom_tab_html('Defence', df); } catch (e3) {}\ntry {\n  if (typeof client !== 'undefined' && client.bmTabIconOk) return;\n  bmApplyTabIcons();\n} catch (eIco) {}\n"},{"type":"function","name":"bm_chip","enabled":true,"id":10,"code":"\nfunction bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmDefOn(k, fallbackOn) {\n  var raw = get_variable(k);\n  if (raw === undefined || raw === null || raw === '') return !!fallbackOn;\n  return bmBool(k);\n}\nfunction bmEngineOn() {\n  var raw = get_variable('bm_engine');\n  if (raw === undefined || raw === null || raw === '') return true;\n  return bmBool('bm_engine');\n}\nfunction bmSpamOn() {\n  return bmDefOn('bm_spam', true);\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nfunction bmPsnmSideHas(list) {\n  if (!list) return false;\n  if (Object.prototype.toString.call(list) === '[object Array]') return list.length > 0;\n  return String(list).trim() !== '';\n}\nfunction bmPsnmCustomFilled() {\n  var keys = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\n  var custom = {};\n  try { custom = JSON.parse(String(bmGet('psnm_custom', '{}') || '{}')); } catch (eC) { custom = {}; }\n  if (!custom || typeof custom !== 'object') custom = {};\n  var out = [];\n  var i, k, p, name;\n  for (i = 0; i < keys.length; i++) {\n    k = keys[i];\n    p = custom[k];\n    if (!p || typeof p !== 'object') continue;\n    if (!bmPsnmSideHas(p.left) && !bmPsnmSideHas(p.right)) continue;\n    name = String(p.name || '').trim();\n    if (!name) name = 'Profile ' + k.replace('profile', '');\n    out.push({ key: k, name: name });\n  }\n  return out;\n}\nfunction bmPoisonRotationKeys() {\n  var list = ['standard', 'power'];\n  var filled = bmPsnmCustomFilled();\n  var i;\n  for (i = 0; i < filled.length; i++) list.push(filled[i].key);\n  return list;\n}\nfunction bmNormalizePoisonMode() {\n  var mode = String(bmGet('bm_poison_mode', 'standard') || 'standard').toLowerCase();\n  if (mode === 'standard' || mode === 'power') return mode;\n  var filled = bmPsnmCustomFilled();\n  var i;\n  for (i = 0; i < filled.length; i++) {\n    if (filled[i].key === mode) return mode;\n  }\n  bmSet('bm_poison_mode', 'standard');\n  return 'standard';\n}\nfunction bmPoisonModeLabel(mode) {\n  mode = String(mode || 'standard').toLowerCase();\n  if (mode === 'power') return 'Power';\n  if (mode === 'standard') return 'Standard';\n  var filled = bmPsnmCustomFilled();\n  var i;\n  for (i = 0; i < filled.length; i++) {\n    if (filled[i].key === mode) return filled[i].name;\n  }\n  return 'Standard';\n}\nvar BM_ASSIST_ORDER = ['off','tahtetso','nekotai','blademaster','axelord','pureblade','bonecrusher'];\nvar BM_ASSIST_SHORT = { off:'Off', tahtetso:'Taht', nekotai:'Neko', blademaster:'BM', axelord:'AL', pureblade:'PB', bonecrusher:'BC' };\nvar BM_ASSIST_ALIAS = {\n  off:'off', taht:'tahtetso', tahtetso:'tahtetso',\n  neko:'nekotai', nekotai:'nekotai',\n  bm:'blademaster', blademaster:'blademaster',\n  al:'axelord', axelord:'axelord',\n  pb:'pureblade', pureblade:'pureblade',\n  bc:'bonecrusher', bonecrusher:'bonecrusher'\n};\nfunction bmAssistRecipes() {\n  return {\n    tahtetso: { left: ['tetrodin', 'crotamine', 'anatine'], right: ['crotamine', 'anatine', 'tetrodin'] },\n    nekotai: { left: ['hadrudin', 'mellitin'], right: ['mellitin', 'hadrudin'] },\n    blademaster: { left: ['senso', 'haemotox'], right: ['haemotox', 'senso'] },\n    axelord: { left: ['senso', 'dendroxin'], right: ['dendroxin', 'senso'] },\n    pureblade: { left: ['haemotox', 'senso'], right: ['senso', 'haemotox'] },\n    bonecrusher: { left: ['senso', 'haemotox'], right: ['haemotox', 'senso'] }\n  };\n}\nfunction bmAssistSpec() {\n  var raw = String(bmGet('bm_assist_spec', 'off') || 'off').toLowerCase();\n  if (BM_ASSIST_ALIAS[raw]) return BM_ASSIST_ALIAS[raw];\n  return 'off';\n}\nfunction bmAssistChipLabel() {\n  return 'Support: ' + (BM_ASSIST_SHORT[bmAssistSpec()] || 'Off');\n}\nfunction bmAssistRecipeTip() {\n  var spec = bmAssistSpec();\n  if (spec === 'tahtetso') return 'Taht: tetrodin + crotamine + anatine (steam/dust/slush). Cycle head/chest/gut. No senso/hadrudin/chansu.';\n  if (spec === 'nekotai') return 'Neko: hadrudin + mellitin. Cycle head/chest/gut. No senso/tetrodin/chansu.';\n  if (spec === 'blademaster') return 'BM: senso + haemotox (dendroxin if both vitals parried). Chest↔gut. No tetrodin/hadrudin.';\n  if (spec === 'axelord') return 'AL: senso + dendroxin. Head to heavy/C!, then chest/gut to heavy.';\n  if (spec === 'pureblade') return 'PB: haemotox + senso. Gut first, chest second. No crotamine (dust).';\n  if (spec === 'bonecrusher') return 'BC: senso + haemotox. Head first, legs second.';\n  return 'Off → Taht → Neko → BM → AL → PB → BC. Feeds that teammate wiki kill path. Forces Support role. Alias xassist.';\n}\nfunction bmAssistWoundWord(limb) {\n  return String(bmGet('bm_w_' + limb, '') || '').toLowerCase();\n}\nfunction bmAssistIsCrit(limb) { return bmAssistWoundWord(limb) === 'critical'; }\nfunction bmAssistParryHigh(limb) {\n  var th = parseInt(bmGet('bm_smart_threshold', '90'), 10);\n  if (isNaN(th)) th = 90;\n  var p = parseInt(bmGet('bm_p_' + limb, ''), 10);\n  if (isNaN(p)) return false;\n  return p >= th;\n}\nfunction bmAssistWoundRank(limb) {\n  var w = bmAssistWoundWord(limb);\n  if (w === 'critical') return 3;\n  if (w === 'heavy') return 2;\n  if (w === 'light') return 1;\n  return 0;\n}\nfunction bmAssistPickCycleVitals() {\n  var order = ['head', 'chest', 'gut'];\n  var last = String(bmGet('bm_kill_limb', '') || '');\n  var best = '', bestRank = 99, bestIdx = 99;\n  var i, limb, rank, idx, lastIdx;\n  lastIdx = order.indexOf(last);\n  for (i = 0; i < order.length; i++) {\n    limb = order[i];\n    if (bmAssistParryHigh(limb)) continue;\n    rank = bmAssistWoundRank(limb);\n    idx = (lastIdx < 0) ? i : ((i - lastIdx - 1 + order.length) % order.length);\n    if (!best || rank < bestRank || (rank === bestRank && idx < bestIdx)) {\n      best = limb;\n      bestRank = rank;\n      bestIdx = idx;\n    }\n  }\n  return best || 'head';\n}\nfunction bmAssistPickKill() {\n  var spec = bmAssistSpec();\n  if (spec === 'tahtetso' || spec === 'nekotai') return bmAssistPickCycleVitals();\n  if (spec === 'axelord') {\n    if (!bmAssistParryHigh('head') && bmAssistWoundRank('head') < 2) return 'head';\n    if (!bmAssistParryHigh('chest') && bmAssistWoundRank('chest') < 2) return 'chest';\n    if (!bmAssistParryHigh('gut') && bmAssistWoundRank('gut') < 2) return 'gut';\n    if (!bmAssistParryHigh('head')) return 'head';\n    if (!bmAssistParryHigh('chest')) return 'chest';\n    return 'gut';\n  }\n  if (spec === 'pureblade') {\n    if (!bmAssistParryHigh('gut') && !bmAssistIsCrit('gut')) return 'gut';\n    if (!bmAssistParryHigh('chest')) return 'chest';\n    return 'gut';\n  }\n  if (spec === 'bonecrusher') {\n    if (!bmAssistParryHigh('head') && !bmAssistIsCrit('head')) return 'head';\n    if (!bmAssistParryHigh('lleg') && bmAssistWoundRank('lleg') <= bmAssistWoundRank('rleg')) return 'lleg';\n    if (!bmAssistParryHigh('rleg')) return 'rleg';\n    if (!bmAssistParryHigh('lleg')) return 'lleg';\n    return 'head';\n  }\n  // Default Blademaster: sticky primary vital (wound rank, then lower effParry, then chest).\n  if (typeof resolveKillVital === 'function') return resolveKillVital();\n  if (bmAssistIsCrit('chest') || bmAssistParryHigh('chest')) return 'gut';\n  return 'chest';\n}\nfunction bmAssistSet(raw) {\n  raw = String(raw == null ? '' : raw).toLowerCase().replace(/^\\s+|\\s+$/g, '');\n  if (raw === 'show') {\n    display_notice('[BM] ' + bmAssistChipLabel() + (bmAssistSpec() === 'off' ? ' — Standard/Power poisons' : ' — ' + bmAssistRecipeTip()), 'lightgreen');\n    return bmAssistSpec();\n  }\n  var spec;\n  if (!raw || raw === 'cycle' || raw === 'next') {\n    var cur = bmAssistSpec();\n    var idx = 0;\n    var i;\n    for (i = 0; i < BM_ASSIST_ORDER.length; i++) {\n      if (BM_ASSIST_ORDER[i] === cur) { idx = i; break; }\n    }\n    spec = BM_ASSIST_ORDER[(idx + 1) % BM_ASSIST_ORDER.length];\n  } else {\n    spec = BM_ASSIST_ALIAS[raw];\n    if (!spec) {\n      display_notice('[BM] Support: use off|taht|neko|bm|al|pb|bc (or xassist).', 'yellow');\n      return bmAssistSpec();\n    }\n  }\n  var prev = bmAssistSpec();\n  if (spec !== 'off') {\n    if (prev === 'off') bmSet('bm_assist_role_saved', String(bmGet('bm_role', 'killer') || 'killer'));\n    bmSet('bm_role', 'support');\n  } else if (prev !== 'off') {\n    var saved = String(bmGet('bm_assist_role_saved', '') || '').toLowerCase();\n    if (saved === 'support' || saved === 'killer') bmSet('bm_role', saved);\n    bmSet('bm_assist_role_saved', '');\n  }\n  bmSet('bm_assist_spec', spec);\n  bmSet('bm_wep_poison_style', '');\n  try { run_function('bm_sync_wep_poison', '', 'BladeMaster Engine'); } catch (eAs) {}\n  if (spec === 'off') {\n    var roleNow = String(bmGet('bm_role', 'killer') || 'killer').toLowerCase() === 'support' ? 'Support' : 'Killer';\n    display_notice('[BM] Support: Off — Role ' + roleNow + ' restored; Standard/Power poison cycle.', 'lightgreen');\n  } else {\n    display_notice('[BM] ' + bmAssistChipLabel() + ' — Role Support (no auto evisc). ' + bmAssistRecipeTip(), 'lightgreen');\n  }\n  return spec;\n}\nfunction bmTeaNormKind(k) {\n  k = String(k || 'green').toLowerCase();\n  if (k === 'black' || k === 'blacktea') return 'blacktea';\n  return 'green';\n}\nfunction bmTeaKind() {\n  return bmTeaNormKind(bmGet('bm_tea_kind', 'green'));\n}\nfunction bmTeaUserKind() {\n  return bmTeaNormKind(bmGet('bm_tea_user', 'green'));\n}\nfunction bmTeaLabel() {\n  return bmTeaKind() === 'blacktea' ? 'Black' : 'Green';\n}\nfunction bmTeaSipCmd() {\n  return bmTeaKind() === 'blacktea' ? 'blacktea' : 'greentea';\n}\nfunction bmTeaKindFromSpec(spec) {\n  spec = String(spec || '').trim().toLowerCase();\n  if (!spec || spec === 'unknown' || spec === 'off' || spec === 'clear') return '';\n  if (spec === 'bonecrusher') return 'blacktea';\n  if (spec === 'pureblade') return 'blacktea';\n  if (spec === 'cavalier' || spec === 'monk' || spec === 'mage' || spec === 'blademaster' || spec === 'axelord') return 'green';\n  if (spec === 'bard') return 'green';\n  return '';\n}\nfunction bmTeaApplyForSpec(spec) {\n  var mapped = bmTeaKindFromSpec(spec);\n  var next = mapped || bmTeaUserKind();\n  next = bmTeaNormKind(next);\n  bmSet('bm_tea_kind', next);\n  bmTeaSipIfNeeded();\n  return next;\n}\nfunction bmTeaDefName(item) {\n  if (item == null) return '';\n  if (typeof item === 'string') return String(item).toLowerCase();\n  return String(item.name || item.defence || item.Name || '').toLowerCase();\n}\nfunction bmTeaFlagOn(k) {\n  var v = get_variable(k);\n  if (v === true || v === 1) return true;\n  var s = String(v == null ? '' : v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmTeaMark(cmd, up) {\n  cmd = String(cmd || '').toLowerCase();\n  if (cmd === 'greentea') set_variable('bm_tea_green_up', up ? '1' : '0');\n  else if (cmd === 'blacktea') set_variable('bm_tea_black_up', up ? '1' : '0');\n}\nfunction bmTeaHasDef(cmd) {\n  cmd = String(cmd || bmTeaSipCmd()).toLowerCase();\n  if (cmd === 'greentea' && bmTeaFlagOn('bm_tea_green_up')) return true;\n  if (cmd === 'blacktea' && bmTeaFlagOn('bm_tea_black_up')) return true;\n  function listHas(list) {\n    if (!list || typeof list.length !== 'number') return false;\n    var i, n;\n    for (i = 0; i < list.length; i++) {\n      n = bmTeaDefName(list[i]);\n      if (n === cmd) return true;\n    }\n    return false;\n  }\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences) {\n      if (listHas(GMCP.Char.Defences.List || GMCP.Char.Defences)) return true;\n    }\n  } catch (eG) {}\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Defences) {\n      if (listHas(gmcp.Char.Defences.List || gmcp.Char.Defences)) return true;\n    }\n  } catch (eG2) {}\n  return false;\n}\nfunction bmTeaSipIfNeeded() {\n  var cmd = bmTeaSipCmd();\n  if (bmTeaHasDef(cmd)) return false;\n  send_command('sip ' + cmd, 0);\n  return true;\n}\nfunction bmTeaCycle() {\n  var next = bmTeaKind() === 'blacktea' ? 'green' : 'blacktea';\n  bmSet('bm_tea_kind', next);\n  bmSet('bm_tea_user', next);\n  bmTeaSipIfNeeded();\n  return next;\n}function bmCandyOn() {\n  return bmBool('pEviscLollyPrep') || bmBool('evisc_candy');\n}\nfunction bmCheekyOn() {\n  return bmBool('evisc_cheeky');\n}\nfunction bmComboWbOn() {\n  var raw = get_variable('evisc_combo_weakblood');\n  if (raw === undefined || raw === null || raw === '') return bmCandyOn();\n  return bmBool('evisc_combo_weakblood');\n}\nfunction bmCallParry(op) {\n  try {\n    run_function('_parry', op, 'BladeMaster Engine');\n    return true;\n  } catch (eP) {\n    return false;\n  }\n}\nfunction bmHasPs() {\n  try {\n    if (get_variable('ps_auto_mode') !== undefined || get_variable('ps_stance') !== undefined || get_variable('ps_parries') !== undefined) return true;\n  } catch (ePs) {}\n  return false;\n}\nfunction bmDefOn(k, fallbackOn) {\n  var raw = get_variable(k);\n  if (raw === undefined || raw === null || raw === '') return !!fallbackOn;\n  return bmBool(k);\n}\nfunction bmApplyDefGates() {\n  if (!bmHasPs()) return false;\n  var smart = bmDefOn('bm_def_smart', false);\n  var parry = bmDefOn('bm_def_parry', true);\n  if (!smart) {\n    bmCallParry('key|off|');\n    try { set_variable('bm_def_choice', ''); } catch (eC0) {}\n    return true;\n  }\n  if (!parry) {\n    bmCallParry('unparry');\n    bmCallParry('key|off|');\n    try { set_variable('bm_def_choice', ''); } catch (eC) {}\n    return true;\n  }\n  try { set_variable('bm_def_choice', ''); } catch (eC2) {}\n  try { run_function('bm_smart_def', '', 'BladeMaster Engine'); } catch (eSd) {\n    bmCallParry('xautoparry|full');\n  }\n  return true;\n}\nvar op = '';\nif (typeof args === 'string') op = args;\nelse if (args && typeof args === 'object' && args[0] != null) op = String(args[0]);\nelse if (args != null) op = String(args);\nop = String(op || '').trim().toLowerCase();\n\nif (op === 'role' || op === 'roleshow') {\n  if (op === 'roleshow') {\n    var rs = String(bmGet('bm_role', 'killer') || 'killer').toLowerCase();\n    var assistShow = bmAssistSpec();\n    display_notice('[BM] Role ' + (rs === 'support' ? 'Support' : 'Killer') + (assistShow !== 'off' ? ' (forced by ' + bmAssistChipLabel() + ')' : ''), 'lightgreen');\n  } else if (bmAssistSpec() !== 'off') {\n    display_notice('[BM] ' + bmAssistChipLabel() + ' is on — Role stays Support so you do not steal their finish. Support: Off to restore Killer.', 'yellow');\n  } else {\n    var next = String(bmGet('bm_role', 'killer') || 'killer').toLowerCase() === 'support' ? 'killer' : 'support';\n    bmSet('bm_role', next);\n    display_notice('[BM] Role ' + (next === 'support' ? 'Support — no auto evisc; lunges every chest/gut at 2p' : 'Killer — finish at C!'), 'lightgreen');\n  }\n} else if (op === 'assistspec' || op.indexOf('assistspec|') === 0) {\n  var assistArg = (op === 'assistspec') ? 'cycle' : op.slice('assistspec|'.length);\n  bmAssistSet(assistArg);\n} else if (op === 'engine' || op.indexOf('engine|') === 0) {\n  var eArg = '';\n  if (op.indexOf('|') >= 0) eArg = String(op.split('|').slice(1).join('|') || '').trim().toLowerCase();\n  var wantOn;\n  if (eArg === 'on' || eArg === '1' || eArg === 'true' || eArg === 'yes') wantOn = true;\n  else if (eArg === 'off' || eArg === '0' || eArg === 'false' || eArg === 'no') wantOn = false;\n  else if (eArg === 'show' || eArg === 'status') {\n    display_notice('[BM] Master ' + (bmEngineOn() ? 'ON' : 'OFF') + ' (xmaster / xbmengine / xengine)', 'lightgreen');\n    wantOn = null;\n  } else wantOn = !bmEngineOn();\n  if (wantOn !== null) {\n    bmSet('bm_engine', wantOn ? '1' : '0');\n    if (!wantOn) {\n      bmSet('bm_killmode', '0');\n      bmSet('bm_kill_volley', '0');\n      bmSet('bm_kill_pending', '');\n      bmSet('bm_pending', '');\n      try {\n        if (typeof client !== 'undefined' && client.evisc && client.evisc.isExecuting) {\n          run_function('evisc_main', 'abort', 'BladeMaster Engine');\n        }\n      } catch (eAb) {}\n      display_notice('[BM] Master OFF — kill mode stopped, evisc aborted, pending cleared.', 'yellow');\n    } else {\n      display_notice('[BM] Master ON', 'lightgreen');\n    }\n  }\n} else if (op === 'spam' || op.indexOf('spam|') === 0) {\n  var sArg = '';\n  if (op.indexOf('|') >= 0) sArg = String(op.split('|').slice(1).join('|') || '').trim().toLowerCase();\n  var wantSpam;\n  if (sArg === 'on' || sArg === '1' || sArg === 'true' || sArg === 'yes') wantSpam = true;\n  else if (sArg === 'off' || sArg === '0' || sArg === 'false' || sArg === 'no') wantSpam = false;\n  else if (sArg === 'show' || sArg === 'status') {\n    display_notice('[BM] Spam ' + (bmSpamOn() ? 'ON' : 'OFF') + (bmEngineOn() ? '' : ' (idle until master is on)'), 'lightgreen');\n    wantSpam = null;\n  } else wantSpam = !bmSpamOn();\n  if (wantSpam !== null) {\n    bmSet('bm_spam', wantSpam ? '1' : '0');\n    display_notice('[BM] Spam ' + (wantSpam ? 'ON' : 'OFF') + (bmEngineOn() ? '' : ' (idle until master is on)'), wantSpam ? 'lightgreen' : 'yellow');\n  }\n} else if (op === 'killmode') {\n  if (!bmEngineOn()) {\n    display_notice('[BM] KillMode needs Master on (xmaster / Master chip).', 'yellow');\n  } else {\n  var v = bmBool('bm_killmode') ? '0' : '1';\n  bmSet('bm_killmode', v);\n  bmSet('bm_kill_volley', '0');\n  bmSet('bm_kill_pending', '');\n  bmSet('bm_conc_sent', '0');\n  if (v === '1') bmSet('bm_poisonist_sent', '0');\n  if (v === '1') {\n    try { run_function('bm_kill_parry', 'reset', 'BladeMaster Engine'); } catch (eKr) {}\n    var t = String(bmGet('bm_target', '') || '').trim();\n    if (!t) display_notice('[BM] Kill mode ON — set a target with bmt <name>.', 'yellow');\n    else display_notice('[BM] Kill mode ON — wound-build ' + t + ' (per-arm volleys, parry-aware plan, xevisc at C!). Manual keys still work.', 'lightgreen');\n    if (!bmBool('bm_xassay') && !bmBool('bm_parry_assay_hint')) {\n      bmSet('bm_parry_assay_hint', '1');\n      display_notice('[BM] Hint: Always Assay is OFF — the parry plan (PARRY CONFIRMED / lunge through / split) needs assay readings. Defence tab chip or xassay.', 'yellow');\n    }\n    try { run_function('bm_kill', '', 'BladeMaster Engine'); } catch (eKm) {}\n  } else display_notice('[BM] Kill mode OFF', 'cyan');\n  }\n} else if (op === 'blade') {\n  var on = !bmBool('bm_pre_evisc_blade');\n  bmSet('bm_pre_evisc_blade', on ? '1' : '0');\n  display_notice('[BM] Blade pre-evisc ' + (on ? 'ON' : 'OFF') + ' (starchant + wound volleys on first C!)', 'lightgreen');\n} else if (op === 'lunges') {\n  var lv = bmBool('bm_kill_lunge') ? '0' : '1';\n  bmSet('bm_kill_lunge', lv);\n  display_notice('[BM] Lunges ' + (lv === '1' ? 'ON' : 'OFF') + ' (wiki Lunge 2p/hand; Killer every 3rd; Support every vital)', 'lightgreen');\n} else if (op === 'candy') {\n  var con = !bmCandyOn();\n  bmSet('pEviscLollyPrep', con ? '1' : '0');\n  if (!con) bmSet('evisc_combo_weakblood', '0');\n  display_notice('[Evisc] Lolly prep bundle ' + (con ? 'ON' : 'OFF'), 'yellow');\n} else if (op === 'cheeky') {\n  var ch = !bmCheekyOn();\n  bmSet('evisc_cheeky', ch ? '1' : '0');\n  display_notice('[Evisc] Cheeky ' + (ch ? 'ON' : 'OFF') + ' (wonderpipe in remiss hole)', 'yellow');\n} else if (op === 'poisons') {\n  if (bmAssistSpec() !== 'off') {\n    display_notice('[BM] ' + bmAssistChipLabel() + ' owns the poison recipe. Support: Off to restore Standard/Power.', 'yellow');\n  } else {\n  bmSet('bm_smart_poison', '1');\n  var rot = bmPoisonRotationKeys();\n  var cur = bmNormalizePoisonMode();\n  var idx = 0;\n  var ri;\n  for (ri = 0; ri < rot.length; ri++) {\n    if (rot[ri] === cur) { idx = ri; break; }\n  }\n  var nextMode = rot[(idx + 1) % rot.length];\n  bmSet('bm_poison_mode', nextMode);\n  bmSet('bm_wep_poison_style', '');\n  var profKey = nextMode;\n  if (nextMode === 'standard') profKey = 'blademaster1';\n  else if (nextMode === 'power') profKey = 'maxdamage';\n  try { run_function('psnm_set_profile', profKey, 'BladeMaster Engine'); } catch (ePprof) {}\n  try { run_function('bm_sync_wep_poison', '', 'BladeMaster Engine'); } catch (ePsync) {}\n  var nextLabel = bmPoisonModeLabel(nextMode);\n  if (nextMode === 'power') {\n    display_notice('[BM] Poisons Power — Power SAP (escozul/dendroxin). Killer C! still evisc dust.', 'lightgreen');\n  } else if (nextMode === 'standard') {\n    display_notice('[BM] Poisons Standard — senso wound-build (parried dendroxin). Killer C! still evisc dust.', 'lightgreen');\n  } else {\n    display_notice('[BM] Poisons ' + nextLabel + ' — custom profile. Killer C! still evisc dust.', 'lightgreen');\n  }\n  }\n} else if (op === 'wb') {\n  if (!bmCandyOn()) {\n    display_notice('[Evisc] WB requires Candy on.', 'yellow');\n  } else {\n    var won = !bmComboWbOn();\n    bmSet('evisc_combo_weakblood', won ? '1' : '0');\n    display_notice('[Evisc] Weakblood middle ' + (won ? 'ON' : 'OFF'), 'yellow');\n  }\n} else if (op === 'lungeleft') {\n  var ll = !bmBool('bm_next_lunge_left');\n  bmSet('bm_next_lunge_left', ll ? '1' : '0');\n  display_notice('[BM] Queue left lunge ' + (ll ? 'ON' : 'OFF'), 'lightgreen');\n} else if (op === 'lungeright') {\n  var lr = !bmBool('bm_next_lunge_right');\n  bmSet('bm_next_lunge_right', lr ? '1' : '0');\n  display_notice('[BM] Queue right lunge ' + (lr ? 'ON' : 'OFF'), 'lightgreen');\n} else if (op === 'remiss') {\n  var rq = !bmBool('bm_next_remiss');\n  bmSet('bm_next_remiss', rq ? '1' : '0');\n  display_notice('[BM] Queue remiss ' + (rq ? 'ON' : 'OFF') + ' (next volley)', 'lightgreen');\n} else if (op === 'stableft') {\n  var sl = !bmBool('bm_next_stab_left');\n  bmSet('bm_next_stab_left', sl ? '1' : '0');\n  display_notice('[BM] Queue left stab ' + (sl ? 'ON' : 'OFF'), 'lightgreen');\n} else if (op === 'stabright') {\n  var sr = !bmBool('bm_next_stab_right');\n  bmSet('bm_next_stab_right', sr ? '1' : '0');\n  display_notice('[BM] Queue right stab ' + (sr ? 'ON' : 'OFF'), 'lightgreen');\n} else if (op === 'assess') {\n  var ao = !bmBool('bm_xassess');\n  bmSet('bm_xassess', ao ? '1' : '0');\n  display_notice('[BM] xassess ' + (ao ? 'ON' : 'OFF') + ' (can stay on with Assay; assess precedes assay)', 'lightgreen');\n} else if (op === 'assay') {\n  var ay = !bmBool('bm_xassay');\n  bmSet('bm_xassay', ay ? '1' : '0');\n  display_notice('[BM] xassay ' + (ay ? 'ON' : 'OFF') + ' (can stay on with Assess; assess precedes assay)', 'lightgreen');\n} else if (op === 'weakblood') {\n  var swo = !bmBool('bm_weakblood');\n  bmSet('bm_weakblood', swo ? '1' : '0');\n  bmSet('evisc_weakblood', swo ? '1' : '0');\n  display_notice('[BM] Weakblood ' + (swo ? 'ON' : 'OFF') + ' (Alt+base only).', 'lightgreen');\n} else if (op === 'xsmart') {\n  var xs = !bmBool('bm_xsmart');\n  bmSet('bm_xsmart', xs ? '1' : '0');\n  display_notice('[BM] xsmart ' + (xs ? 'ON' : 'OFF') + ' — reroutes if assay parry % is at/over threshold', 'lightgreen');\n} else if (op === 'smart') {\n  var ns = !bmDefOn('bm_def_smart', false);\n  bmSet('bm_def_smart', ns ? '1' : '0');\n  if (bmApplyDefGates()) {\n    display_notice('[BM] Reactive ' + (ns ? 'ON' : 'OFF') + ' — opponent spec when known, else full (not xsmart)', 'lightgreen');\n  }\n} else if (op === 'parry') {\n  var np = !bmDefOn('bm_def_parry', true);\n  bmSet('bm_def_parry', np ? '1' : '0');\n  if (bmApplyDefGates()) {\n    display_notice('[BM] Parry ' + (np ? 'ON' : 'OFF') + (np ? '' : ' — cleared, auto parry stopped'), 'lightgreen');\n  }\n} else if (op === 'stance') {\n  var nst = !bmDefOn('bm_def_stance', true);\n  bmSet('bm_def_stance', nst ? '1' : '0');\n  if (bmApplyDefGates()) {\n    display_notice('[BM] Stance ' + (nst ? 'ON' : 'OFF'), 'lightgreen');\n  }\n} else if (op === 'affs') {\n  var na = !bmDefOn('bm_show_affs', true);\n  bmSet('bm_show_affs', na ? '1' : '0');\n  display_notice('[BM] Affs ' + (na ? 'ON' : 'OFF') + ' — your GMCP afflictions (display only)', 'lightgreen');\n} else if (op === 'tea') {\n  var nextTea = bmTeaCycle();\n  display_notice('[BM] Tea ' + (nextTea === 'blacktea' ? 'Black' : 'Green') + ' — sip when that defence is down', 'lightgreen');\n} else if (op === 'heretic' || op === 'infidel' || op === 'inquisition') {\n  var tgt = String(bmGet('bm_target', '') || '').trim();\n  var chant = 'sm add starchant ' + op + (tgt ? ' ' + tgt : '');\n  send_command(chant, 0);\n  bmSet('bm_brand_last', op);\n  display_notice('[BM] queued ' + chant, 'lightgreen');\n} else if (op === 'fervor') {\n  send_command('sm add starchant fervor', 0);\n  display_notice('[BM] queued sm add starchant fervor', 'lightgreen');\n} else if (op === 'hallowed') {\n  send_command('sm add starchant hallowedground', 0);\n  display_notice('[BM] queued sm add starchant hallowedground', 'lightgreen');\n} else if (op === 'glow') {\n  var glowOn = !bmDefOn('bm_glow_brand', true);\n  bmSet('bm_glow_brand', glowOn ? '1' : '0');\n  display_notice('[BM] Glow brand ' + (glowOn ? 'ON — white-glow line not confirmed; chain armed (bm_brand_last)' : 'OFF — no auto-chain'), 'lightgreen');\n} else if (op === 'infidelplus') {\n  var tPlus = String(bmGet('bm_target', '') || '').trim();\n  var plusCmd = 'sm add starchant infidel with holy light' + (tPlus ? ' ' + tPlus : '');\n  send_command(plusCmd, 0);\n  bmSet('bm_brand_last', 'infidel');\n  display_notice('[BM] queued ' + plusCmd, 'lightgreen');\n} else if (op === 'haymaker') {\n  var tHay = String(bmGet('bm_target', '') || '').trim();\n  if (!tHay) display_notice('[BM] No target for haymaker (bmt <name>).', 'red');\n  else {\n    if (bmBool('bm_bladeshield')) {\n      bmSet('bm_bladeshield', '0');\n      bmSet('bm_bladeshield_gmcp', '0');\n    }\n    send_command('strike ' + tHay + ' haymaker', 0);\n  }\n} else if (op === 'warcry') {\n  send_command('warcry', 0);\n} else if (op === 'armsbless') {\n  send_command('sm add starchant righteousarms bless', 0);\n  display_notice('[BM] queued sm add starchant righteousarms bless', 'lightgreen');\n} else if (op === 'armsrelease') {\n  send_command('sm add starchant righteousarms release', 0);\n  display_notice('[BM] queued sm add starchant righteousarms release', 'lightgreen');\n} else if (op === 'poisonist') {\n  var pz = !bmBool('bm_poisonist');\n  bmSet('bm_poisonist', pz ? '1' : '0');\n  if (pz) {\n    bmSet('bm_poisonist_sent', '0');\n    send_command('combatstyle poisonist', 0);\n    bmSet('bm_poisonist_sent', '1');\n  }\n  display_notice('[BM] Poisonist ' + (pz ? 'ON — combatstyle poisonist on kill volleys; evisc finale stays concentrated' : 'OFF'), 'lightgreen');\n} else if (op === 'beast') {\n  try { run_function('bm_beast', 'toggle', 'BladeMaster Engine'); } catch (eBz) {}\n} else if (op === 'emerald' || op === 'azure' || op === 'golden') {\n  var boxId = String(bmGet('bm_box_' + op, '') || '').trim();\n  if (!boxId) {\n    display_notice('[BM] No ' + op + ' box id — auto-Find if needed; click again after the scan.', 'yellow');\n    try { run_function('bm_findgear', 'maybeauto', 'BladeMaster Engine'); } catch (eBox) {}\n  } else {\n    send_command('sm add crank ' + boxId, 0);\n    display_notice('[BM] queued sm add crank ' + boxId, 'lightgreen');\n  }\n} else if (op === 'bastard') {\n  var useB = !bmBool('bm_use_bastard');\n  bmSet('bm_use_bastard', useB ? '1' : '0');\n  display_notice('[BM] Bastard ' + (useB ? 'ON — finder may save psnmbid; open-style may draw bastard' : 'OFF — skip 2H hunt and draw bastard'), 'lightgreen');\n} else if (op === 'findgear' || op === 'find') {\n  try { run_function('bm_findgear', 'start', 'BladeMaster Engine'); } catch (eFg) {}\n} else if (op === 'shield' || op.indexOf('shield|') === 0) {\n  var who = 'me';\n  if (op.indexOf('|') >= 0) who = String(op.split('|').slice(1).join('|') || '').trim();\n  if (!who || who === 'me') who = 'me';\n  send_command('bladeshield ' + who, 0);\n  bmSet('bm_bladeshield', '1');\n  display_notice('[BM] bladeshield ' + who + ' — kill/auto-evisc/haymaker paused until you strike or the defence drops', 'lightgreen');\n} else if (op === 'impede') {\n  var tImp = String(bmGet('bm_target', '') || '').trim();\n  if (!tImp) display_notice('[BM] No target for impede (bmt <name>).', 'red');\n  else send_command('impede ' + tImp, 0);\n} else if (op === 'clickbase' || op === 'clicklunge' || op === 'clicklight' || op === 'clickheavy' || op === 'clickstab' || op === 'clickcrit') {\n  var cmap = { clickbase: 'base', clicklunge: 'lunge', clicklight: 'light', clickheavy: 'heavy', clickstab: 'stab', clickcrit: 'crit' };\n  bmSet('bm_click_mod', cmap[op]);\n} else if (op === 'hithead' || op === 'hitchest' || op === 'hitgut' || op === 'hitlarm' || op === 'hitrarm' || op === 'hitlleg' || op === 'hitrleg') {\n  var hmap = { hithead: 'head', hitchest: 'chest', hitgut: 'gut', hitlarm: 'larm', hitrarm: 'rarm', hitlleg: 'lleg', hitrleg: 'rleg' };\n  var hitBody = hmap[op];\n  var hitMod = String(bmGet('bm_click_mod', 'base') || 'base').toLowerCase();\n  var hitTier = 'base';\n  var hitLun = '0';\n  if (hitMod === 'lunge') hitLun = '1';\n  else if (hitMod === 'light' || hitMod === 'heavy' || hitMod === 'stab' || hitMod === 'crit') hitTier = hitMod;\n  try { run_function('bm_core', hitBody + '|' + hitTier + '|' + hitLun, 'BladeMaster Engine'); } catch (eHit) {}\n} else if (op === 'specbm' || op === 'specpb' || op === 'specbc' || op === 'specal' || op === 'speccv' || op === 'specmk' || op === 'specmg' || op === 'specbd') {\n  try { run_function('bm_intel', op, 'BladeMaster Engine'); } catch (eSp) {}\n}\n\ntry { run_function('bm_tabs', '', 'BladeMaster Engine'); } catch (eT) {}\n"},{"type":"function","name":"bm_beast","enabled":true,"id":11,"code":"function bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\n\nfunction bmBeastPoison() {\n  return String(bmGet('bm_beast_poison', '') || '').replace(/^\\s+|\\s+$/g, '');\n}\nfunction bmBeastBalReady() {\n  var b;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Vitals && GMCP.Char.Vitals.beastbal != null) {\n      b = GMCP.Char.Vitals.beastbal;\n      if (b === 1 || b === true || b === '1') return true;\n      if (b === 0 || b === false || b === '0') return false;\n    }\n  } catch (eG) {}\n  try {\n    if (typeof client !== 'undefined' && client.bm_vitals && client.bm_vitals.beastbal != null) {\n      b = client.bm_vitals.beastbal;\n      if (b === 1 || b === true || b === '1') return true;\n      if (b === 0 || b === false || b === '0') return false;\n    }\n  } catch (eC) {}\n  try {\n    b = get_variable('my_beastbal');\n    if (b === 1 || b === true || b === '1') return true;\n  } catch (eM) {}\n  return false;\n}\nfunction bmBeastEviscBusy() {\n  try { if (client.evisc && client.evisc.isExecuting) return true; } catch (eE) {}\n  return false;\n}\nfunction bmBeastExpireWindow() {\n  var until = parseFloat(bmGet('bm_beast_heavy_until', '0')) || 0;\n  if (until && Date.now() >= until) {\n    bmSet('bm_beast_heavy_until', '0');\n    bmSet('bm_beast_hold', '1');\n  }\n}\nfunction bmBeastResetFight() {\n  bmSet('bm_beast_hold', '0');\n  bmSet('bm_beast_heavy_until', '0');\n  bmSet('bm_beast_evisc_wait', '0');\n}\nfunction bmBeastRequestLoad() {\n  var p = bmBeastPoison();\n  if (!p) {\n    display_notice('[BM] Beast: set a poison with xbeastpoison <name> first.', 'yellow');\n    return false;\n  }\n  send_command('beast order purge', 0);\n  bmSet('bm_beast_loaded', '0');\n  bmSet('bm_beast_need_drink', '1');\n  bmSet('bm_beast_saw_unready', bmBeastBalReady() ? '0' : '1');\n  return true;\n}\nfunction bmBeastTryDrink() {\n  if (!bmBool('bm_beast') || !bmBool('bm_beast_need_drink')) return;\n  var p = bmBeastPoison();\n  if (!p) {\n    bmSet('bm_beast_need_drink', '0');\n    return;\n  }\n  if (!bmBeastBalReady()) {\n    bmSet('bm_beast_saw_unready', '1');\n    return;\n  }\n  if (!bmBool('bm_beast_saw_unready')) return;\n  send_command('beast order drink ' + p, 0);\n  bmSet('bm_beast_need_drink', '0');\n  bmSet('bm_beast_saw_unready', '0');\n  bmSet('bm_beast_loaded', '1');\n}\nfunction bmBeastCanSpit() {\n  if (!bmBool('bm_beast')) return false;\n  if (!bmBeastPoison()) return false;\n  if (bmBool('bm_beast_need_drink')) return false;\n  bmBeastExpireWindow();\n  if (bmBool('bm_beast_hold')) return false;\n  if (bmBeastEviscBusy()) return false;\n  if (String(bmGet('bm_beast_evisc_wait', '') || '').replace(/^\\s+|\\s+$/g, '')) return false;\n  if (!bmBeastBalReady()) return false;\n  return true;\n}\nfunction bmBeastMaybeSpit() {\n  var tgt = String(bmGet('bm_target', '') || '').replace(/^\\s+|\\s+$/g, '');\n  if (!tgt) return false;\n  if (!bmBeastCanSpit()) return false;\n  send_command('beast order spit ' + tgt, 0);\n  var until = parseFloat(bmGet('bm_beast_heavy_until', '0')) || 0;\n  if (until && Date.now() < until) {\n    bmSet('bm_beast_heavy_until', '0');\n    bmSet('bm_beast_hold', '1');\n  }\n  return true;\n}\nfunction bmBeastOnWound(part, state) {\n  if (!bmBool('bm_beast')) return;\n  part = String(part || '').toLowerCase();\n  state = String(state || '').toLowerCase();\n  if (state === 'critical' && (part === 'chest' || part === 'gut')) {\n    bmSet('bm_beast_heavy_until', '0');\n    bmSet('bm_beast_hold', '1');\n    return;\n  }\n  if (state !== 'heavy') return;\n  var kill = String(bmGet('bm_kill_limb', 'chest') || 'chest').toLowerCase();\n  if (kill !== 'chest' && kill !== 'gut') kill = 'chest';\n  if (part !== kill) return;\n  if (bmBool('bm_beast_hold')) return;\n  var until = parseFloat(bmGet('bm_beast_heavy_until', '0')) || 0;\n  if (until && Date.now() < until) return;\n  bmSet('bm_beast_heavy_until', String(Date.now() + 7000));\n}\nfunction bmBeastLaunchEvisc(eviscOp) {\n  eviscOp = String(eviscOp || 'start').toLowerCase();\n  if (eviscOp !== 'start2') eviscOp = 'start';\n  bmSet('bm_beast_evisc_wait', '0');\n  bmSet('bm_beast_hold', '1');\n  try { run_function('evisc_main', eviscOp, 'BladeMaster Engine'); } catch (eX) {}\n}\nfunction bmBeastGateEvisc(eviscOp) {\n  eviscOp = String(eviscOp || 'start').toLowerCase();\n  if (eviscOp !== 'start2') eviscOp = 'start';\n  if (!bmBool('bm_beast')) {\n    try { run_function('evisc_main', eviscOp, 'BladeMaster Engine'); } catch (eOff) {}\n    return;\n  }\n  if (bmBeastEviscBusy()) return;\n  if (bmBeastBalReady()) {\n    bmBeastLaunchEvisc(eviscOp);\n    return;\n  }\n  bmSet('bm_beast_evisc_wait', eviscOp);\n  bmSet('bm_beast_hold', '1');\n  display_notice('[BM] Beast: waiting for beastbal before xevisc.', 'yellow');\n}\nfunction bmBeastOnVitals() {\n  bmBeastExpireWindow();\n  bmBeastTryDrink();\n  var wait = String(bmGet('bm_beast_evisc_wait', '') || '').replace(/^\\s+|\\s+$/g, '');\n  if (wait && bmBool('bm_beast') && bmBeastBalReady()) {\n    bmBeastLaunchEvisc(wait);\n  }\n}\nfunction bmBeastToggle() {\n  var on = !bmBool('bm_beast');\n  bmSet('bm_beast', on ? '1' : '0');\n  if (on) {\n    var p = bmBeastPoison();\n    if (!p) {\n      display_notice('[BM] Beast ON — set a poison with xbeastpoison <name> (no drink until set).', 'yellow');\n    } else if (bmBeastRequestLoad()) {\n      display_notice('[BM] Beast ON — purge, then drink ' + p + ' on next beastbal. Spit on volleys.', 'lightgreen');\n    }\n  } else {\n    var pending = String(bmGet('bm_beast_evisc_wait', '') || '').replace(/^\\s+|\\s+$/g, '');\n    bmSet('bm_beast_need_drink', '0');\n    bmSet('bm_beast_saw_unready', '0');\n    bmSet('bm_beast_hold', '0');\n    bmSet('bm_beast_heavy_until', '0');\n    bmSet('bm_beast_evisc_wait', '0');\n    if (pending) {\n      try { run_function('evisc_main', pending, 'BladeMaster Engine'); } catch (eP) {}\n    }\n    display_notice('[BM] Beast OFF', 'cyan');\n  }\n}\nfunction bmBeastSetPoison(name) {\n  name = String(name || '').replace(/^\\s+|\\s+$/g, '');\n  if (!name) {\n    var cur = bmBeastPoison();\n    display_notice('[BM] Usage: xbeastpoison <name> — purge, then drink on next beastbal. Current: ' + (cur || '(none)'), 'yellow');\n    return;\n  }\n  var prev = bmBeastPoison();\n  bmSet('bm_beast_poison', name);\n  if (!bmBool('bm_beast')) {\n    display_notice('[BM] Beast poison: ' + name + ' (drink when Beast is on).', 'lightgreen');\n    return;\n  }\n  if (prev.toLowerCase() === name.toLowerCase() && bmBool('bm_beast_loaded') && !bmBool('bm_beast_need_drink')) {\n    display_notice('[BM] Beast poison already ' + name + '.', 'cyan');\n    return;\n  }\n  if (bmBeastRequestLoad()) {\n    display_notice('[BM] Beast poison: ' + name + ' — purge, then drink on next beastbal.', 'lightgreen');\n  }\n}\n\nvar raw = '';\nif (typeof args === 'string') raw = args;\nelse if (args && typeof args === 'object' && args[0] != null) raw = String(args[0]);\nelse if (args != null) raw = String(args);\nraw = String(raw || '').replace(/^\\s+|\\s+$/g, '');\nvar op = raw.toLowerCase();\nvar rest = '';\nvar bar = raw.indexOf('|');\nif (bar >= 0) {\n  op = raw.slice(0, bar).toLowerCase();\n  rest = raw.slice(bar + 1);\n}\n\nif (op === 'spit') bmBeastMaybeSpit();\nelse if (op === 'vitals') bmBeastOnVitals();\nelse if (op === 'toggle') bmBeastToggle();\nelse if (op === 'poison') bmBeastSetPoison(rest);\nelse if (op === 'wound') {\n  var bits = String(rest || '').split('|');\n  bmBeastOnWound(bits[0], bits[1]);\n}\nelse if (op === 'evisc') bmBeastGateEvisc(rest);\nelse if (op === 'reset') bmBeastResetFight();\n"},{"type":"function","name":"bm_survive","enabled":true,"id":12,"code":"function bmEngineOn() {\n  var v = get_variable('bm_engine');\n  if (v === undefined || v === null || v === '') return true;\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmSurviveStore() {\n  try {\n    if (typeof client === 'undefined' || !client) return { last: {}, critUp: {}, critNeed: {} };\n    if (!client._bmSurvive) client._bmSurvive = { last: {}, critUp: {}, critNeed: {} };\n    if (!client._bmSurvive.last) client._bmSurvive.last = {};\n    if (!client._bmSurvive.critUp) client._bmSurvive.critUp = {};\n    if (!client._bmSurvive.critNeed) client._bmSurvive.critNeed = {};\n    return client._bmSurvive;\n  } catch (eS) {\n    return { last: {}, critUp: {}, critNeed: {} };\n  }\n}\nfunction bmSurviveAffNames() {\n  var names = null;\n  try {\n    if (typeof client !== 'undefined' && client && client.bm_aff_list && Object.prototype.toString.call(client.bm_aff_list) === '[object Array]') {\n      names = client.bm_aff_list;\n    }\n  } catch (eA) {}\n  if (!names || !names.length) {\n    try {\n      var raw = get_variable('bm_aff_json');\n      if (raw) names = JSON.parse(raw);\n    } catch (eJ) {}\n  }\n  if (!names || !names.length) {\n    try {\n      var list = null;\n      if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Afflictions) {\n        list = GMCP.Char.Afflictions.List || GMCP.Char.Afflictions;\n      } else if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Afflictions) {\n        list = gmcp.Char.Afflictions.List || gmcp.Char.Afflictions;\n      }\n      if (list && typeof list.length === 'number') {\n        names = [];\n        var seen = {}, i, item, n;\n        for (i = 0; i < list.length; i++) {\n          item = list[i];\n          n = (typeof item === 'string') ? item : (item && item.name);\n          n = String(n || '').toLowerCase();\n          if (!n || seen[n]) continue;\n          seen[n] = true;\n          names.push(n);\n        }\n      }\n    } catch (eG) {}\n  }\n  return names || [];\n}\nfunction bmSurviveAffSet() {\n  var names = bmSurviveAffNames();\n  var set = {}, i, n;\n  for (i = 0; i < names.length; i++) {\n    n = String(names[i] || '').toLowerCase();\n    if (n) set[n] = true;\n  }\n  return set;\n}\nfunction bmSurviveHasAff(affs, key) {\n  return !!affs[String(key || '').toLowerCase()];\n}\nfunction bmSurviveHasAny(affs, keys) {\n  var i;\n  for (i = 0; i < keys.length; i++) {\n    if (bmSurviveHasAff(affs, keys[i])) return true;\n  }\n  return false;\n}\nfunction bmSurviveVital(field) {\n  var v = null;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Vitals && GMCP.Char.Vitals[field] != null) {\n      v = GMCP.Char.Vitals[field];\n    }\n  } catch (eG) {}\n  if (v == null) {\n    try {\n      if (typeof client !== 'undefined' && client && client.bm_vitals && client.bm_vitals[field] != null) {\n        v = client.bm_vitals[field];\n      }\n    } catch (eC) {}\n  }\n  if (v == null) {\n    try {\n      if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Vitals && gmcp.Char.Vitals[field] != null) {\n        v = gmcp.Char.Vitals[field];\n      }\n    } catch (eG2) {}\n  }\n  return v;\n}\nfunction bmSurviveBalReady(field) {\n  if (!field) return true;\n  var v = bmSurviveVital(field);\n  if (v == null || v === '') return true;\n  if (v === 1 || v === true || v === '1') return true;\n  if (v === 0 || v === false || v === '0') return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on';\n}\nfunction bmSurviveCooldownOk(id, sec) {\n  var last = parseFloat(bmSurviveStore().last[id] || 0) || 0;\n  return !last || (Date.now() - last) >= ((sec || 1.2) * 1000);\n}\nfunction bmSurviveTry(id, cmd, bal, sec) {\n  if (!bmEngineOn()) return false;\n  if (!bmSurviveCooldownOk(id, sec)) return false;\n  if (!bmSurviveBalReady(bal)) return true;\n  send_command(cmd, 0);\n  try { bmSurviveStore().last[id] = Date.now(); } catch (eL) {}\n  return true;\n}\nvar SLUSH_AFFS = ['asthma', 'nausea', 'squelched', 'sensitivity', 'clumsiness', 'healthleech', 'powerleech', 'vertigo', 'epilepsy'];\nvar WRITHE_AFFS = ['entangled', 'impaled', 'transfixed', 'grapple', 'crucified'];\nvar SLEEP_AFFS = ['sleep', 'asleep'];\nvar CONC_AFFS = ['confusion', 'disrupted'];\nvar CRIT_DEFS = [\n  { id: 'sixthsense', names: ['sixthsense', 'sixth sense'], cmd: 'sixthsense', bal: 'dust' },\n  { id: 'truehearing', names: ['truehearing', 'true hearing'], cmd: 'truehearing', bal: 'steam' },\n  { id: 'insomnia', names: ['insomnia'], cmd: 'insomnia', bal: 'dust' },\n  { id: 'metawake', names: ['metawake', 'metawake on'], cmd: 'metawake on', bal: 'equilibrium' },\n  { id: 'consciousness', names: ['consciousness', 'consciousness on'], cmd: 'consciousness on', bal: 'equilibrium' },\n  { id: 'immunity', names: ['immunity'], cmd: 'immunity', bal: 'equilibrium' },\n  { id: 'kafe', names: ['kafe', 'eat kafe'], cmd: 'eat kafe', bal: 'balance' }\n];\nfunction bmSurviveDefName(item) {\n  if (item == null) return '';\n  if (typeof item === 'string') return String(item).toLowerCase();\n  return String(item.name || item.defence || item.Name || '').toLowerCase();\n}\nfunction bmSurviveNamesFromPayload(payload) {\n  var names = [];\n  if (typeof payload === 'string') names.push(String(payload).toLowerCase());\n  else if (payload && typeof payload.length === 'number') {\n    var i, n;\n    for (i = 0; i < payload.length; i++) {\n      n = bmSurviveDefName(payload[i]);\n      if (n) names.push(n);\n    }\n  } else if (payload) {\n    var one = bmSurviveDefName(payload);\n    if (one) names.push(one);\n  }\n  return names;\n}\nfunction bmSurviveCritIdFromName(name) {\n  name = String(name || '').toLowerCase();\n  if (!name) return '';\n  var i, j, spec, n;\n  for (i = 0; i < CRIT_DEFS.length; i++) {\n    spec = CRIT_DEFS[i];\n    for (j = 0; j < spec.names.length; j++) {\n      n = spec.names[j];\n      if (name === n || name.indexOf(n) >= 0 || n.indexOf(name) >= 0) return spec.id;\n    }\n  }\n  return '';\n}\nfunction bmSurviveGmcpDefs() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences) return GMCP.Char.Defences;\n  } catch (eG) {}\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Defences) return gmcp.Char.Defences;\n  } catch (eG2) {}\n  return null;\n}\nfunction bmSurviveReadDefList() {\n  var defs = bmSurviveGmcpDefs();\n  var list = null;\n  if (defs) list = defs.List || defs;\n  if (!list || typeof list.length !== 'number') return null;\n  return list;\n}\nfunction bmSurviveListHasCrit(list, spec) {\n  if (!list || typeof list.length !== 'number') return false;\n  var i, n, j;\n  for (i = 0; i < list.length; i++) {\n    n = bmSurviveDefName(list[i]);\n    if (!n) continue;\n    for (j = 0; j < spec.names.length; j++) {\n      if (n === spec.names[j] || n.indexOf(spec.names[j]) >= 0) return true;\n    }\n  }\n  return false;\n}\nfunction bmSurviveMarkCritUp(id, up) {\n  var st = bmSurviveStore();\n  st.critUp[id] = !!up;\n  if (up) delete st.critNeed[id];\n}\nfunction bmSurviveNeedCrit(id) {\n  var st = bmSurviveStore();\n  st.critUp[id] = false;\n  if (bmEngineOn()) st.critNeed[id] = true;\n}\nfunction bmSurviveHandleDefs(meth) {\n  var defs = bmSurviveGmcpDefs();\n  var mlow = String(meth || '').toLowerCase();\n  var st = bmSurviveStore();\n  var i, spec, id;\n  if (mlow.indexOf('remove') >= 0) {\n    var rem = defs && defs.Remove != null ? defs.Remove : null;\n    var lost = bmSurviveNamesFromPayload(rem);\n    for (i = 0; i < lost.length; i++) {\n      id = bmSurviveCritIdFromName(lost[i]);\n      if (id) bmSurviveNeedCrit(id);\n    }\n    return;\n  }\n  if (mlow.indexOf('add') >= 0) {\n    var add = defs && defs.Add != null ? defs.Add : null;\n    var gained = bmSurviveNamesFromPayload(add);\n    for (i = 0; i < gained.length; i++) {\n      id = bmSurviveCritIdFromName(gained[i]);\n      if (id) bmSurviveMarkCritUp(id, true);\n    }\n    return;\n  }\n  var list = bmSurviveReadDefList();\n  if (!list) return;\n  var hadSnap = false;\n  for (i = 0; i < CRIT_DEFS.length; i++) {\n    if (st.critUp[CRIT_DEFS[i].id]) { hadSnap = true; break; }\n  }\n  for (i = 0; i < CRIT_DEFS.length; i++) {\n    spec = CRIT_DEFS[i];\n    var nowUp = bmSurviveListHasCrit(list, spec);\n    if (hadSnap && st.critUp[spec.id] && !nowUp) bmSurviveNeedCrit(spec.id);\n    else if (nowUp) bmSurviveMarkCritUp(spec.id, true);\n    else st.critUp[spec.id] = false;\n  }\n}\nfunction bmSurviveTickResponders() {\n  if (!bmEngineOn()) return false;\n  var affs = bmSurviveAffSet();\n  if (bmSurviveHasAny(affs, WRITHE_AFFS)) {\n    if (bmSurviveTry('writhe', 'writhe', 'balance', 1.2)) return true;\n  }\n  if (bmSurviveHasAny(affs, SLEEP_AFFS)) {\n    if (bmSurviveTry('wake', 'wake', 'balance', 1.2)) return true;\n  }\n  if (bmSurviveHasAff(affs, 'sprawled')) {\n    if (bmSurviveTry('stand', 'stand', 'balance', 1.2)) return true;\n  }\n  if (bmSurviveHasAff(affs, 'anorexia')) {\n    if (bmSurviveTry('blocker_anox', 'sip slush', 'dust', 1.5)) return true;\n  }\n  if (bmSurviveHasAff(affs, 'jinx') && bmSurviveHasAny(affs, SLUSH_AFFS)) {\n    if (bmSurviveTry('blocker_anox', 'sip slush', 'dust', 1.5)) return true;\n  }\n  if (bmSurviveHasAff(affs, 'slickness')) {\n    if (bmSurviveBalReady('steam')) {\n      if (bmSurviveTry('blocker_slck', 'smoke steam', 'steam', 1.5)) return true;\n    } else if (bmSurviveTry('scrub', 'scrub', 'balance', 1.5)) {\n      return true;\n    }\n  }\n  if (bmSurviveHasAny(affs, CONC_AFFS)) {\n    if (bmSurviveTry('concentrate', 'concentrate', 'equilibrium', 1.2)) return true;\n  }\n  if (bmSurviveHasAff(affs, 'mucus')) {\n    if (bmSurviveTry('scrub', 'scrub', 'balance', 1.5)) return true;\n  }\n  if (bmBool('bm_survive_sap') && bmSurviveHasAff(affs, 'sap')) {\n    if (bmSurviveTry('scrub_sap', 'scrub', 'balance', 1.5)) return true;\n  }\n  if (bmBool('bm_survive_stench') && bmSurviveHasAff(affs, 'stench')) {\n    if (bmSurviveTry('scrub_stench', 'scrub', 'balance', 1.5)) return true;\n  }\n  return false;\n}\nfunction bmSurviveTickCrit() {\n  if (!bmEngineOn()) return false;\n  var st = bmSurviveStore();\n  var i, spec;\n  for (i = 0; i < CRIT_DEFS.length; i++) {\n    spec = CRIT_DEFS[i];\n    if (!st.critNeed[spec.id]) continue;\n    if (st.critUp[spec.id]) {\n      delete st.critNeed[spec.id];\n      continue;\n    }\n    if (bmSurviveTry('crit_' + spec.id, spec.cmd, spec.bal, 1.5)) return true;\n  }\n  return false;\n}\n\nvar meth = '';\nif (typeof args === 'string') meth = args;\nelse if (args && typeof args === 'object') {\n  if (args.gmcp_method != null) meth = String(args.gmcp_method);\n  else if (args[0] != null) meth = String(args[0]);\n} else if (args != null) meth = String(args);\nmeth = String(meth || '');\nif (meth.toLowerCase().indexOf('defence') >= 0) bmSurviveHandleDefs(meth);\nif (!bmSurviveTickResponders()) bmSurviveTickCrit();\n"},{"type":"function","name":"bm_try_auto_evisc","enabled":true,"id":13,"code":"function bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nfunction autoOn() {\n  var raw = get_variable('bm_auto_evisc');\n  if (raw === undefined || raw === null || raw === '') return true;\n  return bmBool('bm_auto_evisc');\n}\nfunction woundWord(limb) {\n  return String(bmGet('bm_w_' + limb, '') || '').toLowerCase();\n}\nfunction isCrit(limb) { return woundWord(limb) === 'critical'; }\nfunction lightMod(vital) {\n  if (vital === 'gut') return 'disembowel';\n  return 'puncturechest';\n}\nvar source = '';\nif (typeof args === 'string') source = args;\nelse if (args && typeof args === 'object' && args[0] != null) source = String(args[0]);\nelse if (args != null) source = String(args);\nsource = String(source || '').trim().toLowerCase();\n\nif ((String(bmGet('bm_role', 'killer') || 'killer').toLowerCase() === 'support' || (String(bmGet('bm_assist_spec', 'off') || 'off').toLowerCase() !== 'off')) && source !== 'manual' && source !== 'toggle' && source !== 'show') return;\n\nfunction bmEngineOn() {\n  var v = get_variable('bm_engine');\n  if (v === undefined || v === null || v === '') return true;\n  return bmBool('bm_engine');\n}\n\nif (source === 'toggle') {\n  var on = !autoOn();\n  bmSet('bm_auto_evisc', on ? '1' : '0');\n  display_notice('[BM] Auto evisc ' + (on ? 'ON' : 'OFF') + ' (C! chest/gut → xevisc; default ON)', 'lightgreen');\n  return;\n}\nif (source === 'show') {\n  display_notice('[BM] Auto evisc ' + (autoOn() ? 'ON' : 'OFF') + ' — fires on critical chest/gut (KillMode optional)', 'lightgreen');\n  return;\n}\nif (!bmEngineOn()) return;\nif (bmBool('bm_bladeshield')) return;\n\nfunction tgtName() {\n  return String(bmGet('bm_target', '') || '').trim();\n}\nfunction tgtKeyOf(t) {\n  return String(t || '').toLowerCase();\n}\nfunction bmPresenceNameMatches(name, targetName) {\n  if (!targetName) return false;\n  var s = String(name || '').replace(/^\\s+|\\s+$/g, '').toLowerCase()\n    .replace(/^the\\s+/, '').replace(/^an?\\s+/, '');\n  var t = String(targetName || '').replace(/^\\s+|\\s+$/g, '').toLowerCase();\n  if (!s || !t) return false;\n  return s === t || s.indexOf(t) >= 0 || t.indexOf(s) >= 0;\n}\nfunction bmPlayerNameFromGmcpEntry(p) {\n  if (typeof p === 'string') return p;\n  if (!p || typeof p !== 'object') return '';\n  if (typeof p.name === 'string') return p.name;\n  if (p.name && typeof p.name === 'object' && typeof p.name.name === 'string') return p.name.name;\n  if (p[0] != null) return String(p[0]);\n  return '';\n}\nfunction bmGmcpRoot() {\n  try { if (typeof GMCP !== 'undefined' && GMCP) return GMCP; } catch (e1) {}\n  try { if (typeof gmcp !== 'undefined' && gmcp) return gmcp; } catch (e2) {}\n  try { if (typeof client !== 'undefined' && client && client.gmcp) return client.gmcp; } catch (e3) {}\n  return null;\n}\nfunction bmMobRoomListAvailable() {\n  var g = bmGmcpRoot();\n  if (!g) return false;\n  try {\n    if (g.Char && g.Char.Items && g.Char.Items.List) {\n      var list = g.Char.Items.List;\n      if (String(list.location || '') === 'room' && list.items && typeof list.items.length === 'number') return true;\n    }\n  } catch (eL) {}\n  try {\n    if (g.Room) {\n      if (g.Room.Mobs && typeof g.Room.Mobs === 'object') return true;\n      if (g.Room.Monsters && typeof g.Room.Monsters === 'object') return true;\n      if (g.Room.Info && g.Room.Info.mobs && typeof g.Room.Info.mobs === 'object') return true;\n    }\n  } catch (eR) {}\n  return false;\n}\nfunction bmMobTargetInRoom(tgt) {\n  var g = bmGmcpRoot();\n  if (!g) return false;\n  try {\n    if (g.Char && g.Char.Items && g.Char.Items.List) {\n      var list = g.Char.Items.List;\n      if (String(list.location || '') === 'room' && list.items && typeof list.items.length === 'number') {\n        var i, item, attrib, first;\n        for (i = 0; i < list.items.length; i++) {\n          item = list.items[i];\n          if (!item || !item.name || item.attrib == null) continue;\n          attrib = String(item.attrib);\n          first = attrib.charAt(0).toLowerCase();\n          if (first.indexOf('m') < 0) continue;\n          if (attrib.indexOf('d') >= 0 || attrib.indexOf('x') >= 0) continue;\n          if (item.icon === 'pet' || item.icon === 'guard') continue;\n          if (bmPresenceNameMatches(String(item.name), tgt)) return true;\n        }\n      }\n    }\n  } catch (eI) {}\n  try {\n    if (g.Room) {\n      var sources = [g.Room.Mobs, g.Room.Info && g.Room.Info.mobs, g.Room.Monsters];\n      var si, arr, j, v, raw;\n      for (si = 0; si < sources.length; si++) {\n        arr = sources[si];\n        if (!arr || typeof arr !== 'object' || typeof arr.length !== 'number') continue;\n        for (j = 0; j < arr.length; j++) {\n          v = arr[j];\n          raw = (v && typeof v === 'object') ? (v.name || v[0]) : v;\n          if (raw && bmPresenceNameMatches(String(raw), tgt)) return true;\n        }\n      }\n    }\n  } catch (eM) {}\n  return false;\n}\nfunction bmIsTargetInRoom() {\n  var tgt = tgtName();\n  if (!tgt) return false;\n  var g = bmGmcpRoot();\n  try {\n    if (g && g.Room && g.Room.Players && typeof g.Room.Players.length === 'number') {\n      var i, n;\n      for (i = 0; i < g.Room.Players.length; i++) {\n        n = bmPlayerNameFromGmcpEntry(g.Room.Players[i]);\n        if (n && bmPresenceNameMatches(n, tgt)) return true;\n      }\n    }\n  } catch (eP) {}\n  if (bmMobRoomListAvailable() && bmMobTargetInRoom(tgt)) return true;\n  return false;\n}\nfunction bmKillModeTargetOk() {\n  var tgt = tgtName();\n  if (!tgt) return false;\n  return bmIsTargetInRoom();\n}\nfunction eviscRunning() {\n  try { if (client.evisc && client.evisc.isExecuting) return true; } catch (eR) {}\n  return false;\n}\nfunction markDebounce(key) {\n  bmSet('bm_auto_evisc_last', String(Date.now()));\n  bmSet('bm_auto_evisc_last_tgt', key);\n}\nfunction syncEviscPoisons() {\n  if (!bmBool('bm_smart_poison')) return;\n  try { run_function('bm_sync_wep_poison', '', 'BladeMaster Engine'); } catch (eSp) {}\n}\nfunction startEvisc(label) {\n  var t = tgtName();\n  if (!t) return false;\n  if (eviscRunning()) return false;\n  bmSet('bm_pre_evisc_await', '0');\n  markDebounce(tgtKeyOf(t));\n  syncEviscPoisons();\n  display_notice('[BM] ' + (label || 'Auto evisc') + ' — launching xevisc.', 'orange');\n  try { run_function('bm_beast', 'evisc|start', 'BladeMaster Engine'); } catch (eX) {}\n  try { run_function('bm_tabs', '', 'BladeMaster Engine'); } catch (eT) {}\n  return true;\n}\nfunction pickVital() {\n  if (source.indexOf('gut') >= 0) return 'gut';\n  if (source.indexOf('chest') >= 0) return 'chest';\n  if (isCrit('chest')) return 'chest';\n  if (isCrit('gut')) return 'gut';\n  return 'chest';\n}\nfunction sendBladeQueue(t, vital) {\n  var mod = lightMod(vital);\n  var left = 'strike ' + t + ' left ' + vital + ' ' + mod;\n  var right = 'strike ' + t + ' right ' + vital + ' ' + mod;\n  send_command(['sm clear', 'sm add starchant blade', 'sm add arm ' + left, 'sm add arm ' + right].join(';;'), 0);\n}\n\nfunction critLatchFresh() {\n  var t = parseFloat(bmGet('bm_w_crit_latch', '0')) || 0;\n  if (!t) return false;\n  return (Date.now() - t) <= 8000;\n}\nif (source === 'balance') {\n  if (bmBool('bm_pre_evisc_await') && critLatchFresh()) startEvisc('Blade');\n  else if (bmBool('bm_pre_evisc_await') && !critLatchFresh()) bmSet('bm_pre_evisc_await', '0');\n  return;\n}\n\nvar force = (source === 'killmode');\nif (force && !critLatchFresh()) {\n  if (bmBool('bm_pre_evisc_await')) bmSet('bm_pre_evisc_await', '0');\n  return;\n}\nif (!force && !autoOn()) return;\nif (!source || (source !== 'killmode' && source.indexOf('crit') < 0 && source.indexOf('track') < 0)) return;\n\nvar tgt = tgtName();\nif (!tgt) return;\nif (eviscRunning()) return;\n\nvar key = tgtKeyOf(tgt);\nvar now = Date.now();\nvar lastT = String(bmGet('bm_auto_evisc_last_tgt', '') || '');\nvar lastTm = parseFloat(bmGet('bm_auto_evisc_last', '0')) || 0;\nif (lastT === key && lastTm && (now - lastTm) < 2000) return;\n\nif (bmBool('bm_pre_evisc_await')) return;\n\nif (bmBool('bm_pre_evisc_blade') && String(bmGet('bm_pre_evisc_blade_fired', '') || '').toLowerCase() !== key) {\n  var vital = pickVital();\n  sendBladeQueue(tgt, vital);\n  bmSet('bm_pre_evisc_blade_fired', key);\n  bmSet('bm_pre_evisc_await', '1');\n  markDebounce(key);\n  syncEviscPoisons();\n  display_notice('[BM] Blade: starchant + light wounds on ' + vital + ' — evisc next balance.', 'orange');\n  try { run_function('bm_tabs', '', 'BladeMaster Engine'); } catch (eTb) {}\n  return;\n}\n\nstartEvisc(force ? 'Kill mode C!' : 'Auto evisc');\n"},{"type":"function","name":"bm_glow","enabled":true,"id":14,"code":"function bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmDefOn(k, fallbackOn) {\n  var raw = get_variable(k);\n  if (raw === undefined || raw === null || raw === '') return !!fallbackOn;\n  return bmBool(k);\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nvar op = '';\nif (typeof args === 'string') op = args;\nelse if (args && typeof args === 'object' && args[0] != null) op = String(args[0]);\nelse if (args != null) op = String(args);\nop = String(op || '').trim().toLowerCase();\nfunction bmEngineOn() {\n  var v = get_variable('bm_engine');\n  if (v === undefined || v === null || v === '') return true;\n  return bmBool('bm_engine');\n}\nif (op !== 'debug' && op !== 'suspect' && !bmEngineOn()) return;\nif (op === 'debug' || op === 'suspect') {\n  var line = '';\n  try {\n    if (typeof args === 'object' && args && args.text) line = String(args.text);\n    else if (typeof args === 'object' && args && args[1]) line = String(args[1]);\n  } catch (eL) {}\n  line = String(line || '');\n  if (!line || /lies here/i.test(line)) return;\n  if (bmDefOn('bm_glow_brand', true) && !bmBool('bm_glow_noted')) {\n    bmSet('bm_glow_noted', '1');\n    display_notice('[BM] Glow line unconfirmed (debug, chain not sent): ' + line, 'yellow');\n    display_notice('[BM] Paste this line to enable the glow trigger. State machine is ready (bm_brand_last).', 'yellow');\n  }\n  return;\n}\nif (!bmDefOn('bm_glow_brand', true)) return;\nvar tgt = String(bmGet('bm_target', '') || '').trim();\nif (!tgt) return;\nvar now = Date.now();\nvar last = parseFloat(bmGet('bm_glow_last', '0')) || 0;\nif (last && (now - last) < 2000) return;\nvar brand = String(bmGet('bm_brand_last', '') || '').toLowerCase();\nif (brand === 'inquisition') return;\nbmSet('bm_glow_last', String(now));\nif (brand === 'infidel') {\n  send_command('sm add starchant inquisition ' + tgt, 0);\n  bmSet('bm_brand_last', 'inquisition');\n  display_notice('[BM] Glow chain: sm add starchant inquisition ' + tgt, 'lightgreen');\n  return;\n}\nif (bmBool('bm_glow_holy')) {\n  send_command('sm add starchant infidel with holy light ' + tgt, 0);\n  display_notice('[BM] Glow chain: sm add starchant infidel with holy light ' + tgt, 'lightgreen');\n} else {\n  send_command('sm add starchant infidel ' + tgt, 0);\n  display_notice('[BM] Glow chain: sm add starchant infidel ' + tgt, 'lightgreen');\n}\nbmSet('bm_brand_last', 'infidel');\n"},{"type":"function","name":"stein_main","enabled":true,"id":15,"code":"function bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nfunction steinEnabled() {\n  var raw = get_variable('ce_stein');\n  if (raw === undefined || raw === null || raw === '') return true;\n  return bmBool('ce_stein');\n}\nfunction clearSteinTimer() {\n  try {\n    if (typeof client !== 'undefined' && client._steinTimer) {\n      try { clearTimeout(client._steinTimer); } catch (e0) {}\n      client._steinTimer = null;\n    }\n  } catch (e1) {}\n  try {\n    var tid = parseInt(get_variable('ce_stein_tid') || '', 10);\n    if (tid) { try { clearTimeout(tid); } catch (e2) {} }\n  } catch (e3) {}\n  try { set_variable('ce_stein_tid', ''); } catch (e4) {}\n}\nfunction armSteinTick() {\n  var tid = setTimeout(function () {\n    try { run_function('stein_main', 'tick', 'BladeMaster Engine'); } catch (eT) {}\n  }, 1000);\n  try { client._steinTimer = tid; } catch (eC) {}\n  try { set_variable('ce_stein_tid', String(tid)); } catch (eS) {}\n}\nfunction remainingSec() {\n  var until = parseFloat(bmGet('ce_stein_until', '0')) || 0;\n  if (!until) return 0;\n  var left = Math.ceil((until - Date.now()) / 1000);\n  return left > 0 ? left : 0;\n}\nfunction parseStein(raw) {\n  if (raw == null) return { op: '', sipper: '' };\n  if (typeof raw === 'string') {\n    var s = raw.replace(/^\\s+|\\s+$/g, '');\n    if (s.toLowerCase().indexOf('sip|') === 0) return { op: 'sip', sipper: s.slice(4).replace(/^\\s+|\\s+$/g, '') };\n    return { op: s, sipper: '' };\n  }\n  if (typeof raw === 'object') {\n    if (raw[0] != null) {\n      var a0 = String(raw[0]).replace(/^\\s+|\\s+$/g, '');\n      if (a0.toLowerCase().indexOf('sip|') === 0) return { op: 'sip', sipper: a0.slice(4).replace(/^\\s+|\\s+$/g, '') };\n      return { op: a0, sipper: '' };\n    }\n  }\n  return { op: String(raw).replace(/^\\s+|\\s+$/g, ''), sipper: '' };\n}\nvar parsed = parseStein(typeof args !== 'undefined' ? args : '');\nvar opLow = String(parsed.op || '').toLowerCase();\nif (opLow === 'on' || opLow === '1' || opLow === 'true' || opLow === 'yes') {\n  bmSet('ce_stein', '1');\n  display_notice('[Stein] ON — tracking peppermint sip on bmt target (60s).', 'lightgreen');\n  return;\n}\nif (opLow === 'off' || opLow === '0' || opLow === 'false' || opLow === 'no') {\n  bmSet('ce_stein', '0');\n  clearSteinTimer();\n  bmSet('ce_stein_left', '0');\n  display_notice('[Stein] OFF', 'yellow');\n  return;\n}\nif (opLow === 'toggle') {\n  if (steinEnabled()) {\n    bmSet('ce_stein', '0');\n    clearSteinTimer();\n    bmSet('ce_stein_left', '0');\n    display_notice('[Stein] OFF', 'yellow');\n  } else {\n    bmSet('ce_stein', '1');\n    display_notice('[Stein] ON — tracking peppermint sip on bmt target (60s).', 'lightgreen');\n  }\n  return;\n}\nif (opLow === 'tick') {\n  if (!steinEnabled()) return;\n  var left = remainingSec();\n  bmSet('ce_stein_left', String(left));\n  if (left <= 0) {\n    display_notice('[Stein] ready', 'lightgreen');\n    return;\n  }\n  if (left % 10 === 0) display_notice('[Stein] ' + left + 's', 'cyan');\n  armSteinTick();\n  return;\n}\nif (opLow === 'sip') {\n  if (!steinEnabled()) return;\n  var sipper = String(parsed.sipper || '').replace(/^\\s+|\\s+$/g, '');\n  var tgt = String(bmGet('bm_target', '') || '').replace(/^\\s+|\\s+$/g, '');\n  if (!tgt || !sipper) return;\n  if (sipper.toLowerCase() !== tgt.toLowerCase()) return;\n  clearSteinTimer();\n  bmSet('ce_stein_until', String(Date.now() + 60000));\n  bmSet('ce_stein_left', '60');\n  display_notice('[Stein] ' + sipper + ' sip — 60s CD', 'gold');\n  armSteinTick();\n}\n"},{"type":"function","name":"bm_restore_poisonist","enabled":true,"id":16,"code":"var raw = get_variable('bm_poisonist');\nvar on = (raw === true || raw === 1 || String(raw).toLowerCase() === '1' || String(raw).toLowerCase() === 'true');\nif (!on) return;\nsend_command('combatstyle poisonist', 0);\nset_variable('bm_poisonist_sent', '1');\ndisplay_notice('[BM] combatstyle poisonist (after evisc)', 'lightgreen');\n"},{"type":"function","name":"bm_stab_style","enabled":true,"id":17,"code":"function bmBool(k) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return false;\n  if (v === true || v === 1) return true;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nvar op = String(args == null ? '' : args).toLowerCase();\nif (op === 'restore') {\n  if (!bmBool('bm_stab_restore')) return;\n  set_variable('bm_stab_restore', '0');\n  try { if (client._bmStabRestoreTimer) { clearTimeout(client._bmStabRestoreTimer); client._bmStabRestoreTimer = null; } } catch (eT) {}\n  send_command('combatstyle concentrated', 0);\n  set_variable('bm_poisonist_sent', '0');\n  display_notice('[BM] combatstyle concentrated (after stab)', 'lightgreen');\n  return;\n}\nsend_command('combatstyle poisonist', 0);\nset_variable('bm_stab_restore', '1');\ndisplay_notice('[BM] combatstyle poisonist (stab wrap)', 'lightgreen');\ntry { if (client._bmStabRestoreTimer) clearTimeout(client._bmStabRestoreTimer); } catch (eC) {}\ntry {\n  client._bmStabRestoreTimer = setTimeout(function () {\n    client._bmStabRestoreTimer = null;\n    try { run_function('bm_stab_style', 'restore', 'BladeMaster Engine'); } catch (eR) {}\n  }, 2000);\n} catch (eS) {}\n"},{"type":"function","name":"bm_findgear","enabled":true,"id":18,"code":"function bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nfunction buf() {\n  try { return JSON.parse(bmGet('bm_find_buf', '[]') || '[]'); } catch (e) { return []; }\n}\nfunction setBuf(arr) { bmSet('bm_find_buf', JSON.stringify(arr || [])); }\nfunction phase() { return String(bmGet('bm_find_phase', '') || ''); }\nfunction notice(msg, c) { display_notice('[BM] ' + msg, c || 'lightgreen'); }\nfunction trimId(k) { return String(bmGet(k, '') || '').trim(); }\nfunction haveRapiers() { return !!(trimId('psnm_w1') || trimId('psnm_w2')); }\nfunction haveBoxes() {\n  return !!(trimId('bm_box_emerald') || trimId('bm_box_azure') || trimId('bm_box_golden'));\n}\nfunction idsMissing() {\n  if (!trimId('psnm_w1') || !trimId('psnm_w2')) return true;\n  if (bmBool('bm_use_bastard') && !trimId('psnm_bastard_id') && !trimId('psnmbid')) return true;\n  if (!haveBoxes()) return true;\n  return false;\n}\nfunction finishAsk() {\n  if (bmGet('bm_find_just_finished', '') === '1') return;\n  bmSet('bm_find_just_finished', '1');\n  if (haveRapiers() || haveBoxes()) {\n    bmSet('bm_find_empty_asked', '0');\n    bmSet('bm_find_auto_once', '0');\n    return;\n  }\n  notice('Find: nothing stored. Type xfindyes to rescan, or xfindno to stop asking.', 'yellow');\n  bmSet('bm_find_empty_asked', '1');\n  bmSet('bm_find_auto_once', '1');\n}\nfunction boxColor(rest) {\n  var s = String(rest || '').toLowerCase();\n  if (s.indexOf('emerald') >= 0) return 'emerald';\n  if (s.indexOf('azure') >= 0) return 'azure';\n  if (s.indexOf('golden') >= 0) return 'golden';\n  return '';\n}\nfunction wepKind(id, rest) {\n  var s = (String(id || '') + ' ' + String(rest || '')).toLowerCase();\n  if (s.indexOf('bastard') >= 0) return 'bastard';\n  if (s.indexOf('rapier') >= 0) return 'rapier';\n  return '';\n}\nfunction saveBoxes(items) {\n  var i, color;\n  for (i = 0; i < items.length; i++) {\n    color = boxColor(items[i].rest);\n    if (color && items[i].id) bmSet('bm_box_' + color, items[i].id);\n  }\n}\nfunction saveWeapons(items) {\n  var rapiers = [], bastard = '', i, kind;\n  for (i = 0; i < items.length; i++) {\n    kind = wepKind(items[i].id, items[i].rest);\n    if (kind === 'bastard' && bmBool('bm_use_bastard')) bastard = items[i].id;\n    else if (kind === 'rapier') rapiers.push(items[i].id);\n  }\n  if (rapiers[0]) bmSet('psnm_w1', rapiers[0]);\n  if (rapiers[1]) bmSet('psnm_w2', rapiers[1]);\n  if (bastard) bmSet('psnm_bastard_id', bastard);\n  var e = bmGet('bm_box_emerald', '') || '(none)';\n  var a = bmGet('bm_box_azure', '') || '(none)';\n  var g = bmGet('bm_box_golden', '') || '(none)';\n  notice('Find stored boxes emerald=' + e + ' azure=' + a + ' golden=' + g +\n    ' · rapiers ' + (rapiers[0] || '(none)') + ' / ' + (rapiers[1] || '(none)') +\n    ' · bastard ' + (bmBool('bm_use_bastard') ? (bastard || '(none)') : '(skipped)'));\n  finishAsk();\n}\nfunction armSafety() {\n  var prev = parseInt(bmGet('bm_find_safety', ''), 10);\n  if (prev) { try { clearTimeout(prev); } catch (eC) {} }\n  var tid = setTimeout(function () {\n    bmSet('bm_find_safety', '');\n    if (phase()) {\n      notice('Find timed out; parsing what was captured.', 'yellow');\n      run_function('bm_findgear', 'footer', 'BladeMaster Engine');\n    }\n  }, 8000);\n  bmSet('bm_find_safety', String(tid));\n}\nfunction clearSafety() {\n  var prev = parseInt(bmGet('bm_find_safety', ''), 10);\n  if (prev) { try { clearTimeout(prev); } catch (eC) {} }\n  bmSet('bm_find_safety', '');\n}\nfunction probeAll(ids) {\n  bmSet('bm_find_phase', 'probe');\n  setBuf([]);\n  var i = 0;\n  function next() {\n    if (i >= ids.length) {\n      saveWeapons(buf());\n      bmSet('bm_find_phase', '');\n      setBuf([]);\n      clearSafety();\n      return;\n    }\n    send_command('p ' + ids[i], 0);\n    i += 1;\n    setTimeout(next, 450);\n  }\n  if (!ids.length) {\n    saveWeapons([]);\n    bmSet('bm_find_phase', '');\n    setBuf([]);\n    clearSafety();\n    return;\n  }\n  next();\n}\n\nfunction beginScan() {\n  if (phase()) { notice('Find already running.', 'yellow'); return; }\n  bmSet('bm_find_just_finished', '0');\n  bmSet('bm_find_phase', 'boxes');\n  setBuf([]);\n  notice('Find: ii musicbox…');\n  armSafety();\n  send_command('ii musicbox', 0);\n}\nfunction maybeAuto() {\n  var ev = get_variable('bm_engine');\n  var engineOn = (ev === undefined || ev === null || ev === '') ? true : bmBool('bm_engine');\n  if (!engineOn) return false;\n  if (phase()) return false;\n  if (bmBool('bm_find_declined')) return false;\n  if (String(bmGet('bm_find_auto_once', '') || '') === '1') return false;\n  if (!idsMissing()) return false;\n  var last = parseInt(bmGet('bm_find_auto_last', ''), 10);\n  if (last && !isNaN(last) && (Date.now() - last) < 60000) return false;\n  bmSet('bm_find_auto_once', '1');\n  bmSet('bm_find_auto_last', String(Date.now()));\n  notice('Auto-Find: missing weapon/box ids — scanning inventory.');\n  beginScan();\n  return true;\n}\n\nvar op = '';\nif (typeof args === 'string') op = args;\nelse if (args && typeof args === 'object' && args[0] != null) op = String(args[0]);\nelse if (args != null) op = String(args);\nop = String(op || '').trim();\n\nif (op === 'start' || op === 'yes') {\n  bmSet('bm_find_declined', '0');\n  bmSet('bm_find_auto_once', '0');\n  beginScan();\n  return;\n}\nif (op === 'maybeauto') {\n  maybeAuto();\n  return;\n}\nif (op === 'no') {\n  bmSet('bm_find_declined', '1');\n  notice('Find: will not auto-ask. Type xfindyes to scan.', 'cyan');\n  return;\n}\nif (op === 'quote') return;\nif (op === 'footer' || op === 'timeout') {\n  var p = phase();\n  if (!p) return;\n  clearSafety();\n  var items = buf();\n  if (p === 'boxes') {\n    saveBoxes(items);\n    bmSet('bm_find_phase', 'scabbards');\n    setBuf([]);\n    armSafety();\n    send_command('ii scabbard', 0);\n    return;\n  }\n  if (p === 'scabbards') {\n    var sc = [], j;\n    for (j = 0; j < items.length; j++) if (items[j].id) sc.push(items[j].id);\n    probeAll(sc);\n    return;\n  }\n  if (p === 'probe') {\n    saveWeapons(items);\n    bmSet('bm_find_phase', '');\n    setBuf([]);\n  }\n}\n"},{"type":"function","name":"bm_wield","enabled":true,"id":19,"code":"function bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nfunction notice(msg, c) { display_notice('[BM] ' + msg, c || 'cyan'); }\nfunction parseOp() {\n  var op = '';\n  if (typeof args === 'string') op = args;\n  else if (args && typeof args === 'object' && args[0] != null) op = String(args[0]);\n  else if (args != null) op = String(args);\n  return String(op || '').trim();\n}\nfunction shieldId() { return String(bmGet('bm_shield_id', '') || '').trim(); }\nfunction firstGnome() {\n  var parts = String(bmGet('bm_gnome_ids', '') || '').split(',');\n  var i, p;\n  for (i = 0; i < parts.length; i++) {\n    p = String(parts[i] || '').trim();\n    if (p) return p;\n  }\n  return '';\n}\nfunction rememberGnome(id) {\n  id = String(id || '').trim();\n  if (!id) return;\n  var parts = String(bmGet('bm_gnome_ids', '') || '').split(',');\n  var i, seen = false;\n  for (i = 0; i < parts.length; i++) if (String(parts[i] || '').trim() === id) seen = true;\n  if (!seen) {\n    if (parts.length === 1 && !String(parts[0] || '').trim()) parts = [];\n    parts.push(id);\n    bmSet('bm_gnome_ids', parts.join(','));\n  }\n  if (!shieldId()) bmSet('bm_shield_id', id);\n}\nfunction storedId(k) { return String(bmGet(k, '') || '').trim(); }\nfunction sameId(handId, k) {\n  var v = storedId(k);\n  return !!(v && handId && v === String(handId));\n}\nfunction itemsList() {\n  var list = null;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Items)\n      list = GMCP.Char.Items.List || GMCP.Char.Items.list;\n  } catch (e1) {}\n  if (!list) {\n    try {\n      if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Items)\n        list = gmcp.Char.Items.List || gmcp.Char.Items.list;\n    } catch (e2) {}\n  }\n  if (!list) {\n    try {\n      if (typeof client !== 'undefined' && client && client.gmcp && client.gmcp.Char && client.gmcp.Char.Items)\n        list = client.gmcp.Char.Items.List || client.gmcp.Char.Items.list;\n    } catch (e3) {}\n  }\n  return list;\n}\nfunction itemRows(list) {\n  if (!list) return null;\n  if (list.items && typeof list.items.length === 'number') {\n    var loc = String(list.location || '').toLowerCase();\n    if (loc && loc !== 'inv' && loc !== 'inventory') return null;\n    return list.items;\n  }\n  if (typeof list.length === 'number') return list;\n  return null;\n}\nfunction attribHands(attrib) {\n  var a = String(attrib || '');\n  var left = false, right = false, i, ch;\n  for (i = 0; i < a.length; i++) {\n    ch = a.charAt(i);\n    if (ch === 'l') left = true;\n    if (ch === 'L') right = true;\n  }\n  return { left: left, right: right };\n}\nfunction classify(hand) {\n  if (!hand || !hand.id) return '';\n  var id = String(hand.id);\n  var name = String(hand.name || '').toLowerCase();\n  if (name.indexOf('gnomeweapon') >= 0) rememberGnome(id);\n  var sh = shieldId().toLowerCase();\n  if (sh && (id.toLowerCase() === sh || name.indexOf(sh) >= 0)) return 'shield';\n  if (sameId(id, 'psnmw1') || sameId(id, 'psnm_w1') || sameId(id, 'psnmw2') || sameId(id, 'psnm_w2') || name.indexOf('rapier') >= 0) return 'rapier';\n  if (sameId(id, 'psnmbid') || sameId(id, 'psnm_bastard_id') || name.indexOf('bastard') >= 0) return 'bastard';\n  if (name.indexOf('gnomeweapon') >= 0) return 'gnome';\n  return 'junk';\n}\nfunction scanInvGnomes(rows) {\n  if (!rows) return;\n  var i, it, id, name;\n  for (i = 0; i < rows.length; i++) {\n    it = rows[i];\n    if (!it) continue;\n    name = String(it.name || '').toLowerCase();\n    if (name.indexOf('gnomeweapon') < 0) continue;\n    id = String(it.id || it.uid || '').trim();\n    if (id) rememberGnome(id);\n  }\n}\nfunction readHands() {\n  var rows = itemRows(itemsList());\n  if (!rows) return { known: false, left: null, right: null };\n  scanInvGnomes(rows);\n  var left = null, right = null, i, it, h, hand;\n  for (i = 0; i < rows.length; i++) {\n    it = rows[i];\n    if (!it) continue;\n    h = attribHands(it.attrib);\n    if (!h.left && !h.right) continue;\n    hand = { id: String(it.id || it.uid || ''), name: String(it.name || '') };\n    if (h.left && h.right) { left = hand; right = hand; }\n    else if (h.left) left = hand;\n    else right = hand;\n  }\n  return { known: true, left: left, right: right };\n}\nfunction gripUp() {\n  var list = null;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences)\n      list = GMCP.Char.Defences.List || GMCP.Char.Defences;\n  } catch (e1) {}\n  if (!list) {\n    try {\n      if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Defences)\n        list = gmcp.Char.Defences.List || gmcp.Char.Defences;\n    } catch (e2) {}\n  }\n  if (!list || typeof list.length !== 'number') return false;\n  var i, item, n;\n  for (i = 0; i < list.length; i++) {\n    item = list[i];\n    n = (typeof item === 'string') ? item : (item && (item.name || item.defence || ''));\n    if (String(n || '').toLowerCase() === 'grip') return true;\n  }\n  return false;\n}\nfunction kindsOf(hands) {\n  return { left: classify(hands.left), right: classify(hands.right) };\n}\nfunction atGoal(goal, k, gripped) {\n  if (!gripped) return false;\n  if (goal === 'rapiers') return k.left === 'rapier' && k.right === 'rapier';\n  if (goal === 'bastard') {\n    return (k.left === 'bastard' || k.right === 'bastard') &&\n      (!k.left || k.left === 'bastard') && (!k.right || k.right === 'bastard');\n  }\n  if (goal === 'shield') {\n    return (k.left === 'shield' && !k.right) || (k.right === 'shield' && !k.left);\n  }\n  return false;\n}\nfunction needsUnwield(kind, goal) {\n  if (!kind) return false;\n  if (goal === 'rapiers' || goal === 'bastard') return kind === 'junk' || kind === 'gnome' || kind === 'shield';\n  if (goal === 'shield') return kind === 'junk' || kind === 'gnome';\n  return false;\n}\nfunction addDrop(drop, seen, token) {\n  token = String(token || '').trim();\n  if (!token || seen[token]) return;\n  seen[token] = true;\n  drop.push(token);\n}\nfunction sendSwitch(goal, hands) {\n  var k = kindsOf(hands);\n  var cmds = [];\n  var drop = [];\n  var seen = {};\n  var ungrip = false;\n  function consider(hand, kind, side) {\n    if (!needsUnwield(kind, goal)) return;\n    ungrip = true;\n    if (hand && hand.id) addDrop(drop, seen, hand.id);\n    else addDrop(drop, seen, side);\n  }\n  consider(hands.left, k.left, 'left');\n  consider(hands.right, k.right, 'right');\n  if (ungrip) cmds.push('relax grip');\n  var i;\n  for (i = 0; i < drop.length; i++) cmds.push('unwield ' + drop[i]);\n  if (goal === 'rapiers') {\n    if (k.left === 'bastard' || k.right === 'bastard') cmds.push('sheathe bastard');\n    if (k.left !== 'rapier' || k.right !== 'rapier') cmds.push('draw rapier');\n  } else if (goal === 'bastard') {\n    if (k.left === 'rapier' || k.right === 'rapier') cmds.push('sheathe rapier');\n    if (k.left !== 'bastard' && k.right !== 'bastard') cmds.push('draw bastard');\n  } else {\n    if (k.left === 'rapier' || k.right === 'rapier') cmds.push('sheathe rapier');\n    if (k.left === 'bastard' || k.right === 'bastard') cmds.push('sheathe bastard');\n    if (k.left !== 'shield' && k.right !== 'shield') {\n      var sh = shieldId() || firstGnome();\n      if (!sh) { notice('No shield set. xshieldset <id or name>.', 'yellow'); return; }\n      if (!shieldId()) bmSet('bm_shield_id', sh);\n      cmds.push('wield ' + sh);\n    }\n  }\n  if (ungrip || !gripUp()) cmds.push('grip');\n  if (!cmds.length) return;\n  send_command(cmds.join(';;'), 0);\n}\nfunction runGoal(goal, isRetry) {\n  var hands = readHands();\n  if (!hands.known) {\n    if (!isRetry) {\n      bmSet('bm_wield_pending', goal);\n      send_command('ii', 0);\n      return;\n    }\n    hands = { known: true, left: null, right: null };\n  }\n  bmSet('bm_wield_pending', '');\n  var k = kindsOf(hands);\n  if (atGoal(goal, k, gripUp())) {\n    notice('Already ' + goal + ' with grip.');\n    return;\n  }\n  sendSwitch(goal, hands);\n}\nfunction printShield() {\n  var id = shieldId() || firstGnome();\n  if (id && !shieldId()) bmSet('bm_shield_id', id);\n  if (id) notice('Shield: ' + id);\n  else notice('Shield: (none). xshieldset <id or name> — default is first gnomeweapon seen.', 'yellow');\n}\nfunction setShield(raw) {\n  var v = String(raw || '').trim();\n  if (!v) {\n    v = firstGnome();\n    if (!v) { notice('No shield id. xshieldset <id or name> (no gnomeweapon seen yet).', 'yellow'); return; }\n  }\n  bmSet('bm_shield_id', v);\n  notice('Shield set: ' + v, 'lightgreen');\n}\n\nvar raw = parseOp();\nvar pipe = raw.indexOf('|');\nvar op = (pipe < 0 ? raw : raw.slice(0, pipe)).toLowerCase().trim();\nvar extra = (pipe < 0 ? '' : raw.slice(pipe + 1)).trim();\nif (op === 'gmcp') {\n  var pending = String(bmGet('bm_wield_pending', '') || '').trim();\n  readHands();\n  if (pending) runGoal(pending, true);\n  return;\n}\nif (op === 'show') { printShield(); return; }\nif (op === 'set') { setShield(extra); return; }\nif (op === 'rapiers' || op === 'bastard' || op === 'shield') runGoal(op, extra === 'retry');\n"},{"type":"function","name":"bm_tea","enabled":true,"id":20,"code":"\nfunction bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nfunction bmTeaNormKind(k) {\n  k = String(k || 'green').toLowerCase();\n  if (k === 'black' || k === 'blacktea') return 'blacktea';\n  return 'green';\n}\nfunction bmTeaKind() {\n  return bmTeaNormKind(bmGet('bm_tea_kind', 'green'));\n}\nfunction bmTeaUserKind() {\n  return bmTeaNormKind(bmGet('bm_tea_user', 'green'));\n}\nfunction bmTeaLabel() {\n  return bmTeaKind() === 'blacktea' ? 'Black' : 'Green';\n}\nfunction bmTeaSipCmd() {\n  return bmTeaKind() === 'blacktea' ? 'blacktea' : 'greentea';\n}\nfunction bmTeaKindFromSpec(spec) {\n  spec = String(spec || '').trim().toLowerCase();\n  if (!spec || spec === 'unknown' || spec === 'off' || spec === 'clear') return '';\n  if (spec === 'bonecrusher') return 'blacktea';\n  if (spec === 'pureblade') return 'blacktea';\n  if (spec === 'cavalier' || spec === 'monk' || spec === 'mage' || spec === 'blademaster' || spec === 'axelord') return 'green';\n  if (spec === 'bard') return 'green';\n  return '';\n}\nfunction bmTeaApplyForSpec(spec) {\n  var mapped = bmTeaKindFromSpec(spec);\n  var next = mapped || bmTeaUserKind();\n  next = bmTeaNormKind(next);\n  bmSet('bm_tea_kind', next);\n  bmTeaSipIfNeeded();\n  return next;\n}\nfunction bmTeaDefName(item) {\n  if (item == null) return '';\n  if (typeof item === 'string') return String(item).toLowerCase();\n  return String(item.name || item.defence || item.Name || '').toLowerCase();\n}\nfunction bmTeaFlagOn(k) {\n  var v = get_variable(k);\n  if (v === true || v === 1) return true;\n  var s = String(v == null ? '' : v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmTeaMark(cmd, up) {\n  cmd = String(cmd || '').toLowerCase();\n  if (cmd === 'greentea') set_variable('bm_tea_green_up', up ? '1' : '0');\n  else if (cmd === 'blacktea') set_variable('bm_tea_black_up', up ? '1' : '0');\n}\nfunction bmTeaHasDef(cmd) {\n  cmd = String(cmd || bmTeaSipCmd()).toLowerCase();\n  if (cmd === 'greentea' && bmTeaFlagOn('bm_tea_green_up')) return true;\n  if (cmd === 'blacktea' && bmTeaFlagOn('bm_tea_black_up')) return true;\n  function listHas(list) {\n    if (!list || typeof list.length !== 'number') return false;\n    var i, n;\n    for (i = 0; i < list.length; i++) {\n      n = bmTeaDefName(list[i]);\n      if (n === cmd) return true;\n    }\n    return false;\n  }\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences) {\n      if (listHas(GMCP.Char.Defences.List || GMCP.Char.Defences)) return true;\n    }\n  } catch (eG) {}\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Defences) {\n      if (listHas(gmcp.Char.Defences.List || gmcp.Char.Defences)) return true;\n    }\n  } catch (eG2) {}\n  return false;\n}\nfunction bmTeaSipIfNeeded() {\n  var cmd = bmTeaSipCmd();\n  if (bmTeaHasDef(cmd)) return false;\n  send_command('sip ' + cmd, 0);\n  return true;\n}\nfunction bmTeaCycle() {\n  var next = bmTeaKind() === 'blacktea' ? 'green' : 'blacktea';\n  bmSet('bm_tea_kind', next);\n  bmSet('bm_tea_user', next);\n  bmTeaSipIfNeeded();\n  return next;\n}var op = '';\nif (typeof args === 'string') op = args;\nelse if (args && typeof args === 'object' && args[0] != null) op = String(args[0]);\nelse if (args != null) op = String(args);\nop = String(op || '').trim().toLowerCase();\nif (op === 'cycle' || op === 'tea') {\n  var next = bmTeaCycle();\n  display_notice('[BM] Tea ' + (next === 'blacktea' ? 'Black' : 'Green') + ' — sip when that defence is down', 'lightgreen');\n} else if (op === 'spec' || op.indexOf('spec|') === 0) {\n  var specArg = op.indexOf('spec|') === 0 ? op.slice(5) : String(bmGet('bm_en_spec', '') || '');\n  bmTeaApplyForSpec(specArg);\n} else if (op === 'greenup') {\n  bmTeaMark('greentea', true);\n} else if (op === 'belch') {\n  if (bmTeaKind() === 'green') bmTeaSipIfNeeded();\n} else {\n  bmTeaSipIfNeeded();\n}\n"},{"type":"function","name":"bm_intel","enabled":true,"id":21,"code":"function bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nfunction currentTarget() {\n  return String(bmGet('bm_target', '') || '').replace(/^\\s+|\\s+$/g, '');\n}\nfunction trimStr(s) {\n  return String(s || '').replace(/^\\s+|\\s+$/g, '');\n}\nfunction isPronoun(name) {\n  var n = trimStr(name).toLowerCase();\n  return n === 'he' || n === 'she' || n === 'they' || n === 'it'\n    || n === 'his' || n === 'her' || n === 'their' || n === 'him';\n}\nfunction usableActor(name) {\n  name = trimStr(name);\n  if (!name || name.length > 40) return '';\n  if (/^you\\b/i.test(name)) return '';\n  if (isPronoun(name)) return currentTarget();\n  return name;\n}\nfunction actorIsTarget(actor) {\n  var tgt = currentTarget();\n  if (!actor || !tgt) return false;\n  return actor.toLowerCase() === tgt.toLowerCase();\n}\nvar BM_INTEL_KEYS = [\n  { needle: 'tahto', spec: 'Monk', family: 'tahto', confidence: 'high' },\n  { needle: 'shofa', spec: 'Monk', family: 'shofa', confidence: 'high' },\n  { needle: 'jakari', spec: 'Monk', family: 'jakari', confidence: 'high' },\n  { needle: 'nekai', spec: 'Monk', family: 'nekai', confidence: 'high' },\n  { needle: 'bastard sword', spec: 'Pureblade', family: 'bastard sword', confidence: 'medium' },\n  { needle: 'greatsword', spec: 'Pureblade', family: 'greatsword', confidence: 'medium' },\n  { needle: 'claymore', spec: 'Pureblade', family: 'claymore', confidence: 'medium' },\n  { needle: 'morning star', spec: 'Bonecrusher', family: 'morning star', confidence: 'medium' },\n  { needle: 'morningstar', spec: 'Bonecrusher', family: 'morning star', confidence: 'medium' },\n  { needle: 'battle hammer', spec: 'Bonecrusher', family: 'hammer', confidence: 'medium' },\n  { needle: 'war hammer', spec: 'Bonecrusher', family: 'hammer', confidence: 'medium' },\n  { needle: 'battlehammer', spec: 'Bonecrusher', family: 'hammer', confidence: 'medium' },\n  { needle: 'warhammer', spec: 'Bonecrusher', family: 'hammer', confidence: 'medium' },\n  { needle: 'greataxe', spec: 'Axelord', family: 'greataxe', confidence: 'medium' },\n  { needle: 'klangaxe', spec: 'Axelord', family: 'klangaxe', confidence: 'medium' },\n  { needle: 'battleaxe', spec: 'Axelord', family: 'battleaxe', confidence: 'medium' },\n  { needle: 'battle axe', spec: 'Axelord', family: 'battleaxe', confidence: 'medium' },\n  { needle: 'waraxe', spec: 'Axelord', family: 'waraxe', confidence: 'medium' },\n  { needle: 'katana', spec: 'Blademaster', family: 'katana', confidence: 'medium' },\n  { needle: 'longsword', spec: 'Blademaster', family: 'longsword', confidence: 'medium' },\n  { needle: 'broadsword', spec: 'Blademaster', family: 'broadsword', confidence: 'medium' },\n  { needle: 'scimitar', spec: 'Blademaster', family: 'scimitar', confidence: 'medium' },\n  { needle: 'rapier', spec: 'Blademaster', family: 'rapier', confidence: 'medium' },\n  { needle: 'shortsword', spec: 'Blademaster', family: 'shortsword', confidence: 'medium' },\n  { needle: 'bardiche', spec: 'Cavalier', family: 'bardiche', confidence: 'medium' },\n  { needle: 'glaive', spec: 'Cavalier', family: 'glaive', confidence: 'medium' },\n  { needle: 'halberd', spec: 'Cavalier', family: 'halberd', confidence: 'medium' },\n  { needle: 'lance', spec: 'Cavalier', family: 'lance', confidence: 'medium' },\n  { needle: 'flail', spec: 'Bonecrusher', family: 'flail', confidence: 'medium' },\n  { needle: 'mace', spec: 'Bonecrusher', family: 'mace', confidence: 'medium' },\n  { needle: 'club', spec: 'Bonecrusher', family: 'club', confidence: 'medium' },\n  { needle: 'hammer', spec: 'Bonecrusher', family: 'hammer', confidence: 'medium' },\n  { needle: 'axe', spec: 'Axelord', family: 'axe', confidence: 'medium' },\n  { needle: 'dagger', spec: 'Unknown', family: 'dagger', confidence: 'low' },\n  { needle: 'kukri', spec: 'Unknown', family: 'dagger', confidence: 'low' }\n];\nfunction classifyWeapon(desc) {\n  desc = trimStr(desc).toLowerCase().replace(/[.,;:]+$/g, '').replace(/\\s+/g, ' ');\n  if (!desc) return null;\n  var i, r;\n  for (i = 0; i < BM_INTEL_KEYS.length; i++) {\n    r = BM_INTEL_KEYS[i];\n    if (desc.indexOf(r.needle) >= 0) return r;\n  }\n  return { spec: 'Unknown', family: 'unknown', confidence: 'none' };\n}\nfunction cleanDesc(desc) {\n  desc = trimStr(desc);\n  desc = desc.replace(/\\s+in\\s+(?:his|her|their)\\s+(?:left|right)\\s+hand.*$/i, '');\n  desc = desc.replace(/\\s+and\\s+$/i, '');\n  desc = desc.replace(/[.,;:]+$/g, '');\n  return trimStr(desc);\n}\nfunction specLocked() {\n  var v = bmGet('bm_en_spec_lock', '0');\n  if (v === true || v === 1) return true;\n  var s = String(v == null ? '' : v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction noteWeapon(actor, desc) {\n  actor = usableActor(actor);\n  if (!actorIsTarget(actor)) return false;\n  if (specLocked()) return false;\n  desc = cleanDesc(desc);\n  var cls = classifyWeapon(desc);\n  if (!cls || !cls.spec || cls.spec === 'Unknown') return false;\n  var prev = String(bmGet('bm_en_spec', '') || '');\n  bmSet('bm_en_spec', cls.spec);\n  bmSet('bm_en_family', cls.family || '');\n  bmSet('bm_en_conf', cls.confidence || '');\n  if (cls.spec !== prev) {\n    bmSet('bm_def_choice', '');\n    try { run_function('bm_tea', 'spec|' + cls.spec, 'BladeMaster Engine'); } catch (eTea) {}\n  }\n  return true;\n}\nfunction noteHit(actor, limb) {\n  actor = usableActor(actor);\n  if (!actorIsTarget(actor) || !limb) return false;\n  var prev = String(bmGet('bm_en_hit', '') || '');\n  bmSet('bm_en_hit', limb);\n  if (limb !== prev) bmSet('bm_def_choice', '');\n  return true;\n}\nfunction parseHitWeapon(plain) {\n  if (/^\\s*you\\b/i.test(plain)) return false;\n  var m = plain.match(/^\\s*(.+?)\\s+\\w+\\s+you with\\s+/i);\n  if (!m) m = plain.match(/^\\s*(.+?)\\s+you with\\s+/i);\n  var actor = m ? usableActor(m[1]) : '';\n  if (!actor) return false;\n  var lower = plain.toLowerCase();\n  var d = lower.match(/with\\s+(?:a|an|the)\\s+(.+?)(?:\\.|$)/);\n  if (!d) return false;\n  return noteWeapon(actor, d[1]);\n}\nfunction parseLimb(plain) {\n  if (/^\\s*you\\b/i.test(plain)) return false;\n  var m = plain.match(/^\\s*(.+?)\\s+(slash(?:es)?|cut(?:s)?|bash(?:es)?|cleave(?:s)?|impale(?:s)?|stab(?:s)?)\\s+your\\s+(left arm|right arm|left leg|right leg|head|chest|gut)\\b/i);\n  if (!m) return false;\n  var limb = String(m[3] || '').toLowerCase();\n  if (limb === 'left arm') limb = 'larm';\n  else if (limb === 'right arm') limb = 'rarm';\n  else if (limb === 'left leg') limb = 'lleg';\n  else if (limb === 'right leg') limb = 'rleg';\n  return noteHit(m[1], limb);\n}\nfunction bmEngineOn() {\n  var v = get_variable('bm_engine');\n  if (v === undefined || v === null || v === '') return true;\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction handleLine(plain) {\n  if (!bmEngineOn()) return;\n  plain = trimStr(plain);\n  if (!plain) return;\n  if (/^you are wielding|^you wield/i.test(plain)) return;\n  var dirty = false;\n  if (parseLimb(plain)) dirty = true;\n  if (parseHitWeapon(plain)) dirty = true;\n  if (dirty) {\n    try { run_function('bm_tabs', '', 'BladeMaster Engine'); } catch (eT) {}\n    try { run_function('bm_smart_def', '', 'BladeMaster Engine'); } catch (eS) {}\n  }\n}\nfunction specFromToken(tok) {\n  tok = trimStr(tok).toLowerCase().replace(/[^a-z]/g, '');\n  if (tok.indexOf('spec') === 0 && tok.length > 4) tok = tok.slice(4);\n  var map = {\n    bm: 'Blademaster', blademaster: 'Blademaster',\n    pb: 'Pureblade', pureblade: 'Pureblade',\n    bc: 'Bonecrusher', bonecrusher: 'Bonecrusher',\n    al: 'Axelord', axelord: 'Axelord',\n    cv: 'Cavalier', cavalier: 'Cavalier',\n    mk: 'Monk', monk: 'Monk',\n    mg: 'Mage', mage: 'Mage',\n    bd: 'Bard', bard: 'Bard'\n  };\n  return map[tok] || '';\n}\nfunction applyManualSpec(spec, toggle) {\n  var cur = String(bmGet('bm_en_spec', '') || '').trim();\n  if (toggle && spec && cur === spec) spec = '';\n  if (!spec) {\n    bmSet('bm_en_spec', '');\n    bmSet('bm_en_spec_lock', '0');\n    bmSet('bm_en_family', '');\n    bmSet('bm_en_conf', '');\n    bmSet('bm_def_choice', '');\n    display_notice('[BM] Spec cleared (unlocked). Smart uses xautoparry full.', 'cyan');\n  } else {\n    bmSet('bm_en_spec', spec);\n    bmSet('bm_en_spec_lock', '1');\n    bmSet('bm_en_family', '');\n    bmSet('bm_en_conf', 'lock');\n    bmSet('bm_def_choice', '');\n    display_notice('[BM] Spec locked: ' + spec, 'lightgreen');\n  }\n  try { run_function('bm_tea', 'spec|' + spec, 'BladeMaster Engine'); } catch (eTea) {}\n  try { run_function('bm_tabs', '', 'BladeMaster Engine'); } catch (eT) {}\n  try { run_function('bm_smart_def', '', 'BladeMaster Engine'); } catch (eS) {}\n}\nfunction doShow() {\n  var tgt = currentTarget();\n  var spec = String(bmGet('bm_en_spec', '') || '');\n  var fam = String(bmGet('bm_en_family', '') || '');\n  var conf = String(bmGet('bm_en_conf', '') || '');\n  var hit = String(bmGet('bm_en_hit', '') || '');\n  var locked = specLocked();\n  if (!tgt) display_notice('[BM] No target.', 'yellow');\n  else if (!spec) display_notice('[BM] No spec for ' + tgt + '. Use Defence chips or xspec bm|pb|bc|al|cv|mk|mg|bd.', 'yellow');\n  else display_notice('[BM] ' + tgt + ' → Spec: ' + spec + (fam ? ' (' + fam + ')' : '') + (conf ? '  conf=' + conf : ''), 'lightgreen');\n  display_notice('[BM] Lock: ' + (locked ? 'on' : 'off') + (hit ? '  Last hit: ' + hit : ''), 'cyan');\n}\nvar raw = '';\nif (typeof args === 'string') raw = args;\nelse if (args && typeof args === 'object') {\n  if (args.text) raw = String(args.text);\n  else if (args.match) raw = String(args.match);\n  else if (args[0] != null) raw = String(args[0]);\n  else raw = String(args);\n} else if (args != null) raw = String(args);\nraw = String(raw || '');\nvar op = trimStr(raw);\nvar opLow = op.toLowerCase();\nif (opLow === 'look' || opLow === 'xintel' || opLow === 'show' || opLow === 'xspec') doShow();\nelse if (opLow === 'clear' || opLow === 'off') applyManualSpec('');\nelse if (opLow.indexOf('xspec|') === 0) {\n  var tok = trimStr(op.slice(6));\n  var tokLow = tok.toLowerCase();\n  if (!tok || tokLow === 'show') doShow();\n  else if (tokLow === 'clear' || tokLow === 'off') applyManualSpec('');\n  else {\n    var want = specFromToken(tok);\n    if (!want) display_notice('[BM] Unknown spec. Use: xspec bm|pb|bc|al|cv|mk|mg|bd (or full name) or xspec clear', 'yellow');\n    else applyManualSpec(want, false);\n  }\n} else if (/^spec(bm|pb|bc|al|cv|mk|mg|bd)$/i.test(opLow)) {\n  applyManualSpec(specFromToken(opLow), true);\n} else {\n  handleLine(raw);\n}\n"},{"type":"function","name":"bm_smart_def","enabled":true,"id":22,"code":"function bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmDefOn(k, fallbackOn) {\n  var raw = get_variable(k);\n  if (raw === undefined || raw === null || raw === '') return !!fallbackOn;\n  return bmBool(k);\n}\nfunction bmCallParry(op) {\n  try {\n    run_function('_parry', op, 'BladeMaster Engine');\n    return true;\n  } catch (eP) {\n    return false;\n  }\n}\nif (!bmDefOn('bm_def_smart', false) || !bmDefOn('bm_def_parry', true)) return;\nfunction woundOf(wounds, limb) {\n  return parseInt(wounds && wounds[limb], 10) || 0;\n}\nfunction readWounds() {\n  var v = null;\n  try { if (client && client.bm_vitals) v = client.bm_vitals; } catch (e1) {}\n  if (!v) {\n    try { if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Vitals) v = GMCP.Char.Vitals; } catch (e2) {}\n  }\n  var out = { head: 0, chest: 0, gut: 0, larm: 0, rarm: 0, lleg: 0, rleg: 0 };\n  if (v) {\n    out.head = parseInt(v.headwounds, 10) || 0;\n    out.chest = parseInt(v.chestwounds, 10) || 0;\n    out.gut = parseInt(v.gutwounds, 10) || 0;\n    out.larm = parseInt(v.leftarmwounds, 10) || 0;\n    out.rarm = parseInt(v.rightarmwounds, 10) || 0;\n    out.lleg = parseInt(v.leftlegwounds, 10) || 0;\n    out.rleg = parseInt(v.rightlegwounds, 10) || 0;\n    return out;\n  }\n  try {\n    var last = JSON.parse(String(get_variable('ps_last_wounds') || '{}'));\n    out.head = parseInt(last.head, 10) || 0;\n    out.chest = parseInt(last.chest, 10) || 0;\n    out.gut = parseInt(last.gut, 10) || 0;\n    out.larm = parseInt(last.leftarm, 10) || 0;\n    out.rarm = parseInt(last.rightarm, 10) || 0;\n    out.lleg = parseInt(last.leftleg, 10) || 0;\n    out.rleg = parseInt(last.rightleg, 10) || 0;\n  } catch (e3) {}\n  return out;\n}\nfunction isKillLimb(limb, set) {\n  if (!limb || !set) return false;\n  if (set[limb]) return true;\n  if (set.arms && (limb === 'larm' || limb === 'rarm' || limb === 'arms')) return true;\n  if (set.legs && (limb === 'lleg' || limb === 'rleg' || limb === 'legs')) return true;\n  return false;\n}\nfunction highestKillWound(set, wounds) {\n  var best = null, bestN = 0, limb, n;\n  if (!set) return { limb: null, n: 0 };\n  for (limb in set) {\n    if (!set.hasOwnProperty(limb)) continue;\n    if (limb === 'arms') n = woundOf(wounds, 'larm') + woundOf(wounds, 'rarm');\n    else if (limb === 'legs') n = woundOf(wounds, 'lleg') + woundOf(wounds, 'rleg');\n    else n = woundOf(wounds, limb);\n    if (n > bestN) { best = limb; bestN = n; }\n  }\n  return { limb: best, n: bestN };\n}\nfunction threatLimb(set, pred, wounds) {\n  var hit = pred && pred.hitting;\n  if (hit && isKillLimb(hit, set)) return hit;\n  var hw = highestKillWound(set, wounds);\n  if (hw.limb && hw.n > 0) return hw.limb;\n  return null;\n}\nfunction limbLive(pred, wounds, limb) {\n  if (pred && pred.hitting === limb) return true;\n  return woundOf(wounds, limb) > 0;\n}\nfunction vitalsChoice(spec) {\n  return { mode: '25split', part: '', stance: 'vitals', spec: spec || '', label: 'vitals' };\n}\nfunction choose() {\n  var spec = String(bmGet('bm_en_spec', '') || '').replace(/^\\s+|\\s+$/g, '');\n  if (spec === '' || spec === 'Unknown') spec = '';\n  var pred = { spec: spec, hitting: String(bmGet('bm_en_hit', '') || '') };\n  var wounds = readWounds();\n  if (!spec) return { mode: 'full', part: '', stance: '', spec: '', label: 'full' };\n  if (spec === 'Monk' || spec === 'Mage' || spec === 'Bard') return vitalsChoice(spec);\n  if (spec === 'Pureblade') {\n    var pThreat = threatLimb({ gut: true, chest: true }, pred, wounds);\n    var chestLive = limbLive(pred, wounds, 'chest');\n    if (pThreat === 'chest') {\n      return { mode: '50', part: 'chest', stance: limbLive(pred, wounds, 'gut') ? 'vitals' : 'chest', spec: spec, label: 'chest' };\n    }\n    return { mode: '50', part: 'gut', stance: chestLive ? 'vitals' : 'gut', spec: spec, label: 'gut' };\n  }\n  if (spec === 'Axelord') {\n    var aHit = pred.hitting;\n    var aHead = highestKillWound({ head: true, chest: true, gut: true }, wounds);\n    if (aHit === 'head' || (aHead.limb === 'head' && aHead.n > 0)) {\n      return { mode: '75', part: 'head', stance: 'head', spec: spec, label: 'head' };\n    }\n    return vitalsChoice(spec);\n  }\n  if (spec === 'Bonecrusher') {\n    var bThreat = threatLimb({ head: true, chest: true, lleg: true, rleg: true, legs: true }, pred, wounds);\n    if (bThreat === 'lleg' || bThreat === 'rleg' || bThreat === 'legs') {\n      return { mode: '50', part: 'legs', stance: 'lower', spec: spec, label: 'legs' };\n    }\n    return { mode: '75', part: 'head', stance: 'head', spec: spec, label: 'head' };\n  }\n  if (spec === 'Cavalier') {\n    var mid = woundOf(wounds, 'chest') + woundOf(wounds, 'gut');\n    var armsN = woundOf(wounds, 'larm') + woundOf(wounds, 'rarm');\n    var legsN = woundOf(wounds, 'lleg') + woundOf(wounds, 'rleg');\n    var limbsN = armsN + legsN;\n    var cHit = pred.hitting;\n    var hitLimb = cHit === 'larm' || cHit === 'rarm' || cHit === 'lleg' || cHit === 'rleg';\n    if (hitLimb || (limbsN > mid && limbsN > 0)) {\n      var wantArms = (cHit === 'larm' || cHit === 'rarm') || (!hitLimb && armsN >= legsN);\n      if (wantArms) return { mode: '50', part: 'arms', stance: 'arms', spec: spec, label: 'arms' };\n      return { mode: '50', part: 'legs', stance: 'legs', spec: spec, label: 'legs' };\n    }\n    var cThreat = threatLimb({ gut: true, chest: true }, pred, wounds);\n    if (limbLive(pred, wounds, 'chest') && limbLive(pred, wounds, 'gut')) return vitalsChoice(spec);\n    if (cThreat === 'chest') return { mode: '50', part: 'chest', stance: 'middle', spec: spec, label: 'chest' };\n    return { mode: '50', part: 'gut', stance: 'middle', spec: spec, label: 'gut' };\n  }\n  if (spec === 'Blademaster') {\n    var bmThreat = threatLimb({ chest: true, gut: true }, pred, wounds);\n    if (limbLive(pred, wounds, 'chest') && limbLive(pred, wounds, 'gut')) return vitalsChoice(spec);\n    if (bmThreat === 'gut') return { mode: '50', part: 'gut', stance: 'gut', spec: spec, label: 'gut' };\n    return { mode: '50', part: 'chest', stance: 'chest', spec: spec, label: 'chest' };\n  }\n  return vitalsChoice(spec);\n}\nfunction choiceKey(c) {\n  if (!c) return '';\n  return [c.mode || '', c.part || '', c.stance || '', c.spec || ''].join('|');\n}\nvar choice = choose();\nvar key = choiceKey(choice);\nvar prev = String(bmGet('bm_def_choice', '') || '');\nif (key && key === prev) return;\nset_variable('bm_def_choice', key);\nif (choice.mode === 'full') {\n  bmCallParry('xautoparry|full');\n  return;\n}\nif (choice.mode === '75' && choice.part) bmCallParry('xautoparry|75|' + choice.part);\nelse if (choice.mode === '50' && choice.part) bmCallParry('xautoparry|50|' + choice.part);\nelse bmCallParry('xautoparry|25split');\nif (bmDefOn('bm_def_stance', true) && choice.stance) {\n  bmCallParry('xstance|' + choice.stance);\n}\n"},{"type":"function","name":"evisc_main","enabled":true,"id":23,"code":"\r\nfunction evParseOp(raw) {\r\n  if (raw == null || raw === '') return '';\r\n  if (typeof raw === 'string') return (raw.split('|')[0] || '').trim();\r\n  if (typeof raw === 'number' || typeof raw === 'boolean') return String(raw).trim();\r\n  return '';\r\n}\r\nvar OP = evParseOp(args);\r\n\r\nfunction evGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction evBool(k) {\r\n  var v = evGet(k, '0');\r\n  if (v === true || v === 1) return true;\r\n  if (v === false || v === 0) return false;\r\n  var s = String(v).toLowerCase();\r\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\r\n}\r\nfunction evSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction evTarget() {\r\n  return (evGet('bm_target', '') + '').trim();\r\n}\r\n\r\nfunction evHasNamed(list, name) {\r\n  name = String(name || '').toLowerCase();\r\n  if (!list || list.length == null) return false;\r\n  var i, a, n;\r\n  for (i = 0; i < list.length; i++) {\r\n    a = list[i];\r\n    n = (typeof a === 'string') ? a : (a && (a.name || a.affliction || a.defence));\r\n    if (n && String(n).toLowerCase() === name) return true;\r\n  }\r\n  return false;\r\n}\r\nfunction evHasAff(name) {\r\n  try {\r\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Afflictions) {\r\n      return evHasNamed(GMCP.Char.Afflictions.List || GMCP.Char.Afflictions, name);\r\n    }\r\n  } catch (eA) {}\r\n  return false;\r\n}\r\nfunction evHasDef(name) {\r\n  try {\r\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Defences) {\r\n      return evHasNamed(GMCP.Char.Defences.List || GMCP.Char.Defences, name);\r\n    }\r\n  } catch (eD) {}\r\n  return false;\r\n}\r\nfunction evCanSeeAffs() {\r\n  try {\r\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Afflictions) return true;\r\n  } catch (eC) {}\r\n  return false;\r\n}\r\nfunction evShouldSipLove() {\r\n  if (evBool('evisc_love_sipped')) return false;\r\n  if (evHasAff('lovers') || evHasDef('lovers')) return false;\r\n  if (evCanSeeAffs()) return evHasAff('disloyalty');\r\n  return true;\r\n}\r\nfunction evMarkLoveSipped() {\r\n  evSet('evisc_love_sipped', '1');\r\n  evSet('evisc_love_target', evTarget());\r\n}\r\nfunction evClearLoveSip() {\r\n  evSet('evisc_love_sipped', '0');\r\n}\r\nfunction evResetLoveSipIfTargetChanged(tgt) {\r\n  var prev = evGet('evisc_love_target', '');\r\n  if (tgt && prev && String(tgt).toLowerCase() !== String(prev).toLowerCase()) {\r\n    evSet('evisc_love_sipped', '0');\r\n  }\r\n  evSet('evisc_love_target', tgt || '');\r\n}\r\nfunction evOpenSipPoisonist() {\r\n  if (evShouldSipLove()) {\r\n    evMarkLoveSipped();\r\n    return 'sm add FREE sip love|combatstyle poisonist';\r\n  }\r\n  return 'sm add FREE combatstyle poisonist';\r\n}\r\nfunction evOpenLollySipPoisonist() {\r\n  if (evShouldSipLove()) {\r\n    evMarkLoveSipped();\r\n    return 'sm add FREE outr redlollipop|eat redlollipop|sip love|combatstyle poisonist';\r\n  }\r\n  return 'sm add FREE outr redlollipop|eat redlollipop|combatstyle poisonist';\r\n}\r\n\r\nfunction evEnsure() {\r\n  if (!client.evisc) client.evisc = {};\r\n  var e = client.evisc;\r\n  if (!e.timers) e.timers = {};\r\n  return e;\r\n}\r\n\r\nfunction evClearTimer(name) {\r\n  var e = client.evisc;\r\n  if (!e || !e.timers) return;\r\n  var id = e.timers[name];\r\n  if (id) { clearTimeout(id); e.timers[name] = null; }\r\n}\r\n\r\nfunction evClearAllTimers() {\r\n  evClearTimer('remiss');\r\n  evClearTimer('lolly');\r\n  evClearTimer('assess');\r\n  evClearTimer('conc');\r\n  evClearTimer('poll');\r\n}\r\n\r\nfunction evCQ() {\r\n  return evBool('pEviscUseCrystalQueues') && get_variable('sCrystalQueuesVersion') != undefined;\r\n}\r\n\r\nfunction evAddQueue(cmd, label) {\r\n  if (!evCQ()) return false;\r\n  try {\r\n    run_function('add_to_queue', ['bal eq', 'eq', '5', '1', label || 'evisc', cmd, '', ''], 'CrystalQueues');\r\n    return true;\r\n  } catch (err) { return false; }\r\n}\r\n\r\nfunction evIsBalanceReady() {\r\n  try {\r\n    if (typeof GMCP !== 'undefined' && GMCP.Char) {\r\n      var B = GMCP.Char.Balance;\r\n      if (B && B.List) {\r\n        return (B.List.balance === '1' || B.List.balance === 1) && (B.List.equilibrium === '1' || B.List.equilibrium === 1);\r\n      }\r\n      if (B && B.balance !== undefined) {\r\n        return (B.balance === 0 || B.balance === '0') && (B.equilibrium === 0 || B.equilibrium === '0');\r\n      }\r\n      var V = GMCP.Char.Vitals;\r\n      if (V) {\r\n        return (V.balance === '1' || V.balance === 1) && (V.equilibrium === '1' || V.equilibrium === 1);\r\n      }\r\n    }\r\n  } catch (e0) {}\r\n  return true;\r\n}\r\n\r\nfunction evWall() { return Date.now() / 1000; }\r\n\r\nfunction evLollyCdLeft() {\r\n  var u = parseFloat(evGet('evisc_lolly_cd_until', '0'));\r\n  if (!u) return 0;\r\n  return Math.max(0, Math.ceil(u - evWall()));\r\n}\r\n\r\nfunction evLollyCanEat() { return evLollyCdLeft() <= 0; }\r\n\r\nvar LIMB_PH = { rarm: 'right rarm', larm: 'left larm', rleg: 'right rleg', lleg: 'left lleg' };\r\nfunction evLimbPhrase(code) {\r\n  if (!code) return 'right rarm';\r\n  return LIMB_PH[String(code).toLowerCase()] || 'right rarm';\r\n}\r\nfunction evPart(phrase) {\r\n  var m = String(phrase).match(/\\\\s+(\\\\S+)$/);\r\n  return m ? m[1] : phrase;\r\n}\r\n/** Nexus: no BM.isLimbDenied — prefer right rarm weakblood (matches Mudlet default path). */\r\nfunction evPickWb(tgt) {\r\n  var ph = evLimbPhrase('rarm');\r\n  if (evPart(ph) === 'rarm' && ph.indexOf('left') >= 0) ph = 'right rarm';\r\n  return ph;\r\n}\r\nfunction evPickStab(tgt, wbPh) {\r\n  var wbP = evPart(wbPh);\r\n  var ord = ['larm', 'rleg', 'lleg', 'rarm'];\r\n  var i, ph, p;\r\n  for (i = 0; i < ord.length; i++) {\r\n    if (ord[i] === wbP) continue;\r\n    ph = evLimbPhrase(ord[i]);\r\n    p = evPart(ph);\r\n    if (p !== wbP) return ph;\r\n  }\r\n  return 'left larm';\r\n}\r\n\r\nfunction evWoundIsCrit(limb) {\r\n  return String(evGet('bm_w_' + limb, '') || '').toLowerCase() === 'critical';\r\n}\r\nfunction evCritLatchFresh() {\r\n  var t = parseFloat(evGet('bm_w_crit_latch', '0')) || 0;\r\n  if (!t) return false;\r\n  return (Date.now() - t) <= 8000;\r\n}\r\nfunction evKnownChestGutCrit() {\r\n  return evCritLatchFresh() && (evWoundIsCrit('chest') || evWoundIsCrit('gut'));\r\n}\r\n\r\nfunction evAbort(reason) {\r\n  var e = client.evisc || {};\r\n  e.isExecuting = false;\r\n  e.continuationInProgress = false;\r\n  e.phase = 'idle';\r\n  e.comboType = '';\r\n  e.remissCallbackOp = '';\r\n  e.middleVolley = '';\r\n  e.assessPending = false;\r\n  e.eviscDiscernIssued = false;\r\n  evClearAllTimers();\r\n  display_notice('[Evisc] Aborted: ' + (reason || 'unknown'), 'yellow');\r\n  try { run_function('bm_restore_poisonist', '', 'BladeMaster Engine'); } catch (eRp) {}\r\n}\r\n\r\nfunction evRemissLine(tgt) {\r\n  return 'strike ' + tgt + ' lleg remiss damagedleftleg damagedrightleg';\r\n}\r\n\r\nfunction evFinaleBeast(tgt) {\r\n  return 'sm add beast order breathe plague ' + tgt + '|strike ' + tgt + ' left rarm stab|strike ' + tgt + ' right chest eviscerate';\r\n}\r\n\r\nfunction evRegisterRemissTimeout(comboTag) {\r\n  evClearTimer('remiss');\r\n  var e = evEnsure();\r\n  e.timers.remiss = setTimeout(function () {\r\n    e.timers.remiss = null;\r\n    if (!e.isExecuting) return;\r\n    if (e.phase !== 'wait_remiss_hit') return;\r\n    evAbort('remiss timeout (no thigh line in 8s)');\r\n  }, 8000);\r\n}\r\n\r\nfunction evAfterRemissHit() {\r\n  var e = evEnsure();\r\n  e.phase = 'after_remiss';\r\n  e.continuationInProgress = true;\r\n  var tgt = e.target;\r\n  var mid = e.middleVolley;\r\n  evClearTimer('remiss');\r\n  function goFinale() { run_function('evisc_main', 'finale_begin', 'BladeMaster Engine'); }\r\n  if (mid) {\r\n    e.phase = 'wait_bal_middle';\r\n    function tryMid() {\r\n      if (!evIsBalanceReady()) { e.timers.poll = setTimeout(tryMid, 120); return; }\r\n      e.timers.poll = null;\r\n      try { run_function('bm_stab_style', 'arm', 'BladeMaster Engine'); } catch (eSt) {}\r\n      send_command(mid, 0);\r\n      e.phase = 'wait_bal_after_middle';\r\n      function tryAfterMid() {\r\n        if (!evIsBalanceReady()) { e.timers.poll = setTimeout(tryAfterMid, 120); return; }\r\n        e.timers.poll = null;\r\n        goFinale();\r\n      }\r\n      tryAfterMid();\r\n    }\r\n    tryMid();\r\n    return;\r\n  }\r\n  goFinale();\r\n}\r\n\r\nfunction evSendFinaleClassic() {\r\n  var e = evEnsure();\r\n  var t = e.target;\r\n  if (!t) { evAbort('no target'); return; }\r\n  if (evCQ()) {\r\n    var qOk = evAddQueue(evFinaleBeast(t), 'evisc_beast') && evAddQueue('sm add FREE combatstyle concentrated', 'evisc_conc');\r\n    if (!qOk) {\r\n      display_notice('[Evisc] CrystalQueues enqueue failed — falling back to standalone finale.', 'yellow');\r\n    } else {\r\n      display_notice('[Evisc] Finale enqueued (CrystalQueues). Combo complete.', 'cyan');\r\n      evClearAllTimers();\r\n      evClearLoveSip();\r\n      e.phase = 'idle';\r\n      e.comboType = '';\r\n      e.continuationInProgress = false;\r\n      e.remissCallbackOp = '';\r\n      e.middleVolley = '';\r\n      e.assessPending = false;\r\n      e.isExecuting = false;\r\n      evRestorePoisonist();\r\n      return;\r\n    }\r\n  }\r\n  e.phase = 'wait_bal_finale_beast';\r\n  function stepBeast() {\r\n    if (!evIsBalanceReady()) { e.timers.poll = setTimeout(stepBeast, 120); return; }\r\n    e.timers.poll = null;\r\n    send_command(evFinaleBeast(t), 0);\r\n    evClearTimer('conc');\r\n    e.timers.conc = setTimeout(function () {\r\n      e.timers.conc = null;\r\n      send_command('sm add FREE combatstyle concentrated', 0);\r\n      try { run_function('bm_restore_poisonist', '', 'BladeMaster Engine'); } catch (eRp) {}\r\n      display_notice('[Evisc] Combo complete.', 'lightgreen');\r\n      evClearLoveSip();\r\n      e.isExecuting = false;\r\n      e.phase = 'idle';\r\n      e.comboType = '';\r\n      e.continuationInProgress = false;\r\n      evRestorePoisonist();\r\n    }, 1000);\r\n  }\r\n  stepBeast();\r\n}\r\n\r\n// ---- ops ----\r\nif (OP === 'toggle') {\r\n  var on = !evBool('pEviscEnabled');\r\n  evSet('pEviscEnabled', on ? '1' : '0');\r\n  display_notice('[Evisc] ' + (on ? 'ENABLED' : 'DISABLED'), on ? 'lightgreen' : 'red');\r\n  return;\r\n}\r\n\r\nif (OP === 'abort') {\r\n  if (client.evisc && client.evisc.isExecuting) evAbort('manual abort');\r\n  else display_notice('[Evisc] No combo running.', 'yellow');\r\n  return;\r\n}\r\n\r\nif (OP === 'balance' || OP === 'tick') {\r\n  var ex = client.evisc;\r\n  if (!ex || !ex.isExecuting) return;\r\n  if (ex.phase === 'wait_bal_prep') {\r\n    run_function('evisc_main', 'prep_continue', 'BladeMaster Engine');\r\n  }\r\n  return;\r\n}\r\n\r\nif (OP === 'remiss_hit') {\r\n  var exr = client.evisc;\r\n  if (!exr || !exr.isExecuting) return;\r\n  if (exr.phase !== 'wait_remiss_hit') return;\r\n  evAfterRemissHit();\r\n  return;\r\n}\r\n\r\nif (OP === 'assess_ok') {\r\n  var exa = client.evisc;\r\n  if (!exa || !exa.assessPending) return;\r\n  exa.assessPending = false;\r\n  evClearTimer('assess');\r\n  run_function('evisc_main', 'send_remiss_volley', 'BladeMaster Engine');\r\n  return;\r\n}\r\n\r\nif (OP === 'assess_timeout') {\r\n  var ext = client.evisc;\r\n  if (!ext || !ext.assessPending) return;\r\n  if (evBool('pEviscSkipAssess') || evKnownChestGutCrit()) {\r\n    ext.assessPending = false;\r\n    if (!evBool('pEviscSkipAssess')) {\r\n      display_notice('[Evisc] Assess timeout but tracker still C! — remiss', 'cyan');\r\n    }\r\n    run_function('evisc_main', 'send_remiss_volley', 'BladeMaster Engine');\r\n    return;\r\n  }\r\n  ext.assessPending = false;\r\n  evAbort('no critical chest/gut (assess/discern timeout — set pEviscSkipAssess 1 to skip gate)');\r\n  return;\r\n}\r\n\r\nif (OP === 'lolly_continue') {\r\n  var xl = client.evisc;\r\n  if (!xl || !xl.lollyPending) return;\r\n  xl.lollyPending = false;\r\n  evClearTimer('lolly');\r\n  run_function('evisc_main', 'prep_chain_entry', 'BladeMaster Engine');\r\n  return;\r\n}\r\n\r\nif (OP === 'finale_begin') {\r\n  evSendFinaleClassic();\r\n  return;\r\n}\r\n\r\nif (OP === 'prep_continue') {\r\n  var ec = evEnsure();\r\n  if (ec.phase !== 'wait_bal_prep') return;\r\n  run_function('evisc_main', 'prep_chain_entry', 'BladeMaster Engine');\r\n  return;\r\n}\r\n\r\nif (OP === 'send_remiss_volley') {\r\n  var er = evEnsure();\r\n  var tgt0 = er.target;\r\n  var rem = 'sm add ' + evRemissLine(tgt0);\r\n  send_command(rem, 0);\r\n  er.phase = 'wait_remiss_hit';\r\n  evRegisterRemissTimeout(er.comboType);\r\n  return;\r\n}\r\n\r\nif (OP === 'prep_chain_entry') {\r\n  var ep = evEnsure();\r\n  var t = ep.target;\r\n  if (!t) { evAbort('no target'); return; }\r\n  /** Only enter from sip/lolly wait phases once. If we stay on wait_bal_prep, every GMCP Balance/Vitals calls balance→prep_continue and would re-enter here and spam assess. */\r\n  if (ep.phase !== 'wait_bal_prep' && ep.phase !== 'wait_lolly_eat') return;\r\n  ep.phase = 'prep_chain';\r\n  function doAssessGate() {\r\n    if (evBool('pEviscSkipAssess')) {\r\n      run_function('evisc_main', 'send_remiss_volley', 'BladeMaster Engine');\r\n      return;\r\n    }\r\n    if (evKnownChestGutCrit()) {\r\n      display_notice('[Evisc] Tracker C! — remiss (skip assess gate)', 'cyan');\r\n      run_function('evisc_main', 'send_remiss_volley', 'BladeMaster Engine');\r\n      return;\r\n    }\r\n    if (ep.eviscDiscernIssued) return;\r\n    ep.eviscDiscernIssued = true;\r\n    ep.assessPending = true;\r\n    send_command('free assess ' + t, 0);\r\n    evClearTimer('assess');\r\n    ep.timers.assess = setTimeout(function () {\r\n      ep.timers.assess = null;\r\n      run_function('evisc_main', 'assess_timeout', 'BladeMaster Engine');\r\n    }, 4500);\r\n  }\r\n  function afterSip() {\r\n    if (!evIsBalanceReady()) { ep.timers.poll = setTimeout(afterSip, 120); return; }\r\n    ep.timers.poll = null;\r\n    display_notice('[Evisc] Prep done — assess / remiss…', 'cyan');\r\n    doAssessGate();\r\n  }\r\n  afterSip();\r\n  return;\r\n}\r\n\r\nif (OP === 'start' || OP === 'start2') {\r\n  if (!evBool('pEviscEnabled')) {\r\n    display_notice('[Evisc] Disabled. Type evistoggle.', 'red');\r\n    return;\r\n  }\r\n  var tg = evTarget();\r\n  if (!tg) {\r\n    display_notice('[Evisc] No target. Set bm_target with bmt <name> (Blademaster).', 'red');\r\n    return;\r\n  }\r\n  var e0 = evEnsure();\r\n  if (e0.isExecuting) evAbort('new combo started');\r\n  evClearAllTimers();\r\n  e0.eviscDiscernIssued = false;\r\n  e0.isExecuting = true;\r\n  e0.comboType = OP === 'start2' ? 'evisc2' : 'evisc';\r\n  e0.target = tg;\r\n  e0.lollyPending = false;\r\n  e0.assessPending = false;\r\n  e0.phase = 'prep';\r\n  evResetLoveSipIfTargetChanged(tg);\r\n  send_command('sm clear', 0);\r\n  display_notice('[Evisc] ' + (OP === 'start2' ? 'EVISC2' : 'EVISC') + ' starting on ' + tg + '…', 'orange');\r\n\r\n  var lollyOn = evBool('pEviscLollyPrep');\r\n  if (evBool('evisc_cheeky')) {\r\n    e0.middleVolley = 'sm add wonderpipe activate harshsmoke';\r\n  } else if (lollyOn) {\r\n    var wb0 = evPickWb(tg);\r\n    var st0 = evPickStab(tg, wb0);\r\n    e0.middleVolley = 'sm add arm strike ' + tg + ' ' + wb0 + ' weakblood|strike ' + tg + ' ' + st0 + ' stab';\r\n  } else {\r\n    e0.middleVolley = '';\r\n  }\r\n\r\n  if (lollyOn && evLollyCanEat()) {\r\n    e0.lollyPending = true;\r\n    e0.phase = 'wait_lolly_eat';\r\n    send_command(evOpenLollySipPoisonist(), 0);\r\n    evClearTimer('lolly');\r\n    e0.timers.lolly = setTimeout(function () {\r\n      run_function('evisc_main', 'lolly_continue', 'BladeMaster Engine');\r\n    }, 8000);\r\n  } else {\r\n    send_command(evOpenSipPoisonist(), 0);\r\n    e0.phase = 'wait_bal_prep';\r\n    function poll1() {\r\n      if (!e0.isExecuting) return;\r\n      if (evIsBalanceReady()) { run_function('evisc_main', 'prep_chain_entry', 'BladeMaster Engine'); return; }\r\n      e0.timers.poll = setTimeout(poll1, 120);\r\n    }\r\n    poll1();\r\n  }\r\n  return;\r\n}\r\n\n"},{"type":"function","name":"parry_vitals","enabled":true,"id":24,"code":"\r\nvar VITS = {};\r\ntry { VITS = JSON.parse(String(args || '{}')); } catch (e) { return; }\r\n\r\nvar WMAP = { head:'headwounds', chest:'chestwounds', gut:'gutwounds', leftarm:'leftarmwounds', rightarm:'rightarmwounds', leftleg:'leftlegwounds', rightleg:'rightlegwounds' };\r\nfunction getWounds() {\r\n  var w = {}, k, f;\r\n  for (k in WMAP) {\r\n    f = WMAP[k];\r\n    w[k] = parseInt(VITS[f], 10) || 0;\r\n  }\r\n  return w;\r\n}\r\nfunction psGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psSet(k, v) { set_variable(k, String(v)); }\r\nfunction getParries() {\r\n  try { return JSON.parse(psGet('ps_parries', '{}')); } catch (e) { return {}; }\r\n}\r\nfunction setParries(p) { psSet('ps_parries', JSON.stringify(p)); }\r\nfunction getLastWounds() {\r\n  try { return JSON.parse(psGet('ps_last_wounds', '{}')); } catch (e) { return {}; }\r\n}\r\nfunction setLastWounds(w) { psSet('ps_last_wounds', JSON.stringify(w)); }\r\n\r\nvar autoMode = (psGet('ps_auto_mode', 'off') || 'off').toLowerCase();\r\nvar wounds = getWounds();\r\nvar last = getLastWounds();\r\nvar changed = false;\r\nvar part;\r\nfor (part in wounds) {\r\n  if (last[part] !== wounds[part]) { changed = true; break; }\r\n}\r\nsetLastWounds(wounds);\r\nif (autoMode === 'off') return;\r\nif (!changed) return;\r\nrun_function('_parry', 'autotick', 'BladeMaster Engine');\r\n\n"},{"type":"function","name":"_parry","enabled":true,"id":25,"code":"\r\nvar raw = String(args || '');\r\nvar a = raw.split('|');\r\nvar op = a[0] || '';\r\n\r\nvar BODY = { head:1,chest:1,gut:1,leftarm:1,rightarm:1,leftleg:1,rightleg:1,arms:1,legs:1 };\r\nvar B2G = { head:'HEAD',chest:'CHEST',gut:'GUT',leftarm:'LARM',rightarm:'RARM',leftleg:'LLEG',rightleg:'RLEG' };\r\nvar STPROT = {\r\n  legs:['leftleg','rightleg'], arms:['leftarm','rightarm'], gut:['gut'], chest:['chest'], head:['head'],\r\n  left:['leftarm','leftleg'], right:['rightarm','rightleg'], lower:['gut','leftleg','rightleg'],\r\n  middle:['chest','gut','leftarm','rightarm'], upper:['head','chest','leftarm','rightarm'], vitals:['head','chest','gut']\r\n};\r\nvar WMAP = { head:'headwounds', chest:'chestwounds', gut:'gutwounds', leftarm:'leftarmwounds', rightarm:'rightarmwounds', leftleg:'leftlegwounds', rightleg:'rightlegwounds' };\r\n\r\nfunction psGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psSet(k, v) { set_variable(k, String(v)); }\r\nfunction getParries() {\r\n  try { return JSON.parse(psGet('ps_parries', '{}')); } catch (e) { return {}; }\r\n}\r\nfunction setParries(p) { psSet('ps_parries', JSON.stringify(p)); }\r\nfunction getStance() { return (psGet('ps_stance', '') || '').toLowerCase(); }\r\nfunction putStance(s) { psSet('ps_stance', s || ''); }\r\n\r\nfunction normPart(s) {\r\n  s = String(s).toLowerCase();\r\n  s = s.replace(/left\\\\s+arm/g, 'leftarm').replace(/right\\\\s+arm/g, 'rightarm')\r\n    .replace(/left\\\\s+leg/g, 'leftleg').replace(/right\\\\s+leg/g, 'rightleg').replace(/\\\\s+/g, '');\r\n  return s;\r\n}\r\n\r\nfunction readLiveWounds() {\r\n  var w = {}, k, lj = psGet('ps_last_wounds', '{}'), bag;\r\n  try { bag = JSON.parse(lj); } catch (e) { bag = {}; }\r\n  for (k in WMAP) {\r\n    w[k] = parseInt(bag[k], 10) || 0;\r\n  }\r\n  return w;\r\n}\r\n\r\nfunction updateHud() {\r\n  var pr = getParries(), cnt = 0, k, parts = [], txt, st = getStance();\r\n  for (k in pr) { if (pr.hasOwnProperty(k)) cnt++; }\r\n  if (!cnt) txt = 'None';\r\n  else {\r\n    for (k in pr) { if (pr.hasOwnProperty(k)) parts.push(k + '(' + pr[k] + ')'); }\r\n    parts.sort();\r\n    txt = parts.join(', ');\r\n    if (txt.length > 40) txt = txt.substring(0, 37) + '...';\r\n  }\r\n  psSet('ps_hud_parry', txt);\r\n  psSet('ps_hud_stance', st ? st.toUpperCase() : 'None');\r\n}\r\n\r\nfunction sendParryLine(cmd) { send_command(cmd, 0); }\r\n\r\nfunction setParry(bodyPart, weight) {\r\n  if (!bodyPart) { showParryStatus(); return; }\r\n  bodyPart = normPart(bodyPart);\r\n  if (bodyPart === 'all') { parryAll(weight); return; }\r\n  if (!BODY[bodyPart]) {\r\n    display_notice('[Parry] Invalid body part: ' + bodyPart, 'red');\r\n    return;\r\n  }\r\n  weight = parseInt(weight, 10);\r\n  if (isNaN(weight)) weight = 50;\r\n  if (weight < 0 || weight > 100) { display_notice('[Parry] Weight must be 0-100', 'red'); return; }\r\n  var pr = getParries();\r\n  if (bodyPart === 'arms') {\r\n    pr.leftarm = weight; pr.rightarm = weight;\r\n    sendParryLine('PARRY ' + B2G.leftarm + ' ' + weight);\r\n    sendParryLine('PARRY ' + B2G.rightarm + ' ' + weight);\r\n  } else if (bodyPart === 'legs') {\r\n    pr.leftleg = weight; pr.rightleg = weight;\r\n    sendParryLine('PARRY ' + B2G.leftleg + ' ' + weight);\r\n    sendParryLine('PARRY ' + B2G.rightleg + ' ' + weight);\r\n  } else {\r\n    pr[bodyPart] = weight;\r\n    sendParryLine('PARRY ' + (B2G[bodyPart] || bodyPart.toUpperCase()) + ' ' + weight);\r\n  }\r\n  setParries(pr);\r\n  display_notice('[Parry] Set ' + bodyPart + ' to ' + weight, 'green');\r\n  updateHud();\r\n}\r\n\r\nfunction parryAll(weight) {\r\n  weight = parseInt(weight, 10);\r\n  if (isNaN(weight)) weight = 50;\r\n  if (weight < 0 || weight > 100) { display_notice('[Parry] Weight must be 0-100', 'red'); return; }\r\n  sendParryLine('PARRY ALL');\r\n  var pr = {}, k;\r\n  for (k in BODY) {\r\n    if (k !== 'arms' && k !== 'legs') pr[k] = weight;\r\n  }\r\n  pr.leftarm = pr.rightarm = pr.leftleg = pr.rightleg = weight;\r\n  setParries(pr);\r\n  display_notice('[Parry] Set all body parts to ' + weight, 'green');\r\n  updateHud();\r\n}\r\n\r\nfunction unparry() {\r\n  sendParryLine('UNPARRY');\r\n  setParries({});\r\n  display_notice('[Parry] All parries removed', 'green');\r\n  updateHud();\r\n}\r\n\r\nfunction showParryStatus() {\r\n  var pr = getParries(), k, n = 0;\r\n  for (k in pr) { if (pr.hasOwnProperty(k)) n++; }\r\n  if (!n) { display_notice('[Parry] No active parries', 'yellow'); return; }\r\n  display_notice('[Parry Status]', 'cyan');\r\n  for (k in pr) {\r\n    if (pr.hasOwnProperty(k)) display_notice('  ' + k + ': ' + pr[k], 'white');\r\n  }\r\n}\r\n\r\nfunction userSetStance(stance) {\r\n  if (!stance) { showStanceStatus(); return; }\r\n  stance = String(stance).toLowerCase();\r\n  if (!STPROT[stance]) {\r\n    display_notice('[Stance] Invalid stance: ' + stance, 'red');\r\n    return;\r\n  }\r\n  sendParryLine('STANCE ' + stance.toUpperCase());\r\n  putStance(stance);\r\n  display_notice('[Stance] Set to ' + stance.toUpperCase(), 'green');\r\n  if (STPROT[stance]) display_notice('  Protects: ' + STPROT[stance].join(', '), 'cyan');\r\n  updateHud();\r\n}\r\n\r\nfunction showStanceStatus() {\r\n  var st = getStance();\r\n  if (!st) { display_notice('[Stance] No active stance', 'yellow'); return; }\r\n  display_notice('[Stance Status]', 'cyan');\r\n  display_notice('  Current: ' + st.toUpperCase(), 'white');\r\n  if (STPROT[st]) display_notice('  Protects: ' + STPROT[st].join(', '), 'yellow');\r\n}\r\n\r\nfunction getMostWoundedParts(wounds, count) {\r\n  count = count || 3;\r\n  var arr = [], k, v;\r\n  for (k in wounds) {\r\n    v = wounds[k];\r\n    if (v > 0) arr.push({ part: k, value: v });\r\n  }\r\n  arr.sort(function (x, y) { return y.value - x.value; });\r\n  var out = [], i;\r\n  for (i = 0; i < arr.length && i < count; i++) out.push(arr[i].part);\r\n  return out;\r\n}\r\n\r\nfunction findBestStance(woundedParts) {\r\n  if (!woundedParts.length) return null;\r\n  var ws = {}, i, stance, prot, score, totalProtected, efficiency, finalScore, j, p, bestStance = null, bestScore = 0;\r\n  for (i = 0; i < woundedParts.length; i++) ws[woundedParts[i]] = true;\r\n  for (stance in STPROT) {\r\n    prot = STPROT[stance];\r\n    score = 0;\r\n    totalProtected = prot.length;\r\n    for (j = 0; j < prot.length; j++) {\r\n      if (ws[prot[j]]) score++;\r\n    }\r\n    if (totalProtected > 0) {\r\n      efficiency = score / totalProtected;\r\n      finalScore = efficiency * score;\r\n      if (score === woundedParts.length) finalScore += 10;\r\n      if (finalScore > bestScore) { bestScore = finalScore; bestStance = stance; }\r\n    }\r\n  }\r\n  return bestStance;\r\n}\r\n\r\nfunction autoAdjustStance(woundedParts) {\r\n  if (psGet('ps_auto_mode', 'off') === 'off') return;\r\n  var best = findBestStance(woundedParts);\r\n  var cur = getStance();\r\n  if (best && best !== cur) {\r\n    sendParryLine('STANCE ' + best.toUpperCase());\r\n    putStance(best);\r\n    display_notice('[AutoStance] Changed to ' + best.toUpperCase(), 'cyan');\r\n    updateHud();\r\n  }\r\n}\r\n\r\nfunction setStanceForFixedPart() {\r\n  var mode = psGet('ps_auto_mode', 'off');\r\n  if (mode === 'off' || mode === 'full') return;\r\n  var fixed = normPart(psGet('ps_auto50_part', 'head'));\r\n  var stance = null;\r\n  if (fixed === 'head') stance = 'head';\r\n  else if (fixed === 'chest') stance = 'chest';\r\n  else if (fixed === 'gut') stance = 'gut';\r\n  else if (fixed === 'arms') stance = 'arms';\r\n  else if (fixed === 'legs') stance = 'legs';\r\n  else if (fixed === 'leftarm' || fixed === 'leftleg') stance = 'left';\r\n  else if (fixed === 'rightarm' || fixed === 'rightleg') stance = 'right';\r\n  var cur = getStance();\r\n  if (stance && stance !== cur) {\r\n    sendParryLine('STANCE ' + stance.toUpperCase());\r\n    putStance(stance);\r\n    display_notice('[AutoStance] Set to ' + stance.toUpperCase() + ' for ' + fixed, 'cyan');\r\n    updateHud();\r\n  }\r\n}\r\n\r\nfunction applyParryMap(newParries) {\r\n  var pr = getParries(), k, needs = false;\r\n  for (k in newParries) {\r\n    if (newParries[k] !== pr[k]) { needs = true; break; }\r\n  }\r\n  if (!needs) {\r\n    for (k in pr) {\r\n      if (pr.hasOwnProperty(k) && newParries[k] === undefined) { needs = true; break; }\r\n    }\r\n  }\r\n  if (!needs) return false;\r\n  var line = 'UNPARRY', sep = ';;';\r\n  line += sep;\r\n  pr = {};\r\n  for (k in newParries) {\r\n    if (newParries.hasOwnProperty(k)) {\r\n      pr[k] = newParries[k];\r\n      line += 'PARRY ' + (B2G[k] || k.toUpperCase()) + ' ' + newParries[k] + sep;\r\n    }\r\n  }\r\n  if (line.length >= sep.length && line.substring(line.length - sep.length) === sep) line = line.substring(0, line.length - sep.length);\r\n  send_command(line, 0);\r\n  setParries(pr);\r\n  updateHud();\r\n  return true;\r\n}\r\n\r\nfunction autoAdjustFull() {\r\n  var wounds = readLiveWounds(), most = getMostWoundedParts(wounds, 3), wv, i, part;\r\n  if (!most.length) {\r\n    if (applyParryMap({ chest: 50, gut: 50 })) {\r\n      display_notice('[AutoParry] Idle: 50 chest / 50 gut', 'cyan');\r\n    }\r\n    if (getStance() !== 'middle') {\r\n      sendParryLine('STANCE MIDDLE');\r\n      putStance('middle');\r\n      display_notice('[AutoStance] Idle: STANCE MIDDLE', 'cyan');\r\n      updateHud();\r\n    }\r\n    return;\r\n  }\r\n  var totalWoundValue = 0;\r\n  for (i = 0; i < most.length; i++) totalWoundValue += wounds[most[i]];\r\n  var newParries = {}, totalWeight = 0, weight, adjust;\r\n  for (i = 0; i < most.length; i++) {\r\n    part = most[i];\r\n    if (totalWoundValue > 0) {\r\n      weight = Math.floor(100 * wounds[part] / totalWoundValue);\r\n      weight = Math.max(15, Math.min(100, weight));\r\n } else weight = Math.floor(100 / most.length);\r\n    newParries[part] = weight;\r\n    totalWeight += weight;\r\n  }\r\n  if (totalWeight !== 100 && totalWeight > 0) {\r\n    adjust = 100 - totalWeight;\r\n    newParries[most[0]] = (newParries[most[0]] || 0) + adjust;\r\n  }\r\n  if (applyParryMap(newParries)) {\r\n    display_notice('[AutoParry] Adjusted: ' + most.join(', '), 'cyan');\r\n  }\r\n  autoAdjustStance(most);\r\n}\r\n\r\nfunction autoAdjust50() {\r\n  var wounds = readLiveWounds(), most = getMostWoundedParts(wounds, 3), newParries = {}, i, part;\r\n  var totalWoundValue, ratio, weight, totalWoundedWeight, adjust, woundedList, fixedText;\r\n  if (!most.length) {\r\n    var ap = normPart(psGet('ps_auto50_part', 'head'));\r\n    if (ap === 'arms') { newParries.leftarm = 50; newParries.rightarm = 50; }\r\n    else if (ap === 'legs') { newParries.leftleg = 50; newParries.rightleg = 50; }\r\n    else newParries[ap] = 100;\r\n  } else {\r\n    totalWoundValue = 0;\r\n    for (i = 0; i < most.length; i++) totalWoundValue += wounds[most[i]];\r\n    totalWoundedWeight = 0;\r\n    for (i = 0; i < most.length; i++) {\r\n      part = most[i];\r\n      if (totalWoundValue > 0) {\r\n        weight = Math.floor(50 * wounds[part] / totalWoundValue);\r\n        weight = Math.max(15, Math.min(50, weight));\r\n      } else weight = Math.floor(50 / most.length);\r\n      newParries[part] = weight;\r\n      totalWoundedWeight += weight;\r\n    }\r\n    if (totalWoundedWeight !== 50 && totalWoundedWeight > 0) {\r\n      adjust = 50 - totalWoundedWeight;\r\n      newParries[most[0]] = (newParries[most[0]] || 0) + adjust;\r\n    }\r\n    ap = normPart(psGet('ps_auto50_part', 'head'));\r\n    if (ap === 'arms') { newParries.leftarm = 25; newParries.rightarm = 25; }\r\n    else if (ap === 'legs') { newParries.leftleg = 25; newParries.rightleg = 25; }\r\n    else newParries[ap] = 50;\r\n  }\r\n  woundedList = most.join(', ');\r\n  if (applyParryMap(newParries)) {\r\n    fixedText = psGet('ps_auto50_part', 'head');\r\n    if (fixedText === 'arms') fixedText = 'arms (25% each)';\r\n    if (fixedText === 'legs') fixedText = 'legs (25% each)';\r\n    display_notice('[AutoParry 50/50] Wounded: ' + woundedList + ' Fixed: ' + fixedText, 'cyan');\r\n  }\r\n  if (!most.length) setStanceForFixedPart();\r\n  else {\r\n    var stanceParts = most.slice();\r\n    ap = normPart(psGet('ps_auto50_part', 'head'));\r\n    var hasL, hasR, hasFixed, j;\r\n    if (ap === 'arms') {\r\n      hasL = hasR = false;\r\n      for (j = 0; j < stanceParts.length; j++) {\r\n        if (stanceParts[j] === 'leftarm') hasL = true;\r\n        if (stanceParts[j] === 'rightarm') hasR = true;\r\n      }\r\n      if (!hasL) stanceParts.push('leftarm');\r\n      if (!hasR) stanceParts.push('rightarm');\r\n    } else if (ap === 'legs') {\r\n      hasL = hasR = false;\r\n      for (j = 0; j < stanceParts.length; j++) {\r\n        if (stanceParts[j] === 'leftleg') hasL = true;\r\n        if (stanceParts[j] === 'rightleg') hasR = true;\r\n      }\r\n      if (!hasL) stanceParts.push('leftleg');\r\n      if (!hasR) stanceParts.push('rightleg');\r\n    } else {\r\n      hasFixed = false;\r\n      for (j = 0; j < stanceParts.length; j++) {\r\n        if (stanceParts[j] === ap) { hasFixed = true; break; }\r\n      }\r\n      if (!hasFixed) stanceParts.push(ap);\r\n    }\r\n    autoAdjustStance(stanceParts);\r\n  }\r\n}\r\n\r\nfunction autoAdjust75() {\r\n  var wounds = readLiveWounds(), most = getMostWoundedParts(wounds, 3), newParries = {}, i, part, ap;\r\n  var totalWoundValue, weight, totalWoundedWeight, adjust, woundedList, fixedText;\r\n  if (!most.length) {\r\n    ap = normPart(psGet('ps_auto50_part', 'head'));\r\n    if (ap === 'arms') { newParries.leftarm = 50; newParries.rightarm = 50; }\r\n    else if (ap === 'legs') { newParries.leftleg = 50; newParries.rightleg = 50; }\r\n    else newParries[ap] = 100;\r\n  } else {\r\n    totalWoundValue = 0;\r\n    for (i = 0; i < most.length; i++) totalWoundValue += wounds[most[i]];\r\n    totalWoundedWeight = 0;\r\n    for (i = 0; i < most.length; i++) {\r\n      part = most[i];\r\n      if (totalWoundValue > 0) {\r\n        weight = Math.floor(70 * wounds[part] / totalWoundValue);\r\n        weight = Math.max(20, Math.min(70, weight));\r\n      } else weight = Math.floor(70 / most.length);\r\n      newParries[part] = weight;\r\n      totalWoundedWeight += weight;\r\n    }\r\n    if (totalWoundedWeight !== 70 && totalWoundedWeight > 0) {\r\n      adjust = 70 - totalWoundedWeight;\r\n      newParries[most[0]] = (newParries[most[0]] || 0) + adjust;\r\n    }\r\n    ap = normPart(psGet('ps_auto50_part', 'head'));\r\n    if (ap === 'arms') { newParries.leftarm = 15; newParries.rightarm = 15; }\r\n    else if (ap === 'legs') { newParries.leftleg = 15; newParries.rightleg = 15; }\r\n    else newParries[ap] = 30;\r\n  }\r\n  woundedList = most.join(', ');\r\n  if (applyParryMap(newParries)) {\r\n    fixedText = psGet('ps_auto50_part', 'head');\r\n    if (fixedText === 'arms') fixedText = 'arms (15% each)';\r\n    if (fixedText === 'legs') fixedText = 'legs (15% each)';\r\n    display_notice('[AutoParry 70/30] Wounded: ' + woundedList + ' Fixed: ' + fixedText, 'cyan');\r\n  }\r\n  if (!most.length) setStanceForFixedPart();\r\n  else {\r\n    var stanceParts = most.slice();\r\n    ap = normPart(psGet('ps_auto50_part', 'head'));\r\n    var hasL, hasR, hasFixed, j;\r\n    if (ap === 'arms') {\r\n      hasL = hasR = false;\r\n      for (j = 0; j < stanceParts.length; j++) {\r\n        if (stanceParts[j] === 'leftarm') hasL = true;\r\n        if (stanceParts[j] === 'rightarm') hasR = true;\r\n      }\r\n      if (!hasL) stanceParts.push('leftarm');\r\n      if (!hasR) stanceParts.push('rightarm');\r\n    } else if (ap === 'legs') {\r\n      hasL = hasR = false;\r\n      for (j = 0; j < stanceParts.length; j++) {\r\n        if (stanceParts[j] === 'leftleg') hasL = true;\r\n        if (stanceParts[j] === 'rightleg') hasR = true;\r\n      }\r\n      if (!hasL) stanceParts.push('leftleg');\r\n      if (!hasR) stanceParts.push('rightleg');\r\n    } else {\r\n      hasFixed = false;\r\n      for (j = 0; j < stanceParts.length; j++) {\r\n        if (stanceParts[j] === ap) { hasFixed = true; break; }\r\n      }\r\n      if (!hasFixed) stanceParts.push(ap);\r\n    }\r\n    autoAdjustStance(stanceParts);\r\n  }\r\n}\r\n\r\nfunction autoAdjust25Split() {\r\n  var wounds = readLiveWounds(), most = getMostWoundedParts(wounds, 3), newParries = {}, i, part;\r\n  var totalWoundValue, totalWoundedWeight, adjust, woundedList;\r\n  newParries.head = 25; newParries.chest = 25; newParries.gut = 25;\r\n  if (!most.length) {\r\n    newParries.head = 33; newParries.chest = 33; newParries.gut = 34;\r\n  } else {\r\n    totalWoundValue = 0;\r\n    for (i = 0; i < most.length; i++) totalWoundValue += wounds[most[i]];\r\n    totalWoundedWeight = 0;\r\n    for (i = 0; i < most.length; i++) {\r\n      part = most[i];\r\n      if (totalWoundValue > 0) {\r\n        var weight = Math.floor(25 * wounds[part] / totalWoundValue);\r\n        weight = Math.max(5, Math.min(25, weight));\r\n      } else weight = Math.floor(25 / most.length);\r\n      newParries[part] = (newParries[part] || 0) + weight;\r\n      totalWoundedWeight += weight;\r\n    }\r\n    if (totalWoundedWeight !== 25 && totalWoundedWeight > 0) {\r\n      adjust = 25 - totalWoundedWeight;\r\n      newParries[most[0]] = (newParries[most[0]] || 0) + adjust;\r\n    }\r\n  }\r\n  woundedList = most.length ? most.join(', ') : 'none';\r\n  if (applyParryMap(newParries)) {\r\n    display_notice('[AutoParry 25split] Wounded: ' + woundedList, 'cyan');\r\n  }\r\n  if (getStance() !== 'vitals') {\r\n    sendParryLine('STANCE VITALS');\r\n    putStance('vitals');\r\n    display_notice('[AutoStance] Set to VITALS', 'cyan');\r\n    updateHud();\r\n  }\r\n}\r\n\r\nfunction setAutoMode(mode, part) {\r\n  mode = (mode || 'off').toLowerCase();\r\n  if (mode === 'off') {\r\n    psSet('ps_auto_mode', 'off');\r\n    display_notice('[AutoParry] Disabled', 'yellow');\r\n    updateHud();\r\n    return;\r\n  }\r\n  if (mode === 'full') {\r\n    psSet('ps_auto_mode', 'full');\r\n    display_notice('[AutoParry] Full responsive mode enabled', 'green');\r\n    psSet('ps_last_wounds', '{}');\r\n    autoAdjustFull();\r\n    return;\r\n  }\r\n  if (mode === '50' || mode === 'fifty' || mode === 'half') {\r\n    psSet('ps_auto_mode', '50');\r\n    if (part) {\r\n      part = normPart(part);\r\n      if (BODY[part]) {\r\n        psSet('ps_auto50_part', part);\r\n        display_notice('[AutoParry] 50/50 fixed part: ' + part, 'green');\r\n      } else display_notice('[AutoParry] Invalid part, keeping ' + psGet('ps_auto50_part', 'head'), 'yellow');\r\n    } else display_notice('[AutoParry] 50/50 mode on ' + psGet('ps_auto50_part', 'head'), 'green');\r\n    psSet('ps_last_wounds', '{}');\r\n    autoAdjust50();\r\n    setStanceForFixedPart();\r\n    updateHud();\r\n    return;\r\n  }\r\n  if (mode === '75' || mode === 'seventyfive') {\r\n    psSet('ps_auto_mode', '75');\r\n    if (part) {\r\n      part = normPart(part);\r\n      if (BODY[part]) psSet('ps_auto50_part', part);\r\n    }\r\n    display_notice('[AutoParry] 70/30 mode', 'green');\r\n    psSet('ps_last_wounds', '{}');\r\n    autoAdjust75();\r\n    setStanceForFixedPart();\r\n    updateHud();\r\n    return;\r\n  }\r\n  if (mode === '25split' || mode === 'vitals' || mode === '25') {\r\n    psSet('ps_auto_mode', '25split');\r\n    display_notice('[AutoParry] 25split mode', 'green');\r\n    psSet('ps_last_wounds', '{}');\r\n    autoAdjust25Split();\r\n    updateHud();\r\n    return;\r\n  }\r\n  display_notice('[AutoParry] Invalid mode (off|full|50|75|25split)', 'red');\r\n}\r\n\r\nfunction showAutoStatus() {\r\n  var mode = psGet('ps_auto_mode', 'off');\r\n  display_notice('[AutoParry Status] Mode: ' + mode, 'cyan');\r\n  if (mode === '50' || mode === '75') {\r\n    display_notice('  Fixed part: ' + psGet('ps_auto50_part', 'head'), 'white');\r\n  }\r\n  var w = readLiveWounds(), k, any = false;\r\n  for (k in w) { if (w[k] > 0) { any = true; break; } }\r\n  if (any) {\r\n    display_notice('  Wounds:', 'white');\r\n    for (k in w) { if (w[k] > 0) display_notice('    ' + k + ': ' + w[k], 'red'); }\r\n  } else display_notice('  No wounds in last GMCP vitals', 'white');\r\n}\r\n\r\nfunction showHelp() {\r\n  display_notice('ParryStance Nexus — mirrors Mudlet XPARRY* commands', 'gold');\r\n  display_notice(' ', 'cyan');\r\n  display_notice('Parry:', 'cyan');\r\n  display_notice('  XPARRY — show current parry weights', 'cyan');\r\n  display_notice('  XPARRY <part> [weight] — set parry (weight 0-100, default 50)', 'cyan');\r\n  display_notice('  XPARRY ALL [weight] — PARRY ALL', 'cyan');\r\n  display_notice('  Parts: head chest gut leftarm rightarm leftleg rightleg arms legs', 'cyan');\r\n  display_notice('  XUNPARRY — clear all parries', 'cyan');\r\n  display_notice(' ', 'cyan');\r\n  display_notice('Stance:', 'cyan');\r\n  display_notice('  XSTANCE — show current stance', 'cyan');\r\n  display_notice('  XSTANCE <name> — legs arms gut chest head left right lower middle upper vitals', 'cyan');\r\n  display_notice(' ', 'cyan');\r\n  display_notice('Auto parry (needs GMCP Char.Vitals wound fields):', 'cyan');\r\n  display_notice('  XAUTOPARRY — show mode and wounds', 'cyan');\r\n  display_notice('  XAUTOPARRY off — disable auto', 'cyan');\r\n  display_notice('  XAUTOPARRY full — full responsive', 'cyan');\r\n  display_notice('  XAUTOPARRY 50 [part] — 50/50 split', 'cyan');\r\n  display_notice('  XAUTOPARRY 75 [part] — 70/30 split', 'cyan');\r\n  display_notice('  XAUTOPARRY 25split — vitals 25% split', 'cyan');\r\n  display_notice('  XAUTOPARRYOFF  XAUTOPARRYFULL  XAUTOPARRY50 [part]', 'cyan');\r\n  display_notice(' ', 'cyan');\r\n  display_notice('Keyboard shortcuts (hold Ctrl; US QWERTY letter row):', 'gold');\r\n  display_notice('  Ctrl+Q — XAUTOPARRY full (fully responsive)', 'cyan');\r\n  display_notice('  Ctrl+W — XAUTOPARRY 25split', 'cyan');\r\n  display_notice('  Ctrl+E — XAUTOPARRY 50 head (50/50 head fixed)', 'cyan');\r\n  display_notice('  Ctrl+R — XAUTOPARRY 75 head (70/30 head fixed)', 'cyan');\r\n  display_notice('  Ctrl+T — XAUTOPARRY 50 chest', 'cyan');\r\n  display_notice('  Ctrl+Y — XAUTOPARRY 75 chest', 'cyan');\r\n  display_notice('  Ctrl+U — XAUTOPARRY 50 gut', 'cyan');\r\n  display_notice('  Ctrl+I — XAUTOPARRY 75 gut', 'cyan');\r\n  display_notice('  Ctrl+O — XAUTOPARRY 50 arms', 'cyan');\r\n  display_notice('  Ctrl+P — XAUTOPARRY 75 arms', 'cyan');\r\n  display_notice('  Ctrl+[ — XAUTOPARRY 50 legs', 'cyan');\r\n  display_notice('  Ctrl+] — XAUTOPARRY 75 legs', 'cyan');\r\n  display_notice('  Typed: xautoparry25split, xautoparry50head, xautoparry75head, xautoparry50chest, xautoparry75chest, xautoparry50gut, xautoparry75gut, xautoparry50arms, xautoparry75arms, xautoparry50legs, xautoparry75legs', 'cyan');\r\n  display_notice(' ', 'cyan');\r\n  display_notice('Variables: ps_hud_parry  ps_hud_stance (gauges / buttons)', 'cyan');\r\n  display_notice('Stack delineator ;; recommended (same as Blademaster package)', 'cyan');\r\n  display_notice('Custom onGMCP? Merge Char.Vitals call from package onGMCP if auto modes never fire', 'cyan');\r\n}\r\n\r\nfunction parseXparryArg(str) {\r\n  str = String(str || '').trim();\r\n  if (!str) { showParryStatus(); return; }\r\n  var tokens = str.split(/\\\\s+/), last = tokens[tokens.length - 1], w = parseInt(last, 10), body;\r\n  if (!isNaN(w) && String(w) === last && tokens.length > 1) {\r\n    body = tokens.slice(0, -1).join(' ');\r\n    setParry(body, w);\r\n  } else setParry(str, 50);\r\n}\r\n\r\nfunction parseXautoparry(str) {\r\n  str = String(str || '').trim();\r\n  if (!str) { showAutoStatus(); return; }\r\n  var tokens = str.split(/\\\\s+/);\r\n  if (tokens.length === 1) setAutoMode(tokens[0]);\r\n  else setAutoMode(tokens[0], tokens.slice(1).join(' '));\r\n}\r\n\r\nif (op === 'autotick') {\r\n  var am = psGet('ps_auto_mode', 'off');\r\n  if (am === 'full') autoAdjustFull();\r\n  else if (am === '50') autoAdjust50();\r\n  else if (am === '75') autoAdjust75();\r\n  else if (am === '25split') autoAdjust25Split();\r\n} else if (op === 'unparry') unparry();\r\nelse if (op === 'xparry') parseXparryArg(a.slice(1).join('|'));\r\nelse if (op === 'xstance') {\r\n  var rest = a.slice(1).join('|').trim();\r\n  if (!rest) showStanceStatus();\r\n  else userSetStance(rest);\r\n} else if (op === 'xautoparry') parseXautoparry(a.slice(1).join('|'));\r\nelse if (op === 'help') showHelp();\r\nelse if (op === 'hud') updateHud();\r\nelse if (op === 'key') setAutoMode(a[1] || 'off', a[2] || '');\r\n\n"},{"type":"function","name":"psnm_maint_tick","enabled":true,"id":26,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  function bmEngineOn() {\n  var v = get_variable('bm_engine');\n  if (v === undefined || v === null || v === '') return true;\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nif (psnmGet('psnm_maintenance', '0') !== '1') return;\nif (!bmEngineOn()) { psnmScheduleMaint(); return; }\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nif (psnmGet('psnm_maintenance', '0') !== '1') return;\r\nvar P = client.psnm_P || psnmBuildProfiles();\r\nvar eff = psnmEffectiveProfileKey();\r\nvar profile = P[eff];\r\nif (!profile) {\r\n  display_notice('[PoisonManager] No profile for current weapon mode', 'yellow');\r\n  psnmSet('psnm_maintenance', '0');\r\n  psnmClearMaintTimeout();\r\n  return;\r\n}\r\nvar w = psnmGetWeaponsForPoison();\r\nif (!w.left) return;\r\nvar leftPattern = profile.left || [];\r\nvar rightPattern = profile.right || [];\r\nvar dual = profile.dualWield !== false;\r\nvar nl = leftPattern.length;\r\nvar nr = rightPattern.length;\r\n\r\nif (psnmIsCeGated()) {\r\n  psnmScheduleMaint();\r\n  return;\r\n}\r\n\r\nif (w.left && nl > 0) {\r\n  var pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n  pl = (pl % nl) + 1;\r\n  psnmSet('psnm_maint_pos_left', String(pl));\r\n  var poisonL = leftPattern[pl - 1];\r\n  send_command('ENVENOM ' + w.left + ' WITH ' + poisonL, 0);\r\n}\r\nif (dual && w.right && nr > 0) {\r\n  setTimeout(function () {\r\n    if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n    var w2 = psnmGetWeaponsForPoison();\r\n    var P2 = client.psnm_P || psnmBuildProfiles();\r\n    var eff2 = psnmEffectiveProfileKey();\r\n    var prof2 = P2[eff2];\r\n    if (!prof2 || prof2.dualWield === false) { psnmScheduleMaint(); return; }\r\n    var rp = prof2.right || [];\r\n    if (!w2.right || !rp.length) { psnmScheduleMaint(); return; }\r\n    var pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rp.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    var poisonR = rp[pr - 1];\r\n    send_command('ENVENOM ' + w2.right + ' WITH ' + poisonR, 0);\r\n    psnmScheduleMaint();\r\n  }, 200);\r\n} else {\r\n  psnmScheduleMaint();\r\n}\r\n\n"},{"type":"function","name":"psnm_set_maint_arg","enabled":true,"id":27,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar raw = (String(args || '')).trim();\r\nvar arg = raw.toLowerCase().replace(/\\\\s+/g, '');\r\nif (arg === 'menu') {\r\n  display_notice('[PoisonManager] Commands only on Nexus. xpoisons / psnmsync / psnmrapiers / psnmbastard / psnmcane.', 'cyan');\r\n  return;\r\n}\r\nif (arg === 'cane') {\r\n  psnmClearSyncTimeout();\r\n  psnmClearMaintTimeout();\r\n  psnmSet('psnm_weapon_mode', 'none');\r\n  psnmSet('psnm_maintenance', '0');\r\n  display_notice('[PoisonManager] Cane/none mode — maintenance off.', 'yellow');\r\n  return;\r\n}\r\nvar on = false;\r\nif (arg === 'on' || arg === 'enable' || arg === 'start' || arg === '1' || arg === 'true') on = true;\r\nelse if (arg === 'off' || arg === 'disable' || arg === 'stop' || arg === '0' || arg === 'false') on = false;\r\nelse if (arg === 'toggle' || arg === '') {\r\n  on = psnmGet('psnm_maintenance', '0') !== '1';\r\n} else {\r\n  display_notice('[PoisonManager] psnm on|off|menu|cane', 'yellow');\r\n  return;\r\n}\r\npsnmClearMaintTimeout();\r\nif (!on) {\r\n  psnmSet('psnm_maintenance', '0');\r\n  display_notice('[PoisonManager] Maintenance mode disabled', 'yellow');\r\n  return;\r\n}\r\npsnmSet('psnm_maintenance', '1');\r\npsnmSet('psnm_maint_pos_left', '0');\r\npsnmSet('psnm_maint_pos_right', '0');\r\nvar sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\ndisplay_notice('[PoisonManager] Maintenance mode enabled (every ' + sec + 's)', 'lightgreen');\r\nrun_function('psnm_maint_tick', '', PSNM_PKG);\r\n\n"},{"type":"function","name":"psnm_toggle_maint","enabled":true,"id":28,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\npsnmClearMaintTimeout();\r\nvar on = psnmGet('psnm_maintenance', '0') !== '1';\r\nif (!on) {\r\n  psnmSet('psnm_maintenance', '0');\r\n  display_notice('[PoisonManager] Maintenance mode disabled', 'yellow');\r\n  return;\r\n}\r\npsnmSet('psnm_maintenance', '1');\r\npsnmSet('psnm_maint_pos_left', '0');\r\npsnmSet('psnm_maint_pos_right', '0');\r\nvar sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\ndisplay_notice('[PoisonManager] Maintenance mode enabled (every ' + sec + 's)', 'lightgreen');\r\nrun_function('psnm_maint_tick', '', PSNM_PKG);\r\n\n"},{"type":"function","name":"psnm_enable_maint_skip","enabled":true,"id":29,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\npsnmClearMaintTimeout();\r\npsnmSet('psnm_maintenance', '1');\r\npsnmSet('psnm_maint_pos_left', '0');\r\npsnmSet('psnm_maint_pos_right', '0');\r\nvar sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\nif (isNaN(sec) || sec < 0.5) sec = 5;\r\nvar ms = Math.round(sec * 1000);\r\nvar id = setTimeout(function () {\r\n  try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n}, ms);\r\npsnmSet('psnm_maint_timeout_id', String(id));\r\n\n"},{"type":"function","name":"psnm_apply_switch","enabled":true,"id":30,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar w = psnmGetWeaponsForPoison();\r\nif (!w.left) {\r\n  display_notice('[PoisonManager] No weapon for current mode. Set psnmrapiers/psnmbastard + weapon ids.', 'yellow');\r\n  return;\r\n}\r\nvar batchId = psnmBumpApplyGen();\r\npsnmQueueApplyBurst(batchId);\r\n\n"},{"type":"function","name":"psnm_apply_recipe","enabled":true,"id":31,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar spec = {};\r\ntry {\r\n  if (typeof args === 'string' && args) spec = JSON.parse(args);\r\n  else if (args && typeof args === 'object') spec = args;\r\n} catch (eRec) { spec = {}; }\r\nvar left = spec.left || spec.L || [];\r\nvar right = spec.right || spec.R || [];\r\nif (typeof left === 'string') left = String(left).split(/[\\\\s,]+/).filter(Boolean);\r\nif (typeof right === 'string') right = String(right).split(/[\\\\s,]+/).filter(Boolean);\r\nif (!left || Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\nif (!right || Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\nvar w = psnmGetWeaponsForPoison();\r\nif (!w.left) {\r\n  display_notice('[PoisonManager] No weapon for current mode. Set psnmrapiers/psnmbastard + weapon ids.', 'yellow');\r\n  return;\r\n}\r\nvar batchId = psnmBumpApplyGen();\r\npsnmQueueRecipeBurst(batchId, left, right);\r\n\n"},{"type":"function","name":"psnm_apply_volley","enabled":true,"id":32,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar n = 1;\r\nif (typeof args === 'string' && args) n = parseInt(args, 10);\r\nelse if (args && typeof args === 'object' && args.n != null) n = parseInt(args.n, 10);\r\nif (isNaN(n) || n < 1) n = 1;\r\nvar w = psnmGetWeaponsForPoison();\r\nif (!w.left) return;\r\nvar batchId = psnmBumpApplyGen();\r\npsnmQueueVolleyCoats(batchId, n);\r\n\n"},{"type":"function","name":"psnm_volley_sm_cmds","enabled":true,"id":33,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar cmds = psnmBuildVolleySmCmds();\r\npsnmSet('psnm_volley_cmds', JSON.stringify(cmds));\r\ntry { client.psnm_volley_cmds = cmds; } catch (eC) {}\r\n\n"},{"type":"function","name":"psnm_do_sync_burst","enabled":true,"id":34,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar w = psnmGetWeaponsForPoison();\r\nif (!w.left) {\r\n  display_notice('[PoisonManager] psnmsync: no weapon ids for current mode.', 'yellow');\r\n  return;\r\n}\r\nif (psnmGet('psnm_maintenance', '0') !== '1') {\r\n  run_function('psnm_enable_maint_skip', '', PSNM_PKG);\r\n}\r\npsnmSet('psnm_maint_pos_left', '0');\r\npsnmSet('psnm_maint_pos_right', '0');\r\nvar batchId = psnmBumpApplyGen();\r\npsnmQueueApplyBurst(batchId);\r\n\n"},{"type":"function","name":"psnm_sync_weapons","enabled":true,"id":35,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\npsnmClearSyncTimeout();\r\nvar id = setTimeout(function () {\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n  try { run_function('psnm_do_sync_burst', '', PSNM_PKG); } catch (e) {}\r\n}, 400);\r\npsnmSet('psnm_sync_timeout_id', String(id));\r\n\n"},{"type":"function","name":"psnm_set_profile","enabled":true,"id":36,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar name = (String(args || '') + '').toLowerCase().trim();\r\nif (!name) return;\r\nvar P = psnmBuildProfiles();\r\nif (!P[name]) {\r\n  display_notice('[PoisonManager] Unknown profile: ' + name, 'red');\r\n  return;\r\n}\r\nvar defBast = (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\nif (psnmIsRapierSlotKey(name)) {\r\n  psnmSet('psnm_profile_rapiers', name);\r\n  psnmSet('psnm_profile_bastard', defBast);\r\n  psnmSet('psnm_current', name);\r\n} else if (psnmIsBastardKey(name)) {\r\n  psnmSet('psnm_default_bastard', name);\r\n  psnmSet('psnm_profile_bastard', name);\r\n  psnmSet('psnm_current', name);\r\n} else {\r\n  display_notice('[PoisonManager] Unknown profile kind: ' + name, 'red');\r\n  return;\r\n}\r\npsnmSet('psnm_maint_pos_left', '0');\r\npsnmSet('psnm_maint_pos_right', '0');\r\npsnmPersistSlots();\r\npsnmSaveCustom();\r\ndisplay_notice('[PoisonManager] Profile: ' + P[name].name, 'lightgreen');\r\nrun_function('psnm_apply_switch', '', PSNM_PKG);\r\n\n"},{"type":"function","name":"psnm_show_profile","enabled":true,"id":37,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar P = psnmBuildProfiles();\r\nvar mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase();\r\nvar eff = psnmEffectiveProfileKey();\r\nvar ep = P[eff];\r\nvar rapK = (psnmGet('psnm_profile_rapiers', '') || '').toLowerCase().trim();\r\nvar bastK = (psnmGet('psnm_profile_bastard', '') || '').toLowerCase().trim();\r\nvar rap = P[rapK];\r\nvar bast = P[bastK];\r\nvar w = psnmGetWeaponsForPoison();\r\ndisplay_notice('[PoisonManager] Mode: ' + mode + ' | Effective: ' + (ep ? ep.name : eff), 'cyan');\r\ndisplay_notice('  Rapiers slot: ' + (rap ? rap.name : rapK || '?'), 'white');\r\ndisplay_notice('  Bastard slot: ' + (bast ? bast.name : bastK || '?'), 'white');\r\nvar ck = (psnmGet('psnm_current','')||'').toLowerCase().trim();\r\nvar editProf = P[ck];\r\ndisplay_notice('  Edit context (poisonadd…): ' + (editProf ? editProf.name : ck), 'white');\r\ndisplay_notice('  Weapons: ' + (w.left || '?') + ' / ' + (w.right || 'none'), 'white');\r\n\n"},{"type":"function","name":"psnm_reorder","enabled":true,"id":38,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar parts = (String(args || '') + '').split('|');\r\nvar from = parseInt(parts[0], 10);\r\nvar to = parseInt(parts[1], 10);\r\nvar P = psnmBuildProfiles();\r\nvar cur = (psnmGet('psnm_current', 'blademaster1') || '').toLowerCase().trim();\r\nvar prof = P[cur];\r\nif (!prof || prof.isFixed) return;\r\nvar left = prof.left || [];\r\nif (!from || !to || from < 1 || from > left.length || to < 1 || to > left.length) return;\r\nvar tmp = left[from - 1];\r\nleft[from - 1] = left[to - 1];\r\nleft[to - 1] = tmp;\r\nprof.left = left;\r\npsnmApplyStagger(prof);\r\npsnmSaveCustom();\r\ndisplay_notice('[PoisonManager] Swapped positions ' + from + ' and ' + to, 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_remove","enabled":true,"id":39,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar idx = parseInt(String(args || ''), 10);\r\nvar P = psnmBuildProfiles();\r\nvar cur = (psnmGet('psnm_current', 'blademaster1') || '').toLowerCase().trim();\r\nvar prof = P[cur];\r\nif (!prof || prof.isFixed) return;\r\nvar left = prof.left || [];\r\nif (!idx || idx < 1 || idx > left.length) return;\r\nleft.splice(idx - 1, 1);\r\nprof.left = left;\r\npsnmApplyStagger(prof);\r\npsnmSaveCustom();\r\ndisplay_notice('[PoisonManager] Removed poison at position ' + idx, 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_remove_last","enabled":true,"id":40,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar P = psnmBuildProfiles();\r\nvar cur = (psnmGet('psnm_current', 'blademaster1') || '').toLowerCase().trim();\r\nvar prof = P[cur];\r\nif (!prof || prof.isFixed) return;\r\nvar left = prof.left || [];\r\nif (!left.length) {\r\n  display_notice('[PoisonManager] No poisons to remove.', 'yellow');\r\n  return;\r\n}\r\nleft.pop();\r\nprof.left = left;\r\npsnmApplyStagger(prof);\r\npsnmSaveCustom();\r\ndisplay_notice('[PoisonManager] Removed last poison.', 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_add","enabled":true,"id":41,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar poisonName = (String(args || '') + '').toLowerCase().trim();\r\nif (!poisonName) {\r\n  display_notice('[PoisonManager] Usage: poisonadd <poison name>', 'yellow');\r\n  return;\r\n}\r\nif (PSNM_ALL_POISONS.indexOf(poisonName) < 0) {\r\n  display_notice('[PoisonManager] Unknown poison: ' + poisonName, 'red');\r\n  return;\r\n}\r\nvar P = psnmBuildProfiles();\r\nvar cur = (psnmGet('psnm_current', 'blademaster1') || '').toLowerCase().trim();\r\nvar prof = P[cur];\r\nif (!prof || prof.isFixed) {\r\n  display_notice('[PoisonManager] Cannot add poisons to fixed profiles.', 'red');\r\n  return;\r\n}\r\nprof.left.push(poisonName);\r\npsnmApplyStagger(prof);\r\npsnmSaveCustom();\r\ndisplay_notice('[PoisonManager] Added ' + poisonName + ' to profile.', 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_set_default","enabled":true,"id":42,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar name = (String(args || '') + '').toLowerCase().trim();\r\nif (!name) return;\r\nvar P = psnmBuildProfiles();\r\nif (!P[name]) {\r\n  display_notice('[PoisonManager] Unknown profile: ' + name, 'red');\r\n  return;\r\n}\r\nvar ki, pk;\r\nif (psnmIsRapierSlotKey(name)) {\r\n  for (ki = 0; ki < PSNM_PROFILE_KEYS.length; ki++) {\r\n    pk = PSNM_PROFILE_KEYS[ki];\r\n    if (P[pk]) P[pk].isDefault = (pk === name);\r\n  }\r\n  psnmSet('psnm_default', name);\r\n  psnmSet('psnm_default_rapiers', name);\r\n  var defBast = (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  psnmSet('psnm_profile_bastard', defBast);\r\n} else if (psnmIsBastardKey(name)) {\r\n  psnmSet('psnm_default_bastard', name);\r\n  psnmSet('psnm_profile_bastard', name);\r\n} else {\r\n  display_notice('[PoisonManager] Unknown profile kind: ' + name, 'red');\r\n  return;\r\n}\r\npsnmPersistSlots();\r\npsnmSaveCustom();\r\ndisplay_notice('[PoisonManager] Default set to: ' + P[name].name, 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_dual","enabled":true,"id":43,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar P = psnmBuildProfiles();\r\nvar cur = (psnmGet('psnm_current', 'blademaster1') || '').toLowerCase().trim();\r\nvar prof = P[cur];\r\nif (!prof || prof.isFixed) {\r\n  display_notice('[PoisonManager] Cannot change dual/single on fixed profiles.', 'red');\r\n  return;\r\n}\r\nprof.dualWield = true;\r\npsnmApplyStagger(prof);\r\npsnmSaveCustom();\r\ndisplay_notice('[PoisonManager] Mode: Dual', 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_single","enabled":true,"id":44,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar P = psnmBuildProfiles();\r\nvar cur = (psnmGet('psnm_current', 'blademaster1') || '').toLowerCase().trim();\r\nvar prof = P[cur];\r\nif (!prof || prof.isFixed) {\r\n  display_notice('[PoisonManager] Cannot change dual/single on fixed profiles.', 'red');\r\n  return;\r\n}\r\nprof.dualWield = false;\r\npsnmSaveCustom();\r\ndisplay_notice('[PoisonManager] Mode: Single', 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_stagger_arg","enabled":true,"id":45,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar arg = (String(args || '') + '').toLowerCase().replace(/\\\\s+/g, '');\r\nvar on = false;\r\nif (arg === 'on' || arg === '1' || arg === 'true' || arg === 'yes') on = true;\r\nelse if (arg === 'off' || arg === '0' || arg === 'false' || arg === 'no') on = false;\r\nelse {\r\n  display_notice('[PoisonManager] Usage: poisonstagger on|off', 'yellow');\r\n  return;\r\n}\r\nvar P = psnmBuildProfiles();\r\nvar cur = (psnmGet('psnm_current', 'blademaster1') || '').toLowerCase().trim();\r\nvar prof = P[cur];\r\nif (!prof || prof.isFixed) {\r\n  display_notice('[PoisonManager] Cannot change stagger on fixed profiles.', 'red');\r\n  return;\r\n}\r\nif (!prof.dualWield) {\r\n  display_notice('[PoisonManager] Stagger only applies to dual-wield profiles.', 'yellow');\r\n  return;\r\n}\r\nprof.stagger = on;\r\npsnmApplyStagger(prof);\r\npsnmSaveCustom();\r\ndisplay_notice('[PoisonManager] Stagger: ' + (on ? 'ON' : 'OFF'), 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_stagger_toggle","enabled":true,"id":46,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar P = psnmBuildProfiles();\r\nvar cur = (psnmGet('psnm_current', 'blademaster1') || '').toLowerCase().trim();\r\nvar prof = P[cur];\r\nif (!prof || !prof.dualWield) {\r\n  display_notice('[PoisonManager] Stagger only applies to dual-wield profiles.', 'yellow');\r\n  return;\r\n}\r\nif (prof.isFixed) {\r\n  display_notice('[PoisonManager] Cannot change stagger on fixed profiles.', 'red');\r\n  return;\r\n}\r\nprof.stagger = !prof.stagger;\r\npsnmApplyStagger(prof);\r\npsnmSaveCustom();\r\ndisplay_notice('[PoisonManager] Stagger: ' + (prof.stagger ? 'ON' : 'OFF'), 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_rename","enabled":true,"id":47,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar name = (String(args || '') + '').replace(/^\\\\s+|\\\\s+$/g, '');\r\nif (name.length > 30) name = name.substring(0, 30);\r\nvar P = psnmBuildProfiles();\r\nvar cur = (psnmGet('psnm_current', 'blademaster1') || '').toLowerCase().trim();\r\nvar prof = P[cur];\r\nif (!prof || prof.isFixed) {\r\n  display_notice('[PoisonManager] Cannot rename fixed profiles.', 'red');\r\n  return;\r\n}\r\nprof.name = name;\r\npsnmSaveCustom();\r\ndisplay_notice('[PoisonManager] Profile renamed to: ' + name, 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_save","enabled":true,"id":48,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\npsnmBuildProfiles();\r\npsnmSaveCustom();\r\npsnmPersistSlots();\r\ndisplay_notice('[PoisonManager] Profiles saved.', 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_status","enabled":true,"id":49,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar P = psnmBuildProfiles();\r\nvar mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase();\r\nvar eff = psnmEffectiveProfileKey();\r\nvar ep = P[eff];\r\nvar rapK = (psnmGet('psnm_profile_rapiers', '') || '').toLowerCase().trim();\r\nvar bastK = (psnmGet('psnm_profile_bastard', '') || '').toLowerCase().trim();\r\nvar rap = P[rapK];\r\nvar bast = P[bastK];\r\nvar w = psnmGetWeaponsForPoison();\r\nvar m = psnmGet('psnm_maintenance', '0') === '1';\r\ndisplay_notice('=== Poison Manager Status ===', 'cyan');\r\ndisplay_notice('Weapon mode: ' + mode, 'white');\r\ndisplay_notice('Effective profile: ' + (ep ? ep.name : eff), 'white');\r\ndisplay_notice('  Rapiers slot: ' + (rap ? rap.name : '?'), 'white');\r\ndisplay_notice('  Bastard slot: ' + (bast ? bast.name : '?'), 'white');\r\ndisplay_notice('Active weapons: ' + (w.left || '?') + ' / ' + (w.right || 'none'), 'white');\r\ndisplay_notice('Maintenance: ' + (m ? 'ON' : 'OFF'), m ? 'lightgreen' : 'red');\r\nif (m && ep) {\r\n  var lp = ep.left || [];\r\n  var rp = ep.right || [];\r\n  display_notice('  Left pos: ' + psnmGet('psnm_maint_pos_left', '0') + '/' + lp.length, 'white');\r\n  display_notice('  Right pos: ' + psnmGet('psnm_maint_pos_right', '0') + '/' + rp.length, 'white');\r\n}\r\n\n"},{"type":"function","name":"psnm_weapon1","enabled":true,"id":50,"code":"\r\nvar n = (String(args || '') + '').trim();\r\nif (!n) {\r\n  var c = (get_variable('psnm_w1') || '').trim();\r\n  display_notice(c ? '[PoisonManager] Left rapier: ' + c : '[PoisonManager] psnmw1 <id>', 'cyan');\r\n  return;\r\n}\r\nset_variable('psnm_w1', n);\r\ndisplay_notice('[PoisonManager] Left rapier set: ' + n, 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_weapon2","enabled":true,"id":51,"code":"\r\nvar n = (String(args || '') + '').trim();\r\nif (!n) {\r\n  var c = (get_variable('psnm_w2') || '').trim();\r\n  display_notice(c ? '[PoisonManager] Right rapier: ' + c : '[PoisonManager] psnmw2 <id>', 'cyan');\r\n  return;\r\n}\r\nset_variable('psnm_w2', n);\r\ndisplay_notice('[PoisonManager] Right rapier set: ' + n, 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_weapon_bastard","enabled":true,"id":52,"code":"\r\nvar n = (String(args || '') + '').trim();\r\nif (!n) {\r\n  var c = (get_variable('psnm_bastard_id') || '').trim();\r\n  display_notice(c ? '[PoisonManager] Bastard id: ' + c : '[PoisonManager] psnmbid <id>', 'cyan');\r\n  return;\r\n}\r\nset_variable('psnm_bastard_id', n);\r\ndisplay_notice('[PoisonManager] Bastard weapon set: ' + n, 'lightgreen');\r\n\n"},{"type":"function","name":"psnm_probe_rx_line","enabled":true,"id":53,"code":"\r\n(function(){\r\n  if (get_variable('psnm_probe_capturing') !== '1') return;\r\n  var poison = (args[2] || '').toLowerCase();\r\n  if (!poison) return;\r\n  var arr = [];\r\n  try { arr = JSON.parse(get_variable('psnm_probe_poisons') || '[]'); } catch (e) { arr = []; }\r\n  arr.push(poison);\r\n  set_variable('psnm_probe_poisons', JSON.stringify(arr));\r\n})();\r\n\n"},{"type":"function","name":"psnm_probe_analyze","enabled":true,"id":54,"code":"\r\n\r\nvar PSNM_PKG = 'BladeMaster Engine';\r\nvar PSNM_PROFILE_KEYS = ['blademaster1','maxdamage','profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_BASTARD_KEYS = ['bastardsenso'];\r\nvar PSNM_CUSTOM_KEYS = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\r\nvar PSNM_ALL_POISONS = ['dendroxin','mantakaya','chansu','senso','haemotox','crotamine','escozul','mactans','mellitin','botulinum','niricol','ibululu','calcise','pyrotoxin','anerod','saxitin','aleutian','anatine','contortrin','dulak','inyoka','hadrudin','tetrodin','morphite'];\r\n\r\nfunction psnmGet(k, d) {\r\n  var v = get_variable(k);\r\n  if (v === undefined || v === null || v === '') return d;\r\n  return v;\r\n}\r\nfunction psnmSet(k, v) { set_variable(k, String(v)); }\r\n\r\nfunction psnmIsRapierSlotKey(k) {\r\n  return PSNM_PROFILE_KEYS.indexOf(k) >= 0;\r\n}\r\nfunction psnmIsBastardKey(k) {\r\n  return PSNM_BASTARD_KEYS.indexOf(k) >= 0;\r\n}\r\n\r\nfunction psnmApplyStagger(p) {\r\n  if (!p || p.dualWield === false) return;\r\n  var left = p.left || [];\r\n  if (!left.length) { p.right = []; return; }\r\n  var right = [];\r\n  var n = left.length;\r\n  var i;\r\n  if (p.stagger !== false) {\r\n    for (i = 0; i < n; i++) right.push(left[(i + 1) % n]);\r\n  } else {\r\n    for (i = 0; i < n; i++) right.push(left[i]);\r\n  }\r\n  p.right = right;\r\n}\r\n\r\nfunction psnmEmptyProfile(key) {\r\n  return {\r\n    name: 'Profile ' + key.replace('profile', ''),\r\n    left: [],\r\n    right: [],\r\n    dualWield: true,\r\n    stagger: true,\r\n    isFixed: false,\r\n    isDefault: false\r\n  };\r\n}\r\n\r\nfunction psnmBuildProfiles() {\r\n  var P = {\r\n    blademaster1: {\r\n      name: 'Wound Standard',\r\n      left: ['senso'],\r\n      right: ['senso'],\r\n      dualWield: true,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    maxdamage: {\r\n      name: 'Power SAP Blade Master',\r\n      left: ['escozul', 'dendroxin'],\r\n      right: ['dendroxin', 'escozul'],\r\n      dualWield: true,\r\n      stagger: true,\r\n      isFixed: true,\r\n      isDefault: false\r\n    },\r\n    bastardsenso: {\r\n      name: 'Bastard SENSO',\r\n      left: ['senso'],\r\n      right: [],\r\n      dualWield: false,\r\n      stagger: false,\r\n      isFixed: true,\r\n      isDefault: true\r\n    }\r\n  };\r\n  var j, k;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    P[k] = psnmEmptyProfile(k);\r\n  }\r\n  var custom = {};\r\n  try { custom = JSON.parse(psnmGet('psnm_custom', '{}')); } catch (e) { custom = {}; }\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    k = PSNM_CUSTOM_KEYS[j];\r\n    if (custom[k] && typeof custom[k] === 'object') {\r\n      var c = custom[k];\r\n      P[k] = {\r\n        name: c.name || P[k].name,\r\n        left: c.left || [],\r\n        right: c.right || [],\r\n        dualWield: c.dualWield !== false,\r\n        stagger: c.stagger !== false,\r\n        isFixed: false,\r\n        isDefault: !!c.isDefault\r\n      };\r\n      psnmApplyStagger(P[k]);\r\n    }\r\n  }\r\n  client.psnm_P = P;\r\n  return P;\r\n}\r\n\r\nfunction psnmSaveCustom() {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var out = {};\r\n  var j, kk, p;\r\n  for (j = 0; j < PSNM_CUSTOM_KEYS.length; j++) {\r\n    kk = PSNM_CUSTOM_KEYS[j];\r\n    p = P[kk];\r\n    if (p && !p.isFixed) {\r\n      out[kk] = {\r\n        name: p.name,\r\n        left: p.left || [],\r\n        right: p.right || [],\r\n        dualWield: p.dualWield !== false,\r\n        stagger: p.stagger !== false,\r\n        isDefault: !!p.isDefault\r\n      };\r\n    }\r\n  }\r\n  psnmSet('psnm_custom', JSON.stringify(out));\r\n}\r\n\r\nfunction psnmPersistSlots() {\r\n  psnmSet('psnm_profile_rapiers', psnmGet('psnm_profile_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_profile_bastard', psnmGet('psnm_profile_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_default_rapiers', psnmGet('psnm_default_rapiers', 'blademaster1'));\r\n  psnmSet('psnm_default_bastard', psnmGet('psnm_default_bastard', 'bastardsenso'));\r\n  psnmSet('psnm_current', psnmGet('psnm_current', 'blademaster1'));\r\n  psnmSet('psnm_weapon_mode', psnmGet('psnm_weapon_mode', 'none'));\r\n}\r\n\r\nfunction psnmGetWeaponsForPoison() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    var b = (psnmGet('psnm_bastard_id', '') || '').trim();\r\n    return { left: b || null, right: null };\r\n  }\r\n  if (mode === 'rapiers') {\r\n    var w1 = (psnmGet('psnm_w1', '') || '').trim();\r\n    var w2 = (psnmGet('psnm_w2', '') || '').trim();\r\n    return { left: w1 || null, right: w2 || null };\r\n  }\r\n  return { left: null, right: null };\r\n}\r\n\r\nfunction psnmEffectiveProfileKey() {\r\n  var mode = (psnmGet('psnm_weapon_mode', 'none') || '').toLowerCase().trim();\r\n  if (mode === 'bastard') {\r\n    return (psnmGet('psnm_default_bastard', 'bastardsenso') || 'bastardsenso').toLowerCase().trim();\r\n  }\r\n  if (mode === 'rapiers') {\r\n    return (psnmGet('psnm_profile_rapiers', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n  }\r\n  return (psnmGet('psnm_current', 'blademaster1') || 'blademaster1').toLowerCase().trim();\r\n}\r\n\r\nfunction psnmBumpApplyGen() {\r\n  var g = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n  g++;\r\n  psnmSet('psnm_apply_gen', String(g));\r\n  return g;\r\n}\r\n\r\nfunction psnmRememberLists(left, right) {\r\n  psnmSet('psnm_last_left', JSON.stringify(left || []));\r\n  psnmSet('psnm_last_right', JSON.stringify(right || []));\r\n}\r\n\r\nfunction psnmGetLastLists() {\r\n  var left = [];\r\n  var right = [];\r\n  try { left = JSON.parse(psnmGet('psnm_last_left', '[]') || '[]'); } catch (eL) { left = []; }\r\n  try { right = JSON.parse(psnmGet('psnm_last_right', '[]') || '[]'); } catch (eR) { right = []; }\r\n  if (Object.prototype.toString.call(left) !== '[object Array]') left = [];\r\n  if (Object.prototype.toString.call(right) !== '[object Array]') right = [];\r\n  return { left: left, right: right };\r\n}\r\n\r\nfunction psnmIsCeGated() {\r\n  return PSNM_PKG === 'BladeMaster Engine';\r\n}\r\n\r\nfunction psnmBuildVolleySmCmds() {\r\n  var cmds = [];\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return cmds;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var Pv = client.psnm_P || psnmBuildProfiles();\r\n    var effv = psnmEffectiveProfileKey();\r\n    var profilev = Pv[effv];\r\n    if (profilev) {\r\n      leftPattern = profilev.left || [];\r\n      rightPattern = profilev.right || [];\r\n    }\r\n  }\r\n  if (psnmGet('psnm_pending_wipe', '0') === '1') {\r\n    if (w.left) cmds.push('wipe ' + w.left);\r\n    if (w.right) cmds.push('wipe ' + w.right);\r\n  }\r\n  var pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n    pl = (pl % leftPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_left', String(pl));\r\n    cmds.push('ENVENOM ' + w.left + ' WITH ' + leftPattern[pl - 1]);\r\n  }\r\n  if (w.right && rightPattern.length > 0) {\r\n    pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n    pr = (pr % rightPattern.length) + 1;\r\n    psnmSet('psnm_maint_pos_right', String(pr));\r\n    cmds.push('ENVENOM ' + w.right + ' WITH ' + rightPattern[pr - 1]);\r\n  }\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  return cmds;\r\n}\r\n\r\nfunction psnmSetCursorAfterCoats(leftPattern, rightPattern, coats) {\r\n  function after(pattern) {\r\n    if (!pattern || !pattern.length || coats < 1) return 0;\r\n    var pos = 0;\r\n    var i;\r\n    for (i = 0; i < coats; i++) pos = (pos % pattern.length) + 1;\r\n    return pos;\r\n  }\r\n  psnmSet('psnm_maint_pos_left', String(after(leftPattern)));\r\n  if (rightPattern && rightPattern.length) psnmSet('psnm_maint_pos_right', String(after(rightPattern)));\r\n  else psnmSet('psnm_maint_pos_right', '0');\r\n}\r\n\r\nfunction psnmClearMaintTimeout() {\r\n  var t = psnmGet('psnm_maint_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_maint_timeout_id', '');\r\n}\r\n\r\nfunction psnmClearSyncTimeout() {\r\n  var t = psnmGet('psnm_sync_timeout_id', '');\r\n  if (t) {\r\n    try { clearTimeout(parseInt(t, 10)); } catch (e) {}\r\n  }\r\n  psnmSet('psnm_sync_timeout_id', '');\r\n}\r\n\r\nfunction psnmScheduleMaint() {\r\n  if (psnmGet('psnm_maintenance', '0') !== '1') return;\r\n  var sec = parseFloat(psnmGet('psnm_maint_interval_sec', '5'));\r\n  if (isNaN(sec) || sec < 0.5) sec = 5;\r\n  var ms = Math.round(sec * 1000);\r\n  var id = setTimeout(function () {\r\n    try { run_function('psnm_maint_tick', '', PSNM_PKG); } catch (e) {}\r\n  }, ms);\r\n  psnmSet('psnm_maint_timeout_id', String(id));\r\n}\r\n\r\nfunction psnmQueueApplyBurst(batchId) {\r\n  var P = client.psnm_P || psnmBuildProfiles();\r\n  var eff = psnmEffectiveProfileKey();\r\n  var profile = P[eff];\r\n  if (!profile) return;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var leftPattern = profile.left || [];\r\n  var rightPattern = profile.right || [];\r\n  var dual = profile.dualWield !== false;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueRecipeBurst(batchId, leftPattern, rightPattern) {\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  leftPattern = leftPattern || [];\r\n  rightPattern = rightPattern || [];\r\n  var dual = rightPattern.length > 0;\r\n  var maxApply = 2;\r\n  var delayMs = 100;\r\n  var wipeDelayMs = 100;\r\n  psnmRememberLists(leftPattern, rightPattern);\r\n  psnmSet('psnm_pending_wipe', '0');\r\n  psnmSet('psnm_maint_pos_left', '0');\r\n  psnmSet('psnm_maint_pos_right', '0');\r\n  if (w.left) send_command('wipe ' + w.left, 0);\r\n  if (dual && w.right) send_command('wipe ' + w.right, 0);\r\n  var i, t, poison, weapon;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = leftPattern[(i - 1) % leftPattern.length];\r\n      weapon = w.left;\r\n      t = wipeDelayMs + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = wipeDelayMs + maxApply * delayMs;\r\n    for (i = 1; i <= maxApply; i++) {\r\n      poison = rightPattern[(i - 1) % rightPattern.length];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        setTimeout(function () {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  psnmSetCursorAfterCoats(leftPattern, rightPattern, maxApply);\r\n}\r\n\r\nfunction psnmQueueVolleyCoats(batchId, n) {\r\n  if (psnmIsCeGated()) return;\r\n  n = parseInt(n, 10);\r\n  if (isNaN(n) || n < 1) n = 1;\r\n  var w = psnmGetWeaponsForPoison();\r\n  if (!w.left) return;\r\n  var lists = psnmGetLastLists();\r\n  var leftPattern = lists.left || [];\r\n  var rightPattern = lists.right || [];\r\n  if (!leftPattern.length) {\r\n    var P = client.psnm_P || psnmBuildProfiles();\r\n    var eff = psnmEffectiveProfileKey();\r\n    var profile = P[eff];\r\n    if (!profile) return;\r\n    leftPattern = profile.left || [];\r\n    rightPattern = profile.right || [];\r\n  }\r\n  var dual = rightPattern.length > 0;\r\n  var delayMs = 100;\r\n  var i, t, poison, weapon, pl, pr;\r\n  if (w.left && leftPattern.length > 0) {\r\n    for (i = 1; i <= n; i++) {\r\n      pl = parseInt(psnmGet('psnm_maint_pos_left', '0'), 10) || 0;\r\n      pl = (pl % leftPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_left', String(pl));\r\n      poison = leftPattern[pl - 1];\r\n      weapon = w.left;\r\n      t = (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n  if (dual && w.right && rightPattern.length > 0) {\r\n    var baseTime = n * delayMs;\r\n    for (i = 1; i <= n; i++) {\r\n      pr = parseInt(psnmGet('psnm_maint_pos_right', '0'), 10) || 0;\r\n      pr = (pr % rightPattern.length) + 1;\r\n      psnmSet('psnm_maint_pos_right', String(pr));\r\n      poison = rightPattern[pr - 1];\r\n      weapon = w.right;\r\n      t = baseTime + (i - 1) * delayMs;\r\n      (function (W, Pn, tm, bid) {\r\n        function doSend() {\r\n          var cur = parseInt(psnmGet('psnm_apply_gen', '0'), 10) || 0;\r\n          if (cur !== bid) return;\r\n          if (W && Pn) send_command('ENVENOM ' + W + ' WITH ' + Pn, 0);\r\n        }\r\n        if (tm <= 0) doSend();\r\n        else setTimeout(doSend, tm);\r\n      })(weapon, poison, t, batchId);\r\n    }\r\n  }\r\n}\r\n\r\nvar wid = (psnmGet('psnm_probe_weapon', '') || '').trim();\r\nvar arr = [];\r\ntry { arr = JSON.parse(psnmGet('psnm_probe_poisons', '[]')); } catch (e) { arr = []; }\r\npsnmSet('psnm_probe_weapon', '');\r\npsnmSet('psnm_probe_poisons', '[]');\r\nif (!wid) {\r\n  display_notice('[PoisonManager] No probe context.', 'red');\r\n  return;\r\n}\r\nif (!arr.length) {\r\n  display_notice('[PoisonManager] No poisons captured on weapon.', 'yellow');\r\n  return;\r\n}\r\nvar P = psnmBuildProfiles();\r\nvar eff = psnmEffectiveProfileKey();\r\nvar profile = P[eff];\r\nif (!profile) {\r\n  display_notice('[PoisonManager] No active profile.', 'red');\r\n  return;\r\n}\r\nvar w = psnmGetWeaponsForPoison();\r\nvar expectedPattern = profile.left || [];\r\nif (wid === (w.left || '')) expectedPattern = profile.left || [];\r\nelse if (w.right && wid === w.right) expectedPattern = profile.right || [];\r\nif (!expectedPattern.length) {\r\n  display_notice('[PoisonManager] Profile has no poisons configured.', 'yellow');\r\n  return;\r\n}\r\ndisplay_notice('=== Poison Probe Analysis ===', 'cyan');\r\ndisplay_notice('Weapon: ' + wid + ' | Profile: ' + (profile.name || eff), 'white');\r\ndisplay_notice('Expected: ' + expectedPattern.join(', '), 'lime');\r\nvar matches = 0, mismatches = 0, patternLen = expectedPattern.length;\r\nvar i, poison, expectedIndex, expected;\r\nfor (i = 0; i < arr.length; i++) {\r\n  poison = arr[i];\r\n  expectedIndex = i % patternLen;\r\n  expected = expectedPattern[expectedIndex];\r\n  if (poison === expected) { matches++; display_notice((i+1) + ') ' + poison + ' (OK)', 'green'); }\r\n  else { mismatches++; display_notice((i+1) + ') ' + poison + ' (expected ' + expected + ')', 'red'); }\r\n}\r\nif (mismatches === 0) display_notice('Perfect match (' + matches + ').', 'green');\r\nelse display_notice('Partial: ' + matches + ' ok, ' + mismatches + ' mismatch. poisonprofile + switch to reapply.', 'yellow');\r\n\n"},{"type":"function","name":"psnm_xpsncheck","enabled":true,"id":55,"code":"\r\nvar arg = (String(args || '') || '').trim();\r\nvar w1 = (get_variable('psnm_w1') || '').trim();\r\nvar mode = (get_variable('psnm_weapon_mode') || '').toLowerCase();\r\nvar bast = (get_variable('psnm_bastard_id') || '').trim();\r\nvar probeId = arg;\r\nif (!probeId) {\r\n  if (mode === 'bastard') probeId = bast;\r\n  else probeId = w1;\r\n}\r\nif (!probeId) {\r\n  display_notice('[PoisonManager] Draw/set mode + ids, or: xpsncheck <weapon id>', 'yellow');\r\n  return;\r\n}\r\nset_variable('psnm_probe_weapon', probeId);\r\nset_variable('psnm_probe_poisons', '[]');\r\nset_variable('psnm_probe_capturing', '1');\r\nsend_command('probe ' + probeId, 0);\r\ndisplay_notice('[PoisonManager] Probing: ' + probeId, 'cyan');\r\n\n"},{"type":"function","name":"psnm_inventory_denial","enabled":true,"id":56,"code":"\r\n(function(){\r\n  var t = get_variable('psnm_maint_timeout_id');\r\n  if (t) { try { clearTimeout(parseInt(t, 10)); } catch (e) {} }\r\n  set_variable('psnm_maint_timeout_id', '');\r\n})();\r\nset_variable('psnm_maintenance', '0');\r\nvar g = parseInt(get_variable('psnm_apply_gen') || '0', 10) || 0;\r\ng++;\r\nset_variable('psnm_apply_gen', String(g));\r\ndisplay_notice('[PoisonManager] Stopped — item not in inventory. Fix ids, retry.', 'yellow');\r\n\n"},{"type":"function","name":"psnm_help","enabled":true,"id":57,"code":"display_notice(\"=== Poison Manager (Nexus) — help: xpoisons xhelppoisons xhelppsn xpsnmgr xpsnm poisonshelp\", \"cyan\");\ndisplay_notice(\"No xhelp alias here (reserved). Rapier profiles + bastardsenso; custom profile3–9.\", \"white\");\ndisplay_notice(\"Weapon mode (replaces Mudlet WeaponToggle): psnmrapiers | psnmbastard | psnmcane\", \"gold\");\ndisplay_notice(\"psnmw1 / psnmw2 — rapier ids; psnmbid — bastard id; psnmsync — debounced wipe+2/hand after draws\", \"white\");\ndisplay_notice(\"Profile switch = wipe + 2 coats/hand. Kill volleys top up 1/hand (no wipe). Maintenance stays 1/5s.\", \"white\");\ndisplay_notice(\"poisonprofile <key> — switch slot; poisonprofile — summary; poisonstatus — full status\", \"white\");\ndisplay_notice(\"psnm on|off|cane|menu; xpsncheck [id] — probe vs effective profile; inventory denial stops PSNM\", \"white\");\ndisplay_notice(\"Keys (Alt only, Mudlet parity): Alt+q–i profiles 1–8; Alt+o maintenance; Alt+[ status; Alt+p help\", \"gold\");\n"},{"type":"function","name":"onGMCP","enabled":true,"id":58,"code":"(function(){\n\r\nif (!client.evisc || !client.evisc.isExecuting) return;\r\nvar m = args.gmcp_method || '';\r\nif (client.evisc.assessPending && m.indexOf('Vitals') >= 0) {\r\n  var th = parseInt(get_variable('pEviscCritWoundLevel') || '0', 10);\r\n  if (th > 0) {\r\n    try {\r\n      var V = GMCP.Char.Vitals;\r\n      if (V) {\r\n        var c = parseInt(V.chestwounds, 10) || 0;\r\n        var g = parseInt(V.gutwounds, 10) || 0;\r\n        if (c >= th || g >= th) {\r\n          run_function('evisc_main', 'assess_ok', 'BladeMaster Engine');\r\n          return;\r\n        }\r\n      }\r\n    } catch (eV) {}\r\n  }\r\n}\r\nif (m.indexOf('Balance') >= 0 || m.indexOf('Vitals') >= 0) {\r\n  run_function('evisc_main', 'balance', 'BladeMaster Engine');\r\n}\r\n\n})();\nif (args && (args.gmcp_method === 'Char.Vitals' || String(args.gmcp_method || '').indexOf('Vitals') >= 0)) {\n  try {\n    var __va = (args && args.gmcp_args) || {};\n    var __vg = {};\n    try { if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Vitals) __vg = GMCP.Char.Vitals; } catch (eGv) {}\n    function __pick(k) {\n      if (__va[k] != null) return String(__va[k]);\n      if (__vg[k] != null) return String(__vg[k]);\n      return '';\n    }\n    var __snap = { la: __pick('left_arm'), ra: __pick('right_arm') };\n    var __prevS = (typeof client !== 'undefined' && client._bmArmSnap) || {};\n    try { client._bmArmSnap = __snap; } catch (eAs) {}\n    var __engA = get_variable('bm_engine');\n    var __engOn = (__engA === undefined || __engA === null || __engA === '' || __engA === '1' || __engA === 1 || __engA === true || String(__engA).toLowerCase() === 'on' || String(__engA).toLowerCase() === 'yes' || String(__engA).toLowerCase() === 'true');\n    var __kmA = get_variable('bm_killmode');\n    var __kmOn = (__kmA === '1' || __kmA === 1 || __kmA === true);\n    var __haveArms = (__snap.la !== '' || __snap.ra !== '');\n    // Arm balance at 0 = the game consumed our send; that hand's spent mark is done.\n    if (__snap.la === '0' || __snap.la === 'false') set_variable('bm_arm_spent_left', '');\n    if (__snap.ra === '0' || __snap.ra === 'false') set_variable('bm_arm_spent_right', '');\n    // Zero-gap volleys: tick bm_kill on ANY arm change (per-arm spent gating inside bm_kill).\n    var __armChanged = __haveArms && (__snap.la !== (__prevS.la || '') || __snap.ra !== (__prevS.ra || ''));\n    if (__engOn && __kmOn && __armChanged) {\n      try { run_function('bm_kill', '', 'BladeMaster Engine'); } catch (eKME) {}\n    }\n  } catch (eEdge) {}\n  try { if (args.gmcp_args) client.bm_vitals = args.gmcp_args; } catch (eV2) {}\n  try { run_function('bm_beast', 'vitals', 'BladeMaster Engine'); } catch (eBzV) {}\n  try { run_function('parry_vitals', JSON.stringify(args.gmcp_args || {}), 'BladeMaster Engine'); } catch (ePv) {}\n  try {\n    var _sm = get_variable('bm_def_smart');\n    if (_sm === '1' || _sm === 1 || _sm === true) run_function('bm_smart_def', '', 'BladeMaster Engine');\n  } catch (eSd) {}\n  try { run_function('bm_tabs', '', 'BladeMaster Engine'); } catch (eT) {}\n}\n/* BM_AFF_GMCP */\n(function () {\n  var meth = (args && args.gmcp_method != null) ? String(args.gmcp_method) : '';\n  if (meth.indexOf('Afflictions') < 0) return;\n  var list = null;\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Afflictions) {\n      list = GMCP.Char.Afflictions.List || GMCP.Char.Afflictions;\n    }\n  } catch (eG) {}\n  if (!list) {\n    try {\n      if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Afflictions) {\n        list = gmcp.Char.Afflictions.List || gmcp.Char.Afflictions;\n      }\n    } catch (eG2) {}\n  }\n  var names = [];\n  var seen = {};\n  var i, item, n;\n  if (list && typeof list.length === 'number') {\n    for (i = 0; i < list.length; i++) {\n      item = list[i];\n      n = (typeof item === 'string') ? item : (item && item.name);\n      n = String(n || '').toLowerCase();\n      if (!n || seen[n]) continue;\n      seen[n] = true;\n      names.push(n);\n    }\n  }\n  try { client.bm_aff_list = names; } catch (eL) {}\n  try { set_variable('bm_aff_json', JSON.stringify(names)); } catch (eJ) {}\n  try { run_function('bm_tabs', '', 'BladeMaster Engine'); } catch (eTaff) {}\n})();\n/* /BM_AFF_GMCP */\n/* BM_DEF_GMCP */\n(function () {\n  var meth = (args && args.gmcp_method != null) ? String(args.gmcp_method) : '';\n  if (meth.indexOf('Defences') < 0) return;\n  function flagOn() {\n    var v = get_variable('bm_bladeshield');\n    if (v === true || v === 1) return true;\n    var s = String(v == null ? '' : v).toLowerCase();\n    return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n  }\n  function seenOn() {\n    var v = get_variable('bm_bladeshield_gmcp');\n    if (v === true || v === 1) return true;\n    var s = String(v == null ? '' : v).toLowerCase();\n    return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n  }\n  function defName(item) {\n    if (item == null) return '';\n    if (typeof item === 'string') return String(item).toLowerCase();\n    return String(item.name || item.defence || item.Name || '').toLowerCase();\n  }\n  function listHasShield(list) {\n    if (!list || typeof list.length !== 'number') return false;\n    var i, n;\n    for (i = 0; i < list.length; i++) {\n      n = defName(list[i]);\n      if (n === 'bladeshield' || n.indexOf('bladeshield') >= 0) return true;\n    }\n    return false;\n  }\n  function nameIsShield(n) {\n    n = String(n || '').toLowerCase();\n    return n === 'bladeshield' || n.indexOf('bladeshield') >= 0;\n  }\n  function readList() {\n    var list = null;\n    try {\n      if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences) {\n        list = GMCP.Char.Defences.List || GMCP.Char.Defences;\n      }\n    } catch (eG) {}\n    if (!list) {\n      try {\n        if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Defences) {\n          list = gmcp.Char.Defences.List || gmcp.Char.Defences;\n        }\n      } catch (eG2) {}\n    }\n    if ((!list || typeof list.length !== 'number') && args && args.gmcp_args) {\n      var raw = args.gmcp_args;\n      if (raw && typeof raw.length === 'number') list = raw;\n      else if (raw && raw.List && typeof raw.List.length === 'number') list = raw.List;\n    }\n    return list;\n  }\n  function clearShield() {\n    try { set_variable('bm_bladeshield', '0'); } catch (eC) {}\n    try { set_variable('bm_bladeshield_gmcp', '0'); } catch (eC2) {}\n    try { run_function('bm_tabs', '', 'BladeMaster Engine'); } catch (eT) {}\n  }\n  function markSeen() {\n    try { set_variable('bm_bladeshield_gmcp', '1'); } catch (eS) {}\n  }\n  var mlow = meth.toLowerCase();\n  function teaCmd() {\n    var k = String(get_variable('bm_tea_kind') || 'green').toLowerCase();\n    if (k === 'black' || k === 'blacktea') return 'blacktea';\n    return 'greentea';\n  }\n  function markTea(cmd, up) {\n    if (cmd === 'greentea') try { set_variable('bm_tea_green_up', up ? '1' : '0'); } catch (eTg) {}\n    else if (cmd === 'blacktea') try { set_variable('bm_tea_black_up', up ? '1' : '0'); } catch (eTb) {}\n  }\n  function noteTea(payload, up, sipIfGone) {\n    var names = [];\n    if (typeof payload === 'string') names.push(String(payload).toLowerCase());\n    else if (payload && typeof payload.length === 'number') {\n      var ti, tn;\n      for (ti = 0; ti < payload.length; ti++) {\n        tn = defName(payload[ti]);\n        if (tn) names.push(tn);\n      }\n    } else if (payload) {\n      var one = defName(payload);\n      if (one) names.push(one);\n    }\n    var tj, nm, cur = teaCmd();\n    for (tj = 0; tj < names.length; tj++) {\n      nm = names[tj];\n      if (nm === 'greentea' || nm === 'blacktea') {\n        markTea(nm, up);\n        if (sipIfGone && !up && nm === cur) {\n          try { run_function('bm_tea', 'sip', 'BladeMaster Engine'); } catch (eTs) {}\n        }\n      }\n    }\n  }\n  if (mlow.indexOf('remove') >= 0) {\n    var rem = null;\n    try { rem = args && args.gmcp_args; } catch (eR) {}\n    var removed = false;\n    if (typeof rem === 'string') removed = nameIsShield(rem);\n    else if (rem && typeof rem.length === 'number') removed = listHasShield(rem);\n    else if (rem) removed = nameIsShield(defName(rem));\n    if (removed && flagOn()) clearShield();\n    noteTea(rem, false, true);\n    return;\n  }\n  if (mlow.indexOf('add') >= 0) {\n    var add = null;\n    try { add = args && args.gmcp_args; } catch (eA) {}\n    if (nameIsShield(typeof add === 'string' ? add : defName(add))) markSeen();\n    noteTea(add, true, false);\n    return;\n  }\n  var list = readList();\n  if (!list || typeof list.length !== 'number') return;\n  if (listHasShield(list)) markSeen();\n  else if (flagOn() && seenOn()) clearShield();\n  markTea('greentea', false);\n  markTea('blacktea', false);\n  var li, ln;\n  for (li = 0; li < list.length; li++) {\n    ln = defName(list[li]);\n    if (ln === 'greentea' || ln === 'blacktea') markTea(ln, true);\n  }\n})();\n/* /BM_DEF_GMCP */\nif (args && (String(args.gmcp_method || '').indexOf('Vitals') >= 0 || String(args.gmcp_method || '').indexOf('Afflictions') >= 0 || String(args.gmcp_method || '').indexOf('Defences') >= 0)) {\n  try { run_function('bm_survive', String(args.gmcp_method || ''), 'BladeMaster Engine'); } catch (eSv) {}\n}\nif (args && (String(args.gmcp_method || '').indexOf('Char.Items') >= 0 || String(args.gmcp_method || '').indexOf('Items.') >= 0)) {\n  try { run_function('bm_wield', 'gmcp', 'BladeMaster Engine'); } catch (eWield) {}\n}\n"},{"type":"function","name":"Read_Me","enabled":true,"id":59,"code":"display_notice(\"BladeMaster Engine (Nexus) — help: xhelpblademaster | xbmhelp | xblademaster | xblademasterhelp\", \"gold\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"xnumpad — toggle strike-key layout (main row 1–7 vs numpad cluster)\", \"gold\");\ndisplay_notice(\"  OFF (default): main row 1–7 for limbs; plain keys unbound so you can type numbers.\", \"cyan\");\ndisplay_notice(\"  ON: use numpad only — 8 head, 5 chest, 2 gut, 4 larm, 6 rarm, 1 lleg, 3 rleg\", \"cyan\");\ndisplay_notice(\"  Same Alt / Ctrl / Shift chords in either mode (see below).\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"Keyboard — limb map when xnumpad is OFF (main row, not numpad):\", \"gold\");\ndisplay_notice(\"  1 head 2 chest   3 gut   4 left arm   5 right arm   6 left leg   7 right leg\", \"cyan\");\ndisplay_notice(\"  Crit on left arm (4) still uses puncturelung via chest (game rule).\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"Keyboard — limb map when xnumpad is ON (numpad keys only):\", \"gold\");\ndisplay_notice(\"  Num8 head  Num5 chest  Num2 gut  Num4 larm  Num6 rarm  Num1 lleg  Num3 rleg\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"Keyboard — strike chords (same modifiers; use the limb key for your active layout):\", \"gold\");\ndisplay_notice(\"Plain keys do not strike: main row stays free for typing; numpad plain keys idle too (chords only).\", \"cyan\");\ndisplay_notice(\"Alt + limb key: base wound\", \"cyan\");\ndisplay_notice(\"Ctrl + limb key: wound lunge\", \"cyan\");\ndisplay_notice(\"Ctrl+Shift + limb key: light\", \"cyan\");\ndisplay_notice(\"Ctrl+Alt + limb key: heavy\", \"cyan\");\ndisplay_notice(\"Alt+Shift + limb key: stab\", \"cyan\");\ndisplay_notice(\"Ctrl+Shift+Alt + limb key: crit\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"Keyboard — main row 8/9/0 (matches Mudlet; Ctrl+Alt avoids triple-mod F-keys):\", \"gold\");\ndisplay_notice(\"Alt+8 — Starchant Blade (same as blade alias)\", \"cyan\");\ndisplay_notice(\"Ctrl+Alt+8 — impede <target> (bmt; alias ximpede)\", \"cyan\");\ndisplay_notice(\"Ctrl+Alt+9 — toggle remiss (modified strikes only)\", \"cyan\");\ndisplay_notice(\"Ctrl+Alt+0 — toggle weakblood (Alt+base strikes; same vars as evisc1/eviscwb2)\", \"cyan\");\ndisplay_notice(\"Ctrl+Alt+- — haymaker (alias xhaymaker). Killer KillMode auto if HP<25 and prone known.\", \"cyan\");\ndisplay_notice(\"When weakblood is ON: Alt+base strikes append weakblood (main row or numpad per xnumpad)\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"Typed aliases (same functions as the keys; xhit* ignore xnumpad):\", \"gold\");\ndisplay_notice(\"  xhit<head|chest|gut|larm|rarm|lleg|rleg>[lunge|light|heavy|stab|crit] — e.g. xhitchest, xhitchestlunge, xhitgutlight, xhitlarmheavy, xhitheadstab, xhitgutcrit\", \"cyan\");\ndisplay_notice(\"  xremiss — toggle persistent remiss (same as Ctrl+Alt+9; not xqueueremiss)\", \"cyan\");\ndisplay_notice(\"  xweakblood — toggle weakblood (same as Ctrl+Alt+0)\", \"cyan\");\ndisplay_notice(\"  Parry shorts: xautoparry25split, xautoparry50head, xautoparry75head, xautoparry50chest, xautoparry75chest, xautoparry50gut, xautoparry75gut, xautoparry50arms, xautoparry75arms, xautoparry50legs, xautoparry75legs (keep xautoparryfull / xautoparryoff / xautoparry50)\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"Target: bmt <name>   (bmt alone shows current target)\", \"cyan\");\ndisplay_notice(\"xspec / xintel — print spec, lock, last hit (no LOOK). xspec bm|pb|bc|al|cv|mk|mg|bd (or full name) locks. xspec clear / xspec off unlocks.\", \"cyan\");\ndisplay_notice(\"Defence chips BM PB BC AL CV MK MG BD lock the same spec. Click the lit chip again to clear. Hits fill spec only when unlocked.\", \"cyan\");\ndisplay_notice(\"Defence Smart uses opponent spec when known (chip / xspec / they hit you if unlocked). No spec yet = xautoparry full.\", \"cyan\");\ndisplay_notice(\"xnumpad — toggle strike layout: main row 1–7 vs numpad map (see top of help)\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"Assess / assay (independent; both can be lit; assess always precedes assay):\", \"cyan\");\ndisplay_notice(\"  xassess — free assess when ready (reuse timer), then strike\", \"cyan\");\ndisplay_notice(\"  xassay — assay then strike (eq). Both on: free assess then assay then the strike\", \"cyan\");\ndisplay_notice(\"  xxass / Alt+` — one-shot: next strike prep = free assess (if balance) then assay (like Mudlet)\", \"cyan\");\ndisplay_notice(\"  xass — probe only (assess and/or assay per chips; no strike)\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"Weakblood (Alt+base strikes only):\", \"gold\");\ndisplay_notice(\"  evisc1 — weakblood ON\", \"cyan\");\ndisplay_notice(\"  eviscwb2 — weakblood OFF (evisc2 is the EVISC2 combo below, not weakblood)\", \"cyan\");\ndisplay_notice(\"  Ctrl+Alt+0 — toggle weakblood (keyboard)\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"Eviscerate stratagem combo (needs bmt target):\", \"gold\");\ndisplay_notice(\"  xevisc — start main combo (works in Support too)\", \"cyan\");\ndisplay_notice(\"  xeviscauto — toggle auto evisc on C! chest/gut (default ON; KillMode not required; Support skips). xeviscauto show\", \"cyan\");\ndisplay_notice(\"  xsupport — toggle Role Killer/Support (persisted bm_role). xsupport show. Support: no auto evisc; lunges every chest/gut at 2p\", \"cyan\");\ndisplay_notice(\"  xassist / xassist taht|neko|bm|al|pb|bc|off — Defence Support chip (teammate spec). Forces Support role; owns poison recipe. xassist show\", \"cyan\");\ndisplay_notice(\"  evisc2 — start EVISC2 (alternate combo path)\", \"cyan\");\ndisplay_notice(\"  eviscabort — cancel combo / clear evisc timers\", \"cyan\");\ndisplay_notice(\"  evistoggle — enable/disable evisc package (pEviscEnabled)\", \"cyan\");\ndisplay_notice(\"  evisclollyprep — toggle lolly bundle + middle weakblood|stab after remiss\", \"cyan\");\ndisplay_notice(\"  xcheeky — Offence chip (default OFF). Remiss-hole wonderpipe (sm add wonderpipe activate harshsmoke); fills empty hole or replaces candy middle.\", \"cyan\");\ndisplay_notice(\"  eviscskipassess — toggle skip crit chest/gut gate before remiss (manual; tracker C! already skips)\", \"cyan\");\ndisplay_notice(\"  evisccq — toggle CrystalQueues for finale (needs CrystalQueues installed)\", \"cyan\");\ndisplay_notice(\"  Optional: pEviscCritWoundLevel (>0) — GMCP Vitals chestwounds/gutwounds threshold for assess gate (see Eviscerate_Nexus_README.txt)\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"blade — send Starchant Blade (same as Alt+8). xblade — toggle pre-evisc Blade reserve (chip).\", \"cyan\");\ndisplay_notice(\"ximpede — impede <bm_target> (same as Ctrl+Alt+8)\", \"cyan\");\ndisplay_notice(\"xrapiers / xbastard / xcane / xgnome — smart weapon switch (one ;; chain). Sheathe/draw blades (grip can stay). Unwield junk/gnome after relax grip, then grip. Skip if already there with grip. Unknown hands: ii once, retry once.\", \"cyan\");\ndisplay_notice(\"xshieldset <id or name> — persist cane/gnome shield (bm_shield_id; default first gnomeweapon seen). xshield — print current shield. xshield <name> — bladeshield that person (Defence Shield chip still bladeshields you).\", \"cyan\");\ndisplay_notice(\"xhaymaker — strike <target> haymaker now (Ctrl+Alt+-). Killer KillMode auto if HP<25 and prone known.\", \"cyan\");\ndisplay_notice(\"xglowbrand — Glow chip (default ON). Chains Infidel then Inquisition after the white-glow line (paste the line to arm).\", \"cyan\");\ndisplay_notice(\"xmaster / xbmengine / xengine / xmaster on|off — Master gate (default ON). Also runs survival (writhe/wake/stand/slush/steam/concentrate/scrub + crit re-raise). Off: no kill volley, no auto evisc/remiss/glow/intel/poison auto, no survival. Keys, Stein, parry stay. Master chip (CE).\", \"cyan\");\ndisplay_notice(\"xbmspam / xbmspam on|off|toggle|show — hide stratagem chatter and the foe assess wound block (default ON). Needs Master on; idle if Master is off. Filter chip (Defence).\", \"cyan\");\ndisplay_notice(\"xstein / xstein on|off — peppermint stein CD (default ON). Tracks bmt target sip only; 60s notices every 10s. Not gated by KillMode/evisc/Engine.\", \"cyan\");\ndisplay_notice(\"xwarcry — send warcry now\", \"cyan\");\ndisplay_notice(\"xpoisonist — Offence chip (default OFF). combatstyle poisonist on kill volleys; evisc finale stays concentrated.\", \"cyan\");\ndisplay_notice(\"xbeast — Offence chip (default OFF). When on, standalone beast order spit <target> before sm clear/arm if beastbal is up. After kill-limb heavy: one last spit in 7s, then hold beastbal for evisc. C! during the window cancels the remaining spit. xevisc waits for beastbal while Beast is on.\", \"cyan\");\ndisplay_notice(\"xbeastpoison <name> — persist bm_beast_poison (command only; chip does not cycle). Empty name: notice, no drink. On change / Beast on with a poison set: beast order purge, then beast order drink <name> on next beastbal.\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"Behind the scenes (Reflex functions / hooks):\", \"gold\");\ndisplay_notice(\"  onInstall — default BM + evisc + ParryStance (ps_*) + psnm_* variables; bm_engine default 1; bm_spam default 1; onLoad → onInstall\", \"cyan\");\ndisplay_notice(\"  bmEngineOn — persist bm_engine (unset = on). Gates trigger/GMCP combat sends and survival. Aliases, Stein, parry/aff, strike keys stay.\", \"cyan\");\ndisplay_notice(\"  bm_core — strikes, assess/assay prep, xsmart reroute, bm_pending queue; arg balance replays pending strike\", \"cyan\");\ndisplay_notice(\"  bm_kill — xkillmode tick on every arm event (GMCP arm change / arm balance line): opener raze + chest (arm-balance handshake), then per-hand sends the instant that arm is usable (bm_arm_spent_*). Default spec: bmPlanKillVolley (sticky primary vital, lunge through parry from spare power above the evisc reserve, secondary vital, split bait, legs fallback). Smart poison: send wipe/ENVENOM as direct commands before sm clear + prep/arm\", \"cyan\");\ndisplay_notice(\"  bm_kill_parry — xkillparry tuning (bm_parry_*), xkillmode status lines, reset on bmt/xtar/KillMode ON\", \"cyan\");\ndisplay_notice(\"  bm_track — outgoing swipe/lunge land lines + wound-level lines + assess stars → bm_w_* / bm_p_* / bm_en_*; C! chest/gut latch ~8s → bm_try_auto_evisc; live parry lines resolve bm_swing_queue → bm_live_parry_* ring → evalVitalDenied (PARRY CONFIRMED / RELEASED); assay parry % feeds the same hysteresis; Smart poison restyle after wounds/parry\", \"cyan\");\ndisplay_notice(\"  bm_intel — opponent spec from Defence chips / xspec (lock) or they-hit-you weapon words (if unlocked); last limb they hit\", \"cyan\");\ndisplay_notice(\"  bm_smart_def — Defence Smart planner (Mudlet choose table → _parry 50/75/25split + stance)\", \"cyan\");\ndisplay_notice(\"  bm_try_auto_evisc — xeviscauto (default ON): C! chest/gut starts xevisc even if KillMode is off; Blade/Candy/WB/Smart poisons; shared debounce with kill mode\", \"cyan\");\ndisplay_notice(\"  bm_sync_wep_poison — Standard: open senso / one vital denied (parried1) dendroxin hinder hand + senso kill hand / both denied (parried) dendroxin / evisc dust. Power: Power SAP (escozul/dendroxin) on rapiers while wounding (no bastard). Custom: apply that psnm profile. Assist spec wins over Standard/Power. Killer C! still evisc dust.\", \"cyan\");\ndisplay_notice(\"  bm_tabs — HTML + chips for CE / Offence / Defence\", \"cyan\");\ndisplay_notice(\"  bm_chip — tab chip clicks (engine, spam, role, assistspec, killmode, blade, lunges, poisons, candy, cheeky, wb, poisonist, beast, queues, stableft, stabright, assess, assay, smart, parry, stance, affs, tea, specbm/specpb/specbc/specal/speccv/specmk/specmg/specbd, heretic, infidel, inquisition, fervor, hallowed, glow, infidelplus, haymaker, warcry, armsbless, armsrelease, emerald, azure, golden, bastard, findgear, shield, impede, click*, hit*, …)\", \"cyan\");\ndisplay_notice(\"  bm_beast — Beast spit/hold (bm_beast + xbeastpoison). Spit before sendDual / manual strikes; purge+drink on next beastbal; 7s last spit after kill-limb heavy; evisc waits for beastbal\", \"cyan\");\ndisplay_notice(\"  bm_survive — combat-core survival (writhe/wake/stand/slush/steam/concentrate/scrub + slim crit re-raise). Gated by Master. Hooks Char.Vitals / Afflictions / Defences.\", \"cyan\");\ndisplay_notice(\"  bm_tea — keep Green/Black tea up (sip when GMCP Remove says that def is down; green belch/fluid/repels lines)\", \"cyan\");\ndisplay_notice(\"  evisc_main — full evisc state machine (ops: start, start2, abort, toggle, balance, …)\", \"cyan\");\ndisplay_notice(\"  stein_main — peppermint stein 60s tracker (ce_stein default on; bmt only; not gated by evisc/kill mode)\", \"cyan\");\ndisplay_notice(\"  _parry / parry_vitals — bundled ParryStance (xparry, xstance, xautoparry; auto on Char.Vitals)\", \"cyan\");\ndisplay_notice(\"  psnm_* / psnm_help — bundled PoisonManager (xpoisons, psnm, poisonprofile, psnm_apply_recipe, psnm_volley_sm_cmds; Offence Poisons chip)\", \"cyan\");\ndisplay_notice(\"  onGMCP — evisc tick + parry_vitals + bm_smart_def + refresh Defence/CE tabs on Char.Vitals; cache Char.Afflictions for Defence Affs pills; clear bm_bladeshield if Char.Defences lose bladeshield; sip Green/Black tea when that defence is removed; bm_beast drink / 7s expire / evisc-wait on beastbal; bm_survive after those caches on Char.Vitals / Afflictions / Defences (Master on)\", \"cyan\");\ndisplay_notice(\"  Read_Me — this help text\", \"cyan\");\ndisplay_notice(\"Triggers: balance+eq line (incl. per-arm balance) → bm_core + evisc_main balance + bm_kill; <name> parries the attack → bm_track (live parry); remiss thigh spray; * Chest|Gut critical; lollipop eat; peppermint stein sip → stein_main; they-hit-you → bm_intel; green tea belch/fluid/repels → bm_tea. Combat sends and survival gated by bm_engine (xmaster / xbmengine); stein/parry/aff/FIND-in-progress/tea stay.\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"Kill mode (simple auto wound-build):\", \"gold\");\ndisplay_notice(\"  xkillmode — toggle. Needs Master on and bmt/xtar target. Opener raze + base chest (done when both arms cycle), then each hand fires as soon as its arm balance is back (no fixed gap). Default spec: primary vital = most wounded (tie: lower effParry, then chest); both hands base on it while open.\", \"cyan\");\ndisplay_notice(\"  Parry-denied primary (assay >= xsmart threshold twice in the window, a live parry + assay, or vitals stance): spare power above the evisc reserve -> LUNGE THROUGH PARRY (2 hands, else 1 + secondary/bait); no power -> HOLD, build the open vital (xkillparry policy vital = both hands, bait = kill hand + arm bait); both denied -> SPLIT bait arms/legs up to splitmax, then FALLBACK both hands on one leg -> legtendon. Release: assay below release % or 2 landed swings.\", \"cyan\");\ndisplay_notice(\"  xkillmode status — primary + reason, CHEST/GUT effParry (assay, live n/m, pts) DENIED, lunge budget, phase/split, prone. Same block sits under Kill:/Hinder: on the Offence tab while KillMode is on.\", \"cyan\");\ndisplay_notice(\"  xkillparry — show tuning + status. xkillparry policy vital|bait. xkillparry watch|release|points|window|splitmax N (defaults 50 / 70 / 2 / 20s / 4).\", \"cyan\");\ndisplay_notice(\"  xtar <name> — same as bmt <name> (Mudlet parity). xstratecho — toggle a [BM strat] echo of every sent kill chain (default OFF).\", \"cyan\");\ndisplay_notice(\"  xlunges — chest/gut kill path only (never hinder). Killer: every 3rd at 2p/hand. Support: every chest/gut hit at 2p/hand, including C!. Both hands on the kill limb can lunge.\", \"cyan\");\ndisplay_notice(\"  xblade — persist pre-evisc starchant + wound volleys on first C! (default OFF; reserve +3).\", \"cyan\");\ndisplay_notice(\"  xlungeleft / xlungeright — queue left/right lunge on that hand next volley (session; not vital-gated; 2p or power unknown, not evisc reserve). Applied at send. Stab on the same hand wins.\", \"cyan\");\ndisplay_notice(\"  xstableft / xstabright — queue left/right stab on the next kill volley (session; wins over queued lunge; no power cost).\", \"cyan\");\ndisplay_notice(\"  Engine stabs (queue, Alt+Shift / pad, evisc candy middle) send combatstyle poisonist first, then concentrated after the hit — not in the same FREE stack. Evisc finale stays concentrated.\", \"cyan\");\ndisplay_notice(\"  xqueueremiss — queue remiss on the next kill volley (CE Remiss chip; session; does not flip Ctrl+Alt+9 remiss).\", \"cyan\");\ndisplay_notice(\"  KillMode assess only if Assess is on (reuse). Assay only if Always Assay is on: every 3rd volley, or every volley while a vital effParry >= watch, a live parry was just seen, denial flipped, or phase is split/fallback (parry logic needs Assay — one-time hint on KillMode ON). Killer starts xevisc at C!. Support keeps wounding. Manual keys still work.\", \"cyan\");\ndisplay_notice(\"  xeviscauto (default ON) also starts xevisc on C! chest/gut when you are only whacking — KillMode not required. Support skips auto evisc.\", \"cyan\");\ndisplay_notice(\"  Blade (xblade) still starchants + light volleys on the C! vital before that first evisc, even if KillMode is off.\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"Custom tabs (auto-created on load — names stay CE / Offence / Defence):\", \"gold\");\ndisplay_notice(\"  Clickable chips (same names as Mudlet). On = green, Off = grey. Click runs bm_chip and refreshes all three tabs.\", \"cyan\");\ndisplay_notice(\"  CE — Combat Engine: BladeMaster: Master (On/Off), KillMode, Role (Killer/Support), Smart, Heretic/Infidel/Infidel+/Inquisition, Glow/Bastard/Remiss/Impede (default OFF skips 2H), modifier chips (Base/Lunge/Light/Heavy/Stab), 7-limb pad. Crit keybinds (Ctrl+Shift+Alt + limb) stay. Lunges live on Offence. Remiss queue is on CE. Haymaker stays on xhaymaker / Ctrl+Alt+- (no chip).\", \"cyan\");\ndisplay_notice(\"  CE chips: Heretic / Infidel / Infidel+ / Inquisition, Glow / Bastard / Remiss / Impede.\", \"cyan\");\ndisplay_notice(\"  xfindgear — ii musicbox then ii scabbard then p each scabbard; saves box ids and psnmw1/w2 (psnmbid only if Bastard is on). Auto-Find runs once after load and when a box/poison path needs an empty id.\", \"cyan\");\ndisplay_notice(\"  xfindyes — rescan (clears declined). xfindno — stop auto-asking. Empty scan does not loop; type xfindyes to try again.\", \"cyan\");\ndisplay_notice(\"  bm_findgear — inventory finder used by xfindgear / xfindyes / auto-Find\", \"cyan\");\ndisplay_notice(\"  bm_wield — xrapiers / xbastard / xcane / xgnome / xshieldset; persist bm_shield_id; GMCP l/L hands\", \"cyan\");\ndisplay_notice(\"  Offence — Lunges, Candy, Cheeky, Blade, Poisons, Poisonist, WeakBlood, Beast — plus L Lunge / R Lunge / Stab L / Stab R, Spec (from Defence chips / xspec), and wounds/parry.\", \"cyan\");\ndisplay_notice(\"  Defence — Reactive / Parry / Stance / Affs / Always Assess / Always Assay / Filter / Tea (Green/Black), then spec chips BM PB BC AL CV MK MG BD (xspec), then Support (teammate spec, not foe), then Emerald / Azure / Golden / Shield — plus your 7-limb wounds from GMCP. Affs chip stays on the top row; the aff list is at the bottom (after Stance/Parry).\", \"cyan\");\ndisplay_notice(\"  Defence Tea chip: Green or Black (always on, no Off). Click cycles type. Sips that tea when GMCP says the defence is down. White/oolong stay on xtea aliases only.\", \"cyan\");\ndisplay_notice(\"  Defence Affs chip lists your GMCP affs (display only; not inferred / not click-to-cure). Pills render last on Defence.\", \"cyan\");\ndisplay_notice(\"  Defence Reactive/Parry/Stance is built in (no second ParryStance import). Reactive uses opponent spec when known (chip / xspec / unlocked hit guess). Limb pad is snug.\", \"cyan\");\ndisplay_notice(\"  Poisons chip: Standard (senso wound-build), Power (Power SAP / escozul), then any filled custom psnm profiles (3–9). Click to cycle. Killer C! still evisc dust. Needs psnmw1/w2. Help: xpoisons. Support chip owns the recipe while a teammate spec is on.\", \"cyan\");\ndisplay_notice(\"  Support chip: Off / Taht / Neko / BM / AL / PB / BC (xassist). Lives on Defence under foe-spec chips. Teammate spec — not foe. Forces Support role; wound priority + venoms follow that wiki kill path. bmt does not clear it.\", \"cyan\");\ndisplay_notice(\"  xparry / xunparry / xstance / xautoparry* / xparryhelp — same commands as standalone ParryStance.\", \"cyan\");\ndisplay_notice(\"  xpoisons / psnm / poisonprofile / psnmrapiers — same commands as standalone PoisonManager.\", \"cyan\");\ndisplay_notice(\"  If standalone PoisonManager.nxs is still imported, disable it so aliases do not fire twice.\", \"cyan\");\ndisplay_notice(\"  xce — refresh tabs. Drag one out to float. Do not name a tab Main (collides with game output).\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"xsmart — toggle: if assay parry % on the limb is at/over threshold, use the backup limb\", \"cyan\");\ndisplay_notice(\"xsmart threshold <n>   xsmart backup1 chest|gut   backup2/3 <limb>   xsmart show\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"xbmcombatlog / xbmbladelog — toggle vars only on Nexus (no CombatLog window)\", \"cyan\");\ndisplay_notice(\" \", \"cyan\");\ndisplay_notice(\"Nexus: set command stack delineator to ;; (Gear → Advanced), not |\", \"cyan\");\n"},{"type":"alias","name":"","enabled":true,"id":60,"matching":"exact","whole_words":true,"case_sensitive":false,"prefix_suffix":false,"actions":[{"action":"script","script":"run_function('Read_Me','','BladeMaster Engine');"}],"text":"xhelpblademaster"},{"type":"alias","name":"","enabled":true,"id":61,"matching":"exact","whole_words":true,"case_sensitive":false,"prefix_suffix":false,"actions":[{"action":"script","script":"run_function('Read_Me','','BladeMaster Engine');"}],"text":"xbmhelp"},{"type":"alias","name":"","enabled":true,"id":62,"matching":"exact","whole_words":true,"case_sensitive":false,"prefix_suffix":false,"actions":[{"action":"script","script":"run_function('Read_Me','','BladeMaster Engine');"}],"text":"xblademaster"},{"type":"alias","name":"","enabled":true,"id":63,"matching":"exact","whole_words":true,"case_sensitive":false,"prefix_suffix":false,"actions":[{"action":"script","script":"run_function('Read_Me','','BladeMaster Engine');"}],"text":"xblademasterhelp"},{"type":"alias","name":"","enabled":true,"id":64,"matching":"exact","whole_words":true,"case_sensitive":false,"prefix_suffix":false,"actions":[{"action":"script","script":"var v=get_variable('bm_numpad')==='1'?'0':'1';\nset_variable('bm_numpad',v);\ndisplay_notice('[BM] Strike keys: '+(v==='1'?'NUMPAD (8=h 5=c 2=g 4=la 6=ra 1=ll 3=rl)':'MAIN ROW 1-7'),'lightgreen');"}],"text":"xnumpad"},{"type":"alias","name":"","enabled":true,"id":65,"matching":"regexp","whole_words":false,"case_sensitive":false,"prefix_suffix":true,"actions":[{"action":"script","script":"var t=(args[1]||'').trim();\nvar prev=(get_variable('bm_target')||'').trim();\nset_variable('bm_target',t);\nif (t && t.toLowerCase() !== prev.toLowerCase()) {\n  var _w=['head','chest','gut','larm','rarm','lleg','rleg'], _i;\n  for (_i=0;_i<_w.length;_i++) set_variable('bm_w_'+_w[_i],'');\n  set_variable('bm_w_crit_latch','0');\n  set_variable('bm_p_head',''); set_variable('bm_p_chest',''); set_variable('bm_p_gut','');\n  set_variable('bm_en_hp',''); set_variable('bm_en_ego',''); set_variable('bm_en_mana',''); set_variable('bm_en_power','');\n  set_variable('bm_en_style',''); set_variable('bm_en_stance',''); set_variable('bm_en_name','');\n  set_variable('bm_kill_volley','0'); set_variable('bm_kill_pending','');\n  set_variable('bm_kill_watch_tgt', t);\n  try { run_function('bm_kill_parry','reset','BladeMaster Engine'); } catch (eKr) {}\n  set_variable('bm_pre_evisc_blade_fired',''); set_variable('bm_pre_evisc_await','0');\n  set_variable('bm_auto_evisc_last','0'); set_variable('bm_auto_evisc_last_tgt','');\n  set_variable('bm_poisonist_sent','0'); set_variable('bm_conc_sent','0'); set_variable('bm_en_prone','');\n  set_variable('bm_beast_hold','0'); set_variable('bm_beast_heavy_until','0'); set_variable('bm_beast_evisc_wait','0');\n  set_variable('bm_en_spec',''); set_variable('bm_en_spec_lock','0'); set_variable('bm_en_family',''); set_variable('bm_en_conf','');\n  set_variable('bm_en_hit',''); set_variable('bm_def_choice','');\n  try { run_function('bm_tea','spec|','BladeMaster Engine'); } catch (eTea) {}\n  try { run_function('bm_smart_def','','BladeMaster Engine'); } catch (eSd) {}\n}\ndisplay_notice('[BM] Target: '+t,'cyan');\ntry { 