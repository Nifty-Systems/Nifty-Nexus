{"type":"group","name":"BladeMaster Engine","enabled":true,"id":1,"items":[{"type":"function","name":"onLoad","enabled":true,"id":2,"code":"run_function(\"onInstall\",\"\",\"BladeMaster Engine\");\n"},{"type":"function","name":"onInstall","enabled":true,"id":3,"code":"function bmDef(k, v) { if (get_variable(k) == undefined) set_variable(k, v); }\nbmDef('bm_remiss', '0');\nbmDef('bm_xassess', '1');\nbmDef('bm_xassay', '0');\nbmDef('bm_xassessassay', '0');\n(function () {\n  var legacy = get_variable('bm_xassessassay');\n  if (legacy === undefined || legacy === null || legacy === '' || legacy === '0' || legacy === 0) {\n    legacy = get_variable('xassessassay');\n  }\n  var on = (legacy === '1' || legacy === 1 || legacy === true || String(legacy).toLowerCase() === 'on' || String(legacy).toLowerCase() === 'yes');\n  if (on) {\n    set_variable('bm_xassess', '1');\n    set_variable('bm_xassay', '1');\n    set_variable('bm_xassessassay', '0');\n    set_variable('xassessassay', '0');\n  }\n})();\nbmDef('bm_assay_next', '0');\nbmDef('bm_xxass_next', '0');\nbmDef('bm_assess_require_eq', '0');\nbmDef('bm_lr_use_left', '1');\nbmDef('bm_assess_reuse_sec', '12');\nbmDef('bm_target', '');\nbmDef('bm_pending', '');\nbmDef('bm_assess_consumed_tgt', '');\nbmDef('bm_assess_foe_until', '0');\nbmDef('bm_last_assess_time', '0');\nbmDef('bm_xsmart', '0');\nbmDef('bm_smart_threshold', '90');\nbmDef('bm_smart_b1chest', 'gut');\nbmDef('bm_smart_b1gut', 'chest');\nbmDef('bm_smart_b2', 'head');\nbmDef('bm_smart_b3', 'larm');\nbmDef('bm_engine', '1');\nbmDef('bm_spam', '1');\nbmDef('bm_killmode', '0');\nbmDef('bm_smart_poison', '1');\nbmDef('bm_poison_mode', 'standard');\nbmDef('bm_wep_poison_style', '');\nbmDef('bm_kill_limb', 'chest');\nbmDef('bm_hinder_limb', 'larm');\nbmDef('bm_kill_hand', 'right');\nbmDef('bm_hinder_hand', 'left');\nbmDef('bm_kill_volley', '0');\nbmDef('bm_kill_pending', '');\nbmDef('bm_kill_last', '0');\nbmDef('bm_kill_lunge', '0');\nbmDef('bm_kill_phase', 'kill');\nbmDef('bm_kill_wait_note_at', '0');\nbmDef('bm_opener_done', '0');\nbmDef('bm_opener_inflight', '0');\nbmDef('bm_opener_sent_at', '0');\nbmDef('bm_opener_arm_down', '0');\nbmDef('bm_arm_spent_left', '');\nbmDef('bm_arm_spent_right', '');\nbmDef('bm_kill_watch_tgt', '');\nbmDef('bm_parry_watch', '50');\nbmDef('bm_parry_release', '70');\nbmDef('bm_parry_confirm_points', '2');\nbmDef('bm_parry_evidence_sec', '20');\nbmDef('bm_split_max_volleys', '4');\nbmDef('bm_parry_policy', 'vital');\nbmDef('bm_parry_den_head', '');\nbmDef('bm_parry_den_chest', '');\nbmDef('bm_parry_den_gut', '');\nbmDef('bm_kill_vital_lock', '');\nbmDef('bm_split_volleys', '0');\nbmDef('bm_fallback_leg', '');\nbmDef('bm_parry_flip', '0');\nbmDef('bm_parry_was_chest', '');\nbmDef('bm_parry_was_gut', '');\nbmDef('bm_swing_queue', '');\nbmDef('bm_live_parry_last_at', '0');\nbmDef('bm_kill_last_volley_at', '0');\nbmDef('bm_parry_assay_hint', '0');\nbmDef('bm_strat_echo', '0');\nbmDef('bm_role', 'killer');\nbmDef('bm_assist_spec', 'off');\nbmDef('bm_assist_role_saved', '');\nbmDef('bm_use_bastard', '0');\nbmDef('bm_glow_brand', '1');\nbmDef('bm_glow_holy', '0');\nbmDef('bm_poisonist', '0');\nbmDef('bm_poisonist_sent', '0');\nbmDef('bm_beast', '0');\nbmDef('bm_beast_poison', '');\nbmDef('bm_beast_loaded', '0');\nbmDef('bm_survive_sap', '0');\nbmDef('bm_survive_stench', '0');\nset_variable('bm_beast_hold', '0');\nset_variable('bm_beast_heavy_until', '0');\nset_variable('bm_beast_need_drink', '0');\nset_variable('bm_beast_saw_unready', '0');\nset_variable('bm_beast_evisc_wait', '0');\nbmDef('bm_conc_sent', '0');\nbmDef('bm_brand_last', '');\nbmDef('bm_en_prone', '');\nbmDef('bm_haymaker_last', '0');\nbmDef('bm_glow_last', '0');\nbmDef('bm_pre_evisc_blade', '0');\nbmDef('bm_auto_evisc', '1');\nbmDef('bm_pre_evisc_blade_fired', '');\nbmDef('bm_pre_evisc_await', '0');\nbmDef('bm_auto_evisc_last', '0');\nbmDef('bm_auto_evisc_last_tgt', '');\nset_variable('bm_next_lunge_left', '0');\nset_variable('bm_next_lunge_right', '0');\nset_variable('bm_next_stab_left', '0');\nset_variable('bm_next_stab_right', '0');\nset_variable('bm_next_remiss', '0');\nset_variable('bm_stab_restore', '0');\nbmDef('bm_last_action', '');\nbmDef('bm_w_head', '');\nbmDef('bm_w_chest', '');\nbmDef('bm_w_gut', '');\nbmDef('bm_w_larm', '');\nbmDef('bm_w_rarm', '');\nbmDef('bm_w_lleg', '');\nbmDef('bm_w_rleg', '');\nbmDef('bm_w_crit_latch', '0');\nbmDef('bm_p_head', '');\nbmDef('bm_p_chest', '');\nbmDef('bm_p_gut', '');\nbmDef('bm_en_hp', '');\nbmDef('bm_en_ego', '');\nbmDef('bm_en_mana', '');\nbmDef('bm_en_power', '');\nbmDef('bm_en_style', '');\nbmDef('bm_en_stance', '');\nbmDef('bm_en_name', '');\nbmDef('bm_log_combat', '0');\nbmDef('bm_log_blade', '1');\nbmDef('bm_numpad', '0');\nbmDef('bm_def_smart', '0');\nbmDef('bm_def_parry', '1');\nbmDef('bm_def_stance', '1');\nbmDef('bm_en_spec', '');\nbmDef('bm_en_spec_lock', '0');\nbmDef('bm_en_family', '');\nbmDef('bm_en_conf', '');\nbmDef('bm_en_hit', '');\nbmDef('bm_def_choice', '');\nbmDef('bm_show_affs', '1');\nbmDef('bm_tea_kind', 'green');\nvar seedTeaUser = String(get_variable('bm_tea_kind') || 'green').toLowerCase();\nif (seedTeaUser === 'black' || seedTeaUser === 'blacktea') seedTeaUser = 'blacktea';\nelse seedTeaUser = 'green';\nbmDef('bm_tea_user', seedTeaUser);\nbmDef('bm_tea_green_up', '0');\nbmDef('bm_tea_black_up', '0');\nbmDef('bm_click_mod', 'base');\nbmDef('bm_bladeshield', '0');\nbmDef('bm_bladeshield_gmcp', '0');\nbmDef('bm_shield_id', '');\nbmDef('bm_gnome_ids', '');\nset_variable('bm_wield_pending', '');\nset_variable('bm_weakblood', '0');\nset_variable('evisc_weakblood', '0');\nbmDef('bm_find_declined', '0');\nset_variable('bm_find_auto_once', '0');\nbmDef('ce_stein', '1');\nbmDef('ce_stein_left', '0');\nbmDef('ce_stein_until', '0');\ntry {\n  var prevAf = parseInt(get_variable('bm_find_autoload_tid') || '', 10);\n  if (prevAf) { try { clearTimeout(prevAf); } catch (eAf0) {} }\n} catch (eAf1) {}\nvar tidAf = setTimeout(function () {\n  set_variable('bm_find_autoload_tid', '');\n  try { run_function('bm_findgear', 'maybeauto', 'BladeMaster Engine'); } catch (eAf2) {}\n}, 2500);\nset_variable('bm_find_autoload_tid', String(tidAf));\n\r\nfunction evDef(k, v) { if (get_variable(k) == undefined) set_variable(k, v); }\r\nevDef('pEviscEnabled', '1');\r\nevDef('pEviscLollyPrep', '0');\r\nevDef('evisc_cheeky', '0');\r\nevDef('pEviscSkipAssess', '0');\r\nevDef('pEviscUseCrystalQueues', '0');\r\nevDef('pEviscCritWoundLevel', '0');\r\nevDef('evisc_lolly_cd_until', '0');\r\nevDef('evisc_love_sipped', '0');\r\nevDef('evisc_love_target', '');\r\nif (client.evisc == undefined) client.evisc = {};\r\n\n\r\nfunction psDef(k,v){ if(get_variable(k)===undefined||get_variable(k)===null) set_variable(k,v); }\r\npsDef('ps_auto_mode','off');\r\npsDef('ps_auto50_part','head');\r\npsDef('ps_parries','{}');\r\npsDef('ps_stance','');\r\npsDef('ps_last_wounds','{}');\r\nset_variable('ps_parries','{}');\r\nset_variable('ps_stance','');\r\nset_variable('ps_last_wounds','{}');\r\n\n\r\n(function () {\r\n  function d(k, v) { if (get_variable(k) === undefined || get_variable(k) === null || get_variable(k) === '') set_variable(k, v); }\r\n  var legacy = get_variable('psnm_current');\r\n  d('psnm_profile_rapiers', legacy || 'blademaster1');\r\n  d('psnm_current', legacy || 'blademaster1');\r\n  d('psnm_default', 'blademaster1');\r\n  d('psnm_default_rapiers', get_variable('psnm_profile_rapiers') || 'blademaster1');\r\n  d('psnm_default_bastard', 'bastardsenso');\r\n  d('psnm_profile_bastard', get_variable('psnm_default_bastard'));\r\n  d('psnm_weapon_mode', 'none');\r\n  d('psnm_custom', '{}');\r\n  d('psnm_maintenance', '0');\r\n  d('psnm_maint_interval_sec', '5');\r\n  d('psnm_maint_pos_left', '0');\r\n  d('psnm_maint_pos_right', '0');\r\n  d('psnm_w1', '');\r\n  d('psnm_w2', '');\r\n  d('psnm_bastard_id', '');\r\n  d('psnm_maint_timeout_id', '');\r\n  d('psnm_sync_timeout_id', '');\r\n  d('psnm_apply_gen', '0');\r\n  d('psnm_last_left', '[]');\r\n  d('psnm_last_right', '[]');\r\n  d('psnm_pending_wipe', '0');\r\n  d('psnm_volley_cmds', '[]');\r\n  d('psnm_probe_weapon', '');\r\n  d('psnm_probe_poisons', '[]');\r\n  d('psnm_probe_capturing', '0');\r\n})();\r\n\ndisplay_notice(\"BladeMaster Engine: xhelpblademaster - xfindgear - xmaster - xkillmode - xpoisons - xparry:\", \"gold\");\ndisplay_notice(\"Want to Get Fighting? Step 1. Set a target with BMT <target> Step 2. Click Master On and KillMode On in the Combat Engine Tab\", \"gold\");\ntry { run_function('bm_tabs', '', 'BladeMaster Engine'); } catch (eTabs) {}\n\n"},{"type":"function","name":"bm_core","enabled":true,"id":4,"code":"/** Nexus: balance-line triggers may pass {text, match, backrefs, ...} into run_function targets; if that reaches bm_core, String(args) becomes \"[object Object]\" and op !== 'balance', so we fall through and spam free assess (bm_xassess default ON) on each recovery line. Only remap clearly trigger-shaped objects to balance; handle array-likes (e.g. Arguments) so keybind args still work. */\nfunction bmTriggerStyleArgs(raw) {\n  if (raw == null || typeof raw !== 'object' || Array.isArray(raw)) return false;\n  return ('text' in raw) || ('match' in raw) || ('backrefs' in raw) || ('prefix' in raw) || ('suffix' in raw);\n}\nfunction bmSplitArgs(raw) {\n  if (raw == null) return [''];\n  if (typeof raw === 'string') return raw.split('|');\n  if (typeof raw === 'object' && raw !== null) {\n    if (bmTriggerStyleArgs(raw)) return ['balance'];\n    if (typeof raw.length === 'number' && raw.length > 0 && raw[0] !== undefined) {\n      var acc = [];\n      for (var ai = 0; ai < raw.length; ai++) acc.push(String(raw[ai]));\n      return acc.join('|').split('|');\n    }\n  }\n  return String(raw).split('|');\n}\nvar a = bmSplitArgs(args);\nvar op = (a[0] || '').trim();\n\nvar MOD = {\n  head: { light: 'sliceear', heavy: 'slitthroat', crit: '' },\n  chest: { light: 'puncturechest', heavy: 'gashchest', crit: 'eviscerate' },\n  gut: { light: 'disembowel', heavy: 'ravagegut', crit: 'eviscerate' },\n  larm: { light: 'piercearm', heavy: 'collapsenerve', crit: 'puncturelung' },\n  rarm: { light: 'piercearm', heavy: 'collapsenerve', crit: '' },\n  lleg: { light: 'pierceleg', heavy: '', crit: 'legtendon' },\n  rleg: { light: 'pierceleg', heavy: '', crit: 'legtendon' }\n};\n\nfunction bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\n// Nexus may return 1/true vs '1'; weakblood must still apply.\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nfunction noteBmAction(s) {\n  bmSet('bm_last_action', s || '');\n  try { run_function('bm_tabs', '', 'BladeMaster Engine'); } catch (eTab) {}\n}\nfunction bmParryPct(limb) {\n  var v = parseInt(bmGet('bm_p_' + limb, ''), 10);\n  return isNaN(v) ? -1 : v;\n}\nfunction bmLimbDenied(limb) {\n  var th = parseInt(bmGet('bm_smart_threshold', '90'), 10);\n  if (isNaN(th)) th = 90;\n  var p = bmParryPct(limb);\n  if ((limb === 'head' || limb === 'chest' || limb === 'gut') && p >= 0) return p >= th;\n  return false;\n}\nfunction bmResolveSmart(body) {\n  if (!bmBool('bm_xsmart')) return body;\n  if (!bmLimbDenied(body)) return body;\n  var backups = [];\n  if (body === 'chest') backups.push(bmGet('bm_smart_b1chest', 'gut'));\n  else if (body === 'gut') backups.push(bmGet('bm_smart_b1gut', 'chest'));\n  backups.push(bmGet('bm_smart_b2', 'head'));\n  backups.push(bmGet('bm_smart_b3', 'larm'));\n  var i, b;\n  for (i = 0; i < backups.length; i++) {\n    b = String(backups[i] || '').toLowerCase().trim();\n    if (b && b !== body && !bmLimbDenied(b)) return b;\n  }\n  return body;\n}\n\nfunction nextVitalSide() {\n  if (bmBool('bm_lr_use_left')) { bmSet('bm_lr_use_left', '0'); return 'left'; }\n  bmSet('bm_lr_use_left', '1'); return 'right';\n}\nfunction vitalSegments(body) {\n  if (!body || (body !== 'head' && body !== 'chest' && body !== 'gut')) return [body];\n  return [nextVitalSide(), body];\n}\nfunction buildStrikeCmd(tgt, body, tier, doLunge) {\n  var limbSeg = vitalSegments(body);\n  var i, parts, mod, chestSeg;\n  if (tier === 'base' && !doLunge) {\n    var limbStr = limbSeg.join(' ');\n    if (bmBool('bm_weakblood')) return 'strike ' + tgt + ' ' + limbStr + ' weakblood';\n    return 'strike ' + tgt + ' ' + limbStr;\n  }\n  parts = ['strike', tgt];\n  for (i = 0; i < limbSeg.length; i++) parts.push(limbSeg[i]);\n  if (tier && tier !== 'base') {\n    if (tier === 'stab') {\n      parts.push('stab');\n      if (bmBool('bm_remiss')) parts.push('remiss');\n    } else {\n      mod = MOD[body] ? MOD[body][tier] : '';\n      if (mod) {\n        if (mod === 'puncturelung') {\n          chestSeg = vitalSegments('chest');\n          parts = ['strike', tgt];\n          for (i = 0; i < chestSeg.length; i++) parts.push(chestSeg[i]);\n          parts.push('puncturelung');\n        } else if (mod === 'eviscerate' && body === 'gut') {\n          chestSeg = vitalSegments('chest');\n          parts = ['strike', tgt];\n          for (i = 0; i < chestSeg.length; i++) parts.push(chestSeg[i]);\n          parts.push('eviscerate');\n        } else parts.push(mod);\n        if (bmBool('bm_remiss')) parts.push('remiss');\n      }\n    }\n  }\n  if (doLunge) parts.push('lunge');\n  return parts.join(' ');\n}\n\nfunction segsHaveStab(segs) {\n  var i, s;\n  for (i = 0; i < (segs || []).length; i++) {\n    s = String(segs[i] || '');\n    if (/(^|[|s])stab([|s]|$)/i.test(s) && s.toLowerCase().indexOf('eviscerate') < 0) return true;\n  }\n  return false;\n}\nfunction sendBmChain(segs) {\n  if (!segs.length) return;\n  if (segsHaveStab(segs)) {\n    try { run_function('bm_stab_style', 'arm', 'BladeMaster Engine'); } catch (eW) {}\n  }\n  send_command(segs.join(';;'), 0);\n}\nfunction smAddPrepLine(prepCmds) { return 'sm add ' + prepCmds.join('|'); }\nfunction sendPrepOnly(prepCmds) {\n  if (!prepCmds || !prepCmds.length) return;\n  sendBmChain(['sm clear', smAddPrepLine(prepCmds)]);\n}\nfunction bmClearBladeShield() {\n  if (!bmBool('bm_bladeshield')) return;\n  bmSet('bm_bladeshield', '0');\n  bmSet('bm_bladeshield_gmcp', '0');\n}\nfunction sendArmOnly(cmd) {\n  if (!cmd) return;\n  bmClearBladeShield();\n  try { run_function('bm_beast', 'spit', 'BladeMaster Engine'); } catch (eBz) {}\n  sendBmChain(['sm clear', 'sm add arm ' + cmd]);\n}\nfunction sendPrepThenArm(prep, cmd) {\n  if (!cmd) { sendPrepOnly(prep); return; }\n  bmClearBladeShield();\n  if (!prep || !prep.length) { sendArmOnly(cmd); return; }\n  try { run_function('bm_beast', 'spit', 'BladeMaster Engine'); } catch (eBz2) {}\n  sendBmChain(['sm clear', smAddPrepLine(prep), 'sm add arm ' + cmd]);\n}\nfunction assessCmd(tgt) { return 'free assess ' + tgt; }\nfunction shouldPrepAssess(tgt, force) {\n  if (!bmBool('bm_xassess')) return false;\n  var reuse = parseInt(bmGet('bm_assess_reuse_sec', '12'), 10);\n  if (isNaN(reuse)) reuse = 12;\n  if (force) return true;\n  if (reuse > 0 && bmGet('bm_assess_consumed_tgt', '') === tgt) {\n    var last = parseFloat(bmGet('bm_last_assess_time', '0'));\n    if ((Date.now() / 1000 - last) < reuse) return false;\n  }\n  return true;\n}\nfunction noteAssessSent(tgt) {\n  bmSet('bm_assess_consumed_tgt', tgt);\n  bmSet('bm_last_assess_time', String(Date.now() / 1000));\n}\n\nfunction bmBothBalancesReady() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Balance) {\n      var B = GMCP.Char.Balance;\n      if (B.List && B.List.balance != null && B.List.equilibrium != null) {\n        return (B.List.balance === '1' || B.List.balance === 1) && (B.List.equilibrium === '1' || B.List.equilibrium === 1);\n      }\n      if (B.balance != null) {\n        return (B.balance === 0 || B.balance === '0') && (B.equilibrium === 0 || B.equilibrium === '0');\n      }\n    }\n  } catch (eB) {}\n  return true;\n}\n\n/** Matches Mudlet BM.readyForFreeAssess — arm balance by default (assess has no eq cost). */\nfunction bmReadyForFreeAssess() {\n  if (bmBool('bm_assess_require_eq')) return bmBothBalancesReady();\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Vitals && GMCP.Char.Vitals.balance != null) {\n      var vb = GMCP.Char.Vitals.balance;\n      return vb === '1' || vb === 1;\n    }\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Balance && GMCP.Char.Balance.List && GMCP.Char.Balance.List.balance != null) {\n      var lb = GMCP.Char.Balance.List.balance;\n      return lb === '1' || lb === 1;\n    }\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Balance && GMCP.Char.Balance.balance != null) {\n      var bb = GMCP.Char.Balance.balance;\n      return bb === 0 || bb === '0';\n    }\n  } catch (eR) {}\n  return true;\n}\n\nif (op === 'balance') {\n  var raw = bmGet('bm_pending', '');\n  if (!raw) return;\n  var p;\n  try { p = JSON.parse(raw); } catch (e) { bmSet('bm_pending', ''); return; }\n  bmSet('bm_pending', '');\n  if (!p || !p.tgt) return;\n  var cmd = buildStrikeCmd(p.tgt, p.body, p.tier, !!p.doLunge);\n  if (cmd) { sendArmOnly(cmd); noteBmAction((p.body || '') + ' ' + (p.tier || 'base')); }\n  return;\n}\n\nvar body = bmResolveSmart(a[0] || 'head');\nvar tier = a[1] || 'base';\nvar doLunge = a[2] === '1' || a[2] === 'true';\nvar tgt = bmGet('bm_target', '').trim();\nif (!tgt) {\n  display_notice('[BM] No target. Set with: bmt <name> (mirrors Bashing.target).', 'red');\n  return;\n}\n\nvar assayOneShot = bmBool('bm_assay_next');\nvar hasMode = bmBool('bm_xassess') || bmBool('bm_xassay');\n\nfunction queuePending() {\n  bmSet('bm_pending', JSON.stringify({ tgt: tgt, body: body, tier: tier, doLunge: doLunge }));\n}\n\n/* One-shot: next strike prep = free assess (if balance) then assay — ignores xassess/xassay toggles (Mudlet xxass). */\nif (bmBool('bm_xxass_next')) {\n  bmSet('bm_xxass_next', '0');\n  bmSet('bm_assay_next', '0');\n  var prepX = [];\n  if (bmReadyForFreeAssess()) {\n    prepX.push(assessCmd(tgt));\n    noteAssessSent(tgt);\n  }\n  prepX.push('assay ' + tgt);\n  sendPrepOnly(prepX);\n  queuePending();\n  noteBmAction('xxass');\n  return;\n}\n\nif (hasMode || assayOneShot) {\n  if (assayOneShot) bmSet('bm_assay_next', '0');\n  var doAssess = shouldPrepAssess(tgt, false);\n  var doAssay = bmBool('bm_xassay') || assayOneShot;\n  if (doAssay) {\n    var prepA = [];\n    if (doAssess) {\n      prepA.push(assessCmd(tgt));\n      noteAssessSent(tgt);\n    }\n    prepA.push('assay ' + tgt);\n    sendPrepOnly(prepA);\n    queuePending();\n    noteBmAction(body + ' ' + tier + ' (assay)');\n    return;\n  }\n  var strikeLine = buildStrikeCmd(tgt, body, tier, doLunge);\n  if (doAssess) {\n    sendPrepThenArm([assessCmd(tgt)], strikeLine);\n    noteAssessSent(tgt);\n  } else sendArmOnly(strikeLine);\n  noteBmAction(body + ' ' + tier);\n  return;\n}\nsendArmOnly(buildStrikeCmd(tgt, body, tier, doLunge));\nnoteBmAction(body + ' ' + tier);\n"},{"type":"function","name":"bm_kill","enabled":true,"id":5,"code":"\nfunction bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nvar BM_ASSIST_ORDER = ['off','tahtetso','nekotai','blademaster','axelord','pureblade','bonecrusher'];\nvar BM_ASSIST_SHORT = { off:'Off', tahtetso:'Taht', nekotai:'Neko', blademaster:'BM', axelord:'AL', pureblade:'PB', bonecrusher:'BC' };\nvar BM_ASSIST_ALIAS = {\n  off:'off', taht:'tahtetso', tahtetso:'tahtetso',\n  neko:'nekotai', nekotai:'nekotai',\n  bm:'blademaster', blademaster:'blademaster',\n  al:'axelord', axelord:'axelord',\n  pb:'pureblade', pureblade:'pureblade',\n  bc:'bonecrusher', bonecrusher:'bonecrusher'\n};\nfunction bmAssistRecipes() {\n  return {\n    tahtetso: { left: ['tetrodin', 'crotamine', 'anatine'], right: ['crotamine', 'anatine', 'tetrodin'] },\n    nekotai: { left: ['hadrudin', 'mellitin'], right: ['mellitin', 'hadrudin'] },\n    blademaster: { left: ['senso', 'haemotox'], right: ['haemotox', 'senso'] },\n    axelord: { left: ['senso', 'dendroxin'], right: ['dendroxin', 'senso'] },\n    pureblade: { left: ['haemotox', 'senso'], right: ['senso', 'haemotox'] },\n    bonecrusher: { left: ['senso', 'haemotox'], right: ['haemotox', 'senso'] }\n  };\n}\nfunction bmAssistSpec() {\n  var raw = String(bmGet('bm_assist_spec', 'off') || 'off').toLowerCase();\n  if (BM_ASSIST_ALIAS[raw]) return BM_ASSIST_ALIAS[raw];\n  return 'off';\n}\nfunction bmAssistChipLabel() {\n  return 'Support: ' + (BM_ASSIST_SHORT[bmAssistSpec()] || 'Off');\n}\nfunction bmAssistRecipeTip() {\n  var spec = bmAssistSpec();\n  if (spec === 'tahtetso') return 'Taht: tetrodin + crotamine + anatine (steam/dust/slush). Cycle head/chest/gut. No senso/hadrudin/chansu.';\n  if (spec === 'nekotai') return 'Neko: hadrudin + mellitin. Cycle head/chest/gut. No senso/tetrodin/chansu.';\n  if (spec === 'blademaster') return 'BM: senso + haemotox (dendroxin if both vitals parried). Chest↔gut. No tetrodin/hadrudin.';\n  if (spec === 'axelord') return 'AL: senso + dendroxin. Head to heavy/C!, then chest/gut to heavy.';\n  if (spec === 'pureblade') return 'PB: haemotox + senso. Gut first, chest second. No crotamine (dust).';\n  if (spec === 'bonecrusher') return 'BC: senso + haemotox. Head first, legs second.';\n  return 'Off → Taht → Neko → BM → AL → PB → BC. Feeds that teammate wiki kill path. Forces Support role. Alias xassist.';\n}\nfunction bmAssistWoundWord(limb) {\n  return String(bmGet('bm_w_' + limb, '') || '').toLowerCase();\n}\nfunction bmAssistIsCrit(limb) { return bmAssistWoundWord(limb) === 'critical'; }\nfunction bmAssistParryHigh(limb) {\n  var th = parseInt(bmGet('bm_smart_threshold', '90'), 10);\n  if (isNaN(th)) th = 90;\n  var p = parseInt(bmGet('bm_p_' + limb, ''), 10);\n  if (isNaN(p)) return false;\n  return p >= th;\n}\nfunction bmAssistWoundRank(limb) {\n  var w = bmAssistWoundWord(limb);\n  if (w === 'critical') return 3;\n  if (w === 'heavy') return 2;\n  if (w === 'light') return 1;\n  return 0;\n}\nfunction bmAssistPickCycleVitals() {\n  var order = ['head', 'chest', 'gut'];\n  var last = String(bmGet('bm_kill_limb', '') || '');\n  var best = '', bestRank = 99, bestIdx = 99;\n  var i, limb, rank, idx, lastIdx;\n  lastIdx = order.indexOf(last);\n  for (i = 0; i < order.length; i++) {\n    limb = order[i];\n    if (bmAssistParryHigh(limb)) continue;\n    rank = bmAssistWoundRank(limb);\n    idx = (lastIdx < 0) ? i : ((i - lastIdx - 1 + order.length) % order.length);\n    if (!best || rank < bestRank || (rank === bestRank && idx < bestIdx)) {\n      best = limb;\n      bestRank = rank;\n      bestIdx = idx;\n    }\n  }\n  return best || 'head';\n}\nfunction bmAssistPickKill() {\n  var spec = bmAssistSpec();\n  if (spec === 'tahtetso' || spec === 'nekotai') return bmAssistPickCycleVitals();\n  if (spec === 'axelord') {\n    if (!bmAssistParryHigh('head') && bmAssistWoundRank('head') < 2) return 'head';\n    if (!bmAssistParryHigh('chest') && bmAssistWoundRank('chest') < 2) return 'chest';\n    if (!bmAssistParryHigh('gut') && bmAssistWoundRank('gut') < 2) return 'gut';\n    if (!bmAssistParryHigh('head')) return 'head';\n    if (!bmAssistParryHigh('chest')) return 'chest';\n    return 'gut';\n  }\n  if (spec === 'pureblade') {\n    if (!bmAssistParryHigh('gut') && !bmAssistIsCrit('gut')) return 'gut';\n    if (!bmAssistParryHigh('chest')) return 'chest';\n    return 'gut';\n  }\n  if (spec === 'bonecrusher') {\n    if (!bmAssistParryHigh('head') && !bmAssistIsCrit('head')) return 'head';\n    if (!bmAssistParryHigh('lleg') && bmAssistWoundRank('lleg') <= bmAssistWoundRank('rleg')) return 'lleg';\n    if (!bmAssistParryHigh('rleg')) return 'rleg';\n    if (!bmAssistParryHigh('lleg')) return 'lleg';\n    return 'head';\n  }\n  // Default Blademaster: sticky primary vital (wound rank, then lower effParry, then chest).\n  if (typeof resolveKillVital === 'function') return resolveKillVital();\n  if (bmAssistIsCrit('chest') || bmAssistParryHigh('chest')) return 'gut';\n  return 'chest';\n}\nfunction bmAssistSet(raw) {\n  raw = String(raw == null ? '' : raw).toLowerCase().replace(/^\\s+|\\s+$/g, '');\n  if (raw === 'show') {\n    display_notice('[BM] ' + bmAssistChipLabel() + (bmAssistSpec() === 'off' ? ' — Standard/Power poisons' : ' — ' + bmAssistRecipeTip()), 'lightgreen');\n    return bmAssistSpec();\n  }\n  var spec;\n  if (!raw || raw === 'cycle' || raw === 'next') {\n    var cur = bmAssistSpec();\n    var idx = 0;\n    var i;\n    for (i = 0; i < BM_ASSIST_ORDER.length; i++) {\n      if (BM_ASSIST_ORDER[i] === cur) { idx = i; break; }\n    }\n    spec = BM_ASSIST_ORDER[(idx + 1) % BM_ASSIST_ORDER.length];\n  } else {\n    spec = BM_ASSIST_ALIAS[raw];\n    if (!spec) {\n      display_notice('[BM] Support: use off|taht|neko|bm|al|pb|bc (or xassist).', 'yellow');\n      return bmAssistSpec();\n    }\n  }\n  var prev = bmAssistSpec();\n  if (spec !== 'off') {\n    if (prev === 'off') bmSet('bm_assist_role_saved', String(bmGet('bm_role', 'killer') || 'killer'));\n    bmSet('bm_role', 'support');\n  } else if (prev !== 'off') {\n    var saved = String(bmGet('bm_assist_role_saved', '') || '').toLowerCase();\n    if (saved === 'support' || saved === 'killer') bmSet('bm_role', saved);\n    bmSet('bm_assist_role_saved', '');\n  }\n  bmSet('bm_assist_spec', spec);\n  bmSet('bm_wep_poison_style', '');\n  try { run_function('bm_sync_wep_poison', '', 'BladeMaster Engine'); } catch (eAs) {}\n  if (spec === 'off') {\n    var roleNow = String(bmGet('bm_role', 'killer') || 'killer').toLowerCase() === 'support' ? 'Support' : 'Killer';\n    display_notice('[BM] Support: Off — Role ' + roleNow + ' restored; Standard/Power poison cycle.', 'lightgreen');\n  } else {\n    display_notice('[BM] ' + bmAssistChipLabel() + ' — Role Support (no auto evisc). ' + bmAssistRecipeTip(), 'lightgreen');\n  }\n  return spec;\n}\nfunction bmpNow() { return Date.now(); }\nfunction bmpNum(k, d) {\n  var n = parseFloat(bmGet(k, ''));\n  return isNaN(n) ? d : n;\n}\nfunction bmpJson(k, d) {\n  try {\n    var raw = bmGet(k, '');\n    if (!raw) return d;\n    var v = JSON.parse(raw);\n    if (v === null || typeof v !== 'object') return d;\n    return v;\n  } catch (eJ) { return d; }\n}\nfunction bmpIsArray(v) { return Object.prototype.toString.call(v) === '[object Array]'; }\nfunction bmpIsVital(limb) { return limb === 'head' || limb === 'chest' || limb === 'gut'; }\nfunction bmpWoundWord(limb) { return String(bmGet('bm_w_' + limb, '') || '').toLowerCase(); }\nfunction bmpWoundRank(limb) {\n  var w = bmpWoundWord(limb);\n  if (w === 'critical') return 3;\n  if (w === 'heavy') return 2;\n  if (w === 'light') return 1;\n  return 0;\n}\nfunction bmpAssayPct(limb) {\n  var p = parseInt(bmGet('bm_p_' + limb, ''), 10);\n  return isNaN(p) ? null : p;\n}\nfunction bmpThreshold() {\n  var th = parseInt(bmGet('bm_smart_threshold', '90'), 10);\n  return isNaN(th) ? 90 : th;\n}\nfunction bmpStanceCoversVitals() {\n  return String(bmGet('bm_en_stance', '') || '').toLowerCase().indexOf('vital') >= 0;\n}\nfunction bmpEvidenceMs() { return bmpNum('bm_parry_evidence_sec', 20) * 1000; }\nfunction bmpParryPolicy() {\n  var p = String(bmGet('bm_parry_policy', 'vital') || 'vital').toLowerCase();\n  return p === 'bait' ? 'bait' : 'vital';\n}\nfunction bmpSplitMax() {\n  var n = parseInt(bmGet('bm_split_max_volleys', '4'), 10);\n  return (isNaN(n) || n < 1) ? 4 : n;\n}\nfunction bmParsePowerVal(raw) {\n  if (raw == null || raw === '') return NaN;\n  if (typeof raw === 'number') return raw;\n  var s = String(raw).replace(/^\\s+|\\s+$/g, '');\n  var slash = s.indexOf('/');\n  if (slash >= 0) s = s.substring(0, slash);\n  return parseFloat(s);\n}\nfunction bmGetPower() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Vitals) {\n      var v = GMCP.Char.Vitals;\n      var keys = ['power', 'pow', 'p', 'stars'];\n      var i, p;\n      for (i = 0; i < keys.length; i++) {\n        p = bmParsePowerVal(v[keys[i]]);\n        if (!isNaN(p)) return p;\n      }\n    }\n  } catch (eP) {}\n  return null;\n}\nfunction bmEviscReserve() {\n  var reserve = 5;\n  var candy = bmBool('pEviscLollyPrep') || bmBool('evisc_candy');\n  var wbRaw = get_variable('evisc_combo_weakblood');\n  var wb;\n  if (wbRaw === undefined || wbRaw === null || wbRaw === '') {\n    wb = candy;\n  } else {\n    wb = bmBool('evisc_combo_weakblood');\n  }\n  if (candy && wb) reserve += 3;\n  if (bmBool('bm_pre_evisc_blade')) reserve += 3;\n  return reserve;\n}\n// 0..2 lunge hands from spare power above the evisc reserve. Unknown power -> 0 (never guess).\nfunction lungeBudgetHands() {\n  var power = bmGetPower();\n  if (power === null) return 0;\n  var n = Math.floor((power - bmEviscReserve()) / 2);\n  if (n < 0) n = 0;\n  if (n > 2) n = 2;\n  return n;\n}\n// --- live parry ring (BM_CombatTracker) ---\nfunction bmpLiveRing(limb) {\n  var list = bmpJson('bm_live_parry_' + limb, []);\n  if (!bmpIsArray(list)) list = [];\n  var cutoff = bmpNow() - bmpEvidenceMs();\n  var out = [], i;\n  for (i = 0; i < list.length; i++) {\n    if (list[i] && (parseFloat(list[i].t) || 0) >= cutoff) out.push(list[i]);\n  }\n  return out;\n}\nfunction bmpLiveCounts(limb) {\n  var list = bmpLiveRing(limb);\n  var parried = 0, i;\n  for (i = 0; i < list.length; i++) if (list[i].p) parried++;\n  return { parried: parried, total: list.length };\n}\nfunction bmpLiveRate(limb) {\n  var c = bmpLiveCounts(limb);\n  if (!c.total) return null;\n  return c.parried / c.total;\n}\nfunction bmpLiveLandedStreak(limb) {\n  var list = bmpLiveRing(limb);\n  var streak = 0, i;\n  for (i = list.length - 1; i >= 0; i--) {\n    if (list[i].p) break;\n    streak++;\n  }\n  return streak;\n}\nfunction bmpPushLiveOutcome(limb, parried) {\n  var list = bmpLiveRing(limb);\n  list.push({ p: parried ? 1 : 0, t: bmpNow() });\n  while (list.length > 6) list.shift();\n  bmSet('bm_live_parry_' + limb, JSON.stringify(list));\n  if (parried) bmSet('bm_live_parry_last_at', String(bmpNow()));\n}\nfunction liveParrySeenSince(t) {\n  var last = parseFloat(bmGet('bm_live_parry_last_at', '0')) || 0;\n  return last > 0 && last >= (parseFloat(t) || 0);\n}\n// --- swing queue (written by sendDual, resolved by bm_track) ---\nfunction bmpSwingQueue() {\n  var q = bmpJson('bm_swing_queue', []);\n  if (!bmpIsArray(q)) q = [];\n  var cutoff = bmpNow() - 6000;\n  var out = [], i;\n  for (i = 0; i < q.length; i++) {\n    if (q[i] && (parseFloat(q[i].t) || 0) >= cutoff) out.push(q[i]);\n  }\n  return out;\n}\nfunction bmpSaveSwingQueue(q) { bmSet('bm_swing_queue', JSON.stringify(q || [])); }\nfunction queueSwings(intents) {\n  var q = bmpSwingQueue();\n  var now = bmpNow();\n  var i, it;\n  for (i = 0; i < (intents || []).length; i++) {\n    it = intents[i];\n    if (!it || !it.limb) continue;\n    q.push({ hand: it.hand || '', limb: String(it.limb).toLowerCase(), lunge: it.lunge ? 1 : 0, t: now, r: 0, rt: 0 });\n  }\n  while (q.length > 8) q.shift();\n  bmpSaveSwingQueue(q);\n}\nfunction bmpNextUnresolved(q, lungeOnly) {\n  var i;\n  for (i = 0; i < q.length; i++) {\n    if (q[i] && !q[i].r && (!!q[i].lunge) === (!!lungeOnly)) return q[i];\n  }\n  return null;\n}\n// --- effective parry + hysteresis denial (BM_CombatEngine) ---\nfunction effParry(limb) {\n  if (!bmpIsVital(limb)) return 0;\n  if (bmpStanceCoversVitals()) return 100;\n  var pct = bmpAssayPct(limb);\n  if (pct === null) pct = 0;\n  var live = bmpLiveRate(limb);\n  if (live !== null && live * 100 > pct) pct = live * 100;\n  if (pct < 0) pct = 0;\n  if (pct > 100) pct = 100;\n  return pct;\n}\nfunction bmpDenState(limb) {\n  var st = bmpJson('bm_parry_den_' + limb, null);\n  if (!st) st = {};\n  st.denied = !!st.denied;\n  if (!bmpIsArray(st.pts)) st.pts = [];\n  st.liveBase = parseFloat(st.liveBase) || 0;\n  st.reason = String(st.reason || '');\n  st.since = parseFloat(st.since) || 0;\n  st.assayFresh = !!st.assayFresh;\n  if (st.lastAssay === undefined) st.lastAssay = null;\n  st.points = parseFloat(st.points) || 0;\n  return st;\n}\nfunction bmpSaveDenState(limb, st) { bmSet('bm_parry_den_' + limb, JSON.stringify(st)); }\nfunction isVitalDenied(limb) {\n  if (!bmpIsVital(limb)) return false;\n  if (bmpStanceCoversVitals()) return true;\n  return bmpDenState(limb).denied === true;\n}\n// Any limb: vitals = hysteresis OR raw assay >= threshold; arms/legs from the foe stance.\nfunction isLimbDenied(limb) {\n  if (!limb) return false;\n  if (bmpIsVital(limb)) {\n    if (isVitalDenied(limb)) return true;\n    var p = bmpAssayPct(limb);\n    return p !== null && p >= bmpThreshold();\n  }\n  var s = String(bmGet('bm_en_stance', '') || '').toLowerCase();\n  if ((limb === 'lleg' || limb === 'rleg') && s.indexOf('leg') >= 0) return true;\n  if ((limb === 'larm' || limb === 'rarm') && s.indexOf('arm') >= 0) return true;\n  return false;\n}\n// Hysteresis: assayPct (optional) is a NEW reading -> 1 point when >= threshold; live parries\n// add points via the ring. Enter denied at >= confirm points (or stance); leave on a fresh assay\n// below release or 2 consecutive landed swings. Banners only on change. Returns denied.\nfunction evalVitalDenied(limb, assayPct) {\n  if (!bmpIsVital(limb)) return false;\n  var st = bmpDenState(limb);\n  var now = bmpNow();\n  var win = bmpEvidenceMs();\n  var th = bmpThreshold();\n  if (assayPct !== undefined && assayPct !== null && !isNaN(assayPct)) {\n    st.lastAssay = assayPct;\n    st.assayFresh = true;\n    if (assayPct >= th) st.pts.push(now);\n  }\n  var kept = [], i;\n  for (i = 0; i < st.pts.length; i++) {\n    if ((now - (parseFloat(st.pts[i]) || 0)) <= win) kept.push(st.pts[i]);\n  }\n  st.pts = kept;\n  var liveRaw = bmpLiveCounts(limb).parried;\n  if (liveRaw < st.liveBase) st.liveBase = liveRaw;\n  var livePts = liveRaw - st.liveBase;\n  st.points = kept.length + livePts;\n  var pct = bmpAssayPct(limb);\n  var release = bmpNum('bm_parry_release', 70);\n  var need = parseInt(bmGet('bm_parry_confirm_points', '2'), 10);\n  if (isNaN(need) || need < 1) need = 2;\n  var streak = bmpLiveLandedStreak(limb);\n  var wasDenied = st.denied;\n  var nowDenied = wasDenied;\n  var reason = st.reason;\n  function evidenceReason() {\n    if (kept.length > 0 && livePts > 0) return 'assay+live';\n    return kept.length > 0 ? 'assay' : 'live';\n  }\n  if (bmpStanceCoversVitals()) {\n    nowDenied = true;\n    reason = 'stance';\n  } else if (wasDenied && st.reason === 'stance') {\n    if (st.points >= need) {\n      reason = evidenceReason();\n      st.reason = reason;\n    } else {\n      nowDenied = false;\n      reason = 'stance dropped';\n    }\n  } else if (wasDenied) {\n    if (pct !== null && pct < release && st.assayFresh) {\n      nowDenied = false;\n      reason = 'assay ' + pct + '%';\n    } else if (streak >= 2) {\n      nowDenied = false;\n      reason = 'landed x' + streak;\n    }\n  } else if (st.points >= need) {\n    nowDenied = true;\n    reason = evidenceReason();\n  }\n  if (nowDenied !== wasDenied) {\n    st.denied = nowDenied;\n    st.reason = reason;\n    st.since = now;\n    bmSet('bm_parry_flip', '1');\n    var eff = Math.round(effParry(limb));\n    if (nowDenied) {\n      st.assayFresh = false;\n      if (limb !== 'head') display_notice('[BM] PARRY CONFIRMED — ' + limb.toUpperCase() + ' ' + eff + '% (' + reason + ')', 'orange');\n    } else {\n      st.pts = [];\n      st.liveBase = liveRaw;\n      st.points = 0;\n      if (limb !== 'head') display_notice('[BM] PARRY RELEASED — ' + limb.toUpperCase() + ' ' + eff + '% (' + reason + ')', 'orange');\n    }\n  } else if (nowDenied && reason === 'stance' && st.reason !== 'stance') {\n    st.reason = 'stance';\n  }\n  bmpSaveDenState(limb, st);\n  return st.denied === true;\n}\n// Phase: kill | split (both vitals denied) | fallback (split cap reached). Default spec only.\nfunction bmRefreshKillPhase() {\n  var prev = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var chestD = isVitalDenied('chest');\n  var gutD = isVitalDenied('gut');\n  var splitN = parseInt(bmGet('bm_split_volleys', '0'), 10) || 0;\n  var maxSplit = bmpSplitMax();\n  var wasChest = String(bmGet('bm_parry_was_chest', '') || '') === '1';\n  var wasGut = String(bmGet('bm_parry_was_gut', '') || '') === '1';\n  if (chestD && gutD) {\n    if (prev === 'fallback') {\n      // stay\n    } else if (prev === 'split') {\n      if (splitN >= maxSplit) {\n        bmSet('bm_kill_phase', 'fallback');\n        bmSet('bm_fallback_leg', '');\n        display_notice('[BM] FALLBACK — legs: split ' + splitN + '/' + maxSplit + ' with no release — both hands on one leg → legtendon → prone → haymaker', 'orange');\n      }\n    } else {\n      bmSet('bm_kill_phase', 'split');\n      bmSet('bm_split_volleys', '0');\n      display_notice('[BM] SPLIT MODE — bait parry off vitals', 'orange');\n    }\n  } else {\n    if (prev === 'split' || prev === 'fallback') {\n      if (!chestD && !gutD) display_notice('[BM] BAIT SUCCESS — vitals open', 'orange');\n      else if (wasChest && !chestD) display_notice('[BM] BAIT SUCCESS — chest parry dropped', 'orange');\n      else if (wasGut && !gutD) display_notice('[BM] BAIT SUCCESS — gut parry dropped', 'orange');\n    }\n    bmSet('bm_kill_phase', 'kill');\n    bmSet('bm_split_volleys', '0');\n    bmSet('bm_fallback_leg', '');\n  }\n  bmSet('bm_parry_was_chest', chestD ? '1' : '0');\n  bmSet('bm_parry_was_gut', gutD ? '1' : '0');\n}\n// Primary vital: higher wound rank; tie -> lower effParry; tie -> chest. Parry never moves it.\nfunction pickKillModeVital() {\n  var wc = bmpWoundRank('chest');\n  var wg = bmpWoundRank('gut');\n  if (wg > wc) return 'gut';\n  if (wc > wg) return 'chest';\n  if (effParry('gut') < effParry('chest')) return 'gut';\n  return 'chest';\n}\nfunction resolveKillVital() {\n  var primary = pickKillModeVital();\n  var secondary = (primary === 'chest') ? 'gut' : 'chest';\n  var wp = bmpWoundRank(primary);\n  var ws = bmpWoundRank(secondary);\n  var reason;\n  if (wp > ws) reason = 'wounds ' + wp + ' > ' + ws;\n  else if (effParry(primary) < effParry(secondary)) reason = 'wounds tie, parry ' + Math.round(effParry(primary)) + '% < ' + Math.round(effParry(secondary)) + '%';\n  else reason = 'wounds tie, chest default';\n  if (isVitalDenied(primary)) reason += ' (denied)';\n  bmSet('bm_kill_vital_lock', JSON.stringify({ limb: primary, reason: reason }));\n  return primary;\n}\n// --- bait / leg helpers (tiers map onto MOD via strikeCmd: light=pierce*, crit=legtendon) ---\nfunction baitTier(limb) { return bmpWoundRank(limb) >= 1 ? 'light' : 'base'; }\nfunction pickBaitArm(volley) {\n  var lOk = !isLimbDenied('larm');\n  var rOk = !isLimbDenied('rarm');\n  if (lOk && !rOk) return 'larm';\n  if (rOk && !lOk) return 'rarm';\n  if (!lOk && !rOk) return '';\n  var wl = bmpWoundRank('larm');\n  var wr = bmpWoundRank('rarm');\n  if (wl > wr) return 'larm';\n  if (wr > wl) return 'rarm';\n  return (((parseInt(volley, 10) || 0) % 2) === 0) ? 'larm' : 'rarm';\n}\nfunction pickBaitLeg() {\n  var lOk = !isLimbDenied('lleg');\n  var rOk = !isLimbDenied('rleg');\n  if (lOk && !rOk) return 'lleg';\n  if (rOk && !lOk) return 'rleg';\n  if (!lOk && !rOk) return '';\n  if (bmpWoundRank('rleg') > bmpWoundRank('lleg')) return 'rleg';\n  return 'lleg';\n}\nfunction pickFallbackLeg() {\n  var cur = String(bmGet('bm_fallback_leg', '') || '');\n  if ((cur === 'lleg' || cur === 'rleg') && !isLimbDenied(cur)) return cur;\n  var lOk = !isLimbDenied('lleg');\n  var rOk = !isLimbDenied('rleg');\n  var pick;\n  if (lOk && !rOk) pick = 'lleg';\n  else if (rOk && !lOk) pick = 'rleg';\n  else pick = (bmpWoundRank('rleg') < bmpWoundRank('lleg')) ? 'rleg' : 'lleg';\n  bmSet('bm_fallback_leg', pick);\n  return pick;\n}\nfunction legBaitTier(leg, allowCrit) {\n  var w = bmpWoundRank(leg);\n  if (allowCrit && w >= 3) return 'crit';\n  if (w >= 1) return 'light';\n  return 'base';\n}\n// Kill volley plan for the default spec (mirror of Lua planKillVolley). Pure: safe per tick.\nfunction bmPlanKillVolley(tgt) {\n  var primary = resolveKillVital();\n  var secondary = (primary === 'chest') ? 'gut' : 'chest';\n  var volley = (parseInt(bmGet('bm_kill_volley', '0'), 10) || 0) + 1;\n  var plan = {\n    killBody: primary, killTier: 'base', killLunge: false,\n    hinderBody: primary, hinderTier: 'base', hinderLunge: false,\n    primary: primary, secondary: secondary, budget: 0, note: '', noteMid: '',\n    vitalLunge: false, bait: false\n  };\n  var phase = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var pDenied = isVitalDenied(primary);\n  var sDenied = isVitalDenied(secondary);\n  var budget = lungeBudgetHands();\n  var power = bmGetPower();\n  var reserve = bmEviscReserve();\n  plan.budget = budget;\n  var powStr = '(power ' + (power === null ? '?' : power) + ', reserve ' + reserve + ')';\n  function woundStr(limb) { return bmpWoundWord(limb) || 'no wounds'; }\n  function baitArmHinder() {\n    var arm = pickBaitArm(volley);\n    if (!arm) {\n      if (!isLimbDenied('head')) {\n        plan.hinderBody = 'head';\n        plan.hinderTier = baitTier('head');\n        return;\n      }\n      var leg = pickBaitLeg() || 'lleg';\n      plan.hinderBody = leg;\n      plan.hinderTier = legBaitTier(leg, false);\n      return;\n    }\n    plan.hinderBody = arm;\n    plan.hinderTier = baitTier(arm);\n  }\n  if (!pDenied) return plan;\n  if (budget >= 2) {\n    plan.killLunge = true;\n    plan.hinderLunge = true;\n    plan.vitalLunge = true;\n    plan.note = 'LUNGE THROUGH PARRY — ' + primary.toUpperCase() + ' x2';\n    plan.noteMid = powStr;\n    return plan;\n  }\n  if (budget === 1) {\n    plan.killLunge = true;\n    plan.vitalLunge = true;\n    if (!sDenied) {\n      plan.hinderBody = secondary;\n      plan.hinderTier = 'base';\n    } else {\n      baitArmHinder();\n    }\n    plan.note = 'LUNGE THROUGH PARRY — ' + primary.toUpperCase() + ' x1';\n    plan.noteMid = powStr + (sDenied ? ' · hinder baits ' + String(plan.hinderBody).toUpperCase() : ' · hinder ' + secondary.toUpperCase());\n    return plan;\n  }\n  if (phase === 'fallback') {\n    var fleg = pickFallbackLeg() || 'lleg';\n    plan.killBody = fleg;\n    plan.killTier = (bmpWoundRank(fleg) >= 3) ? 'crit' : 'base';\n    plan.hinderBody = fleg;\n    plan.hinderTier = legBaitTier(fleg, true);\n    plan.bait = true;\n    plan.note = 'FALLBACK — legs';\n    plan.noteMid = fleg.toUpperCase() + ' ' + woundStr(fleg);\n    return plan;\n  }\n  if (!sDenied) {\n    var needPower = reserve + 2;\n    plan.killBody = secondary;\n    plan.killTier = 'base';\n    if (bmpParryPolicy() === 'bait') {\n      baitArmHinder();\n      plan.noteMid = 'bait ' + String(plan.hinderBody).toUpperCase();\n    } else {\n      plan.hinderBody = secondary;\n      plan.hinderTier = 'base';\n      plan.noteMid = powStr;\n    }\n    plan.note = 'HOLD ' + primary.toUpperCase() + ' ' + bmpWoundWord(primary) + ' — building ' + secondary.toUpperCase() + ' until power >= ' + needPower;\n    return plan;\n  }\n  // Both vitals denied, no lunge budget: split bait. Never base into a denied vital.\n  baitArmHinder();\n  var bleg = pickBaitLeg();\n  if (bleg) {\n    plan.killBody = bleg;\n    plan.killTier = legBaitTier(bleg, false);\n  } else if (plan.hinderBody !== 'head' && !isLimbDenied('head')) {\n    plan.killBody = 'head';\n    plan.killTier = 'base';\n  } else {\n    plan.killBody = (plan.hinderBody === 'larm') ? 'rarm' : 'larm';\n    plan.killTier = 'base';\n  }\n  plan.bait = true;\n  plan.note = 'SPLIT ' + ((parseInt(bmGet('bm_split_volleys', '0'), 10) || 0) + 1) + '/' + bmpSplitMax();\n  plan.noteMid = 'hinder ' + String(plan.hinderBody).toUpperCase() + ' · kill hand ' + String(plan.killBody).toUpperCase();\n  return plan;\n}\n// Plain-text status (Offence tab block, xkillmode status, xkillparry).\nfunction killModeStatusLines() {\n  var lines = [];\n  var assist = 'off';\n  try { if (typeof bmAssistSpec === 'function') assist = bmAssistSpec(); } catch (eA) {}\n  if (assist === 'off') resolveKillVital();\n  var lock = bmpJson('bm_kill_vital_lock', {});\n  var primary = String(lock.limb || bmGet('bm_kill_limb', 'chest') || 'chest');\n  lines.push('primary ' + primary.toUpperCase() + ' (' + (bmpWoundWord(primary) || 'no wounds') + ') — ' + (lock.reason || '?'));\n  var vitals = ['chest', 'gut'], i, limb, ap, c, st, denied;\n  for (i = 0; i < vitals.length; i++) {\n    limb = vitals[i];\n    ap = bmpAssayPct(limb);\n    c = bmpLiveCounts(limb);\n    st = bmpDenState(limb);\n    denied = isVitalDenied(limb);\n    lines.push(limb.toUpperCase() + ' ' + Math.round(effParry(limb)) + '% (assay ' + (ap === null ? '?' : ap + '%') + ', live ' + c.parried + '/' + c.total + ', pts ' + st.points + ')' +\n      (denied ? ' DENIED' + (st.reason ? ' [' + st.reason + ']' : '') : ''));\n  }\n  var power = bmGetPower();\n  lines.push('lunge: power ' + (power === null ? '?' : power) + ' / reserve ' + bmEviscReserve() + ' -> ' + lungeBudgetHands() + ' hand(s)');\n  var phase = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var phaseLine = 'phase ' + phase;\n  if (phase === 'split' || phase === 'fallback') phaseLine += '  split ' + (parseInt(bmGet('bm_split_volleys', '0'), 10) || 0) + '/' + bmpSplitMax();\n  if (phase === 'fallback' && bmGet('bm_fallback_leg', '')) phaseLine += '  leg ' + String(bmGet('bm_fallback_leg', '')).toUpperCase();\n  phaseLine += '  policy ' + bmpParryPolicy();\n  lines.push(phaseLine);\n  var proneRaw = String(bmGet('bm_en_prone', '') || '');\n  if (!proneRaw) lines.push('prone: unknown');\n  else lines.push('prone: ' + (bmBool('bm_en_prone') ? 'yes' : 'no'));\n  return lines;\n}\n// Target change / KillMode ON: forget parry evidence, queue, lock, phase counters.\nfunction resetParryState() {\n  var limbs = ['head', 'chest', 'gut', 'larm', 'rarm', 'lleg', 'rleg'], i;\n  for (i = 0; i < limbs.length; i++) bmSet('bm_live_parry_' + limbs[i], '');\n  bmSet('bm_parry_den_head', '');\n  bmSet('bm_parry_den_chest', '');\n  bmSet('bm_parry_den_gut', '');\n  bmSet('bm_swing_queue', '');\n  bmSet('bm_live_parry_last_at', '0');\n  bmSet('bm_kill_last_volley_at', '0');\n  bmSet('bm_kill_vital_lock', '');\n  bmSet('bm_split_volleys', '0');\n  bmSet('bm_fallback_leg', '');\n  bmSet('bm_parry_flip', '0');\n  bmSet('bm_parry_was_chest', '');\n  bmSet('bm_parry_was_gut', '');\n  bmSet('bm_kill_phase', 'kill');\n}var MOD = {\n  head: { light: 'sliceear', heavy: 'slitthroat' },\n  chest: { light: 'puncturechest', heavy: 'gashchest' },\n  gut: { light: 'disembowel', heavy: 'ravagegut' },\n  larm: { light: 'piercearm', heavy: 'collapsenerve' },\n  rarm: { light: 'piercearm', heavy: 'collapsenerve' },\n  lleg: { light: 'pierceleg', heavy: '', crit: 'legtendon' },\n  rleg: { light: 'pierceleg', heavy: '', crit: 'legtendon' }\n};\nfunction noteAction(s) {\n  bmSet('bm_last_action', s || '');\n  try { run_function('bm_tabs', '', 'BladeMaster Engine'); } catch (eT) {}\n}\nfunction segsHaveStab(segs) {\n  var i, s;\n  for (i = 0; i < (segs || []).length; i++) {\n    s = String(segs[i] || '');\n    if (/(^|[|s])stab([|s]|$)/i.test(s) && s.toLowerCase().indexOf('eviscerate') < 0) return true;\n  }\n  return false;\n}\nfunction sendBmChain(segs) {\n  if (!segs.length) return;\n  if (segsHaveStab(segs)) {\n    try { run_function('bm_stab_style', 'arm', 'BladeMaster Engine'); } catch (eW) {}\n  }\n  send_command(segs.join(';;'), 0);\n  bmSet('bm_kill_last', String(Date.now()));\n  if (bmBool('bm_strat_echo')) display_notice('[BM strat] ' + segs.join(' ;; '), 'gray');\n}\nfunction maybeQueueConcentrated(segs) {\n  if (bmBool('bm_poisonist')) return;\n  try { if (client.evisc && client.evisc.isExecuting) return; } catch (eCq) {}\n  if (bmBool('bm_conc_sent')) return;\n  if (!segs || !segs.length) return;\n  if (String(segs[0] || '') !== 'sm clear') return;\n  segs.splice(1, 0, 'sm add FREE combatstyle concentrated');\n  bmSet('bm_conc_sent', '1');\n}\nfunction sendPrepOnly(prepCmds) {\n  if (!prepCmds || !prepCmds.length) return;\n  var segs = ['sm clear', 'sm add ' + prepCmds.join('|')];\n  maybeQueueConcentrated(segs);\n  sendBmChain(segs);\n}\nfunction bmVolleyPoisonCmds() {\n  if (!bmBool('bm_smart_poison')) return [];\n  var cmds = [];\n  try {\n    run_function('psnm_volley_sm_cmds', '', 'BladeMaster Engine');\n    try {\n      if (client.psnm_volley_cmds && Object.prototype.toString.call(client.psnm_volley_cmds) === '[object Array]') {\n        cmds = client.psnm_volley_cmds;\n      }\n    } catch (eC) {}\n    if (!cmds.length) {\n      cmds = JSON.parse(bmGet('psnm_volley_cmds', '[]') || '[]');\n    }\n  } catch (eV) { cmds = []; }\n  if (!cmds || Object.prototype.toString.call(cmds) !== '[object Array]') return [];\n  return cmds;\n}\n// intents: [{hand, limb, lunge}] in send order (hinder, then kill) -> bm_swing_queue for live parry tracking.\nfunction sendDual(prep, hinderCmd, killCmd, intents) {\n  var poisonCmds = bmVolleyPoisonCmds();\n  var i;\n  for (i = 0; i < poisonCmds.length; i++) {\n    if (poisonCmds[i]) send_command(String(poisonCmds[i]), 0);\n  }\n  try { run_function('bm_beast', 'spit', 'BladeMaster Engine'); } catch (eBz) {}\n  var segs = ['sm clear'];\n  if (prep && prep.length) segs.push('sm add ' + prep.join('|'));\n  if (hinderCmd) segs.push('sm add arm ' + hinderCmd);\n  if (killCmd) segs.push('sm add arm ' + killCmd);\n  maybeQueueConcentrated(segs);\n  sendBmChain(segs);\n  if (intents && intents.length) queueSwings(intents);\n  if (hinderCmd || killCmd) bmSet('bm_kill_last_volley_at', String(Date.now()));\n}\n// --- per-arm balance (zero-gap sends) ---\nfunction bmArmReady(hand) {\n  var key = (hand === 'right') ? 'ra' : 'la';\n  var field = (hand === 'right') ? 'right_arm' : 'left_arm';\n  var v = '';\n  try { if (typeof client !== 'undefined' && client._bmArmSnap && client._bmArmSnap[key] != null) v = String(client._bmArmSnap[key]); } catch (eS) {}\n  if (v === '') {\n    try { if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Vitals && GMCP.Char.Vitals[field] != null) v = String(GMCP.Char.Vitals[field]); } catch (eG) {}\n  }\n  if (v === '') return true;\n  return v === '1' || v === 'true';\n}\n// Spent from the moment we send with a hand until GMCP reports that arm at 0 (cleared in onGMCP);\n// the 1.0 s timeout only stops a rejected command wedging the hand.\nfunction markArmSpent(hand) {\n  bmSet((hand === 'right') ? 'bm_arm_spent_right' : 'bm_arm_spent_left', String(Date.now()));\n}\nfunction armUsable(hand) {\n  if (!bmArmReady(hand)) return false;\n  var spent = parseFloat(bmGet((hand === 'right') ? 'bm_arm_spent_right' : 'bm_arm_spent_left', '')) || 0;\n  if (!spent) return true;\n  return (Date.now() - spent) > 1000;\n}\n// Opener done-gate (cannot loop): after the send, done when both arms are down, or one arm was\n// seen down and 1.5 s passed since the send, or 4 s passed since the send (safety: never raze\n// twice for one opener).\nfunction tryFinishOpenerFromArms() {\n  if (bmBool('bm_opener_done') || !bmBool('bm_opener_inflight')) return;\n  var lReady = bmArmReady('left');\n  var rReady = bmArmReady('right');\n  if (!lReady || !rReady) bmSet('bm_opener_arm_down', '1');\n  var sentAt = parseFloat(bmGet('bm_opener_sent_at', '0')) || 0;\n  var age = Date.now() - sentAt;\n  var done = (!lReady && !rReady) || (bmBool('bm_opener_arm_down') && age >= 1500) || (age >= 4000);\n  if (done) {\n    bmSet('bm_opener_done', '1');\n    bmSet('bm_opener_inflight', '0');\n  }\n}\nfunction resetKillModeOpener() {\n  bmSet('bm_opener_done', '0');\n  bmSet('bm_opener_inflight', '0');\n  bmSet('bm_opener_sent_at', '0');\n  bmSet('bm_opener_arm_down', '0');\n  bmSet('bm_arm_spent_left', '');\n  bmSet('bm_arm_spent_right', '');\n}\nfunction woundWord(limb) {\n  return String(bmGet('bm_w_' + limb, '') || '').toLowerCase();\n}\nfunction isCrit(limb) { return woundWord(limb) === 'critical'; }\nfunction critLatchFresh() {\n  var t = parseFloat(bmGet('bm_w_crit_latch', '0')) || 0;\n  if (!t) return false;\n  return (Date.now() - t) <= 8000;\n}\nfunction parryHigh(limb) {\n  var th = parseInt(bmGet('bm_smart_threshold', '90'), 10);\n  if (isNaN(th)) th = 90;\n  var p = parseInt(bmGet('bm_p_' + limb, ''), 10);\n  if (isNaN(p)) return false;\n  return p >= th;\n}\nfunction pickKill() {\n  return bmAssistPickKill();\n}\nfunction bmPresenceNameMatches(name, targetName) {\n  if (!targetName) return false;\n  var s = String(name || '').replace(/^\\s+|\\s+$/g, '').toLowerCase()\n    .replace(/^the\\s+/, '').replace(/^an?\\s+/, '');\n  var t = String(targetName || '').replace(/^\\s+|\\s+$/g, '').toLowerCase();\n  if (!s || !t) return false;\n  return s === t || s.indexOf(t) >= 0 || t.indexOf(s) >= 0;\n}\nfunction bmPlayerNameFromGmcpEntry(p) {\n  if (typeof p === 'string') return p;\n  if (!p || typeof p !== 'object') return '';\n  if (typeof p.name === 'string') return p.name;\n  if (p.name && typeof p.name === 'object' && typeof p.name.name === 'string') return p.name.name;\n  if (p[0] != null) return String(p[0]);\n  return '';\n}\nfunction bmGmcpRoot() {\n  try { if (typeof GMCP !== 'undefined' && GMCP) return GMCP; } catch (e1) {}\n  try { if (typeof gmcp !== 'undefined' && gmcp) return gmcp; } catch (e2) {}\n  try { if (typeof client !== 'undefined' && client && client.gmcp) return client.gmcp; } catch (e3) {}\n  return null;\n}\nfunction bmMobRoomListAvailable() {\n  var g = bmGmcpRoot();\n  if (!g) return false;\n  try {\n    if (g.Char && g.Char.Items && g.Char.Items.List) {\n      var list = g.Char.Items.List;\n      if (String(list.location || '') === 'room' && list.items && typeof list.items.length === 'number') return true;\n    }\n  } catch (eL) {}\n  try {\n    if (g.Room) {\n      if (g.Room.Mobs && typeof g.Room.Mobs === 'object') return true;\n      if (g.Room.Monsters && typeof g.Room.Monsters === 'object') return true;\n      if (g.Room.Info && g.Room.Info.mobs && typeof g.Room.Info.mobs === 'object') return true;\n    }\n  } catch (eR) {}\n  return false;\n}\nfunction bmMobTargetInRoom(tgt) {\n  var g = bmGmcpRoot();\n  if (!g) return false;\n  try {\n    if (g.Char && g.Char.Items && g.Char.Items.List) {\n      var list = g.Char.Items.List;\n      if (String(list.location || '') === 'room' && list.items && typeof list.items.length === 'number') {\n        var i, item, attrib, first;\n        for (i = 0; i < list.items.length; i++) {\n          item = list.items[i];\n          if (!item || !item.name || item.attrib == null) continue;\n          attrib = String(item.attrib);\n          first = attrib.charAt(0).toLowerCase();\n          if (first.indexOf('m') < 0) continue;\n          if (attrib.indexOf('d') >= 0 || attrib.indexOf('x') >= 0) continue;\n          if (item.icon === 'pet' || item.icon === 'guard') continue;\n          if (bmPresenceNameMatches(String(item.name), tgt)) return true;\n        }\n      }\n    }\n  } catch (eI) {}\n  try {\n    if (g.Room) {\n      var sources = [g.Room.Mobs, g.Room.Info && g.Room.Info.mobs, g.Room.Monsters];\n      var si, arr, j, v, raw;\n      for (si = 0; si < sources.length; si++) {\n        arr = sources[si];\n        if (!arr || typeof arr !== 'object' || typeof arr.length !== 'number') continue;\n        for (j = 0; j < arr.length; j++) {\n          v = arr[j];\n          raw = (v && typeof v === 'object') ? (v.name || v[0]) : v;\n          if (raw && bmPresenceNameMatches(String(raw), tgt)) return true;\n        }\n      }\n    }\n  } catch (eM) {}\n  return false;\n}\nfunction bmIsTargetInRoom() {\n  var tgt = String(bmGet('bm_target', '') || '').trim();\n  if (!tgt) return false;\n  var g = bmGmcpRoot();\n  try {\n    if (g && g.Room && g.Room.Players && typeof g.Room.Players.length === 'number') {\n      var i, n;\n      for (i = 0; i < g.Room.Players.length; i++) {\n        n = bmPlayerNameFromGmcpEntry(g.Room.Players[i]);\n        if (n && bmPresenceNameMatches(n, tgt)) return true;\n      }\n    }\n  } catch (eP) {}\n  if (bmMobRoomListAvailable() && bmMobTargetInRoom(tgt)) return true;\n  return false;\n}\nfunction bmKillModeTargetOk() {\n  var tgt = String(bmGet('bm_target', '') || '').trim();\n  if (!tgt) return false;\n  return bmIsTargetInRoom();\n}\nfunction bmNoteKillModeWaitingTarget() {\n  var now = Date.now() / 1000;\n  var last = parseFloat(bmGet('bm_kill_wait_note_at', '0')) || 0;\n  if ((now - last) < 8) return;\n  bmSet('bm_kill_wait_note_at', String(now));\n  display_notice('[BM] Kill mode ON — waiting for target in room', 'yellow');\n}\nfunction pickHinder(killLimb) {\n  var split = (String(bmGet('bm_kill_phase', '') || '') === 'split')\n    || (parryHigh('chest') && parryHigh('gut'));\n  bmSet('bm_kill_phase', split ? 'split' : 'kill');\n  function usable(limb) {\n    return limb !== killLimb && !parryHigh(limb);\n  }\n  function baitLimb() {\n    if (split) {\n      if (!parryHigh('larm')) return 'larm';\n      if (!parryHigh('rarm')) return 'rarm';\n      if (!parryHigh('head')) return 'head';\n      return 'larm';\n    }\n    var otherVital = (killLimb === 'chest') ? 'gut' : 'chest';\n    if (usable(otherVital)) return otherVital;\n    if (usable('larm')) return 'larm';\n    if (usable('rarm')) return 'rarm';\n    if (usable('head')) return 'head';\n    if (killLimb !== 'larm') return 'larm';\n    return 'rarm';\n  }\n  if (!split && !parryHigh(killLimb)) return killLimb;\n  return baitLimb();\n}\nfunction volleyNotice(killLimb, hinderLimb, killLunge, hinderLunge) {\n  var k = 'kill ' + killLimb + (killLunge ? ' lunge' : '');\n  var h;\n  if (hinderLimb === killLimb) h = hinderLimb + (hinderLunge ? ' lunge' : '');\n  else h = 'hinder ' + hinderLimb + (hinderLunge ? ' lunge' : '');\n  return k + ' + ' + h;\n}\nfunction tierFor(limb) {\n  var w = woundWord(limb);\n  if (w === 'light' || w === 'heavy' || w === 'critical') return 'light';\n  return 'base';\n}\nfunction strikeCmd(tgt, hand, body, tier, doLunge, doRemiss) {\n  var parts = ['strike', tgt, hand, body];\n  if (tier === 'stab') {\n    parts.push('stab');\n  } else if (tier === 'light' || tier === 'heavy' || tier === 'crit') {\n    var mod = MOD[body] ? MOD[body][tier] : '';\n    if (mod) parts.push(mod);\n  } else if (bmBool('bm_weakblood') && !doRemiss) {\n    parts.push('weakblood');\n  }\n  if (doRemiss || (bmBool('bm_remiss') && (tier === 'light' || tier === 'heavy'))) {\n    parts.push('remiss');\n  }\n  if (doLunge) parts.push('lunge');\n  return parts.join(' ');\n}\n// plan: bmPlanKillVolley result (default spec) or null; killOn/hinderOn: that hand is usable now.\n// Unusable hands get '' commands (sendDual skips them) and keep their queued lunge/stab for later.\nfunction buildKillVolley(tgt, killLimb, hinderLimb, killHand, hinderHand, n, plan, killOn, hinderOn) {\n  if (killOn === undefined) killOn = true;\n  if (hinderOn === undefined) hinderOn = true;\n  var queuedLeft = bmBool('bm_next_lunge_left');\n  var queuedRight = bmBool('bm_next_lunge_right');\n  var queuedStabLeft = bmBool('bm_next_stab_left');\n  var queuedStabRight = bmBool('bm_next_stab_right');\n  var queuedRemiss = bmBool('bm_next_remiss') && killOn;\n  var queuedKillLunge = killOn && ((killHand === 'left' && queuedLeft) || (killHand === 'right' && queuedRight));\n  var queuedHinderLunge = hinderOn && ((hinderHand === 'left' && queuedLeft) || (hinderHand === 'right' && queuedRight));\n  var queuedKillStab = killOn && ((killHand === 'left' && queuedStabLeft) || (killHand === 'right' && queuedStabRight));\n  var queuedHinderStab = hinderOn && ((hinderHand === 'left' && queuedStabLeft) || (hinderHand === 'right' && queuedStabRight));\n  var isSupport = String(bmGet('bm_role', 'killer') || 'killer').toLowerCase() === 'support';\n  var power = bmGetPower();\n  var budget = { known: power != null, left: power };\n  function takeLunge(want, stabWins, handName, fromQueue) {\n    if (!want || stabWins) return false;\n    if (!budget.known) {\n      if (fromQueue) display_notice('[BM] Queue ' + handName + ' lunge (power unknown)', 'yellow');\n      return true;\n    }\n    if (budget.left < 2) {\n      if (fromQueue) display_notice('[BM] Queue ' + handName + ' lunge refused (power)', 'yellow');\n      return false;\n    }\n    budget.left -= 2;\n    return true;\n  }\n  var killLunge = takeLunge(queuedKillLunge, queuedKillStab, killHand, true);\n  var hinderLunge = takeLunge(queuedHinderLunge, queuedHinderStab, hinderHand, true);\n  // Plan lunges (lunge through parry) go through the same power budget as chip/queued lunges.\n  if (plan) {\n    if (killOn && plan.killLunge && !killLunge && !queuedKillStab) killLunge = takeLunge(true, false, killHand, false);\n    if (hinderOn && plan.hinderLunge && !hinderLunge && !queuedHinderStab) hinderLunge = takeLunge(true, false, hinderHand, false);\n  }\n  var killIsVital = (killLimb === 'chest' || killLimb === 'gut');\n  var chipWant = false;\n  if (bmBool('bm_kill_lunge') && killIsVital) {\n    if (isSupport) chipWant = true;\n    else if ((n % 3 === 0) && !isCrit(killLimb)) chipWant = true;\n  }\n  if (chipWant) {\n    if (killOn && !killLunge && !queuedKillStab) killLunge = takeLunge(true, false, killHand, false);\n    if (hinderOn && !hinderLunge && !queuedHinderStab && hinderLimb === killLimb) hinderLunge = takeLunge(true, false, hinderHand, false);\n  }\n  var remissOnKill = queuedRemiss;\n  var killTier = queuedKillStab ? 'stab' : ((plan && plan.killTier) ? plan.killTier : 'base');\n  var hinderTier;\n  if (queuedHinderStab) hinderTier = 'stab';\n  else if (plan && plan.hinderTier) hinderTier = plan.hinderTier;\n  else hinderTier = (hinderLimb !== killLimb) ? tierFor(hinderLimb) : 'base';\n  var killCmd = killOn ? strikeCmd(tgt, killHand, killLimb, killTier, killLunge, remissOnKill) : '';\n  var hinderCmd = hinderOn ? strikeCmd(tgt, hinderHand, hinderLimb, hinderTier, hinderLunge, false) : '';\n  var intents = [];\n  if (hinderCmd) intents.push({ hand: hinderHand, limb: hinderLimb, lunge: hinderLunge });\n  if (killCmd) intents.push({ hand: killHand, limb: killLimb, lunge: killLunge });\n  if (queuedKillLunge && killLunge) {\n    if (killHand === 'left') bmSet('bm_next_lunge_left', '0');\n    else bmSet('bm_next_lunge_right', '0');\n  }\n  if (queuedHinderLunge && hinderLunge) {\n    if (hinderHand === 'left') bmSet('bm_next_lunge_left', '0');\n    else bmSet('bm_next_lunge_right', '0');\n  }\n  if (queuedKillStab) {\n    if (killHand === 'left') bmSet('bm_next_stab_left', '0');\n    else bmSet('bm_next_stab_right', '0');\n  }\n  if (queuedHinderStab) {\n    if (hinderHand === 'left') bmSet('bm_next_stab_left', '0');\n    else bmSet('bm_next_stab_right', '0');\n  }\n  if (queuedRemiss) bmSet('bm_next_remiss', '0');\n  var label;\n  if (killOn && hinderOn) label = volleyNotice(killLimb, hinderLimb, killLunge, hinderLunge);\n  else if (killOn) label = 'kill ' + killLimb + (killLunge ? ' lunge' : '') + ' (' + killHand + ')';\n  else label = 'hinder ' + hinderLimb + (hinderLunge ? ' lunge' : '') + ' (' + hinderHand + ')';\n  return {\n    killCmd: killCmd,\n    hinderCmd: hinderCmd,\n    killLunge: killLunge,\n    hinderLunge: hinderLunge,\n    intents: intents,\n    label: label\n  };\n}\nfunction readyAssess() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Vitals && GMCP.Char.Vitals.balance != null) {\n      var vb = GMCP.Char.Vitals.balance;\n      return vb === '1' || vb === 1;\n    }\n  } catch (eR) {}\n  return true;\n}\nfunction shouldKillAssess(tgt) {\n  if (!bmBool('bm_xassess')) return false;\n  if (!readyAssess()) return false;\n  var reuse = parseInt(bmGet('bm_assess_reuse_sec', '12'), 10);\n  if (isNaN(reuse)) reuse = 12;\n  if (reuse > 0 && bmGet('bm_assess_consumed_tgt', '') === tgt) {\n    var last = parseFloat(bmGet('bm_last_assess_time', '0'));\n    if ((Date.now() / 1000 - last) < reuse) return false;\n  }\n  return true;\n}\nfunction bmEngineOn() {\n  var v = get_variable('bm_engine');\n  if (v === undefined || v === null || v === '') return true;\n  return bmBool('bm_engine');\n}\n\nif (!bmEngineOn()) return;\nif (!bmBool('bm_killmode')) return;\nif (bmBool('bm_bladeshield')) return;\nif (bmBool('bm_smart_poison')) {\n  try { run_function('bm_sync_wep_poison', '', 'BladeMaster Engine'); } catch (eSp) {}\n}\ntry { if (client.evisc && client.evisc.isExecuting) return; } catch (eE) {}\nif (bmGet('bm_pending', '')) return;\n// No fixed send gate: per-arm spent marks (GMCP arm=0 clears, 1 s safety) stop double-fire.\n// bm_kill_last stays as an informational timestamp only.\nvar now = Date.now();\n\nvar tgt = String(bmGet('bm_target', '') || '').trim();\nif (!tgt) {\n  return;\n}\n\nvar watchTgt = String(bmGet('bm_kill_watch_tgt', '') || '');\nif (tgt.toLowerCase() !== watchTgt.toLowerCase()) {\n  bmSet('bm_kill_watch_tgt', tgt);\n  resetKillModeOpener();\n  resetParryState();\n}\n\ntryFinishOpenerFromArms();\n\nvar killHand = bmGet('bm_kill_hand', 'right') || 'right';\nvar hinderHand = bmGet('bm_hinder_hand', 'left') || 'left';\nvar defaultSpec = (bmAssistSpec() === 'off');\n\n// Limbs (+ plan for the default spec). Re-run at fire time so an assay result re-picks.\nfunction pickVolley() {\n  var out = { killLimb: '', hinderLimb: '', plan: null };\n  if (defaultSpec) {\n    bmRefreshKillPhase();\n    out.plan = bmPlanKillVolley(tgt);\n    out.killLimb = out.plan.killBody;\n    out.hinderLimb = out.plan.hinderBody;\n  } else {\n    out.killLimb = pickKill();\n    out.hinderLimb = pickHinder(out.killLimb);\n  }\n  bmSet('bm_kill_limb', out.killLimb);\n  bmSet('bm_hinder_limb', out.hinderLimb);\n  return out;\n}\n// Send whatever hands are usable right now; each sent hand is marked spent.\nfunction fireVolley(prep, pick, n, suffix) {\n  var killOn = armUsable(killHand);\n  var hinderOn = armUsable(hinderHand);\n  if (!killOn && !hinderOn) return false;\n  var built = buildKillVolley(tgt, pick.killLimb, pick.hinderLimb, killHand, hinderHand, n, pick.plan, killOn, hinderOn);\n  if (!built.killCmd && !built.hinderCmd) return false;\n  sendDual(prep, built.hinderCmd, built.killCmd, built.intents);\n  if (built.hinderCmd) markArmSpent(hinderHand);\n  if (built.killCmd) {\n    markArmSpent(killHand);\n    // One volley = one kill-hand send (the hinder hand may go out on its own arm event).\n    bmSet('bm_kill_volley', String(n));\n    if (pick.plan) {\n      if (pick.plan.bait && String(bmGet('bm_kill_phase', 'kill') || 'kill') === 'split') {\n        bmSet('bm_split_volleys', String((parseInt(bmGet('bm_split_volleys', '0'), 10) || 0) + 1));\n      }\n      if (pick.plan.note) display_notice('[BM] ' + pick.plan.note + (pick.plan.noteMid ? ' — ' + pick.plan.noteMid : ''), 'orange');\n    }\n  }\n  noteAction(built.label + (suffix || ''));\n  return true;\n}\n// Assay cadence (default spec): every volley while a vital effParry >= watch, a live parry was\n// seen since the last volley, phase is split/fallback, or denial flipped; else every 3rd.\nfunction needAssay(nextN) {\n  if (!bmBool('bm_xassay')) return false;\n  if (bmBool('bm_parry_flip')) return true;\n  if (defaultSpec) {\n    var phase = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n    if (phase === 'split' || phase === 'fallback') return true;\n    var watch = bmpNum('bm_parry_watch', 50);\n    if (effParry('chest') >= watch || effParry('gut') >= watch) return true;\n    if (liveParrySeenSince(bmGet('bm_kill_last_volley_at', '0'))) return true;\n  }\n  return (nextN % 3) === 0;\n}\n\nvar pendRaw = bmGet('bm_kill_pending', '');\nif (pendRaw) {\n  if (!armUsable(killHand) && !armUsable(hinderHand)) return; // keep it for the next arm event\n  bmSet('bm_kill_pending', '');\n  try {\n    var pend = JSON.parse(pendRaw) || {};\n    var pickP = pickVolley();\n    fireVolley([], pickP, pend.n || ((parseInt(bmGet('bm_kill_volley', '0'), 10) || 0) + 1), ' (after assay)');\n  } catch (eP) {}\n  return;\n}\n\nvar openerDone = bmBool('bm_opener_done');\nif (!openerDone) {\n  // Opener already sent: wait for tryFinishOpenerFromArms (never resend while inflight).\n  if (bmBool('bm_opener_inflight')) return;\n  // Opener is raze (hinder hand) + base chest (kill hand) and needs both arms (per-arm spent gating).\n  if (!(armUsable('left') && armUsable('right'))) return;\n  sendDual([], 'raze ' + tgt + ' ' + hinderHand, strikeCmd(tgt, killHand, 'chest', 'base', false, false), [{ hand: killHand, limb: 'chest', lunge: false }]);\n  markArmSpent('left');\n  markArmSpent('right');\n  bmSet('bm_opener_inflight', '1');\n  bmSet('bm_opener_sent_at', String(Date.now()));\n  bmSet('bm_opener_arm_down', '0');\n  noteAction('opener raze + chest');\n  display_notice('[BM] opener raze + chest', 'yellow');\n  return;\n}\n\nvar isSupport = String(bmGet('bm_role', 'killer') || 'killer').toLowerCase() === 'support';\nif (!critLatchFresh() && bmBool('bm_pre_evisc_await')) bmSet('bm_pre_evisc_await', '0');\nif (openerDone && !isSupport && critLatchFresh() && (isCrit('chest') || isCrit('gut') || bmBool('bm_pre_evisc_await'))) {\n  bmSet('bm_kill_last', String(Date.now()));\n  noteAction('xevisc (C!)');\n  try { run_function('bm_try_auto_evisc', 'killmode', 'BladeMaster Engine'); } catch (eX) {}\n  return;\n}\n\nif (bmBool('bm_poisonist') && !bmBool('bm_poisonist_sent')) {\n  var eviscBusy = false;\n  try { if (client.evisc && client.evisc.isExecuting) eviscBusy = true; } catch (ePb) {}\n  if (!eviscBusy) {\n    send_command('combatstyle poisonist', 0);\n    bmSet('bm_poisonist_sent', '1');\n  }\n}\nif (!isSupport) {\n  var hpN = parseFloat(bmGet('bm_en_hp', ''));\n  var proneKnown = String(bmGet('bm_en_prone', '') || '') !== '';\n  var proneOn = bmBool('bm_en_prone');\n  var lastHay = parseFloat(bmGet('bm_haymaker_last', '0')) || 0;\n  if (hpN && hpN < 25 && proneKnown && proneOn && (!lastHay || (now - lastHay) >= 2000)) {\n    if (!(armUsable('left') || armUsable('right'))) return;\n    send_command('strike ' + tgt + ' haymaker', 0);\n    markArmSpent('left');\n    markArmSpent('right');\n    bmSet('bm_haymaker_last', String(now));\n    bmSet('bm_kill_last', String(now));\n    noteAction('haymaker (HP<25 + prone)');\n    return;\n  }\n}\n\nif (!armUsable(killHand) && !armUsable(hinderHand)) return;\n\nvar nextN = (parseInt(bmGet('bm_kill_volley', '0'), 10) || 0) + 1;\nvar pick = pickVolley();\nvar doAssay = needAssay(nextN);\n\nvar prep = [];\nif (shouldKillAssess(tgt)) {\n  prep.push('free assess ' + tgt);\n  bmSet('bm_assess_consumed_tgt', tgt);\n  bmSet('bm_last_assess_time', String(Date.now() / 1000));\n}\n\nif (doAssay) {\n  prep.push('assay ' + tgt);\n  sendPrepOnly(prep);\n  bmSet('bm_parry_flip', '0');\n  bmSet('bm_kill_pending', JSON.stringify({ killHand: killHand, hinderHand: hinderHand, n: nextN }));\n  noteAction('assay (strikes next balance)');\n  return;\n}\n\nfireVolley(prep, pick, nextN, '');\n"},{"type":"function","name":"bm_track","enabled":true,"id":6,"code":"\nfunction bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nfunction bmpNow() { return Date.now(); }\nfunction bmpNum(k, d) {\n  var n = parseFloat(bmGet(k, ''));\n  return isNaN(n) ? d : n;\n}\nfunction bmpJson(k, d) {\n  try {\n    var raw = bmGet(k, '');\n    if (!raw) return d;\n    var v = JSON.parse(raw);\n    if (v === null || typeof v !== 'object') return d;\n    return v;\n  } catch (eJ) { return d; }\n}\nfunction bmpIsArray(v) { return Object.prototype.toString.call(v) === '[object Array]'; }\nfunction bmpIsVital(limb) { return limb === 'head' || limb === 'chest' || limb === 'gut'; }\nfunction bmpWoundWord(limb) { return String(bmGet('bm_w_' + limb, '') || '').toLowerCase(); }\nfunction bmpWoundRank(limb) {\n  var w = bmpWoundWord(limb);\n  if (w === 'critical') return 3;\n  if (w === 'heavy') return 2;\n  if (w === 'light') return 1;\n  return 0;\n}\nfunction bmpAssayPct(limb) {\n  var p = parseInt(bmGet('bm_p_' + limb, ''), 10);\n  return isNaN(p) ? null : p;\n}\nfunction bmpThreshold() {\n  var th = parseInt(bmGet('bm_smart_threshold', '90'), 10);\n  return isNaN(th) ? 90 : th;\n}\nfunction bmpStanceCoversVitals() {\n  return String(bmGet('bm_en_stance', '') || '').toLowerCase().indexOf('vital') >= 0;\n}\nfunction bmpEvidenceMs() { return bmpNum('bm_parry_evidence_sec', 20) * 1000; }\nfunction bmpParryPolicy() {\n  var p = String(bmGet('bm_parry_policy', 'vital') || 'vital').toLowerCase();\n  return p === 'bait' ? 'bait' : 'vital';\n}\nfunction bmpSplitMax() {\n  var n = parseInt(bmGet('bm_split_max_volleys', '4'), 10);\n  return (isNaN(n) || n < 1) ? 4 : n;\n}\nfunction bmParsePowerVal(raw) {\n  if (raw == null || raw === '') return NaN;\n  if (typeof raw === 'number') return raw;\n  var s = String(raw).replace(/^\\s+|\\s+$/g, '');\n  var slash = s.indexOf('/');\n  if (slash >= 0) s = s.substring(0, slash);\n  return parseFloat(s);\n}\nfunction bmGetPower() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Vitals) {\n      var v = GMCP.Char.Vitals;\n      var keys = ['power', 'pow', 'p', 'stars'];\n      var i, p;\n      for (i = 0; i < keys.length; i++) {\n        p = bmParsePowerVal(v[keys[i]]);\n        if (!isNaN(p)) return p;\n      }\n    }\n  } catch (eP) {}\n  return null;\n}\nfunction bmEviscReserve() {\n  var reserve = 5;\n  var candy = bmBool('pEviscLollyPrep') || bmBool('evisc_candy');\n  var wbRaw = get_variable('evisc_combo_weakblood');\n  var wb;\n  if (wbRaw === undefined || wbRaw === null || wbRaw === '') {\n    wb = candy;\n  } else {\n    wb = bmBool('evisc_combo_weakblood');\n  }\n  if (candy && wb) reserve += 3;\n  if (bmBool('bm_pre_evisc_blade')) reserve += 3;\n  return reserve;\n}\n// 0..2 lunge hands from spare power above the evisc reserve. Unknown power -> 0 (never guess).\nfunction lungeBudgetHands() {\n  var power = bmGetPower();\n  if (power === null) return 0;\n  var n = Math.floor((power - bmEviscReserve()) / 2);\n  if (n < 0) n = 0;\n  if (n > 2) n = 2;\n  return n;\n}\n// --- live parry ring (BM_CombatTracker) ---\nfunction bmpLiveRing(limb) {\n  var list = bmpJson('bm_live_parry_' + limb, []);\n  if (!bmpIsArray(list)) list = [];\n  var cutoff = bmpNow() - bmpEvidenceMs();\n  var out = [], i;\n  for (i = 0; i < list.length; i++) {\n    if (list[i] && (parseFloat(list[i].t) || 0) >= cutoff) out.push(list[i]);\n  }\n  return out;\n}\nfunction bmpLiveCounts(limb) {\n  var list = bmpLiveRing(limb);\n  var parried = 0, i;\n  for (i = 0; i < list.length; i++) if (list[i].p) parried++;\n  return { parried: parried, total: list.length };\n}\nfunction bmpLiveRate(limb) {\n  var c = bmpLiveCounts(limb);\n  if (!c.total) return null;\n  return c.parried / c.total;\n}\nfunction bmpLiveLandedStreak(limb) {\n  var list = bmpLiveRing(limb);\n  var streak = 0, i;\n  for (i = list.length - 1; i >= 0; i--) {\n    if (list[i].p) break;\n    streak++;\n  }\n  return streak;\n}\nfunction bmpPushLiveOutcome(limb, parried) {\n  var list = bmpLiveRing(limb);\n  list.push({ p: parried ? 1 : 0, t: bmpNow() });\n  while (list.length > 6) list.shift();\n  bmSet('bm_live_parry_' + limb, JSON.stringify(list));\n  if (parried) bmSet('bm_live_parry_last_at', String(bmpNow()));\n}\nfunction liveParrySeenSince(t) {\n  var last = parseFloat(bmGet('bm_live_parry_last_at', '0')) || 0;\n  return last > 0 && last >= (parseFloat(t) || 0);\n}\n// --- swing queue (written by sendDual, resolved by bm_track) ---\nfunction bmpSwingQueue() {\n  var q = bmpJson('bm_swing_queue', []);\n  if (!bmpIsArray(q)) q = [];\n  var cutoff = bmpNow() - 6000;\n  var out = [], i;\n  for (i = 0; i < q.length; i++) {\n    if (q[i] && (parseFloat(q[i].t) || 0) >= cutoff) out.push(q[i]);\n  }\n  return out;\n}\nfunction bmpSaveSwingQueue(q) { bmSet('bm_swing_queue', JSON.stringify(q || [])); }\nfunction queueSwings(intents) {\n  var q = bmpSwingQueue();\n  var now = bmpNow();\n  var i, it;\n  for (i = 0; i < (intents || []).length; i++) {\n    it = intents[i];\n    if (!it || !it.limb) continue;\n    q.push({ hand: it.hand || '', limb: String(it.limb).toLowerCase(), lunge: it.lunge ? 1 : 0, t: now, r: 0, rt: 0 });\n  }\n  while (q.length > 8) q.shift();\n  bmpSaveSwingQueue(q);\n}\nfunction bmpNextUnresolved(q, lungeOnly) {\n  var i;\n  for (i = 0; i < q.length; i++) {\n    if (q[i] && !q[i].r && (!!q[i].lunge) === (!!lungeOnly)) return q[i];\n  }\n  return null;\n}\n// --- effective parry + hysteresis denial (BM_CombatEngine) ---\nfunction effParry(limb) {\n  if (!bmpIsVital(limb)) return 0;\n  if (bmpStanceCoversVitals()) return 100;\n  var pct = bmpAssayPct(limb);\n  if (pct === null) pct = 0;\n  var live = bmpLiveRate(limb);\n  if (live !== null && live * 100 > pct) pct = live * 100;\n  if (pct < 0) pct = 0;\n  if (pct > 100) pct = 100;\n  return pct;\n}\nfunction bmpDenState(limb) {\n  var st = bmpJson('bm_parry_den_' + limb, null);\n  if (!st) st = {};\n  st.denied = !!st.denied;\n  if (!bmpIsArray(st.pts)) st.pts = [];\n  st.liveBase = parseFloat(st.liveBase) || 0;\n  st.reason = String(st.reason || '');\n  st.since = parseFloat(st.since) || 0;\n  st.assayFresh = !!st.assayFresh;\n  if (st.lastAssay === undefined) st.lastAssay = null;\n  st.points = parseFloat(st.points) || 0;\n  return st;\n}\nfunction bmpSaveDenState(limb, st) { bmSet('bm_parry_den_' + limb, JSON.stringify(st)); }\nfunction isVitalDenied(limb) {\n  if (!bmpIsVital(limb)) return false;\n  if (bmpStanceCoversVitals()) return true;\n  return bmpDenState(limb).denied === true;\n}\n// Any limb: vitals = hysteresis OR raw assay >= threshold; arms/legs from the foe stance.\nfunction isLimbDenied(limb) {\n  if (!limb) return false;\n  if (bmpIsVital(limb)) {\n    if (isVitalDenied(limb)) return true;\n    var p = bmpAssayPct(limb);\n    return p !== null && p >= bmpThreshold();\n  }\n  var s = String(bmGet('bm_en_stance', '') || '').toLowerCase();\n  if ((limb === 'lleg' || limb === 'rleg') && s.indexOf('leg') >= 0) return true;\n  if ((limb === 'larm' || limb === 'rarm') && s.indexOf('arm') >= 0) return true;\n  return false;\n}\n// Hysteresis: assayPct (optional) is a NEW reading -> 1 point when >= threshold; live parries\n// add points via the ring. Enter denied at >= confirm points (or stance); leave on a fresh assay\n// below release or 2 consecutive landed swings. Banners only on change. Returns denied.\nfunction evalVitalDenied(limb, assayPct) {\n  if (!bmpIsVital(limb)) return false;\n  var st = bmpDenState(limb);\n  var now = bmpNow();\n  var win = bmpEvidenceMs();\n  var th = bmpThreshold();\n  if (assayPct !== undefined && assayPct !== null && !isNaN(assayPct)) {\n    st.lastAssay = assayPct;\n    st.assayFresh = true;\n    if (assayPct >= th) st.pts.push(now);\n  }\n  var kept = [], i;\n  for (i = 0; i < st.pts.length; i++) {\n    if ((now - (parseFloat(st.pts[i]) || 0)) <= win) kept.push(st.pts[i]);\n  }\n  st.pts = kept;\n  var liveRaw = bmpLiveCounts(limb).parried;\n  if (liveRaw < st.liveBase) st.liveBase = liveRaw;\n  var livePts = liveRaw - st.liveBase;\n  st.points = kept.length + livePts;\n  var pct = bmpAssayPct(limb);\n  var release = bmpNum('bm_parry_release', 70);\n  var need = parseInt(bmGet('bm_parry_confirm_points', '2'), 10);\n  if (isNaN(need) || need < 1) need = 2;\n  var streak = bmpLiveLandedStreak(limb);\n  var wasDenied = st.denied;\n  var nowDenied = wasDenied;\n  var reason = st.reason;\n  function evidenceReason() {\n    if (kept.length > 0 && livePts > 0) return 'assay+live';\n    return kept.length > 0 ? 'assay' : 'live';\n  }\n  if (bmpStanceCoversVitals()) {\n    nowDenied = true;\n    reason = 'stance';\n  } else if (wasDenied && st.reason === 'stance') {\n    if (st.points >= need) {\n      reason = evidenceReason();\n      st.reason = reason;\n    } else {\n      nowDenied = false;\n      reason = 'stance dropped';\n    }\n  } else if (wasDenied) {\n    if (pct !== null && pct < release && st.assayFresh) {\n      nowDenied = false;\n      reason = 'assay ' + pct + '%';\n    } else if (streak >= 2) {\n      nowDenied = false;\n      reason = 'landed x' + streak;\n    }\n  } else if (st.points >= need) {\n    nowDenied = true;\n    reason = evidenceReason();\n  }\n  if (nowDenied !== wasDenied) {\n    st.denied = nowDenied;\n    st.reason = reason;\n    st.since = now;\n    bmSet('bm_parry_flip', '1');\n    var eff = Math.round(effParry(limb));\n    if (nowDenied) {\n      st.assayFresh = false;\n      if (limb !== 'head') display_notice('[BM] PARRY CONFIRMED — ' + limb.toUpperCase() + ' ' + eff + '% (' + reason + ')', 'orange');\n    } else {\n      st.pts = [];\n      st.liveBase = liveRaw;\n      st.points = 0;\n      if (limb !== 'head') display_notice('[BM] PARRY RELEASED — ' + limb.toUpperCase() + ' ' + eff + '% (' + reason + ')', 'orange');\n    }\n  } else if (nowDenied && reason === 'stance' && st.reason !== 'stance') {\n    st.reason = 'stance';\n  }\n  bmpSaveDenState(limb, st);\n  return st.denied === true;\n}\n// Phase: kill | split (both vitals denied) | fallback (split cap reached). Default spec only.\nfunction bmRefreshKillPhase() {\n  var prev = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var chestD = isVitalDenied('chest');\n  var gutD = isVitalDenied('gut');\n  var splitN = parseInt(bmGet('bm_split_volleys', '0'), 10) || 0;\n  var maxSplit = bmpSplitMax();\n  var wasChest = String(bmGet('bm_parry_was_chest', '') || '') === '1';\n  var wasGut = String(bmGet('bm_parry_was_gut', '') || '') === '1';\n  if (chestD && gutD) {\n    if (prev === 'fallback') {\n      // stay\n    } else if (prev === 'split') {\n      if (splitN >= maxSplit) {\n        bmSet('bm_kill_phase', 'fallback');\n        bmSet('bm_fallback_leg', '');\n        display_notice('[BM] FALLBACK — legs: split ' + splitN + '/' + maxSplit + ' with no release — both hands on one leg → legtendon → prone → haymaker', 'orange');\n      }\n    } else {\n      bmSet('bm_kill_phase', 'split');\n      bmSet('bm_split_volleys', '0');\n      display_notice('[BM] SPLIT MODE — bait parry off vitals', 'orange');\n    }\n  } else {\n    if (prev === 'split' || prev === 'fallback') {\n      if (!chestD && !gutD) display_notice('[BM] BAIT SUCCESS — vitals open', 'orange');\n      else if (wasChest && !chestD) display_notice('[BM] BAIT SUCCESS — chest parry dropped', 'orange');\n      else if (wasGut && !gutD) display_notice('[BM] BAIT SUCCESS — gut parry dropped', 'orange');\n    }\n    bmSet('bm_kill_phase', 'kill');\n    bmSet('bm_split_volleys', '0');\n    bmSet('bm_fallback_leg', '');\n  }\n  bmSet('bm_parry_was_chest', chestD ? '1' : '0');\n  bmSet('bm_parry_was_gut', gutD ? '1' : '0');\n}\n// Primary vital: higher wound rank; tie -> lower effParry; tie -> chest. Parry never moves it.\nfunction pickKillModeVital() {\n  var wc = bmpWoundRank('chest');\n  var wg = bmpWoundRank('gut');\n  if (wg > wc) return 'gut';\n  if (wc > wg) return 'chest';\n  if (effParry('gut') < effParry('chest')) return 'gut';\n  return 'chest';\n}\nfunction resolveKillVital() {\n  var primary = pickKillModeVital();\n  var secondary = (primary === 'chest') ? 'gut' : 'chest';\n  var wp = bmpWoundRank(primary);\n  var ws = bmpWoundRank(secondary);\n  var reason;\n  if (wp > ws) reason = 'wounds ' + wp + ' > ' + ws;\n  else if (effParry(primary) < effParry(secondary)) reason = 'wounds tie, parry ' + Math.round(effParry(primary)) + '% < ' + Math.round(effParry(secondary)) + '%';\n  else reason = 'wounds tie, chest default';\n  if (isVitalDenied(primary)) reason += ' (denied)';\n  bmSet('bm_kill_vital_lock', JSON.stringify({ limb: primary, reason: reason }));\n  return primary;\n}\n// --- bait / leg helpers (tiers map onto MOD via strikeCmd: light=pierce*, crit=legtendon) ---\nfunction baitTier(limb) { return bmpWoundRank(limb) >= 1 ? 'light' : 'base'; }\nfunction pickBaitArm(volley) {\n  var lOk = !isLimbDenied('larm');\n  var rOk = !isLimbDenied('rarm');\n  if (lOk && !rOk) return 'larm';\n  if (rOk && !lOk) return 'rarm';\n  if (!lOk && !rOk) return '';\n  var wl = bmpWoundRank('larm');\n  var wr = bmpWoundRank('rarm');\n  if (wl > wr) return 'larm';\n  if (wr > wl) return 'rarm';\n  return (((parseInt(volley, 10) || 0) % 2) === 0) ? 'larm' : 'rarm';\n}\nfunction pickBaitLeg() {\n  var lOk = !isLimbDenied('lleg');\n  var rOk = !isLimbDenied('rleg');\n  if (lOk && !rOk) return 'lleg';\n  if (rOk && !lOk) return 'rleg';\n  if (!lOk && !rOk) return '';\n  if (bmpWoundRank('rleg') > bmpWoundRank('lleg')) return 'rleg';\n  return 'lleg';\n}\nfunction pickFallbackLeg() {\n  var cur = String(bmGet('bm_fallback_leg', '') || '');\n  if ((cur === 'lleg' || cur === 'rleg') && !isLimbDenied(cur)) return cur;\n  var lOk = !isLimbDenied('lleg');\n  var rOk = !isLimbDenied('rleg');\n  var pick;\n  if (lOk && !rOk) pick = 'lleg';\n  else if (rOk && !lOk) pick = 'rleg';\n  else pick = (bmpWoundRank('rleg') < bmpWoundRank('lleg')) ? 'rleg' : 'lleg';\n  bmSet('bm_fallback_leg', pick);\n  return pick;\n}\nfunction legBaitTier(leg, allowCrit) {\n  var w = bmpWoundRank(leg);\n  if (allowCrit && w >= 3) return 'crit';\n  if (w >= 1) return 'light';\n  return 'base';\n}\n// Kill volley plan for the default spec (mirror of Lua planKillVolley). Pure: safe per tick.\nfunction bmPlanKillVolley(tgt) {\n  var primary = resolveKillVital();\n  var secondary = (primary === 'chest') ? 'gut' : 'chest';\n  var volley = (parseInt(bmGet('bm_kill_volley', '0'), 10) || 0) + 1;\n  var plan = {\n    killBody: primary, killTier: 'base', killLunge: false,\n    hinderBody: primary, hinderTier: 'base', hinderLunge: false,\n    primary: primary, secondary: secondary, budget: 0, note: '', noteMid: '',\n    vitalLunge: false, bait: false\n  };\n  var phase = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var pDenied = isVitalDenied(primary);\n  var sDenied = isVitalDenied(secondary);\n  var budget = lungeBudgetHands();\n  var power = bmGetPower();\n  var reserve = bmEviscReserve();\n  plan.budget = budget;\n  var powStr = '(power ' + (power === null ? '?' : power) + ', reserve ' + reserve + ')';\n  function woundStr(limb) { return bmpWoundWord(limb) || 'no wounds'; }\n  function baitArmHinder() {\n    var arm = pickBaitArm(volley);\n    if (!arm) {\n      if (!isLimbDenied('head')) {\n        plan.hinderBody = 'head';\n        plan.hinderTier = baitTier('head');\n        return;\n      }\n      var leg = pickBaitLeg() || 'lleg';\n      plan.hinderBody = leg;\n      plan.hinderTier = legBaitTier(leg, false);\n      return;\n    }\n    plan.hinderBody = arm;\n    plan.hinderTier = baitTier(arm);\n  }\n  if (!pDenied) return plan;\n  if (budget >= 2) {\n    plan.killLunge = true;\n    plan.hinderLunge = true;\n    plan.vitalLunge = true;\n    plan.note = 'LUNGE THROUGH PARRY — ' + primary.toUpperCase() + ' x2';\n    plan.noteMid = powStr;\n    return plan;\n  }\n  if (budget === 1) {\n    plan.killLunge = true;\n    plan.vitalLunge = true;\n    if (!sDenied) {\n      plan.hinderBody = secondary;\n      plan.hinderTier = 'base';\n    } else {\n      baitArmHinder();\n    }\n    plan.note = 'LUNGE THROUGH PARRY — ' + primary.toUpperCase() + ' x1';\n    plan.noteMid = powStr + (sDenied ? ' · hinder baits ' + String(plan.hinderBody).toUpperCase() : ' · hinder ' + secondary.toUpperCase());\n    return plan;\n  }\n  if (phase === 'fallback') {\n    var fleg = pickFallbackLeg() || 'lleg';\n    plan.killBody = fleg;\n    plan.killTier = (bmpWoundRank(fleg) >= 3) ? 'crit' : 'base';\n    plan.hinderBody = fleg;\n    plan.hinderTier = legBaitTier(fleg, true);\n    plan.bait = true;\n    plan.note = 'FALLBACK — legs';\n    plan.noteMid = fleg.toUpperCase() + ' ' + woundStr(fleg);\n    return plan;\n  }\n  if (!sDenied) {\n    var needPower = reserve + 2;\n    plan.killBody = secondary;\n    plan.killTier = 'base';\n    if (bmpParryPolicy() === 'bait') {\n      baitArmHinder();\n      plan.noteMid = 'bait ' + String(plan.hinderBody).toUpperCase();\n    } else {\n      plan.hinderBody = secondary;\n      plan.hinderTier = 'base';\n      plan.noteMid = powStr;\n    }\n    plan.note = 'HOLD ' + primary.toUpperCase() + ' ' + bmpWoundWord(primary) + ' — building ' + secondary.toUpperCase() + ' until power >= ' + needPower;\n    return plan;\n  }\n  // Both vitals denied, no lunge budget: split bait. Never base into a denied vital.\n  baitArmHinder();\n  var bleg = pickBaitLeg();\n  if (bleg) {\n    plan.killBody = bleg;\n    plan.killTier = legBaitTier(bleg, false);\n  } else if (plan.hinderBody !== 'head' && !isLimbDenied('head')) {\n    plan.killBody = 'head';\n    plan.killTier = 'base';\n  } else {\n    plan.killBody = (plan.hinderBody === 'larm') ? 'rarm' : 'larm';\n    plan.killTier = 'base';\n  }\n  plan.bait = true;\n  plan.note = 'SPLIT ' + ((parseInt(bmGet('bm_split_volleys', '0'), 10) || 0) + 1) + '/' + bmpSplitMax();\n  plan.noteMid = 'hinder ' + String(plan.hinderBody).toUpperCase() + ' · kill hand ' + String(plan.killBody).toUpperCase();\n  return plan;\n}\n// Plain-text status (Offence tab block, xkillmode status, xkillparry).\nfunction killModeStatusLines() {\n  var lines = [];\n  var assist = 'off';\n  try { if (typeof bmAssistSpec === 'function') assist = bmAssistSpec(); } catch (eA) {}\n  if (assist === 'off') resolveKillVital();\n  var lock = bmpJson('bm_kill_vital_lock', {});\n  var primary = String(lock.limb || bmGet('bm_kill_limb', 'chest') || 'chest');\n  lines.push('primary ' + primary.toUpperCase() + ' (' + (bmpWoundWord(primary) || 'no wounds') + ') — ' + (lock.reason || '?'));\n  var vitals = ['chest', 'gut'], i, limb, ap, c, st, denied;\n  for (i = 0; i < vitals.length; i++) {\n    limb = vitals[i];\n    ap = bmpAssayPct(limb);\n    c = bmpLiveCounts(limb);\n    st = bmpDenState(limb);\n    denied = isVitalDenied(limb);\n    lines.push(limb.toUpperCase() + ' ' + Math.round(effParry(limb)) + '% (assay ' + (ap === null ? '?' : ap + '%') + ', live ' + c.parried + '/' + c.total + ', pts ' + st.points + ')' +\n      (denied ? ' DENIED' + (st.reason ? ' [' + st.reason + ']' : '') : ''));\n  }\n  var power = bmGetPower();\n  lines.push('lunge: power ' + (power === null ? '?' : power) + ' / reserve ' + bmEviscReserve() + ' -> ' + lungeBudgetHands() + ' hand(s)');\n  var phase = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var phaseLine = 'phase ' + phase;\n  if (phase === 'split' || phase === 'fallback') phaseLine += '  split ' + (parseInt(bmGet('bm_split_volleys', '0'), 10) || 0) + '/' + bmpSplitMax();\n  if (phase === 'fallback' && bmGet('bm_fallback_leg', '')) phaseLine += '  leg ' + String(bmGet('bm_fallback_leg', '')).toUpperCase();\n  phaseLine += '  policy ' + bmpParryPolicy();\n  lines.push(phaseLine);\n  var proneRaw = String(bmGet('bm_en_prone', '') || '');\n  if (!proneRaw) lines.push('prone: unknown');\n  else lines.push('prone: ' + (bmBool('bm_en_prone') ? 'yes' : 'no'));\n  return lines;\n}\n// Target change / KillMode ON: forget parry evidence, queue, lock, phase counters.\nfunction resetParryState() {\n  var limbs = ['head', 'chest', 'gut', 'larm', 'rarm', 'lleg', 'rleg'], i;\n  for (i = 0; i < limbs.length; i++) bmSet('bm_live_parry_' + limbs[i], '');\n  bmSet('bm_parry_den_head', '');\n  bmSet('bm_parry_den_chest', '');\n  bmSet('bm_parry_den_gut', '');\n  bmSet('bm_swing_queue', '');\n  bmSet('bm_live_parry_last_at', '0');\n  bmSet('bm_kill_last_volley_at', '0');\n  bmSet('bm_kill_vital_lock', '');\n  bmSet('bm_split_volleys', '0');\n  bmSet('bm_fallback_leg', '');\n  bmSet('bm_parry_flip', '0');\n  bmSet('bm_parry_was_chest', '');\n  bmSet('bm_parry_was_gut', '');\n  bmSet('bm_kill_phase', 'kill');\n}function refresh() {\n  try { run_function('bm_tabs', '', 'BladeMaster Engine'); } catch (eR) {}\n}\nfunction killModeOn() { return bmBool('bm_killmode'); }\nfunction liveNameMatchesTarget(name) {\n  var tgt = String(bmGet('bm_target', '') || '');\n  var s = String(name || '').replace(/^\\s+|\\s+$/g, '').toLowerCase().replace(/^the\\s+/, '').replace(/^an?\\s+/, '');\n  var t = tgt.replace(/^\\s+|\\s+$/g, '').toLowerCase().replace(/^the\\s+/, '').replace(/^an?\\s+/, '');\n  if (!s || !t) return false;\n  return s === t || s.indexOf(t) === 0 || t.indexOf(s) === 0;\n}\n// One of our non-lunge swings landed on limb: resolve the matching queued swing (landed = not\n// parried). Idempotent inside 1 s so the two swing triggers that both route here do not double-count.\nfunction noteSwingLanded(limb) {\n  limb = String(limb || '').toLowerCase();\n  if (!limb || !killModeOn()) return;\n  var q = bmpSwingQueue();\n  var now = Date.now();\n  var i, sw = null;\n  for (i = 0; i < q.length; i++) {\n    if (!q[i].r && q[i].limb === limb) { sw = q[i]; break; }\n  }\n  if (!sw) {\n    for (i = 0; i < q.length; i++) {\n      if (q[i].r && q[i].limb === limb && (now - (parseFloat(q[i].rt) || 0)) <= 1000) { bmpSaveSwingQueue(q); return; }\n    }\n    sw = bmpNextUnresolved(q, false);\n  }\n  if (!sw) { bmpSaveSwingQueue(q); return; }\n  sw.r = 1;\n  sw.rt = now;\n  bmpSaveSwingQueue(q);\n  if (sw.lunge) return; // lunges bypass parry: no evidence\n  bmpPushLiveOutcome(sw.limb, false);\n  if (bmpIsVital(sw.limb)) evalVitalDenied(sw.limb);\n}\nfunction noteLungeLanded() {\n  if (!killModeOn()) return;\n  var q = bmpSwingQueue();\n  var sw = bmpNextUnresolved(q, true);\n  if (!sw) return;\n  sw.r = 1;\n  sw.rt = Date.now();\n  bmpSaveSwingQueue(q);\n}\n// \"<Name> parries the attack\": attribute to the next unresolved non-lunge swing we sent.\nfunction noteParry(name) {\n  if (!killModeOn() || !liveNameMatchesTarget(name)) return;\n  var q = bmpSwingQueue();\n  var now = Date.now();\n  var sw = bmpNextUnresolved(q, false);\n  var limb = '';\n  var flipped = false;\n  if (sw) {\n    sw.r = 1;\n    sw.rt = now;\n    limb = sw.limb;\n    bmpSaveSwingQueue(q);\n  } else {\n    // Queue exhausted: our own swing line for this swing may have arrived just before the parry\n    // line (same burst) -> flip that landed outcome instead of double-counting.\n    var i, last = null;\n    for (i = 0; i < q.length; i++) {\n      if (q[i].r && !q[i].lunge && (now - (parseFloat(q[i].rt) || 0)) <= 1000) last = q[i];\n    }\n    if (last) {\n      limb = last.limb;\n      var ring = bmpLiveRing(limb);\n      if (ring.length && !ring[ring.length - 1].p && (now - (parseFloat(ring[ring.length - 1].t) || 0)) <= 1000) {\n        ring[ring.length - 1].p = 1;\n        bmSet('bm_live_parry_' + limb, JSON.stringify(ring));\n        bmSet('bm_live_parry_last_at', String(now));\n        flipped = true;\n      }\n    } else {\n      limb = String(bmGet('bm_kill_limb', '') || '').toLowerCase();\n      if (!bmpIsVital(limb)) return;\n    }\n  }\n  if (!flipped) bmpPushLiveOutcome(limb, true);\n  if (bmpIsVital(limb)) evalVitalDenied(limb);\n  refresh();\n  maybeSyncWepPoison();\n}\nfunction maybeSyncWepPoison() {\n  function flag(k) {\n    var v = get_variable(k);\n    if (v === undefined || v === null || v === '') return false;\n    if (v === true || v === 1) return true;\n    var s = String(v).toLowerCase();\n    return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n  }\n  function engineOn() {\n    var v = get_variable('bm_engine');\n    if (v === undefined || v === null || v === '') return true;\n    return flag('bm_engine');\n  }\n  if (!engineOn()) return;\n  if (flag('bm_smart_poison')) {\n    try { run_function('bm_sync_wep_poison', '', 'BladeMaster Engine'); } catch (eS) {}\n  }\n}\nfunction normPart(name) {\n  name = String(name || '').toLowerCase().replace(/^\\s+|\\s+$/g, '');\n  name = name.replace(/^(his|her|their|the|your)\\s+/, '');\n  if (name === 'left arm' || name === 'leftarm') return 'larm';\n  if (name === 'right arm' || name === 'rightarm') return 'rarm';\n  if (name === 'left leg' || name === 'leftleg') return 'lleg';\n  if (name === 'right leg' || name === 'rightleg') return 'rleg';\n  if (name === 'head' || name === 'chest' || name === 'gut' || name === 'larm' || name === 'rarm' || name === 'lleg' || name === 'rleg') return name;\n  return '';\n}\nfunction clearWounds() {\n  var limbs = ['head', 'chest', 'gut', 'larm', 'rarm', 'lleg', 'rleg'];\n  var i;\n  for (i = 0; i < limbs.length; i++) bmSet('bm_w_' + limbs[i], '');\n}\nfunction woundState(word) {\n  word = String(word || '').toLowerCase();\n  if (word === 'critically' || word === 'critical') return 'critical';\n  if (word === 'heavily' || word === 'heavy') return 'heavy';\n  if (word === 'lightly' || word === 'light') return 'light';\n  return word;\n}\nfunction applyWound(part, state) {\n  if (!part) return false;\n  state = woundState(state);\n  if (!state) return false;\n  bmSet('bm_w_' + part, state);\n  try { run_function('bm_beast', 'wound|' + part + '|' + state, 'BladeMaster Engine'); } catch (eBzW) {}\n  if ((part === 'chest' || part === 'gut') && state === 'critical') {\n    bmSet('bm_w_crit_latch', String(Date.now()));\n    try { run_function('bm_try_auto_evisc', 'track_' + part, 'BladeMaster Engine'); } catch (eAe) {}\n  }\n  refresh();\n  maybeSyncWepPoison();\n  return true;\n}\nfunction playerName() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char) {\n      if (GMCP.Char.Status && GMCP.Char.Status.name) return String(GMCP.Char.Status.name);\n      if (GMCP.Char.Name && (GMCP.Char.Name.name || typeof GMCP.Char.Name === 'string')) return String(GMCP.Char.Name.name || GMCP.Char.Name);\n    }\n    if (typeof client !== 'undefined' && client && client.gmcp && client.gmcp.Char) {\n      var C = client.gmcp.Char;\n      if (C.Status && C.Status.name) return String(C.Status.name);\n    }\n  } catch (ePn) {}\n  return '';\n}\nfunction isPlayerName(s) {\n  s = String(s || '').replace(/^\\s+|\\s+$/g, '');\n  if (!s) return false;\n  if (/^(me|self)$/i.test(s)) return true;\n  var pn = playerName();\n  return !!(pn && s.toLowerCase() === pn.toLowerCase());\n}\nfunction foeAssessWindowOpen() {\n  var until = parseFloat(get_variable('bm_assess_foe_until') || '0') || 0;\n  return until > Date.now();\n}\nfunction openFoeAssessWindow(header) {\n  var tgt = String(get_variable('bm_target') || '').replace(/^\\s+|\\s+$/g, '');\n  var consumed = String(get_variable('bm_assess_consumed_tgt') || '').replace(/^\\s+|\\s+$/g, '');\n  var low = String(header || '').toLowerCase();\n  var pn = playerName();\n  if (/\\byour\\b/i.test(header)) {\n    bmSet('bm_assess_foe_until', '0');\n    return;\n  }\n  if (pn && low.indexOf(pn.toLowerCase()) >= 0) {\n    bmSet('bm_assess_foe_until', '0');\n    return;\n  }\n  if (tgt && !isPlayerName(tgt) && low.indexOf(tgt.toLowerCase()) >= 0) {\n    bmSet('bm_assess_foe_until', String(Date.now() + 2000));\n    return;\n  }\n  if (consumed && tgt && consumed.toLowerCase() === tgt.toLowerCase() && !isPlayerName(consumed) && !isPlayerName(tgt)) {\n    bmSet('bm_assess_foe_until', String(Date.now() + 2000));\n    return;\n  }\n  bmSet('bm_assess_foe_until', '0');\n}\nfunction landClauseOwned(clause, limb) {\n  var tgt = String(get_variable('bm_target') || '').replace(/^\\s+|\\s+$/g, '');\n  var low = String(clause || '').toLowerCase();\n  if (tgt && low.indexOf(tgt.toLowerCase()) >= 0) return true;\n  var lim = String(limb || '').toLowerCase();\n  if (lim && low.indexOf(\"'s \" + lim) >= 0) return true;\n  return false;\n}\nfunction rejectPlayerHit(clause) {\n  if (/\\bacross your\\b/i.test(clause)) return true;\n  if (/\\byour\\s+(?:chest|gut|head|left arm|right arm|left leg|right leg)\\b/i.test(clause)) return true;\n  return false;\n}\nvar raw = '';\nif (typeof args === 'string') raw = args;\nelse if (args && typeof args === 'object') {\n  if (args.text) raw = String(args.text);\n  else if (args.match) raw = String(args.match);\n  else if (args[0] != null) raw = String(args[0]);\n  else raw = String(args);\n} else if (args != null) raw = String(args);\nraw = raw.replace(/\\u001b\\[[0-9;]*[a-zA-Z]/g, '');\n\nvar m, part, state, kind, cur, mx, pct, name, style, stance;\n\nm = raw.match(/^(\\w+) parries (?:the|your) attack/i);\nif (m) {\n  noteParry(m[1]);\n  return;\n}\nif (/You assess the bodily wounds as follows/i.test(raw)) {\n  openFoeAssessWindow(raw);\n  refresh();\n  maybeSyncWepPoison();\n  return;\n}\nm = raw.match(/\\*\\s*(.+?)\\s+has\\s+(\\w+)\\s+wounds/i);\nif (m) {\n  if (/^\\s*your\\b/i.test(m[1]) || !foeAssessWindowOpen()) {\n    return;\n  }\n  applyWound(normPart(m[1]), m[2]);\n  return;\n}\nif (foeAssessWindowOpen()) {\n  bmSet('bm_assess_foe_until', '0');\n}\nif (/\\bwound\\b/i.test(raw) && /\\blevel\\b/i.test(raw) && !/\\byour\\s+(?:chest|gut|head|left arm|right arm|left leg|right leg)\\b/i.test(raw)) {\n  m = raw.match(/\\b(chest|gut|head|left arm|right arm|left leg|right leg)\\b[\\s\\S]{0,80}?\\b(lightly|heavily|critically|light|heavy|critical)\\b/i);\n  if (!m) m = raw.match(/\\b(lightly|heavily|critically|light|heavy|critical)\\b[\\s\\S]{0,80}?\\b(chest|gut|head|left arm|right arm|left leg|right leg)\\b/i);\n  if (m) {\n    part = normPart(m[1]);\n    state = m[2];\n    if (!part) { part = normPart(m[2]); state = m[1]; }\n    if (applyWound(part, state)) {\n      if (/\\blunge/i.test(raw)) noteLungeLanded();\n      else noteSwingLanded(part);\n      return;\n    }\n  }\n}\nm = raw.match(/(?:You|Your)\\s+(?:slash|jab|stab|strike|lunge|swipe|run your blade|blade burrows)[^\\n\\r.]{0,240}?\\b(chest|gut|head|left arm|right arm|left leg|right leg)\\b[^\\n\\r.]{0,160}?leaving it (critically|heavily|lightly) wounded/i);\nif (m) {\n  if (rejectPlayerHit(m[0]) || !landClauseOwned(m[0], m[1])) {\n    return;\n  }\n  part = normPart(m[1]);\n  applyWound(part, m[2]);\n  if (/^You lunge powerfully at/i.test(raw)) noteLungeLanded();\n  else noteSwingLanded(part);\n  return;\n}\n// Our own base swing / lunge landing without a wound-level change: still resolves the queued swing.\nm = raw.match(/^You (swipe your blade swiftly across|lunge powerfully at)\\b[^\\n\\r]{0,200}?\\b(chest|gut|head|left arm|right arm|left leg|right leg)\\b/i);\nif (m) {\n  if (rejectPlayerHit(m[0])) return;\n  if (/^lunge/i.test(m[1])) noteLungeLanded();\n  else noteSwingLanded(normPart(m[2]));\n  return;\n}\nm = raw.match(/(health|ego|power|mana)\\s+stands at\\s+(\\d+)\\/(\\d+)/i);\nif (!m) m = raw.match(/(health|ego|power|mana)\\s+is at\\s+(\\d+)\\/(\\d+)/i);\nif (m) {\n  kind = m[1].toLowerCase();\n  cur = parseInt(m[2], 10);\n  mx = parseInt(m[3], 10);\n  pct = (mx > 0) ? String(Math.floor(100 * cur / mx)) : '';\n  if (kind === 'health') bmSet('bm_en_hp', pct);\n  else if (kind === 'ego') bmSet('bm_en_ego', pct);\n  else if (kind === 'mana') bmSet('bm_en_mana', pct);\n  else if (kind === 'power') bmSet('bm_en_power', pct);\n  refresh();\n  return;\n}\nm = raw.match(/(.+?)\\s+is fighting with\\s+(.+)\\./i);\nif (m) {\n  name = String(m[1] || '').replace(/^\\s+|\\s+$/g, '');\n  style = String(m[2] || '').replace(/^\\s+|\\s+$/g, '');\n  bmSet('bm_en_name', name);\n  bmSet('bm_en_style', style);\n  bmSet('bm_p_head', '');\n  bmSet('bm_p_chest', '');\n  bmSet('bm_p_gut', '');\n  refresh();\n  return;\n}\nm = raw.match(/stance to protect\\s+(his|her|their)\\s+(.+)\\./i);\nif (m) {\n  stance = String(m[2] || '').replace(/^\\s+|\\s+$/g, '');\n  bmSet('bm_en_stance', stance);\n  refresh();\n  return;\n}\nm = raw.match(/parrying\\s+(his|her|their)\\s+(head|chest|gut)\\s+approximately\\s+(\\d+)%/i);\nif (m) {\n  var pLimb = m[2].toLowerCase();\n  var pPct = parseInt(m[3], 10) || 0;\n  bmSet('bm_p_' + pLimb, String(pPct));\n  if (killModeOn()) evalVitalDenied(pLimb, pPct);\n  refresh();\n  maybeSyncWepPoison();\n}\n"},{"type":"function","name":"bm_kill_parry","enabled":true,"id":7,"code":"\nfunction bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nvar BM_ASSIST_ORDER = ['off','tahtetso','nekotai','blademaster','axelord','pureblade','bonecrusher'];\nvar BM_ASSIST_SHORT = { off:'Off', tahtetso:'Taht', nekotai:'Neko', blademaster:'BM', axelord:'AL', pureblade:'PB', bonecrusher:'BC' };\nvar BM_ASSIST_ALIAS = {\n  off:'off', taht:'tahtetso', tahtetso:'tahtetso',\n  neko:'nekotai', nekotai:'nekotai',\n  bm:'blademaster', blademaster:'blademaster',\n  al:'axelord', axelord:'axelord',\n  pb:'pureblade', pureblade:'pureblade',\n  bc:'bonecrusher', bonecrusher:'bonecrusher'\n};\nfunction bmAssistRecipes() {\n  return {\n    tahtetso: { left: ['tetrodin', 'crotamine', 'anatine'], right: ['crotamine', 'anatine', 'tetrodin'] },\n    nekotai: { left: ['hadrudin', 'mellitin'], right: ['mellitin', 'hadrudin'] },\n    blademaster: { left: ['senso', 'haemotox'], right: ['haemotox', 'senso'] },\n    axelord: { left: ['senso', 'dendroxin'], right: ['dendroxin', 'senso'] },\n    pureblade: { left: ['haemotox', 'senso'], right: ['senso', 'haemotox'] },\n    bonecrusher: { left: ['senso', 'haemotox'], right: ['haemotox', 'senso'] }\n  };\n}\nfunction bmAssistSpec() {\n  var raw = String(bmGet('bm_assist_spec', 'off') || 'off').toLowerCase();\n  if (BM_ASSIST_ALIAS[raw]) return BM_ASSIST_ALIAS[raw];\n  return 'off';\n}\nfunction bmAssistChipLabel() {\n  return 'Support: ' + (BM_ASSIST_SHORT[bmAssistSpec()] || 'Off');\n}\nfunction bmAssistRecipeTip() {\n  var spec = bmAssistSpec();\n  if (spec === 'tahtetso') return 'Taht: tetrodin + crotamine + anatine (steam/dust/slush). Cycle head/chest/gut. No senso/hadrudin/chansu.';\n  if (spec === 'nekotai') return 'Neko: hadrudin + mellitin. Cycle head/chest/gut. No senso/tetrodin/chansu.';\n  if (spec === 'blademaster') return 'BM: senso + haemotox (dendroxin if both vitals parried). Chest↔gut. No tetrodin/hadrudin.';\n  if (spec === 'axelord') return 'AL: senso + dendroxin. Head to heavy/C!, then chest/gut to heavy.';\n  if (spec === 'pureblade') return 'PB: haemotox + senso. Gut first, chest second. No crotamine (dust).';\n  if (spec === 'bonecrusher') return 'BC: senso + haemotox. Head first, legs second.';\n  return 'Off → Taht → Neko → BM → AL → PB → BC. Feeds that teammate wiki kill path. Forces Support role. Alias xassist.';\n}\nfunction bmAssistWoundWord(limb) {\n  return String(bmGet('bm_w_' + limb, '') || '').toLowerCase();\n}\nfunction bmAssistIsCrit(limb) { return bmAssistWoundWord(limb) === 'critical'; }\nfunction bmAssistParryHigh(limb) {\n  var th = parseInt(bmGet('bm_smart_threshold', '90'), 10);\n  if (isNaN(th)) th = 90;\n  var p = parseInt(bmGet('bm_p_' + limb, ''), 10);\n  if (isNaN(p)) return false;\n  return p >= th;\n}\nfunction bmAssistWoundRank(limb) {\n  var w = bmAssistWoundWord(limb);\n  if (w === 'critical') return 3;\n  if (w === 'heavy') return 2;\n  if (w === 'light') return 1;\n  return 0;\n}\nfunction bmAssistPickCycleVitals() {\n  var order = ['head', 'chest', 'gut'];\n  var last = String(bmGet('bm_kill_limb', '') || '');\n  var best = '', bestRank = 99, bestIdx = 99;\n  var i, limb, rank, idx, lastIdx;\n  lastIdx = order.indexOf(last);\n  for (i = 0; i < order.length; i++) {\n    limb = order[i];\n    if (bmAssistParryHigh(limb)) continue;\n    rank = bmAssistWoundRank(limb);\n    idx = (lastIdx < 0) ? i : ((i - lastIdx - 1 + order.length) % order.length);\n    if (!best || rank < bestRank || (rank === bestRank && idx < bestIdx)) {\n      best = limb;\n      bestRank = rank;\n      bestIdx = idx;\n    }\n  }\n  return best || 'head';\n}\nfunction bmAssistPickKill() {\n  var spec = bmAssistSpec();\n  if (spec === 'tahtetso' || spec === 'nekotai') return bmAssistPickCycleVitals();\n  if (spec === 'axelord') {\n    if (!bmAssistParryHigh('head') && bmAssistWoundRank('head') < 2) return 'head';\n    if (!bmAssistParryHigh('chest') && bmAssistWoundRank('chest') < 2) return 'chest';\n    if (!bmAssistParryHigh('gut') && bmAssistWoundRank('gut') < 2) return 'gut';\n    if (!bmAssistParryHigh('head')) return 'head';\n    if (!bmAssistParryHigh('chest')) return 'chest';\n    return 'gut';\n  }\n  if (spec === 'pureblade') {\n    if (!bmAssistParryHigh('gut') && !bmAssistIsCrit('gut')) return 'gut';\n    if (!bmAssistParryHigh('chest')) return 'chest';\n    return 'gut';\n  }\n  if (spec === 'bonecrusher') {\n    if (!bmAssistParryHigh('head') && !bmAssistIsCrit('head')) return 'head';\n    if (!bmAssistParryHigh('lleg') && bmAssistWoundRank('lleg') <= bmAssistWoundRank('rleg')) return 'lleg';\n    if (!bmAssistParryHigh('rleg')) return 'rleg';\n    if (!bmAssistParryHigh('lleg')) return 'lleg';\n    return 'head';\n  }\n  // Default Blademaster: sticky primary vital (wound rank, then lower effParry, then chest).\n  if (typeof resolveKillVital === 'function') return resolveKillVital();\n  if (bmAssistIsCrit('chest') || bmAssistParryHigh('chest')) return 'gut';\n  return 'chest';\n}\nfunction bmAssistSet(raw) {\n  raw = String(raw == null ? '' : raw).toLowerCase().replace(/^\\s+|\\s+$/g, '');\n  if (raw === 'show') {\n    display_notice('[BM] ' + bmAssistChipLabel() + (bmAssistSpec() === 'off' ? ' — Standard/Power poisons' : ' — ' + bmAssistRecipeTip()), 'lightgreen');\n    return bmAssistSpec();\n  }\n  var spec;\n  if (!raw || raw === 'cycle' || raw === 'next') {\n    var cur = bmAssistSpec();\n    var idx = 0;\n    var i;\n    for (i = 0; i < BM_ASSIST_ORDER.length; i++) {\n      if (BM_ASSIST_ORDER[i] === cur) { idx = i; break; }\n    }\n    spec = BM_ASSIST_ORDER[(idx + 1) % BM_ASSIST_ORDER.length];\n  } else {\n    spec = BM_ASSIST_ALIAS[raw];\n    if (!spec) {\n      display_notice('[BM] Support: use off|taht|neko|bm|al|pb|bc (or xassist).', 'yellow');\n      return bmAssistSpec();\n    }\n  }\n  var prev = bmAssistSpec();\n  if (spec !== 'off') {\n    if (prev === 'off') bmSet('bm_assist_role_saved', String(bmGet('bm_role', 'killer') || 'killer'));\n    bmSet('bm_role', 'support');\n  } else if (prev !== 'off') {\n    var saved = String(bmGet('bm_assist_role_saved', '') || '').toLowerCase();\n    if (saved === 'support' || saved === 'killer') bmSet('bm_role', saved);\n    bmSet('bm_assist_role_saved', '');\n  }\n  bmSet('bm_assist_spec', spec);\n  bmSet('bm_wep_poison_style', '');\n  try { run_function('bm_sync_wep_poison', '', 'BladeMaster Engine'); } catch (eAs) {}\n  if (spec === 'off') {\n    var roleNow = String(bmGet('bm_role', 'killer') || 'killer').toLowerCase() === 'support' ? 'Support' : 'Killer';\n    display_notice('[BM] Support: Off — Role ' + roleNow + ' restored; Standard/Power poison cycle.', 'lightgreen');\n  } else {\n    display_notice('[BM] ' + bmAssistChipLabel() + ' — Role Support (no auto evisc). ' + bmAssistRecipeTip(), 'lightgreen');\n  }\n  return spec;\n}\nfunction bmpNow() { return Date.now(); }\nfunction bmpNum(k, d) {\n  var n = parseFloat(bmGet(k, ''));\n  return isNaN(n) ? d : n;\n}\nfunction bmpJson(k, d) {\n  try {\n    var raw = bmGet(k, '');\n    if (!raw) return d;\n    var v = JSON.parse(raw);\n    if (v === null || typeof v !== 'object') return d;\n    return v;\n  } catch (eJ) { return d; }\n}\nfunction bmpIsArray(v) { return Object.prototype.toString.call(v) === '[object Array]'; }\nfunction bmpIsVital(limb) { return limb === 'head' || limb === 'chest' || limb === 'gut'; }\nfunction bmpWoundWord(limb) { return String(bmGet('bm_w_' + limb, '') || '').toLowerCase(); }\nfunction bmpWoundRank(limb) {\n  var w = bmpWoundWord(limb);\n  if (w === 'critical') return 3;\n  if (w === 'heavy') return 2;\n  if (w === 'light') return 1;\n  return 0;\n}\nfunction bmpAssayPct(limb) {\n  var p = parseInt(bmGet('bm_p_' + limb, ''), 10);\n  return isNaN(p) ? null : p;\n}\nfunction bmpThreshold() {\n  var th = parseInt(bmGet('bm_smart_threshold', '90'), 10);\n  return isNaN(th) ? 90 : th;\n}\nfunction bmpStanceCoversVitals() {\n  return String(bmGet('bm_en_stance', '') || '').toLowerCase().indexOf('vital') >= 0;\n}\nfunction bmpEvidenceMs() { return bmpNum('bm_parry_evidence_sec', 20) * 1000; }\nfunction bmpParryPolicy() {\n  var p = String(bmGet('bm_parry_policy', 'vital') || 'vital').toLowerCase();\n  return p === 'bait' ? 'bait' : 'vital';\n}\nfunction bmpSplitMax() {\n  var n = parseInt(bmGet('bm_split_max_volleys', '4'), 10);\n  return (isNaN(n) || n < 1) ? 4 : n;\n}\nfunction bmParsePowerVal(raw) {\n  if (raw == null || raw === '') return NaN;\n  if (typeof raw === 'number') return raw;\n  var s = String(raw).replace(/^\\s+|\\s+$/g, '');\n  var slash = s.indexOf('/');\n  if (slash >= 0) s = s.substring(0, slash);\n  return parseFloat(s);\n}\nfunction bmGetPower() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Vitals) {\n      var v = GMCP.Char.Vitals;\n      var keys = ['power', 'pow', 'p', 'stars'];\n      var i, p;\n      for (i = 0; i < keys.length; i++) {\n        p = bmParsePowerVal(v[keys[i]]);\n        if (!isNaN(p)) return p;\n      }\n    }\n  } catch (eP) {}\n  return null;\n}\nfunction bmEviscReserve() {\n  var reserve = 5;\n  var candy = bmBool('pEviscLollyPrep') || bmBool('evisc_candy');\n  var wbRaw = get_variable('evisc_combo_weakblood');\n  var wb;\n  if (wbRaw === undefined || wbRaw === null || wbRaw === '') {\n    wb = candy;\n  } else {\n    wb = bmBool('evisc_combo_weakblood');\n  }\n  if (candy && wb) reserve += 3;\n  if (bmBool('bm_pre_evisc_blade')) reserve += 3;\n  return reserve;\n}\n// 0..2 lunge hands from spare power above the evisc reserve. Unknown power -> 0 (never guess).\nfunction lungeBudgetHands() {\n  var power = bmGetPower();\n  if (power === null) return 0;\n  var n = Math.floor((power - bmEviscReserve()) / 2);\n  if (n < 0) n = 0;\n  if (n > 2) n = 2;\n  return n;\n}\n// --- live parry ring (BM_CombatTracker) ---\nfunction bmpLiveRing(limb) {\n  var list = bmpJson('bm_live_parry_' + limb, []);\n  if (!bmpIsArray(list)) list = [];\n  var cutoff = bmpNow() - bmpEvidenceMs();\n  var out = [], i;\n  for (i = 0; i < list.length; i++) {\n    if (list[i] && (parseFloat(list[i].t) || 0) >= cutoff) out.push(list[i]);\n  }\n  return out;\n}\nfunction bmpLiveCounts(limb) {\n  var list = bmpLiveRing(limb);\n  var parried = 0, i;\n  for (i = 0; i < list.length; i++) if (list[i].p) parried++;\n  return { parried: parried, total: list.length };\n}\nfunction bmpLiveRate(limb) {\n  var c = bmpLiveCounts(limb);\n  if (!c.total) return null;\n  return c.parried / c.total;\n}\nfunction bmpLiveLandedStreak(limb) {\n  var list = bmpLiveRing(limb);\n  var streak = 0, i;\n  for (i = list.length - 1; i >= 0; i--) {\n    if (list[i].p) break;\n    streak++;\n  }\n  return streak;\n}\nfunction bmpPushLiveOutcome(limb, parried) {\n  var list = bmpLiveRing(limb);\n  list.push({ p: parried ? 1 : 0, t: bmpNow() });\n  while (list.length > 6) list.shift();\n  bmSet('bm_live_parry_' + limb, JSON.stringify(list));\n  if (parried) bmSet('bm_live_parry_last_at', String(bmpNow()));\n}\nfunction liveParrySeenSince(t) {\n  var last = parseFloat(bmGet('bm_live_parry_last_at', '0')) || 0;\n  return last > 0 && last >= (parseFloat(t) || 0);\n}\n// --- swing queue (written by sendDual, resolved by bm_track) ---\nfunction bmpSwingQueue() {\n  var q = bmpJson('bm_swing_queue', []);\n  if (!bmpIsArray(q)) q = [];\n  var cutoff = bmpNow() - 6000;\n  var out = [], i;\n  for (i = 0; i < q.length; i++) {\n    if (q[i] && (parseFloat(q[i].t) || 0) >= cutoff) out.push(q[i]);\n  }\n  return out;\n}\nfunction bmpSaveSwingQueue(q) { bmSet('bm_swing_queue', JSON.stringify(q || [])); }\nfunction queueSwings(intents) {\n  var q = bmpSwingQueue();\n  var now = bmpNow();\n  var i, it;\n  for (i = 0; i < (intents || []).length; i++) {\n    it = intents[i];\n    if (!it || !it.limb) continue;\n    q.push({ hand: it.hand || '', limb: String(it.limb).toLowerCase(), lunge: it.lunge ? 1 : 0, t: now, r: 0, rt: 0 });\n  }\n  while (q.length > 8) q.shift();\n  bmpSaveSwingQueue(q);\n}\nfunction bmpNextUnresolved(q, lungeOnly) {\n  var i;\n  for (i = 0; i < q.length; i++) {\n    if (q[i] && !q[i].r && (!!q[i].lunge) === (!!lungeOnly)) return q[i];\n  }\n  return null;\n}\n// --- effective parry + hysteresis denial (BM_CombatEngine) ---\nfunction effParry(limb) {\n  if (!bmpIsVital(limb)) return 0;\n  if (bmpStanceCoversVitals()) return 100;\n  var pct = bmpAssayPct(limb);\n  if (pct === null) pct = 0;\n  var live = bmpLiveRate(limb);\n  if (live !== null && live * 100 > pct) pct = live * 100;\n  if (pct < 0) pct = 0;\n  if (pct > 100) pct = 100;\n  return pct;\n}\nfunction bmpDenState(limb) {\n  var st = bmpJson('bm_parry_den_' + limb, null);\n  if (!st) st = {};\n  st.denied = !!st.denied;\n  if (!bmpIsArray(st.pts)) st.pts = [];\n  st.liveBase = parseFloat(st.liveBase) || 0;\n  st.reason = String(st.reason || '');\n  st.since = parseFloat(st.since) || 0;\n  st.assayFresh = !!st.assayFresh;\n  if (st.lastAssay === undefined) st.lastAssay = null;\n  st.points = parseFloat(st.points) || 0;\n  return st;\n}\nfunction bmpSaveDenState(limb, st) { bmSet('bm_parry_den_' + limb, JSON.stringify(st)); }\nfunction isVitalDenied(limb) {\n  if (!bmpIsVital(limb)) return false;\n  if (bmpStanceCoversVitals()) return true;\n  return bmpDenState(limb).denied === true;\n}\n// Any limb: vitals = hysteresis OR raw assay >= threshold; arms/legs from the foe stance.\nfunction isLimbDenied(limb) {\n  if (!limb) return false;\n  if (bmpIsVital(limb)) {\n    if (isVitalDenied(limb)) return true;\n    var p = bmpAssayPct(limb);\n    return p !== null && p >= bmpThreshold();\n  }\n  var s = String(bmGet('bm_en_stance', '') || '').toLowerCase();\n  if ((limb === 'lleg' || limb === 'rleg') && s.indexOf('leg') >= 0) return true;\n  if ((limb === 'larm' || limb === 'rarm') && s.indexOf('arm') >= 0) return true;\n  return false;\n}\n// Hysteresis: assayPct (optional) is a NEW reading -> 1 point when >= threshold; live parries\n// add points via the ring. Enter denied at >= confirm points (or stance); leave on a fresh assay\n// below release or 2 consecutive landed swings. Banners only on change. Returns denied.\nfunction evalVitalDenied(limb, assayPct) {\n  if (!bmpIsVital(limb)) return false;\n  var st = bmpDenState(limb);\n  var now = bmpNow();\n  var win = bmpEvidenceMs();\n  var th = bmpThreshold();\n  if (assayPct !== undefined && assayPct !== null && !isNaN(assayPct)) {\n    st.lastAssay = assayPct;\n    st.assayFresh = true;\n    if (assayPct >= th) st.pts.push(now);\n  }\n  var kept = [], i;\n  for (i = 0; i < st.pts.length; i++) {\n    if ((now - (parseFloat(st.pts[i]) || 0)) <= win) kept.push(st.pts[i]);\n  }\n  st.pts = kept;\n  var liveRaw = bmpLiveCounts(limb).parried;\n  if (liveRaw < st.liveBase) st.liveBase = liveRaw;\n  var livePts = liveRaw - st.liveBase;\n  st.points = kept.length + livePts;\n  var pct = bmpAssayPct(limb);\n  var release = bmpNum('bm_parry_release', 70);\n  var need = parseInt(bmGet('bm_parry_confirm_points', '2'), 10);\n  if (isNaN(need) || need < 1) need = 2;\n  var streak = bmpLiveLandedStreak(limb);\n  var wasDenied = st.denied;\n  var nowDenied = wasDenied;\n  var reason = st.reason;\n  function evidenceReason() {\n    if (kept.length > 0 && livePts > 0) return 'assay+live';\n    return kept.length > 0 ? 'assay' : 'live';\n  }\n  if (bmpStanceCoversVitals()) {\n    nowDenied = true;\n    reason = 'stance';\n  } else if (wasDenied && st.reason === 'stance') {\n    if (st.points >= need) {\n      reason = evidenceReason();\n      st.reason = reason;\n    } else {\n      nowDenied = false;\n      reason = 'stance dropped';\n    }\n  } else if (wasDenied) {\n    if (pct !== null && pct < release && st.assayFresh) {\n      nowDenied = false;\n      reason = 'assay ' + pct + '%';\n    } else if (streak >= 2) {\n      nowDenied = false;\n      reason = 'landed x' + streak;\n    }\n  } else if (st.points >= need) {\n    nowDenied = true;\n    reason = evidenceReason();\n  }\n  if (nowDenied !== wasDenied) {\n    st.denied = nowDenied;\n    st.reason = reason;\n    st.since = now;\n    bmSet('bm_parry_flip', '1');\n    var eff = Math.round(effParry(limb));\n    if (nowDenied) {\n      st.assayFresh = false;\n      if (limb !== 'head') display_notice('[BM] PARRY CONFIRMED — ' + limb.toUpperCase() + ' ' + eff + '% (' + reason + ')', 'orange');\n    } else {\n      st.pts = [];\n      st.liveBase = liveRaw;\n      st.points = 0;\n      if (limb !== 'head') display_notice('[BM] PARRY RELEASED — ' + limb.toUpperCase() + ' ' + eff + '% (' + reason + ')', 'orange');\n    }\n  } else if (nowDenied && reason === 'stance' && st.reason !== 'stance') {\n    st.reason = 'stance';\n  }\n  bmpSaveDenState(limb, st);\n  return st.denied === true;\n}\n// Phase: kill | split (both vitals denied) | fallback (split cap reached). Default spec only.\nfunction bmRefreshKillPhase() {\n  var prev = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var chestD = isVitalDenied('chest');\n  var gutD = isVitalDenied('gut');\n  var splitN = parseInt(bmGet('bm_split_volleys', '0'), 10) || 0;\n  var maxSplit = bmpSplitMax();\n  var wasChest = String(bmGet('bm_parry_was_chest', '') || '') === '1';\n  var wasGut = String(bmGet('bm_parry_was_gut', '') || '') === '1';\n  if (chestD && gutD) {\n    if (prev === 'fallback') {\n      // stay\n    } else if (prev === 'split') {\n      if (splitN >= maxSplit) {\n        bmSet('bm_kill_phase', 'fallback');\n        bmSet('bm_fallback_leg', '');\n        display_notice('[BM] FALLBACK — legs: split ' + splitN + '/' + maxSplit + ' with no release — both hands on one leg → legtendon → prone → haymaker', 'orange');\n      }\n    } else {\n      bmSet('bm_kill_phase', 'split');\n      bmSet('bm_split_volleys', '0');\n      display_notice('[BM] SPLIT MODE — bait parry off vitals', 'orange');\n    }\n  } else {\n    if (prev === 'split' || prev === 'fallback') {\n      if (!chestD && !gutD) display_notice('[BM] BAIT SUCCESS — vitals open', 'orange');\n      else if (wasChest && !chestD) display_notice('[BM] BAIT SUCCESS — chest parry dropped', 'orange');\n      else if (wasGut && !gutD) display_notice('[BM] BAIT SUCCESS — gut parry dropped', 'orange');\n    }\n    bmSet('bm_kill_phase', 'kill');\n    bmSet('bm_split_volleys', '0');\n    bmSet('bm_fallback_leg', '');\n  }\n  bmSet('bm_parry_was_chest', chestD ? '1' : '0');\n  bmSet('bm_parry_was_gut', gutD ? '1' : '0');\n}\n// Primary vital: higher wound rank; tie -> lower effParry; tie -> chest. Parry never moves it.\nfunction pickKillModeVital() {\n  var wc = bmpWoundRank('chest');\n  var wg = bmpWoundRank('gut');\n  if (wg > wc) return 'gut';\n  if (wc > wg) return 'chest';\n  if (effParry('gut') < effParry('chest')) return 'gut';\n  return 'chest';\n}\nfunction resolveKillVital() {\n  var primary = pickKillModeVital();\n  var secondary = (primary === 'chest') ? 'gut' : 'chest';\n  var wp = bmpWoundRank(primary);\n  var ws = bmpWoundRank(secondary);\n  var reason;\n  if (wp > ws) reason = 'wounds ' + wp + ' > ' + ws;\n  else if (effParry(primary) < effParry(secondary)) reason = 'wounds tie, parry ' + Math.round(effParry(primary)) + '% < ' + Math.round(effParry(secondary)) + '%';\n  else reason = 'wounds tie, chest default';\n  if (isVitalDenied(primary)) reason += ' (denied)';\n  bmSet('bm_kill_vital_lock', JSON.stringify({ limb: primary, reason: reason }));\n  return primary;\n}\n// --- bait / leg helpers (tiers map onto MOD via strikeCmd: light=pierce*, crit=legtendon) ---\nfunction baitTier(limb) { return bmpWoundRank(limb) >= 1 ? 'light' : 'base'; }\nfunction pickBaitArm(volley) {\n  var lOk = !isLimbDenied('larm');\n  var rOk = !isLimbDenied('rarm');\n  if (lOk && !rOk) return 'larm';\n  if (rOk && !lOk) return 'rarm';\n  if (!lOk && !rOk) return '';\n  var wl = bmpWoundRank('larm');\n  var wr = bmpWoundRank('rarm');\n  if (wl > wr) return 'larm';\n  if (wr > wl) return 'rarm';\n  return (((parseInt(volley, 10) || 0) % 2) === 0) ? 'larm' : 'rarm';\n}\nfunction pickBaitLeg() {\n  var lOk = !isLimbDenied('lleg');\n  var rOk = !isLimbDenied('rleg');\n  if (lOk && !rOk) return 'lleg';\n  if (rOk && !lOk) return 'rleg';\n  if (!lOk && !rOk) return '';\n  if (bmpWoundRank('rleg') > bmpWoundRank('lleg')) return 'rleg';\n  return 'lleg';\n}\nfunction pickFallbackLeg() {\n  var cur = String(bmGet('bm_fallback_leg', '') || '');\n  if ((cur === 'lleg' || cur === 'rleg') && !isLimbDenied(cur)) return cur;\n  var lOk = !isLimbDenied('lleg');\n  var rOk = !isLimbDenied('rleg');\n  var pick;\n  if (lOk && !rOk) pick = 'lleg';\n  else if (rOk && !lOk) pick = 'rleg';\n  else pick = (bmpWoundRank('rleg') < bmpWoundRank('lleg')) ? 'rleg' : 'lleg';\n  bmSet('bm_fallback_leg', pick);\n  return pick;\n}\nfunction legBaitTier(leg, allowCrit) {\n  var w = bmpWoundRank(leg);\n  if (allowCrit && w >= 3) return 'crit';\n  if (w >= 1) return 'light';\n  return 'base';\n}\n// Kill volley plan for the default spec (mirror of Lua planKillVolley). Pure: safe per tick.\nfunction bmPlanKillVolley(tgt) {\n  var primary = resolveKillVital();\n  var secondary = (primary === 'chest') ? 'gut' : 'chest';\n  var volley = (parseInt(bmGet('bm_kill_volley', '0'), 10) || 0) + 1;\n  var plan = {\n    killBody: primary, killTier: 'base', killLunge: false,\n    hinderBody: primary, hinderTier: 'base', hinderLunge: false,\n    primary: primary, secondary: secondary, budget: 0, note: '', noteMid: '',\n    vitalLunge: false, bait: false\n  };\n  var phase = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var pDenied = isVitalDenied(primary);\n  var sDenied = isVitalDenied(secondary);\n  var budget = lungeBudgetHands();\n  var power = bmGetPower();\n  var reserve = bmEviscReserve();\n  plan.budget = budget;\n  var powStr = '(power ' + (power === null ? '?' : power) + ', reserve ' + reserve + ')';\n  function woundStr(limb) { return bmpWoundWord(limb) || 'no wounds'; }\n  function baitArmHinder() {\n    var arm = pickBaitArm(volley);\n    if (!arm) {\n      if (!isLimbDenied('head')) {\n        plan.hinderBody = 'head';\n        plan.hinderTier = baitTier('head');\n        return;\n      }\n      var leg = pickBaitLeg() || 'lleg';\n      plan.hinderBody = leg;\n      plan.hinderTier = legBaitTier(leg, false);\n      return;\n    }\n    plan.hinderBody = arm;\n    plan.hinderTier = baitTier(arm);\n  }\n  if (!pDenied) return plan;\n  if (budget >= 2) {\n    plan.killLunge = true;\n    plan.hinderLunge = true;\n    plan.vitalLunge = true;\n    plan.note = 'LUNGE THROUGH PARRY — ' + primary.toUpperCase() + ' x2';\n    plan.noteMid = powStr;\n    return plan;\n  }\n  if (budget === 1) {\n    plan.killLunge = true;\n    plan.vitalLunge = true;\n    if (!sDenied) {\n      plan.hinderBody = secondary;\n      plan.hinderTier = 'base';\n    } else {\n      baitArmHinder();\n    }\n    plan.note = 'LUNGE THROUGH PARRY — ' + primary.toUpperCase() + ' x1';\n    plan.noteMid = powStr + (sDenied ? ' · hinder baits ' + String(plan.hinderBody).toUpperCase() : ' · hinder ' + secondary.toUpperCase());\n    return plan;\n  }\n  if (phase === 'fallback') {\n    var fleg = pickFallbackLeg() || 'lleg';\n    plan.killBody = fleg;\n    plan.killTier = (bmpWoundRank(fleg) >= 3) ? 'crit' : 'base';\n    plan.hinderBody = fleg;\n    plan.hinderTier = legBaitTier(fleg, true);\n    plan.bait = true;\n    plan.note = 'FALLBACK — legs';\n    plan.noteMid = fleg.toUpperCase() + ' ' + woundStr(fleg);\n    return plan;\n  }\n  if (!sDenied) {\n    var needPower = reserve + 2;\n    plan.killBody = secondary;\n    plan.killTier = 'base';\n    if (bmpParryPolicy() === 'bait') {\n      baitArmHinder();\n      plan.noteMid = 'bait ' + String(plan.hinderBody).toUpperCase();\n    } else {\n      plan.hinderBody = secondary;\n      plan.hinderTier = 'base';\n      plan.noteMid = powStr;\n    }\n    plan.note = 'HOLD ' + primary.toUpperCase() + ' ' + bmpWoundWord(primary) + ' — building ' + secondary.toUpperCase() + ' until power >= ' + needPower;\n    return plan;\n  }\n  // Both vitals denied, no lunge budget: split bait. Never base into a denied vital.\n  baitArmHinder();\n  var bleg = pickBaitLeg();\n  if (bleg) {\n    plan.killBody = bleg;\n    plan.killTier = legBaitTier(bleg, false);\n  } else if (plan.hinderBody !== 'head' && !isLimbDenied('head')) {\n    plan.killBody = 'head';\n    plan.killTier = 'base';\n  } else {\n    plan.killBody = (plan.hinderBody === 'larm') ? 'rarm' : 'larm';\n    plan.killTier = 'base';\n  }\n  plan.bait = true;\n  plan.note = 'SPLIT ' + ((parseInt(bmGet('bm_split_volleys', '0'), 10) || 0) + 1) + '/' + bmpSplitMax();\n  plan.noteMid = 'hinder ' + String(plan.hinderBody).toUpperCase() + ' · kill hand ' + String(plan.killBody).toUpperCase();\n  return plan;\n}\n// Plain-text status (Offence tab block, xkillmode status, xkillparry).\nfunction killModeStatusLines() {\n  var lines = [];\n  var assist = 'off';\n  try { if (typeof bmAssistSpec === 'function') assist = bmAssistSpec(); } catch (eA) {}\n  if (assist === 'off') resolveKillVital();\n  var lock = bmpJson('bm_kill_vital_lock', {});\n  var primary = String(lock.limb || bmGet('bm_kill_limb', 'chest') || 'chest');\n  lines.push('primary ' + primary.toUpperCase() + ' (' + (bmpWoundWord(primary) || 'no wounds') + ') — ' + (lock.reason || '?'));\n  var vitals = ['chest', 'gut'], i, limb, ap, c, st, denied;\n  for (i = 0; i < vitals.length; i++) {\n    limb = vitals[i];\n    ap = bmpAssayPct(limb);\n    c = bmpLiveCounts(limb);\n    st = bmpDenState(limb);\n    denied = isVitalDenied(limb);\n    lines.push(limb.toUpperCase() + ' ' + Math.round(effParry(limb)) + '% (assay ' + (ap === null ? '?' : ap + '%') + ', live ' + c.parried + '/' + c.total + ', pts ' + st.points + ')' +\n      (denied ? ' DENIED' + (st.reason ? ' [' + st.reason + ']' : '') : ''));\n  }\n  var power = bmGetPower();\n  lines.push('lunge: power ' + (power === null ? '?' : power) + ' / reserve ' + bmEviscReserve() + ' -> ' + lungeBudgetHands() + ' hand(s)');\n  var phase = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var phaseLine = 'phase ' + phase;\n  if (phase === 'split' || phase === 'fallback') phaseLine += '  split ' + (parseInt(bmGet('bm_split_volleys', '0'), 10) || 0) + '/' + bmpSplitMax();\n  if (phase === 'fallback' && bmGet('bm_fallback_leg', '')) phaseLine += '  leg ' + String(bmGet('bm_fallback_leg', '')).toUpperCase();\n  phaseLine += '  policy ' + bmpParryPolicy();\n  lines.push(phaseLine);\n  var proneRaw = String(bmGet('bm_en_prone', '') || '');\n  if (!proneRaw) lines.push('prone: unknown');\n  else lines.push('prone: ' + (bmBool('bm_en_prone') ? 'yes' : 'no'));\n  return lines;\n}\n// Target change / KillMode ON: forget parry evidence, queue, lock, phase counters.\nfunction resetParryState() {\n  var limbs = ['head', 'chest', 'gut', 'larm', 'rarm', 'lleg', 'rleg'], i;\n  for (i = 0; i < limbs.length; i++) bmSet('bm_live_parry_' + limbs[i], '');\n  bmSet('bm_parry_den_head', '');\n  bmSet('bm_parry_den_chest', '');\n  bmSet('bm_parry_den_gut', '');\n  bmSet('bm_swing_queue', '');\n  bmSet('bm_live_parry_last_at', '0');\n  bmSet('bm_kill_last_volley_at', '0');\n  bmSet('bm_kill_vital_lock', '');\n  bmSet('bm_split_volleys', '0');\n  bmSet('bm_fallback_leg', '');\n  bmSet('bm_parry_flip', '0');\n  bmSet('bm_parry_was_chest', '');\n  bmSet('bm_parry_was_gut', '');\n  bmSet('bm_kill_phase', 'kill');\n}function statusOut() {\n  var lines = killModeStatusLines();\n  var i;\n  for (i = 0; i < lines.length; i++) display_notice('[BM]   ' + lines[i], 'lightgreen');\n}\nvar op = '';\nif (typeof args === 'string') op = args;\nelse if (args && typeof args === 'object') {\n  if (args.text) op = String(args.text);\n  else if (args[0] != null) op = String(args[0]);\n}\nop = String(op || '').toLowerCase().replace(/^\\s+|\\s+$/g, '').replace(/\\s+/g, ' ');\nvar parts = op ? op.split(' ') : [];\nvar key = parts[0] || '';\nvar val = parts[1] || '';\n\nif (key === 'reset') {\n  bmSet('bm_opener_done', '0');\n  bmSet('bm_opener_inflight', '0');\n  bmSet('bm_opener_sent_at', '0');\n  bmSet('bm_opener_arm_down', '0');\n  bmSet('bm_arm_spent_left', '');\n  bmSet('bm_arm_spent_right', '');\n  resetParryState();\n  return;\n}\nif (key === 'status') {\n  display_notice('[BM] Kill mode ' + (bmBool('bm_killmode') ? 'ON' : 'OFF') + ' — target ' + (bmGet('bm_target', '') || '(none)') + ' — kill ' + String(bmGet('bm_kill_limb', 'chest')).toUpperCase() + ' / hinder ' + String(bmGet('bm_hinder_limb', 'larm')).toUpperCase() + ' — ' + (bmGet('bm_last_action', '') || 'idle'), 'lightgreen');\n  statusOut();\n  return;\n}\nif (key === '' || key === 'show') {\n  display_notice('[BM] Parry tuning: watch=' + bmGet('bm_parry_watch', '50') + ' release=' + bmGet('bm_parry_release', '70') + ' points=' + bmGet('bm_parry_confirm_points', '2') + ' window=' + bmGet('bm_parry_evidence_sec', '20') + 's splitmax=' + bmGet('bm_split_max_volleys', '4') + ' policy=' + bmpParryPolicy(), 'lightgreen');\n  statusOut();\n  return;\n}\nif (key === 'policy') {\n  if (val !== 'vital' && val !== 'bait') { display_notice('[BM] xkillparry policy vital|bait', 'red'); return; }\n  bmSet('bm_parry_policy', val);\n  display_notice('[BM] Parry policy ' + val + (val === 'bait' ? ' (kill hand on open vital, hinder baits)' : ' (both hands on open vital)'), 'lightgreen');\n  return;\n}\nvar n = parseFloat(val);\nif (isNaN(n)) { display_notice('[BM] xkillparry watch|release|points|window|splitmax N — or policy vital|bait', 'red'); return; }\nif (key === 'watch' && n >= 0 && n <= 100) bmSet('bm_parry_watch', n);\nelse if (key === 'release' && n >= 0 && n <= 100) bmSet('bm_parry_release', n);\nelse if (key === 'points' && n >= 1 && n <= 10) bmSet('bm_parry_confirm_points', Math.floor(n));\nelse if (key === 'window' && n >= 5 && n <= 120) bmSet('bm_parry_evidence_sec', n);\nelse if (key === 'splitmax' && n >= 1 && n <= 20) bmSet('bm_split_max_volleys', Math.floor(n));\nelse { display_notice('[BM] xkillparry: watch/release 0-100, points 1-10, window 5-120, splitmax 1-20', 'red'); return; }\ndisplay_notice('[BM] Parry tuning ' + key + ' = ' + n, 'lightgreen');\ntry { run_function('bm_tabs', '', 'BladeMaster Engine'); } catch (eT) {}\n"},{"type":"function","name":"bm_sync_wep_poison","enabled":true,"id":8,"code":"\nfunction bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nfunction bmPsnmSideHas(list) {\n  if (!list) return false;\n  if (Object.prototype.toString.call(list) === '[object Array]') return list.length > 0;\n  return String(list).trim() !== '';\n}\nfunction bmPsnmCustomFilled() {\n  var keys = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\n  var custom = {};\n  try { custom = JSON.parse(String(bmGet('psnm_custom', '{}') || '{}')); } catch (eC) { custom = {}; }\n  if (!custom || typeof custom !== 'object') custom = {};\n  var out = [];\n  var i, k, p, name;\n  for (i = 0; i < keys.length; i++) {\n    k = keys[i];\n    p = custom[k];\n    if (!p || typeof p !== 'object') continue;\n    if (!bmPsnmSideHas(p.left) && !bmPsnmSideHas(p.right)) continue;\n    name = String(p.name || '').trim();\n    if (!name) name = 'Profile ' + k.replace('profile', '');\n    out.push({ key: k, name: name });\n  }\n  return out;\n}\nfunction bmPoisonRotationKeys() {\n  var list = ['standard', 'power'];\n  var filled = bmPsnmCustomFilled();\n  var i;\n  for (i = 0; i < filled.length; i++) list.push(filled[i].key);\n  return list;\n}\nfunction bmNormalizePoisonMode() {\n  var mode = String(bmGet('bm_poison_mode', 'standard') || 'standard').toLowerCase();\n  if (mode === 'standard' || mode === 'power') return mode;\n  var filled = bmPsnmCustomFilled();\n  var i;\n  for (i = 0; i < filled.length; i++) {\n    if (filled[i].key === mode) return mode;\n  }\n  bmSet('bm_poison_mode', 'standard');\n  return 'standard';\n}\nfunction bmPoisonModeLabel(mode) {\n  mode = String(mode || 'standard').toLowerCase();\n  if (mode === 'power') return 'Power';\n  if (mode === 'standard') return 'Standard';\n  var filled = bmPsnmCustomFilled();\n  var i;\n  for (i = 0; i < filled.length; i++) {\n    if (filled[i].key === mode) return filled[i].name;\n  }\n  return 'Standard';\n}\nvar BM_ASSIST_ORDER = ['off','tahtetso','nekotai','blademaster','axelord','pureblade','bonecrusher'];\nvar BM_ASSIST_SHORT = { off:'Off', tahtetso:'Taht', nekotai:'Neko', blademaster:'BM', axelord:'AL', pureblade:'PB', bonecrusher:'BC' };\nvar BM_ASSIST_ALIAS = {\n  off:'off', taht:'tahtetso', tahtetso:'tahtetso',\n  neko:'nekotai', nekotai:'nekotai',\n  bm:'blademaster', blademaster:'blademaster',\n  al:'axelord', axelord:'axelord',\n  pb:'pureblade', pureblade:'pureblade',\n  bc:'bonecrusher', bonecrusher:'bonecrusher'\n};\nfunction bmAssistRecipes() {\n  return {\n    tahtetso: { left: ['tetrodin', 'crotamine', 'anatine'], right: ['crotamine', 'anatine', 'tetrodin'] },\n    nekotai: { left: ['hadrudin', 'mellitin'], right: ['mellitin', 'hadrudin'] },\n    blademaster: { left: ['senso', 'haemotox'], right: ['haemotox', 'senso'] },\n    axelord: { left: ['senso', 'dendroxin'], right: ['dendroxin', 'senso'] },\n    pureblade: { left: ['haemotox', 'senso'], right: ['senso', 'haemotox'] },\n    bonecrusher: { left: ['senso', 'haemotox'], right: ['haemotox', 'senso'] }\n  };\n}\nfunction bmAssistSpec() {\n  var raw = String(bmGet('bm_assist_spec', 'off') || 'off').toLowerCase();\n  if (BM_ASSIST_ALIAS[raw]) return BM_ASSIST_ALIAS[raw];\n  return 'off';\n}\nfunction bmAssistChipLabel() {\n  return 'Support: ' + (BM_ASSIST_SHORT[bmAssistSpec()] || 'Off');\n}\nfunction bmAssistRecipeTip() {\n  var spec = bmAssistSpec();\n  if (spec === 'tahtetso') return 'Taht: tetrodin + crotamine + anatine (steam/dust/slush). Cycle head/chest/gut. No senso/hadrudin/chansu.';\n  if (spec === 'nekotai') return 'Neko: hadrudin + mellitin. Cycle head/chest/gut. No senso/tetrodin/chansu.';\n  if (spec === 'blademaster') return 'BM: senso + haemotox (dendroxin if both vitals parried). Chest↔gut. No tetrodin/hadrudin.';\n  if (spec === 'axelord') return 'AL: senso + dendroxin. Head to heavy/C!, then chest/gut to heavy.';\n  if (spec === 'pureblade') return 'PB: haemotox + senso. Gut first, chest second. No crotamine (dust).';\n  if (spec === 'bonecrusher') return 'BC: senso + haemotox. Head first, legs second.';\n  return 'Off → Taht → Neko → BM → AL → PB → BC. Feeds that teammate wiki kill path. Forces Support role. Alias xassist.';\n}\nfunction bmAssistWoundWord(limb) {\n  return String(bmGet('bm_w_' + limb, '') || '').toLowerCase();\n}\nfunction bmAssistIsCrit(limb) { return bmAssistWoundWord(limb) === 'critical'; }\nfunction bmAssistParryHigh(limb) {\n  var th = parseInt(bmGet('bm_smart_threshold', '90'), 10);\n  if (isNaN(th)) th = 90;\n  var p = parseInt(bmGet('bm_p_' + limb, ''), 10);\n  if (isNaN(p)) return false;\n  return p >= th;\n}\nfunction bmAssistWoundRank(limb) {\n  var w = bmAssistWoundWord(limb);\n  if (w === 'critical') return 3;\n  if (w === 'heavy') return 2;\n  if (w === 'light') return 1;\n  return 0;\n}\nfunction bmAssistPickCycleVitals() {\n  var order = ['head', 'chest', 'gut'];\n  var last = String(bmGet('bm_kill_limb', '') || '');\n  var best = '', bestRank = 99, bestIdx = 99;\n  var i, limb, rank, idx, lastIdx;\n  lastIdx = order.indexOf(last);\n  for (i = 0; i < order.length; i++) {\n    limb = order[i];\n    if (bmAssistParryHigh(limb)) continue;\n    rank = bmAssistWoundRank(limb);\n    idx = (lastIdx < 0) ? i : ((i - lastIdx - 1 + order.length) % order.length);\n    if (!best || rank < bestRank || (rank === bestRank && idx < bestIdx)) {\n      best = limb;\n      bestRank = rank;\n      bestIdx = idx;\n    }\n  }\n  return best || 'head';\n}\nfunction bmAssistPickKill() {\n  var spec = bmAssistSpec();\n  if (spec === 'tahtetso' || spec === 'nekotai') return bmAssistPickCycleVitals();\n  if (spec === 'axelord') {\n    if (!bmAssistParryHigh('head') && bmAssistWoundRank('head') < 2) return 'head';\n    if (!bmAssistParryHigh('chest') && bmAssistWoundRank('chest') < 2) return 'chest';\n    if (!bmAssistParryHigh('gut') && bmAssistWoundRank('gut') < 2) return 'gut';\n    if (!bmAssistParryHigh('head')) return 'head';\n    if (!bmAssistParryHigh('chest')) return 'chest';\n    return 'gut';\n  }\n  if (spec === 'pureblade') {\n    if (!bmAssistParryHigh('gut') && !bmAssistIsCrit('gut')) return 'gut';\n    if (!bmAssistParryHigh('chest')) return 'chest';\n    return 'gut';\n  }\n  if (spec === 'bonecrusher') {\n    if (!bmAssistParryHigh('head') && !bmAssistIsCrit('head')) return 'head';\n    if (!bmAssistParryHigh('lleg') && bmAssistWoundRank('lleg') <= bmAssistWoundRank('rleg')) return 'lleg';\n    if (!bmAssistParryHigh('rleg')) return 'rleg';\n    if (!bmAssistParryHigh('lleg')) return 'lleg';\n    return 'head';\n  }\n  // Default Blademaster: sticky primary vital (wound rank, then lower effParry, then chest).\n  if (typeof resolveKillVital === 'function') return resolveKillVital();\n  if (bmAssistIsCrit('chest') || bmAssistParryHigh('chest')) return 'gut';\n  return 'chest';\n}\nfunction bmAssistSet(raw) {\n  raw = String(raw == null ? '' : raw).toLowerCase().replace(/^\\s+|\\s+$/g, '');\n  if (raw === 'show') {\n    display_notice('[BM] ' + bmAssistChipLabel() + (bmAssistSpec() === 'off' ? ' — Standard/Power poisons' : ' — ' + bmAssistRecipeTip()), 'lightgreen');\n    return bmAssistSpec();\n  }\n  var spec;\n  if (!raw || raw === 'cycle' || raw === 'next') {\n    var cur = bmAssistSpec();\n    var idx = 0;\n    var i;\n    for (i = 0; i < BM_ASSIST_ORDER.length; i++) {\n      if (BM_ASSIST_ORDER[i] === cur) { idx = i; break; }\n    }\n    spec = BM_ASSIST_ORDER[(idx + 1) % BM_ASSIST_ORDER.length];\n  } else {\n    spec = BM_ASSIST_ALIAS[raw];\n    if (!spec) {\n      display_notice('[BM] Support: use off|taht|neko|bm|al|pb|bc (or xassist).', 'yellow');\n      return bmAssistSpec();\n    }\n  }\n  var prev = bmAssistSpec();\n  if (spec !== 'off') {\n    if (prev === 'off') bmSet('bm_assist_role_saved', String(bmGet('bm_role', 'killer') || 'killer'));\n    bmSet('bm_role', 'support');\n  } else if (prev !== 'off') {\n    var saved = String(bmGet('bm_assist_role_saved', '') || '').toLowerCase();\n    if (saved === 'support' || saved === 'killer') bmSet('bm_role', saved);\n    bmSet('bm_assist_role_saved', '');\n  }\n  bmSet('bm_assist_spec', spec);\n  bmSet('bm_wep_poison_style', '');\n  try { run_function('bm_sync_wep_poison', '', 'BladeMaster Engine'); } catch (eAs) {}\n  if (spec === 'off') {\n    var roleNow = String(bmGet('bm_role', 'killer') || 'killer').toLowerCase() === 'support' ? 'Support' : 'Killer';\n    display_notice('[BM] Support: Off — Role ' + roleNow + ' restored; Standard/Power poison cycle.', 'lightgreen');\n  } else {\n    display_notice('[BM] ' + bmAssistChipLabel() + ' — Role Support (no auto evisc). ' + bmAssistRecipeTip(), 'lightgreen');\n  }\n  return spec;\n}\nfunction bmpNow() { return Date.now(); }\nfunction bmpNum(k, d) {\n  var n = parseFloat(bmGet(k, ''));\n  return isNaN(n) ? d : n;\n}\nfunction bmpJson(k, d) {\n  try {\n    var raw = bmGet(k, '');\n    if (!raw) return d;\n    var v = JSON.parse(raw);\n    if (v === null || typeof v !== 'object') return d;\n    return v;\n  } catch (eJ) { return d; }\n}\nfunction bmpIsArray(v) { return Object.prototype.toString.call(v) === '[object Array]'; }\nfunction bmpIsVital(limb) { return limb === 'head' || limb === 'chest' || limb === 'gut'; }\nfunction bmpWoundWord(limb) { return String(bmGet('bm_w_' + limb, '') || '').toLowerCase(); }\nfunction bmpWoundRank(limb) {\n  var w = bmpWoundWord(limb);\n  if (w === 'critical') return 3;\n  if (w === 'heavy') return 2;\n  if (w === 'light') return 1;\n  return 0;\n}\nfunction bmpAssayPct(limb) {\n  var p = parseInt(bmGet('bm_p_' + limb, ''), 10);\n  return isNaN(p) ? null : p;\n}\nfunction bmpThreshold() {\n  var th = parseInt(bmGet('bm_smart_threshold', '90'), 10);\n  return isNaN(th) ? 90 : th;\n}\nfunction bmpStanceCoversVitals() {\n  return String(bmGet('bm_en_stance', '') || '').toLowerCase().indexOf('vital') >= 0;\n}\nfunction bmpEvidenceMs() { return bmpNum('bm_parry_evidence_sec', 20) * 1000; }\nfunction bmpParryPolicy() {\n  var p = String(bmGet('bm_parry_policy', 'vital') || 'vital').toLowerCase();\n  return p === 'bait' ? 'bait' : 'vital';\n}\nfunction bmpSplitMax() {\n  var n = parseInt(bmGet('bm_split_max_volleys', '4'), 10);\n  return (isNaN(n) || n < 1) ? 4 : n;\n}\nfunction bmParsePowerVal(raw) {\n  if (raw == null || raw === '') return NaN;\n  if (typeof raw === 'number') return raw;\n  var s = String(raw).replace(/^\\s+|\\s+$/g, '');\n  var slash = s.indexOf('/');\n  if (slash >= 0) s = s.substring(0, slash);\n  return parseFloat(s);\n}\nfunction bmGetPower() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Vitals) {\n      var v = GMCP.Char.Vitals;\n      var keys = ['power', 'pow', 'p', 'stars'];\n      var i, p;\n      for (i = 0; i < keys.length; i++) {\n        p = bmParsePowerVal(v[keys[i]]);\n        if (!isNaN(p)) return p;\n      }\n    }\n  } catch (eP) {}\n  return null;\n}\nfunction bmEviscReserve() {\n  var reserve = 5;\n  var candy = bmBool('pEviscLollyPrep') || bmBool('evisc_candy');\n  var wbRaw = get_variable('evisc_combo_weakblood');\n  var wb;\n  if (wbRaw === undefined || wbRaw === null || wbRaw === '') {\n    wb = candy;\n  } else {\n    wb = bmBool('evisc_combo_weakblood');\n  }\n  if (candy && wb) reserve += 3;\n  if (bmBool('bm_pre_evisc_blade')) reserve += 3;\n  return reserve;\n}\n// 0..2 lunge hands from spare power above the evisc reserve. Unknown power -> 0 (never guess).\nfunction lungeBudgetHands() {\n  var power = bmGetPower();\n  if (power === null) return 0;\n  var n = Math.floor((power - bmEviscReserve()) / 2);\n  if (n < 0) n = 0;\n  if (n > 2) n = 2;\n  return n;\n}\n// --- live parry ring (BM_CombatTracker) ---\nfunction bmpLiveRing(limb) {\n  var list = bmpJson('bm_live_parry_' + limb, []);\n  if (!bmpIsArray(list)) list = [];\n  var cutoff = bmpNow() - bmpEvidenceMs();\n  var out = [], i;\n  for (i = 0; i < list.length; i++) {\n    if (list[i] && (parseFloat(list[i].t) || 0) >= cutoff) out.push(list[i]);\n  }\n  return out;\n}\nfunction bmpLiveCounts(limb) {\n  var list = bmpLiveRing(limb);\n  var parried = 0, i;\n  for (i = 0; i < list.length; i++) if (list[i].p) parried++;\n  return { parried: parried, total: list.length };\n}\nfunction bmpLiveRate(limb) {\n  var c = bmpLiveCounts(limb);\n  if (!c.total) return null;\n  return c.parried / c.total;\n}\nfunction bmpLiveLandedStreak(limb) {\n  var list = bmpLiveRing(limb);\n  var streak = 0, i;\n  for (i = list.length - 1; i >= 0; i--) {\n    if (list[i].p) break;\n    streak++;\n  }\n  return streak;\n}\nfunction bmpPushLiveOutcome(limb, parried) {\n  var list = bmpLiveRing(limb);\n  list.push({ p: parried ? 1 : 0, t: bmpNow() });\n  while (list.length > 6) list.shift();\n  bmSet('bm_live_parry_' + limb, JSON.stringify(list));\n  if (parried) bmSet('bm_live_parry_last_at', String(bmpNow()));\n}\nfunction liveParrySeenSince(t) {\n  var last = parseFloat(bmGet('bm_live_parry_last_at', '0')) || 0;\n  return last > 0 && last >= (parseFloat(t) || 0);\n}\n// --- swing queue (written by sendDual, resolved by bm_track) ---\nfunction bmpSwingQueue() {\n  var q = bmpJson('bm_swing_queue', []);\n  if (!bmpIsArray(q)) q = [];\n  var cutoff = bmpNow() - 6000;\n  var out = [], i;\n  for (i = 0; i < q.length; i++) {\n    if (q[i] && (parseFloat(q[i].t) || 0) >= cutoff) out.push(q[i]);\n  }\n  return out;\n}\nfunction bmpSaveSwingQueue(q) { bmSet('bm_swing_queue', JSON.stringify(q || [])); }\nfunction queueSwings(intents) {\n  var q = bmpSwingQueue();\n  var now = bmpNow();\n  var i, it;\n  for (i = 0; i < (intents || []).length; i++) {\n    it = intents[i];\n    if (!it || !it.limb) continue;\n    q.push({ hand: it.hand || '', limb: String(it.limb).toLowerCase(), lunge: it.lunge ? 1 : 0, t: now, r: 0, rt: 0 });\n  }\n  while (q.length > 8) q.shift();\n  bmpSaveSwingQueue(q);\n}\nfunction bmpNextUnresolved(q, lungeOnly) {\n  var i;\n  for (i = 0; i < q.length; i++) {\n    if (q[i] && !q[i].r && (!!q[i].lunge) === (!!lungeOnly)) return q[i];\n  }\n  return null;\n}\n// --- effective parry + hysteresis denial (BM_CombatEngine) ---\nfunction effParry(limb) {\n  if (!bmpIsVital(limb)) return 0;\n  if (bmpStanceCoversVitals()) return 100;\n  var pct = bmpAssayPct(limb);\n  if (pct === null) pct = 0;\n  var live = bmpLiveRate(limb);\n  if (live !== null && live * 100 > pct) pct = live * 100;\n  if (pct < 0) pct = 0;\n  if (pct > 100) pct = 100;\n  return pct;\n}\nfunction bmpDenState(limb) {\n  var st = bmpJson('bm_parry_den_' + limb, null);\n  if (!st) st = {};\n  st.denied = !!st.denied;\n  if (!bmpIsArray(st.pts)) st.pts = [];\n  st.liveBase = parseFloat(st.liveBase) || 0;\n  st.reason = String(st.reason || '');\n  st.since = parseFloat(st.since) || 0;\n  st.assayFresh = !!st.assayFresh;\n  if (st.lastAssay === undefined) st.lastAssay = null;\n  st.points = parseFloat(st.points) || 0;\n  return st;\n}\nfunction bmpSaveDenState(limb, st) { bmSet('bm_parry_den_' + limb, JSON.stringify(st)); }\nfunction isVitalDenied(limb) {\n  if (!bmpIsVital(limb)) return false;\n  if (bmpStanceCoversVitals()) return true;\n  return bmpDenState(limb).denied === true;\n}\n// Any limb: vitals = hysteresis OR raw assay >= threshold; arms/legs from the foe stance.\nfunction isLimbDenied(limb) {\n  if (!limb) return false;\n  if (bmpIsVital(limb)) {\n    if (isVitalDenied(limb)) return true;\n    var p = bmpAssayPct(limb);\n    return p !== null && p >= bmpThreshold();\n  }\n  var s = String(bmGet('bm_en_stance', '') || '').toLowerCase();\n  if ((limb === 'lleg' || limb === 'rleg') && s.indexOf('leg') >= 0) return true;\n  if ((limb === 'larm' || limb === 'rarm') && s.indexOf('arm') >= 0) return true;\n  return false;\n}\n// Hysteresis: assayPct (optional) is a NEW reading -> 1 point when >= threshold; live parries\n// add points via the ring. Enter denied at >= confirm points (or stance); leave on a fresh assay\n// below release or 2 consecutive landed swings. Banners only on change. Returns denied.\nfunction evalVitalDenied(limb, assayPct) {\n  if (!bmpIsVital(limb)) return false;\n  var st = bmpDenState(limb);\n  var now = bmpNow();\n  var win = bmpEvidenceMs();\n  var th = bmpThreshold();\n  if (assayPct !== undefined && assayPct !== null && !isNaN(assayPct)) {\n    st.lastAssay = assayPct;\n    st.assayFresh = true;\n    if (assayPct >= th) st.pts.push(now);\n  }\n  var kept = [], i;\n  for (i = 0; i < st.pts.length; i++) {\n    if ((now - (parseFloat(st.pts[i]) || 0)) <= win) kept.push(st.pts[i]);\n  }\n  st.pts = kept;\n  var liveRaw = bmpLiveCounts(limb).parried;\n  if (liveRaw < st.liveBase) st.liveBase = liveRaw;\n  var livePts = liveRaw - st.liveBase;\n  st.points = kept.length + livePts;\n  var pct = bmpAssayPct(limb);\n  var release = bmpNum('bm_parry_release', 70);\n  var need = parseInt(bmGet('bm_parry_confirm_points', '2'), 10);\n  if (isNaN(need) || need < 1) need = 2;\n  var streak = bmpLiveLandedStreak(limb);\n  var wasDenied = st.denied;\n  var nowDenied = wasDenied;\n  var reason = st.reason;\n  function evidenceReason() {\n    if (kept.length > 0 && livePts > 0) return 'assay+live';\n    return kept.length > 0 ? 'assay' : 'live';\n  }\n  if (bmpStanceCoversVitals()) {\n    nowDenied = true;\n    reason = 'stance';\n  } else if (wasDenied && st.reason === 'stance') {\n    if (st.points >= need) {\n      reason = evidenceReason();\n      st.reason = reason;\n    } else {\n      nowDenied = false;\n      reason = 'stance dropped';\n    }\n  } else if (wasDenied) {\n    if (pct !== null && pct < release && st.assayFresh) {\n      nowDenied = false;\n      reason = 'assay ' + pct + '%';\n    } else if (streak >= 2) {\n      nowDenied = false;\n      reason = 'landed x' + streak;\n    }\n  } else if (st.points >= need) {\n    nowDenied = true;\n    reason = evidenceReason();\n  }\n  if (nowDenied !== wasDenied) {\n    st.denied = nowDenied;\n    st.reason = reason;\n    st.since = now;\n    bmSet('bm_parry_flip', '1');\n    var eff = Math.round(effParry(limb));\n    if (nowDenied) {\n      st.assayFresh = false;\n      if (limb !== 'head') display_notice('[BM] PARRY CONFIRMED — ' + limb.toUpperCase() + ' ' + eff + '% (' + reason + ')', 'orange');\n    } else {\n      st.pts = [];\n      st.liveBase = liveRaw;\n      st.points = 0;\n      if (limb !== 'head') display_notice('[BM] PARRY RELEASED — ' + limb.toUpperCase() + ' ' + eff + '% (' + reason + ')', 'orange');\n    }\n  } else if (nowDenied && reason === 'stance' && st.reason !== 'stance') {\n    st.reason = 'stance';\n  }\n  bmpSaveDenState(limb, st);\n  return st.denied === true;\n}\n// Phase: kill | split (both vitals denied) | fallback (split cap reached). Default spec only.\nfunction bmRefreshKillPhase() {\n  var prev = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var chestD = isVitalDenied('chest');\n  var gutD = isVitalDenied('gut');\n  var splitN = parseInt(bmGet('bm_split_volleys', '0'), 10) || 0;\n  var maxSplit = bmpSplitMax();\n  var wasChest = String(bmGet('bm_parry_was_chest', '') || '') === '1';\n  var wasGut = String(bmGet('bm_parry_was_gut', '') || '') === '1';\n  if (chestD && gutD) {\n    if (prev === 'fallback') {\n      // stay\n    } else if (prev === 'split') {\n      if (splitN >= maxSplit) {\n        bmSet('bm_kill_phase', 'fallback');\n        bmSet('bm_fallback_leg', '');\n        display_notice('[BM] FALLBACK — legs: split ' + splitN + '/' + maxSplit + ' with no release — both hands on one leg → legtendon → prone → haymaker', 'orange');\n      }\n    } else {\n      bmSet('bm_kill_phase', 'split');\n      bmSet('bm_split_volleys', '0');\n      display_notice('[BM] SPLIT MODE — bait parry off vitals', 'orange');\n    }\n  } else {\n    if (prev === 'split' || prev === 'fallback') {\n      if (!chestD && !gutD) display_notice('[BM] BAIT SUCCESS — vitals open', 'orange');\n      else if (wasChest && !chestD) display_notice('[BM] BAIT SUCCESS — chest parry dropped', 'orange');\n      else if (wasGut && !gutD) display_notice('[BM] BAIT SUCCESS — gut parry dropped', 'orange');\n    }\n    bmSet('bm_kill_phase', 'kill');\n    bmSet('bm_split_volleys', '0');\n    bmSet('bm_fallback_leg', '');\n  }\n  bmSet('bm_parry_was_chest', chestD ? '1' : '0');\n  bmSet('bm_parry_was_gut', gutD ? '1' : '0');\n}\n// Primary vital: higher wound rank; tie -> lower effParry; tie -> chest. Parry never moves it.\nfunction pickKillModeVital() {\n  var wc = bmpWoundRank('chest');\n  var wg = bmpWoundRank('gut');\n  if (wg > wc) return 'gut';\n  if (wc > wg) return 'chest';\n  if (effParry('gut') < effParry('chest')) return 'gut';\n  return 'chest';\n}\nfunction resolveKillVital() {\n  var primary = pickKillModeVital();\n  var secondary = (primary === 'chest') ? 'gut' : 'chest';\n  var wp = bmpWoundRank(primary);\n  var ws = bmpWoundRank(secondary);\n  var reason;\n  if (wp > ws) reason = 'wounds ' + wp + ' > ' + ws;\n  else if (effParry(primary) < effParry(secondary)) reason = 'wounds tie, parry ' + Math.round(effParry(primary)) + '% < ' + Math.round(effParry(secondary)) + '%';\n  else reason = 'wounds tie, chest default';\n  if (isVitalDenied(primary)) reason += ' (denied)';\n  bmSet('bm_kill_vital_lock', JSON.stringify({ limb: primary, reason: reason }));\n  return primary;\n}\n// --- bait / leg helpers (tiers map onto MOD via strikeCmd: light=pierce*, crit=legtendon) ---\nfunction baitTier(limb) { return bmpWoundRank(limb) >= 1 ? 'light' : 'base'; }\nfunction pickBaitArm(volley) {\n  var lOk = !isLimbDenied('larm');\n  var rOk = !isLimbDenied('rarm');\n  if (lOk && !rOk) return 'larm';\n  if (rOk && !lOk) return 'rarm';\n  if (!lOk && !rOk) return '';\n  var wl = bmpWoundRank('larm');\n  var wr = bmpWoundRank('rarm');\n  if (wl > wr) return 'larm';\n  if (wr > wl) return 'rarm';\n  return (((parseInt(volley, 10) || 0) % 2) === 0) ? 'larm' : 'rarm';\n}\nfunction pickBaitLeg() {\n  var lOk = !isLimbDenied('lleg');\n  var rOk = !isLimbDenied('rleg');\n  if (lOk && !rOk) return 'lleg';\n  if (rOk && !lOk) return 'rleg';\n  if (!lOk && !rOk) return '';\n  if (bmpWoundRank('rleg') > bmpWoundRank('lleg')) return 'rleg';\n  return 'lleg';\n}\nfunction pickFallbackLeg() {\n  var cur = String(bmGet('bm_fallback_leg', '') || '');\n  if ((cur === 'lleg' || cur === 'rleg') && !isLimbDenied(cur)) return cur;\n  var lOk = !isLimbDenied('lleg');\n  var rOk = !isLimbDenied('rleg');\n  var pick;\n  if (lOk && !rOk) pick = 'lleg';\n  else if (rOk && !lOk) pick = 'rleg';\n  else pick = (bmpWoundRank('rleg') < bmpWoundRank('lleg')) ? 'rleg' : 'lleg';\n  bmSet('bm_fallback_leg', pick);\n  return pick;\n}\nfunction legBaitTier(leg, allowCrit) {\n  var w = bmpWoundRank(leg);\n  if (allowCrit && w >= 3) return 'crit';\n  if (w >= 1) return 'light';\n  return 'base';\n}\n// Kill volley plan for the default spec (mirror of Lua planKillVolley). Pure: safe per tick.\nfunction bmPlanKillVolley(tgt) {\n  var primary = resolveKillVital();\n  var secondary = (primary === 'chest') ? 'gut' : 'chest';\n  var volley = (parseInt(bmGet('bm_kill_volley', '0'), 10) || 0) + 1;\n  var plan = {\n    killBody: primary, killTier: 'base', killLunge: false,\n    hinderBody: primary, hinderTier: 'base', hinderLunge: false,\n    primary: primary, secondary: secondary, budget: 0, note: '', noteMid: '',\n    vitalLunge: false, bait: false\n  };\n  var phase = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var pDenied = isVitalDenied(primary);\n  var sDenied = isVitalDenied(secondary);\n  var budget = lungeBudgetHands();\n  var power = bmGetPower();\n  var reserve = bmEviscReserve();\n  plan.budget = budget;\n  var powStr = '(power ' + (power === null ? '?' : power) + ', reserve ' + reserve + ')';\n  function woundStr(limb) { return bmpWoundWord(limb) || 'no wounds'; }\n  function baitArmHinder() {\n    var arm = pickBaitArm(volley);\n    if (!arm) {\n      if (!isLimbDenied('head')) {\n        plan.hinderBody = 'head';\n        plan.hinderTier = baitTier('head');\n        return;\n      }\n      var leg = pickBaitLeg() || 'lleg';\n      plan.hinderBody = leg;\n      plan.hinderTier = legBaitTier(leg, false);\n      return;\n    }\n    plan.hinderBody = arm;\n    plan.hinderTier = baitTier(arm);\n  }\n  if (!pDenied) return plan;\n  if (budget >= 2) {\n    plan.killLunge = true;\n    plan.hinderLunge = true;\n    plan.vitalLunge = true;\n    plan.note = 'LUNGE THROUGH PARRY — ' + primary.toUpperCase() + ' x2';\n    plan.noteMid = powStr;\n    return plan;\n  }\n  if (budget === 1) {\n    plan.killLunge = true;\n    plan.vitalLunge = true;\n    if (!sDenied) {\n      plan.hinderBody = secondary;\n      plan.hinderTier = 'base';\n    } else {\n      baitArmHinder();\n    }\n    plan.note = 'LUNGE THROUGH PARRY — ' + primary.toUpperCase() + ' x1';\n    plan.noteMid = powStr + (sDenied ? ' · hinder baits ' + String(plan.hinderBody).toUpperCase() : ' · hinder ' + secondary.toUpperCase());\n    return plan;\n  }\n  if (phase === 'fallback') {\n    var fleg = pickFallbackLeg() || 'lleg';\n    plan.killBody = fleg;\n    plan.killTier = (bmpWoundRank(fleg) >= 3) ? 'crit' : 'base';\n    plan.hinderBody = fleg;\n    plan.hinderTier = legBaitTier(fleg, true);\n    plan.bait = true;\n    plan.note = 'FALLBACK — legs';\n    plan.noteMid = fleg.toUpperCase() + ' ' + woundStr(fleg);\n    return plan;\n  }\n  if (!sDenied) {\n    var needPower = reserve + 2;\n    plan.killBody = secondary;\n    plan.killTier = 'base';\n    if (bmpParryPolicy() === 'bait') {\n      baitArmHinder();\n      plan.noteMid = 'bait ' + String(plan.hinderBody).toUpperCase();\n    } else {\n      plan.hinderBody = secondary;\n      plan.hinderTier = 'base';\n      plan.noteMid = powStr;\n    }\n    plan.note = 'HOLD ' + primary.toUpperCase() + ' ' + bmpWoundWord(primary) + ' — building ' + secondary.toUpperCase() + ' until power >= ' + needPower;\n    return plan;\n  }\n  // Both vitals denied, no lunge budget: split bait. Never base into a denied vital.\n  baitArmHinder();\n  var bleg = pickBaitLeg();\n  if (bleg) {\n    plan.killBody = bleg;\n    plan.killTier = legBaitTier(bleg, false);\n  } else if (plan.hinderBody !== 'head' && !isLimbDenied('head')) {\n    plan.killBody = 'head';\n    plan.killTier = 'base';\n  } else {\n    plan.killBody = (plan.hinderBody === 'larm') ? 'rarm' : 'larm';\n    plan.killTier = 'base';\n  }\n  plan.bait = true;\n  plan.note = 'SPLIT ' + ((parseInt(bmGet('bm_split_volleys', '0'), 10) || 0) + 1) + '/' + bmpSplitMax();\n  plan.noteMid = 'hinder ' + String(plan.hinderBody).toUpperCase() + ' · kill hand ' + String(plan.killBody).toUpperCase();\n  return plan;\n}\n// Plain-text status (Offence tab block, xkillmode status, xkillparry).\nfunction killModeStatusLines() {\n  var lines = [];\n  var assist = 'off';\n  try { if (typeof bmAssistSpec === 'function') assist = bmAssistSpec(); } catch (eA) {}\n  if (assist === 'off') resolveKillVital();\n  var lock = bmpJson('bm_kill_vital_lock', {});\n  var primary = String(lock.limb || bmGet('bm_kill_limb', 'chest') || 'chest');\n  lines.push('primary ' + primary.toUpperCase() + ' (' + (bmpWoundWord(primary) || 'no wounds') + ') — ' + (lock.reason || '?'));\n  var vitals = ['chest', 'gut'], i, limb, ap, c, st, denied;\n  for (i = 0; i < vitals.length; i++) {\n    limb = vitals[i];\n    ap = bmpAssayPct(limb);\n    c = bmpLiveCounts(limb);\n    st = bmpDenState(limb);\n    denied = isVitalDenied(limb);\n    lines.push(limb.toUpperCase() + ' ' + Math.round(effParry(limb)) + '% (assay ' + (ap === null ? '?' : ap + '%') + ', live ' + c.parried + '/' + c.total + ', pts ' + st.points + ')' +\n      (denied ? ' DENIED' + (st.reason ? ' [' + st.reason + ']' : '') : ''));\n  }\n  var power = bmGetPower();\n  lines.push('lunge: power ' + (power === null ? '?' : power) + ' / reserve ' + bmEviscReserve() + ' -> ' + lungeBudgetHands() + ' hand(s)');\n  var phase = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var phaseLine = 'phase ' + phase;\n  if (phase === 'split' || phase === 'fallback') phaseLine += '  split ' + (parseInt(bmGet('bm_split_volleys', '0'), 10) || 0) + '/' + bmpSplitMax();\n  if (phase === 'fallback' && bmGet('bm_fallback_leg', '')) phaseLine += '  leg ' + String(bmGet('bm_fallback_leg', '')).toUpperCase();\n  phaseLine += '  policy ' + bmpParryPolicy();\n  lines.push(phaseLine);\n  var proneRaw = String(bmGet('bm_en_prone', '') || '');\n  if (!proneRaw) lines.push('prone: unknown');\n  else lines.push('prone: ' + (bmBool('bm_en_prone') ? 'yes' : 'no'));\n  return lines;\n}\n// Target change / KillMode ON: forget parry evidence, queue, lock, phase counters.\nfunction resetParryState() {\n  var limbs = ['head', 'chest', 'gut', 'larm', 'rarm', 'lleg', 'rleg'], i;\n  for (i = 0; i < limbs.length; i++) bmSet('bm_live_parry_' + limbs[i], '');\n  bmSet('bm_parry_den_head', '');\n  bmSet('bm_parry_den_chest', '');\n  bmSet('bm_parry_den_gut', '');\n  bmSet('bm_swing_queue', '');\n  bmSet('bm_live_parry_last_at', '0');\n  bmSet('bm_kill_last_volley_at', '0');\n  bmSet('bm_kill_vital_lock', '');\n  bmSet('bm_split_volleys', '0');\n  bmSet('bm_fallback_leg', '');\n  bmSet('bm_parry_flip', '0');\n  bmSet('bm_parry_was_chest', '');\n  bmSet('bm_parry_was_gut', '');\n  bmSet('bm_kill_phase', 'kill');\n}function woundWord(limb) {\n  return String(bmGet('bm_w_' + limb, '') || '').toLowerCase();\n}\nfunction isCrit(limb) { return woundWord(limb) === 'critical'; }\nfunction critLatchFresh() {\n  var t = parseFloat(bmGet('bm_w_crit_latch', '0')) || 0;\n  if (!t) return false;\n  return (Date.now() - t) <= 8000;\n}\nfunction parryHigh(limb) {\n  var th = parseInt(bmGet('bm_smart_threshold', '90'), 10);\n  if (isNaN(th)) th = 90;\n  var p = parseInt(bmGet('bm_p_' + limb, ''), 10);\n  if (isNaN(p)) return false;\n  return p >= th;\n}\n\nif (!bmBool('bm_smart_poison')) return;\nif (!bmBool('bm_killmode')) {\n  var launching = false;\n  try { if (client.evisc && client.evisc.isExecuting) launching = true; } catch (eE0) {}\n  if (critLatchFresh() && (isCrit('chest') || isCrit('gut'))) launching = true;\n  if (!launching) return;\n}\n\nvar eviscLaunching = false;\ntry { if (client.evisc && client.evisc.isExecuting) eviscLaunching = true; } catch (eE) {}\nif (critLatchFresh() && (isCrit('chest') || isCrit('gut'))) eviscLaunching = true;\nif (String(bmGet('bm_role', 'killer') || 'killer').toLowerCase() === 'support') eviscLaunching = false;\n\nvar poisonMode = bmNormalizePoisonMode();\nvar custom = poisonMode !== 'standard' && poisonMode !== 'power';\nvar power = poisonMode === 'power';\nvar assist = bmAssistSpec();\nvar chestDenied = isVitalDenied('chest');\nvar gutDenied = isVitalDenied('gut');\nvar style;\nif (eviscLaunching) style = 'evisc';\nelse if (assist !== 'off') {\n  style = 'assist:' + assist;\n  if (assist === 'blademaster' && parryHigh('chest') && parryHigh('gut')) style = 'assist:blademaster:parried';\n} else if (custom) style = 'custom:' + poisonMode;\nelse if (power) style = 'power';\nelse if (chestDenied && gutDenied) style = 'parried';\nelse if (chestDenied || gutDenied) style = 'parried1';\nelse style = 'open';\n\nif (bmGet('bm_wep_poison_style', '') === style) return;\nbmSet('bm_wep_poison_style', style);\n\nfunction noticeMissingIdsOnce() {\n  if (bmGet('bm_wep_poison_id_notice', '') === '1') return;\n  bmSet('bm_wep_poison_id_notice', '1');\n  display_notice('[BM] Smart poisons: missing weapon ids — auto-Find if needed (or xpoisons).', 'yellow');\n  try { run_function('bm_findgear', 'maybeauto', 'BladeMaster Engine'); } catch (eAf) {}\n}\nfunction applyRecipe(left, right) {\n  try {\n    run_function('psnm_apply_recipe', JSON.stringify({ left: left || [], right: right || [] }), 'BladeMaster Engine');\n  } catch (eA) {}\n}\nfunction applyNowOrAfterDraw(applyFn) {\n  try { applyFn(); } catch (e0) {}\n  var prev = parseInt(bmGet('bm_wep_poison_apply_tid', ''), 10);\n  if (prev) { try { clearTimeout(prev); } catch (eC) {} }\n  var locked = style;\n  var tid = setTimeout(function () {\n    bmSet('bm_wep_poison_apply_tid', '');\n    if (bmGet('bm_wep_poison_style', '') === locked) {\n      try { applyFn(); } catch (e1) {}\n    }\n  }, 550);\n  bmSet('bm_wep_poison_apply_tid', String(tid));\n}\nfunction drawAndApply(mode, applyFn) {\n  bmSet('psnm_weapon_mode', mode);\n  if (mode === 'bastard') {\n    send_command('draw bastard', 0);\n    if (!String(bmGet('psnm_bastard_id', '') || '').trim()) { noticeMissingIdsOnce(); return; }\n  } else {\n    send_command('draw rapier', 0);\n    var w1 = String(bmGet('psnm_w1', '') || '').trim();\n    var w2 = String(bmGet('psnm_w2', '') || '').trim();\n    if (!w1 && !w2) { noticeMissingIdsOnce(); return; }\n  }\n  applyNowOrAfterDraw(applyFn);\n  if (!bmBool('psnm_maintenance')) {\n    try { run_function('psnm_enable_maint_skip', '', 'BladeMaster Engine'); } catch (eM) {}\n  }\n}\n\nif (style === 'evisc') {\n  drawAndApply('rapiers', function () {\n    applyRecipe(['dendroxin', 'crotamine', 'mantakaya'], ['crotamine', 'mantakaya', 'dendroxin']);\n  });\n} else if (style.indexOf('assist:') === 0) {\n  drawAndApply('rapiers', function () {\n    if (style === 'assist:blademaster:parried') {\n      applyRecipe(['dendroxin'], ['dendroxin']);\n      return;\n    }\n    var rec = bmAssistRecipes()[assist];\n    if (rec) applyRecipe(rec.left, rec.right);\n  });\n} else if (custom) {\n  drawAndApply('rapiers', function () {\n    bmSet('psnm_profile_rapiers', poisonMode);\n    try { run_function('psnm_apply_switch', '', 'BladeMaster Engine'); } catch (eSw) {}\n  });\n} else if (style === 'power') {\n  drawAndApply('rapiers', function () {\n    applyRecipe(['escozul', 'dendroxin'], ['dendroxin', 'escozul']);\n  });\n} else if (style === 'parried1') {\n  // Exactly one vital denied: dendroxin (asthenia hampers parry) on the hinder hand, senso on the kill hand.\n  drawAndApply('rapiers', function () {\n    var hinderRight = String(bmGet('bm_hinder_hand', 'left') || 'left').toLowerCase() === 'right';\n    if (hinderRight) applyRecipe(['senso'], ['dendroxin']);\n    else applyRecipe(['dendroxin'], ['senso']);\n  });\n} else if (style === 'parried') {\n  drawAndApply('rapiers', function () {\n    applyRecipe(['dendroxin'], ['dendroxin']);\n  });\n} else if (bmBool('bm_use_bastard')) {\n  drawAndApply('bastard', function () {\n    applyRecipe(['senso'], []);\n  });\n} else {\n  drawAndApply('rapiers', function () {\n    applyRecipe(['senso'], ['senso']);\n  });\n}\n"},{"type":"function","name":"bm_tabs","enabled":true,"id":9,"code":"\nfunction bmGet(k, d) {\n  var v = get_variable(k);\n  if (v === undefined || v === null || v === '') return d;\n  return v;\n}\nfunction bmBool(k) {\n  var v = bmGet(k, '0');\n  if (v === true || v === 1) return true;\n  if (v === false || v === 0) return false;\n  var s = String(v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmDefOn(k, fallbackOn) {\n  var raw = get_variable(k);\n  if (raw === undefined || raw === null || raw === '') return !!fallbackOn;\n  return bmBool(k);\n}\nfunction bmEngineOn() {\n  var raw = get_variable('bm_engine');\n  if (raw === undefined || raw === null || raw === '') return true;\n  return bmBool('bm_engine');\n}\nfunction bmSpamOn() {\n  return bmDefOn('bm_spam', true);\n}\nfunction bmSet(k, v) { set_variable(k, String(v)); }\nfunction bmPsnmSideHas(list) {\n  if (!list) return false;\n  if (Object.prototype.toString.call(list) === '[object Array]') return list.length > 0;\n  return String(list).trim() !== '';\n}\nfunction bmPsnmCustomFilled() {\n  var keys = ['profile3','profile4','profile5','profile6','profile7','profile8','profile9'];\n  var custom = {};\n  try { custom = JSON.parse(String(bmGet('psnm_custom', '{}') || '{}')); } catch (eC) { custom = {}; }\n  if (!custom || typeof custom !== 'object') custom = {};\n  var out = [];\n  var i, k, p, name;\n  for (i = 0; i < keys.length; i++) {\n    k = keys[i];\n    p = custom[k];\n    if (!p || typeof p !== 'object') continue;\n    if (!bmPsnmSideHas(p.left) && !bmPsnmSideHas(p.right)) continue;\n    name = String(p.name || '').trim();\n    if (!name) name = 'Profile ' + k.replace('profile', '');\n    out.push({ key: k, name: name });\n  }\n  return out;\n}\nfunction bmPoisonRotationKeys() {\n  var list = ['standard', 'power'];\n  var filled = bmPsnmCustomFilled();\n  var i;\n  for (i = 0; i < filled.length; i++) list.push(filled[i].key);\n  return list;\n}\nfunction bmNormalizePoisonMode() {\n  var mode = String(bmGet('bm_poison_mode', 'standard') || 'standard').toLowerCase();\n  if (mode === 'standard' || mode === 'power') return mode;\n  var filled = bmPsnmCustomFilled();\n  var i;\n  for (i = 0; i < filled.length; i++) {\n    if (filled[i].key === mode) return mode;\n  }\n  bmSet('bm_poison_mode', 'standard');\n  return 'standard';\n}\nfunction bmPoisonModeLabel(mode) {\n  mode = String(mode || 'standard').toLowerCase();\n  if (mode === 'power') return 'Power';\n  if (mode === 'standard') return 'Standard';\n  var filled = bmPsnmCustomFilled();\n  var i;\n  for (i = 0; i < filled.length; i++) {\n    if (filled[i].key === mode) return filled[i].name;\n  }\n  return 'Standard';\n}\nvar BM_ASSIST_ORDER = ['off','tahtetso','nekotai','blademaster','axelord','pureblade','bonecrusher'];\nvar BM_ASSIST_SHORT = { off:'Off', tahtetso:'Taht', nekotai:'Neko', blademaster:'BM', axelord:'AL', pureblade:'PB', bonecrusher:'BC' };\nvar BM_ASSIST_ALIAS = {\n  off:'off', taht:'tahtetso', tahtetso:'tahtetso',\n  neko:'nekotai', nekotai:'nekotai',\n  bm:'blademaster', blademaster:'blademaster',\n  al:'axelord', axelord:'axelord',\n  pb:'pureblade', pureblade:'pureblade',\n  bc:'bonecrusher', bonecrusher:'bonecrusher'\n};\nfunction bmAssistRecipes() {\n  return {\n    tahtetso: { left: ['tetrodin', 'crotamine', 'anatine'], right: ['crotamine', 'anatine', 'tetrodin'] },\n    nekotai: { left: ['hadrudin', 'mellitin'], right: ['mellitin', 'hadrudin'] },\n    blademaster: { left: ['senso', 'haemotox'], right: ['haemotox', 'senso'] },\n    axelord: { left: ['senso', 'dendroxin'], right: ['dendroxin', 'senso'] },\n    pureblade: { left: ['haemotox', 'senso'], right: ['senso', 'haemotox'] },\n    bonecrusher: { left: ['senso', 'haemotox'], right: ['haemotox', 'senso'] }\n  };\n}\nfunction bmAssistSpec() {\n  var raw = String(bmGet('bm_assist_spec', 'off') || 'off').toLowerCase();\n  if (BM_ASSIST_ALIAS[raw]) return BM_ASSIST_ALIAS[raw];\n  return 'off';\n}\nfunction bmAssistChipLabel() {\n  return 'Support: ' + (BM_ASSIST_SHORT[bmAssistSpec()] || 'Off');\n}\nfunction bmAssistRecipeTip() {\n  var spec = bmAssistSpec();\n  if (spec === 'tahtetso') return 'Taht: tetrodin + crotamine + anatine (steam/dust/slush). Cycle head/chest/gut. No senso/hadrudin/chansu.';\n  if (spec === 'nekotai') return 'Neko: hadrudin + mellitin. Cycle head/chest/gut. No senso/tetrodin/chansu.';\n  if (spec === 'blademaster') return 'BM: senso + haemotox (dendroxin if both vitals parried). Chest↔gut. No tetrodin/hadrudin.';\n  if (spec === 'axelord') return 'AL: senso + dendroxin. Head to heavy/C!, then chest/gut to heavy.';\n  if (spec === 'pureblade') return 'PB: haemotox + senso. Gut first, chest second. No crotamine (dust).';\n  if (spec === 'bonecrusher') return 'BC: senso + haemotox. Head first, legs second.';\n  return 'Off → Taht → Neko → BM → AL → PB → BC. Feeds that teammate wiki kill path. Forces Support role. Alias xassist.';\n}\nfunction bmAssistWoundWord(limb) {\n  return String(bmGet('bm_w_' + limb, '') || '').toLowerCase();\n}\nfunction bmAssistIsCrit(limb) { return bmAssistWoundWord(limb) === 'critical'; }\nfunction bmAssistParryHigh(limb) {\n  var th = parseInt(bmGet('bm_smart_threshold', '90'), 10);\n  if (isNaN(th)) th = 90;\n  var p = parseInt(bmGet('bm_p_' + limb, ''), 10);\n  if (isNaN(p)) return false;\n  return p >= th;\n}\nfunction bmAssistWoundRank(limb) {\n  var w = bmAssistWoundWord(limb);\n  if (w === 'critical') return 3;\n  if (w === 'heavy') return 2;\n  if (w === 'light') return 1;\n  return 0;\n}\nfunction bmAssistPickCycleVitals() {\n  var order = ['head', 'chest', 'gut'];\n  var last = String(bmGet('bm_kill_limb', '') || '');\n  var best = '', bestRank = 99, bestIdx = 99;\n  var i, limb, rank, idx, lastIdx;\n  lastIdx = order.indexOf(last);\n  for (i = 0; i < order.length; i++) {\n    limb = order[i];\n    if (bmAssistParryHigh(limb)) continue;\n    rank = bmAssistWoundRank(limb);\n    idx = (lastIdx < 0) ? i : ((i - lastIdx - 1 + order.length) % order.length);\n    if (!best || rank < bestRank || (rank === bestRank && idx < bestIdx)) {\n      best = limb;\n      bestRank = rank;\n      bestIdx = idx;\n    }\n  }\n  return best || 'head';\n}\nfunction bmAssistPickKill() {\n  var spec = bmAssistSpec();\n  if (spec === 'tahtetso' || spec === 'nekotai') return bmAssistPickCycleVitals();\n  if (spec === 'axelord') {\n    if (!bmAssistParryHigh('head') && bmAssistWoundRank('head') < 2) return 'head';\n    if (!bmAssistParryHigh('chest') && bmAssistWoundRank('chest') < 2) return 'chest';\n    if (!bmAssistParryHigh('gut') && bmAssistWoundRank('gut') < 2) return 'gut';\n    if (!bmAssistParryHigh('head')) return 'head';\n    if (!bmAssistParryHigh('chest')) return 'chest';\n    return 'gut';\n  }\n  if (spec === 'pureblade') {\n    if (!bmAssistParryHigh('gut') && !bmAssistIsCrit('gut')) return 'gut';\n    if (!bmAssistParryHigh('chest')) return 'chest';\n    return 'gut';\n  }\n  if (spec === 'bonecrusher') {\n    if (!bmAssistParryHigh('head') && !bmAssistIsCrit('head')) return 'head';\n    if (!bmAssistParryHigh('lleg') && bmAssistWoundRank('lleg') <= bmAssistWoundRank('rleg')) return 'lleg';\n    if (!bmAssistParryHigh('rleg')) return 'rleg';\n    if (!bmAssistParryHigh('lleg')) return 'lleg';\n    return 'head';\n  }\n  // Default Blademaster: sticky primary vital (wound rank, then lower effParry, then chest).\n  if (typeof resolveKillVital === 'function') return resolveKillVital();\n  if (bmAssistIsCrit('chest') || bmAssistParryHigh('chest')) return 'gut';\n  return 'chest';\n}\nfunction bmAssistSet(raw) {\n  raw = String(raw == null ? '' : raw).toLowerCase().replace(/^\\s+|\\s+$/g, '');\n  if (raw === 'show') {\n    display_notice('[BM] ' + bmAssistChipLabel() + (bmAssistSpec() === 'off' ? ' — Standard/Power poisons' : ' — ' + bmAssistRecipeTip()), 'lightgreen');\n    return bmAssistSpec();\n  }\n  var spec;\n  if (!raw || raw === 'cycle' || raw === 'next') {\n    var cur = bmAssistSpec();\n    var idx = 0;\n    var i;\n    for (i = 0; i < BM_ASSIST_ORDER.length; i++) {\n      if (BM_ASSIST_ORDER[i] === cur) { idx = i; break; }\n    }\n    spec = BM_ASSIST_ORDER[(idx + 1) % BM_ASSIST_ORDER.length];\n  } else {\n    spec = BM_ASSIST_ALIAS[raw];\n    if (!spec) {\n      display_notice('[BM] Support: use off|taht|neko|bm|al|pb|bc (or xassist).', 'yellow');\n      return bmAssistSpec();\n    }\n  }\n  var prev = bmAssistSpec();\n  if (spec !== 'off') {\n    if (prev === 'off') bmSet('bm_assist_role_saved', String(bmGet('bm_role', 'killer') || 'killer'));\n    bmSet('bm_role', 'support');\n  } else if (prev !== 'off') {\n    var saved = String(bmGet('bm_assist_role_saved', '') || '').toLowerCase();\n    if (saved === 'support' || saved === 'killer') bmSet('bm_role', saved);\n    bmSet('bm_assist_role_saved', '');\n  }\n  bmSet('bm_assist_spec', spec);\n  bmSet('bm_wep_poison_style', '');\n  try { run_function('bm_sync_wep_poison', '', 'BladeMaster Engine'); } catch (eAs) {}\n  if (spec === 'off') {\n    var roleNow = String(bmGet('bm_role', 'killer') || 'killer').toLowerCase() === 'support' ? 'Support' : 'Killer';\n    display_notice('[BM] Support: Off — Role ' + roleNow + ' restored; Standard/Power poison cycle.', 'lightgreen');\n  } else {\n    display_notice('[BM] ' + bmAssistChipLabel() + ' — Role Support (no auto evisc). ' + bmAssistRecipeTip(), 'lightgreen');\n  }\n  return spec;\n}\nfunction bmpNow() { return Date.now(); }\nfunction bmpNum(k, d) {\n  var n = parseFloat(bmGet(k, ''));\n  return isNaN(n) ? d : n;\n}\nfunction bmpJson(k, d) {\n  try {\n    var raw = bmGet(k, '');\n    if (!raw) return d;\n    var v = JSON.parse(raw);\n    if (v === null || typeof v !== 'object') return d;\n    return v;\n  } catch (eJ) { return d; }\n}\nfunction bmpIsArray(v) { return Object.prototype.toString.call(v) === '[object Array]'; }\nfunction bmpIsVital(limb) { return limb === 'head' || limb === 'chest' || limb === 'gut'; }\nfunction bmpWoundWord(limb) { return String(bmGet('bm_w_' + limb, '') || '').toLowerCase(); }\nfunction bmpWoundRank(limb) {\n  var w = bmpWoundWord(limb);\n  if (w === 'critical') return 3;\n  if (w === 'heavy') return 2;\n  if (w === 'light') return 1;\n  return 0;\n}\nfunction bmpAssayPct(limb) {\n  var p = parseInt(bmGet('bm_p_' + limb, ''), 10);\n  return isNaN(p) ? null : p;\n}\nfunction bmpThreshold() {\n  var th = parseInt(bmGet('bm_smart_threshold', '90'), 10);\n  return isNaN(th) ? 90 : th;\n}\nfunction bmpStanceCoversVitals() {\n  return String(bmGet('bm_en_stance', '') || '').toLowerCase().indexOf('vital') >= 0;\n}\nfunction bmpEvidenceMs() { return bmpNum('bm_parry_evidence_sec', 20) * 1000; }\nfunction bmpParryPolicy() {\n  var p = String(bmGet('bm_parry_policy', 'vital') || 'vital').toLowerCase();\n  return p === 'bait' ? 'bait' : 'vital';\n}\nfunction bmpSplitMax() {\n  var n = parseInt(bmGet('bm_split_max_volleys', '4'), 10);\n  return (isNaN(n) || n < 1) ? 4 : n;\n}\nfunction bmParsePowerVal(raw) {\n  if (raw == null || raw === '') return NaN;\n  if (typeof raw === 'number') return raw;\n  var s = String(raw).replace(/^\\s+|\\s+$/g, '');\n  var slash = s.indexOf('/');\n  if (slash >= 0) s = s.substring(0, slash);\n  return parseFloat(s);\n}\nfunction bmGetPower() {\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP.Char && GMCP.Char.Vitals) {\n      var v = GMCP.Char.Vitals;\n      var keys = ['power', 'pow', 'p', 'stars'];\n      var i, p;\n      for (i = 0; i < keys.length; i++) {\n        p = bmParsePowerVal(v[keys[i]]);\n        if (!isNaN(p)) return p;\n      }\n    }\n  } catch (eP) {}\n  return null;\n}\nfunction bmEviscReserve() {\n  var reserve = 5;\n  var candy = bmBool('pEviscLollyPrep') || bmBool('evisc_candy');\n  var wbRaw = get_variable('evisc_combo_weakblood');\n  var wb;\n  if (wbRaw === undefined || wbRaw === null || wbRaw === '') {\n    wb = candy;\n  } else {\n    wb = bmBool('evisc_combo_weakblood');\n  }\n  if (candy && wb) reserve += 3;\n  if (bmBool('bm_pre_evisc_blade')) reserve += 3;\n  return reserve;\n}\n// 0..2 lunge hands from spare power above the evisc reserve. Unknown power -> 0 (never guess).\nfunction lungeBudgetHands() {\n  var power = bmGetPower();\n  if (power === null) return 0;\n  var n = Math.floor((power - bmEviscReserve()) / 2);\n  if (n < 0) n = 0;\n  if (n > 2) n = 2;\n  return n;\n}\n// --- live parry ring (BM_CombatTracker) ---\nfunction bmpLiveRing(limb) {\n  var list = bmpJson('bm_live_parry_' + limb, []);\n  if (!bmpIsArray(list)) list = [];\n  var cutoff = bmpNow() - bmpEvidenceMs();\n  var out = [], i;\n  for (i = 0; i < list.length; i++) {\n    if (list[i] && (parseFloat(list[i].t) || 0) >= cutoff) out.push(list[i]);\n  }\n  return out;\n}\nfunction bmpLiveCounts(limb) {\n  var list = bmpLiveRing(limb);\n  var parried = 0, i;\n  for (i = 0; i < list.length; i++) if (list[i].p) parried++;\n  return { parried: parried, total: list.length };\n}\nfunction bmpLiveRate(limb) {\n  var c = bmpLiveCounts(limb);\n  if (!c.total) return null;\n  return c.parried / c.total;\n}\nfunction bmpLiveLandedStreak(limb) {\n  var list = bmpLiveRing(limb);\n  var streak = 0, i;\n  for (i = list.length - 1; i >= 0; i--) {\n    if (list[i].p) break;\n    streak++;\n  }\n  return streak;\n}\nfunction bmpPushLiveOutcome(limb, parried) {\n  var list = bmpLiveRing(limb);\n  list.push({ p: parried ? 1 : 0, t: bmpNow() });\n  while (list.length > 6) list.shift();\n  bmSet('bm_live_parry_' + limb, JSON.stringify(list));\n  if (parried) bmSet('bm_live_parry_last_at', String(bmpNow()));\n}\nfunction liveParrySeenSince(t) {\n  var last = parseFloat(bmGet('bm_live_parry_last_at', '0')) || 0;\n  return last > 0 && last >= (parseFloat(t) || 0);\n}\n// --- swing queue (written by sendDual, resolved by bm_track) ---\nfunction bmpSwingQueue() {\n  var q = bmpJson('bm_swing_queue', []);\n  if (!bmpIsArray(q)) q = [];\n  var cutoff = bmpNow() - 6000;\n  var out = [], i;\n  for (i = 0; i < q.length; i++) {\n    if (q[i] && (parseFloat(q[i].t) || 0) >= cutoff) out.push(q[i]);\n  }\n  return out;\n}\nfunction bmpSaveSwingQueue(q) { bmSet('bm_swing_queue', JSON.stringify(q || [])); }\nfunction queueSwings(intents) {\n  var q = bmpSwingQueue();\n  var now = bmpNow();\n  var i, it;\n  for (i = 0; i < (intents || []).length; i++) {\n    it = intents[i];\n    if (!it || !it.limb) continue;\n    q.push({ hand: it.hand || '', limb: String(it.limb).toLowerCase(), lunge: it.lunge ? 1 : 0, t: now, r: 0, rt: 0 });\n  }\n  while (q.length > 8) q.shift();\n  bmpSaveSwingQueue(q);\n}\nfunction bmpNextUnresolved(q, lungeOnly) {\n  var i;\n  for (i = 0; i < q.length; i++) {\n    if (q[i] && !q[i].r && (!!q[i].lunge) === (!!lungeOnly)) return q[i];\n  }\n  return null;\n}\n// --- effective parry + hysteresis denial (BM_CombatEngine) ---\nfunction effParry(limb) {\n  if (!bmpIsVital(limb)) return 0;\n  if (bmpStanceCoversVitals()) return 100;\n  var pct = bmpAssayPct(limb);\n  if (pct === null) pct = 0;\n  var live = bmpLiveRate(limb);\n  if (live !== null && live * 100 > pct) pct = live * 100;\n  if (pct < 0) pct = 0;\n  if (pct > 100) pct = 100;\n  return pct;\n}\nfunction bmpDenState(limb) {\n  var st = bmpJson('bm_parry_den_' + limb, null);\n  if (!st) st = {};\n  st.denied = !!st.denied;\n  if (!bmpIsArray(st.pts)) st.pts = [];\n  st.liveBase = parseFloat(st.liveBase) || 0;\n  st.reason = String(st.reason || '');\n  st.since = parseFloat(st.since) || 0;\n  st.assayFresh = !!st.assayFresh;\n  if (st.lastAssay === undefined) st.lastAssay = null;\n  st.points = parseFloat(st.points) || 0;\n  return st;\n}\nfunction bmpSaveDenState(limb, st) { bmSet('bm_parry_den_' + limb, JSON.stringify(st)); }\nfunction isVitalDenied(limb) {\n  if (!bmpIsVital(limb)) return false;\n  if (bmpStanceCoversVitals()) return true;\n  return bmpDenState(limb).denied === true;\n}\n// Any limb: vitals = hysteresis OR raw assay >= threshold; arms/legs from the foe stance.\nfunction isLimbDenied(limb) {\n  if (!limb) return false;\n  if (bmpIsVital(limb)) {\n    if (isVitalDenied(limb)) return true;\n    var p = bmpAssayPct(limb);\n    return p !== null && p >= bmpThreshold();\n  }\n  var s = String(bmGet('bm_en_stance', '') || '').toLowerCase();\n  if ((limb === 'lleg' || limb === 'rleg') && s.indexOf('leg') >= 0) return true;\n  if ((limb === 'larm' || limb === 'rarm') && s.indexOf('arm') >= 0) return true;\n  return false;\n}\n// Hysteresis: assayPct (optional) is a NEW reading -> 1 point when >= threshold; live parries\n// add points via the ring. Enter denied at >= confirm points (or stance); leave on a fresh assay\n// below release or 2 consecutive landed swings. Banners only on change. Returns denied.\nfunction evalVitalDenied(limb, assayPct) {\n  if (!bmpIsVital(limb)) return false;\n  var st = bmpDenState(limb);\n  var now = bmpNow();\n  var win = bmpEvidenceMs();\n  var th = bmpThreshold();\n  if (assayPct !== undefined && assayPct !== null && !isNaN(assayPct)) {\n    st.lastAssay = assayPct;\n    st.assayFresh = true;\n    if (assayPct >= th) st.pts.push(now);\n  }\n  var kept = [], i;\n  for (i = 0; i < st.pts.length; i++) {\n    if ((now - (parseFloat(st.pts[i]) || 0)) <= win) kept.push(st.pts[i]);\n  }\n  st.pts = kept;\n  var liveRaw = bmpLiveCounts(limb).parried;\n  if (liveRaw < st.liveBase) st.liveBase = liveRaw;\n  var livePts = liveRaw - st.liveBase;\n  st.points = kept.length + livePts;\n  var pct = bmpAssayPct(limb);\n  var release = bmpNum('bm_parry_release', 70);\n  var need = parseInt(bmGet('bm_parry_confirm_points', '2'), 10);\n  if (isNaN(need) || need < 1) need = 2;\n  var streak = bmpLiveLandedStreak(limb);\n  var wasDenied = st.denied;\n  var nowDenied = wasDenied;\n  var reason = st.reason;\n  function evidenceReason() {\n    if (kept.length > 0 && livePts > 0) return 'assay+live';\n    return kept.length > 0 ? 'assay' : 'live';\n  }\n  if (bmpStanceCoversVitals()) {\n    nowDenied = true;\n    reason = 'stance';\n  } else if (wasDenied && st.reason === 'stance') {\n    if (st.points >= need) {\n      reason = evidenceReason();\n      st.reason = reason;\n    } else {\n      nowDenied = false;\n      reason = 'stance dropped';\n    }\n  } else if (wasDenied) {\n    if (pct !== null && pct < release && st.assayFresh) {\n      nowDenied = false;\n      reason = 'assay ' + pct + '%';\n    } else if (streak >= 2) {\n      nowDenied = false;\n      reason = 'landed x' + streak;\n    }\n  } else if (st.points >= need) {\n    nowDenied = true;\n    reason = evidenceReason();\n  }\n  if (nowDenied !== wasDenied) {\n    st.denied = nowDenied;\n    st.reason = reason;\n    st.since = now;\n    bmSet('bm_parry_flip', '1');\n    var eff = Math.round(effParry(limb));\n    if (nowDenied) {\n      st.assayFresh = false;\n      if (limb !== 'head') display_notice('[BM] PARRY CONFIRMED — ' + limb.toUpperCase() + ' ' + eff + '% (' + reason + ')', 'orange');\n    } else {\n      st.pts = [];\n      st.liveBase = liveRaw;\n      st.points = 0;\n      if (limb !== 'head') display_notice('[BM] PARRY RELEASED — ' + limb.toUpperCase() + ' ' + eff + '% (' + reason + ')', 'orange');\n    }\n  } else if (nowDenied && reason === 'stance' && st.reason !== 'stance') {\n    st.reason = 'stance';\n  }\n  bmpSaveDenState(limb, st);\n  return st.denied === true;\n}\n// Phase: kill | split (both vitals denied) | fallback (split cap reached). Default spec only.\nfunction bmRefreshKillPhase() {\n  var prev = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var chestD = isVitalDenied('chest');\n  var gutD = isVitalDenied('gut');\n  var splitN = parseInt(bmGet('bm_split_volleys', '0'), 10) || 0;\n  var maxSplit = bmpSplitMax();\n  var wasChest = String(bmGet('bm_parry_was_chest', '') || '') === '1';\n  var wasGut = String(bmGet('bm_parry_was_gut', '') || '') === '1';\n  if (chestD && gutD) {\n    if (prev === 'fallback') {\n      // stay\n    } else if (prev === 'split') {\n      if (splitN >= maxSplit) {\n        bmSet('bm_kill_phase', 'fallback');\n        bmSet('bm_fallback_leg', '');\n        display_notice('[BM] FALLBACK — legs: split ' + splitN + '/' + maxSplit + ' with no release — both hands on one leg → legtendon → prone → haymaker', 'orange');\n      }\n    } else {\n      bmSet('bm_kill_phase', 'split');\n      bmSet('bm_split_volleys', '0');\n      display_notice('[BM] SPLIT MODE — bait parry off vitals', 'orange');\n    }\n  } else {\n    if (prev === 'split' || prev === 'fallback') {\n      if (!chestD && !gutD) display_notice('[BM] BAIT SUCCESS — vitals open', 'orange');\n      else if (wasChest && !chestD) display_notice('[BM] BAIT SUCCESS — chest parry dropped', 'orange');\n      else if (wasGut && !gutD) display_notice('[BM] BAIT SUCCESS — gut parry dropped', 'orange');\n    }\n    bmSet('bm_kill_phase', 'kill');\n    bmSet('bm_split_volleys', '0');\n    bmSet('bm_fallback_leg', '');\n  }\n  bmSet('bm_parry_was_chest', chestD ? '1' : '0');\n  bmSet('bm_parry_was_gut', gutD ? '1' : '0');\n}\n// Primary vital: higher wound rank; tie -> lower effParry; tie -> chest. Parry never moves it.\nfunction pickKillModeVital() {\n  var wc = bmpWoundRank('chest');\n  var wg = bmpWoundRank('gut');\n  if (wg > wc) return 'gut';\n  if (wc > wg) return 'chest';\n  if (effParry('gut') < effParry('chest')) return 'gut';\n  return 'chest';\n}\nfunction resolveKillVital() {\n  var primary = pickKillModeVital();\n  var secondary = (primary === 'chest') ? 'gut' : 'chest';\n  var wp = bmpWoundRank(primary);\n  var ws = bmpWoundRank(secondary);\n  var reason;\n  if (wp > ws) reason = 'wounds ' + wp + ' > ' + ws;\n  else if (effParry(primary) < effParry(secondary)) reason = 'wounds tie, parry ' + Math.round(effParry(primary)) + '% < ' + Math.round(effParry(secondary)) + '%';\n  else reason = 'wounds tie, chest default';\n  if (isVitalDenied(primary)) reason += ' (denied)';\n  bmSet('bm_kill_vital_lock', JSON.stringify({ limb: primary, reason: reason }));\n  return primary;\n}\n// --- bait / leg helpers (tiers map onto MOD via strikeCmd: light=pierce*, crit=legtendon) ---\nfunction baitTier(limb) { return bmpWoundRank(limb) >= 1 ? 'light' : 'base'; }\nfunction pickBaitArm(volley) {\n  var lOk = !isLimbDenied('larm');\n  var rOk = !isLimbDenied('rarm');\n  if (lOk && !rOk) return 'larm';\n  if (rOk && !lOk) return 'rarm';\n  if (!lOk && !rOk) return '';\n  var wl = bmpWoundRank('larm');\n  var wr = bmpWoundRank('rarm');\n  if (wl > wr) return 'larm';\n  if (wr > wl) return 'rarm';\n  return (((parseInt(volley, 10) || 0) % 2) === 0) ? 'larm' : 'rarm';\n}\nfunction pickBaitLeg() {\n  var lOk = !isLimbDenied('lleg');\n  var rOk = !isLimbDenied('rleg');\n  if (lOk && !rOk) return 'lleg';\n  if (rOk && !lOk) return 'rleg';\n  if (!lOk && !rOk) return '';\n  if (bmpWoundRank('rleg') > bmpWoundRank('lleg')) return 'rleg';\n  return 'lleg';\n}\nfunction pickFallbackLeg() {\n  var cur = String(bmGet('bm_fallback_leg', '') || '');\n  if ((cur === 'lleg' || cur === 'rleg') && !isLimbDenied(cur)) return cur;\n  var lOk = !isLimbDenied('lleg');\n  var rOk = !isLimbDenied('rleg');\n  var pick;\n  if (lOk && !rOk) pick = 'lleg';\n  else if (rOk && !lOk) pick = 'rleg';\n  else pick = (bmpWoundRank('rleg') < bmpWoundRank('lleg')) ? 'rleg' : 'lleg';\n  bmSet('bm_fallback_leg', pick);\n  return pick;\n}\nfunction legBaitTier(leg, allowCrit) {\n  var w = bmpWoundRank(leg);\n  if (allowCrit && w >= 3) return 'crit';\n  if (w >= 1) return 'light';\n  return 'base';\n}\n// Kill volley plan for the default spec (mirror of Lua planKillVolley). Pure: safe per tick.\nfunction bmPlanKillVolley(tgt) {\n  var primary = resolveKillVital();\n  var secondary = (primary === 'chest') ? 'gut' : 'chest';\n  var volley = (parseInt(bmGet('bm_kill_volley', '0'), 10) || 0) + 1;\n  var plan = {\n    killBody: primary, killTier: 'base', killLunge: false,\n    hinderBody: primary, hinderTier: 'base', hinderLunge: false,\n    primary: primary, secondary: secondary, budget: 0, note: '', noteMid: '',\n    vitalLunge: false, bait: false\n  };\n  var phase = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var pDenied = isVitalDenied(primary);\n  var sDenied = isVitalDenied(secondary);\n  var budget = lungeBudgetHands();\n  var power = bmGetPower();\n  var reserve = bmEviscReserve();\n  plan.budget = budget;\n  var powStr = '(power ' + (power === null ? '?' : power) + ', reserve ' + reserve + ')';\n  function woundStr(limb) { return bmpWoundWord(limb) || 'no wounds'; }\n  function baitArmHinder() {\n    var arm = pickBaitArm(volley);\n    if (!arm) {\n      if (!isLimbDenied('head')) {\n        plan.hinderBody = 'head';\n        plan.hinderTier = baitTier('head');\n        return;\n      }\n      var leg = pickBaitLeg() || 'lleg';\n      plan.hinderBody = leg;\n      plan.hinderTier = legBaitTier(leg, false);\n      return;\n    }\n    plan.hinderBody = arm;\n    plan.hinderTier = baitTier(arm);\n  }\n  if (!pDenied) return plan;\n  if (budget >= 2) {\n    plan.killLunge = true;\n    plan.hinderLunge = true;\n    plan.vitalLunge = true;\n    plan.note = 'LUNGE THROUGH PARRY — ' + primary.toUpperCase() + ' x2';\n    plan.noteMid = powStr;\n    return plan;\n  }\n  if (budget === 1) {\n    plan.killLunge = true;\n    plan.vitalLunge = true;\n    if (!sDenied) {\n      plan.hinderBody = secondary;\n      plan.hinderTier = 'base';\n    } else {\n      baitArmHinder();\n    }\n    plan.note = 'LUNGE THROUGH PARRY — ' + primary.toUpperCase() + ' x1';\n    plan.noteMid = powStr + (sDenied ? ' · hinder baits ' + String(plan.hinderBody).toUpperCase() : ' · hinder ' + secondary.toUpperCase());\n    return plan;\n  }\n  if (phase === 'fallback') {\n    var fleg = pickFallbackLeg() || 'lleg';\n    plan.killBody = fleg;\n    plan.killTier = (bmpWoundRank(fleg) >= 3) ? 'crit' : 'base';\n    plan.hinderBody = fleg;\n    plan.hinderTier = legBaitTier(fleg, true);\n    plan.bait = true;\n    plan.note = 'FALLBACK — legs';\n    plan.noteMid = fleg.toUpperCase() + ' ' + woundStr(fleg);\n    return plan;\n  }\n  if (!sDenied) {\n    var needPower = reserve + 2;\n    plan.killBody = secondary;\n    plan.killTier = 'base';\n    if (bmpParryPolicy() === 'bait') {\n      baitArmHinder();\n      plan.noteMid = 'bait ' + String(plan.hinderBody).toUpperCase();\n    } else {\n      plan.hinderBody = secondary;\n      plan.hinderTier = 'base';\n      plan.noteMid = powStr;\n    }\n    plan.note = 'HOLD ' + primary.toUpperCase() + ' ' + bmpWoundWord(primary) + ' — building ' + secondary.toUpperCase() + ' until power >= ' + needPower;\n    return plan;\n  }\n  // Both vitals denied, no lunge budget: split bait. Never base into a denied vital.\n  baitArmHinder();\n  var bleg = pickBaitLeg();\n  if (bleg) {\n    plan.killBody = bleg;\n    plan.killTier = legBaitTier(bleg, false);\n  } else if (plan.hinderBody !== 'head' && !isLimbDenied('head')) {\n    plan.killBody = 'head';\n    plan.killTier = 'base';\n  } else {\n    plan.killBody = (plan.hinderBody === 'larm') ? 'rarm' : 'larm';\n    plan.killTier = 'base';\n  }\n  plan.bait = true;\n  plan.note = 'SPLIT ' + ((parseInt(bmGet('bm_split_volleys', '0'), 10) || 0) + 1) + '/' + bmpSplitMax();\n  plan.noteMid = 'hinder ' + String(plan.hinderBody).toUpperCase() + ' · kill hand ' + String(plan.killBody).toUpperCase();\n  return plan;\n}\n// Plain-text status (Offence tab block, xkillmode status, xkillparry).\nfunction killModeStatusLines() {\n  var lines = [];\n  var assist = 'off';\n  try { if (typeof bmAssistSpec === 'function') assist = bmAssistSpec(); } catch (eA) {}\n  if (assist === 'off') resolveKillVital();\n  var lock = bmpJson('bm_kill_vital_lock', {});\n  var primary = String(lock.limb || bmGet('bm_kill_limb', 'chest') || 'chest');\n  lines.push('primary ' + primary.toUpperCase() + ' (' + (bmpWoundWord(primary) || 'no wounds') + ') — ' + (lock.reason || '?'));\n  var vitals = ['chest', 'gut'], i, limb, ap, c, st, denied;\n  for (i = 0; i < vitals.length; i++) {\n    limb = vitals[i];\n    ap = bmpAssayPct(limb);\n    c = bmpLiveCounts(limb);\n    st = bmpDenState(limb);\n    denied = isVitalDenied(limb);\n    lines.push(limb.toUpperCase() + ' ' + Math.round(effParry(limb)) + '% (assay ' + (ap === null ? '?' : ap + '%') + ', live ' + c.parried + '/' + c.total + ', pts ' + st.points + ')' +\n      (denied ? ' DENIED' + (st.reason ? ' [' + st.reason + ']' : '') : ''));\n  }\n  var power = bmGetPower();\n  lines.push('lunge: power ' + (power === null ? '?' : power) + ' / reserve ' + bmEviscReserve() + ' -> ' + lungeBudgetHands() + ' hand(s)');\n  var phase = String(bmGet('bm_kill_phase', 'kill') || 'kill');\n  var phaseLine = 'phase ' + phase;\n  if (phase === 'split' || phase === 'fallback') phaseLine += '  split ' + (parseInt(bmGet('bm_split_volleys', '0'), 10) || 0) + '/' + bmpSplitMax();\n  if (phase === 'fallback' && bmGet('bm_fallback_leg', '')) phaseLine += '  leg ' + String(bmGet('bm_fallback_leg', '')).toUpperCase();\n  phaseLine += '  policy ' + bmpParryPolicy();\n  lines.push(phaseLine);\n  var proneRaw = String(bmGet('bm_en_prone', '') || '');\n  if (!proneRaw) lines.push('prone: unknown');\n  else lines.push('prone: ' + (bmBool('bm_en_prone') ? 'yes' : 'no'));\n  return lines;\n}\n// Target change / KillMode ON: forget parry evidence, queue, lock, phase counters.\nfunction resetParryState() {\n  var limbs = ['head', 'chest', 'gut', 'larm', 'rarm', 'lleg', 'rleg'], i;\n  for (i = 0; i < limbs.length; i++) bmSet('bm_live_parry_' + limbs[i], '');\n  bmSet('bm_parry_den_head', '');\n  bmSet('bm_parry_den_chest', '');\n  bmSet('bm_parry_den_gut', '');\n  bmSet('bm_swing_queue', '');\n  bmSet('bm_live_parry_last_at', '0');\n  bmSet('bm_kill_last_volley_at', '0');\n  bmSet('bm_kill_vital_lock', '');\n  bmSet('bm_split_volleys', '0');\n  bmSet('bm_fallback_leg', '');\n  bmSet('bm_parry_flip', '0');\n  bmSet('bm_parry_was_chest', '');\n  bmSet('bm_parry_was_gut', '');\n  bmSet('bm_kill_phase', 'kill');\n}\nfunction bmTeaNormKind(k) {\n  k = String(k || 'green').toLowerCase();\n  if (k === 'black' || k === 'blacktea') return 'blacktea';\n  return 'green';\n}\nfunction bmTeaKind() {\n  return bmTeaNormKind(bmGet('bm_tea_kind', 'green'));\n}\nfunction bmTeaUserKind() {\n  return bmTeaNormKind(bmGet('bm_tea_user', 'green'));\n}\nfunction bmTeaLabel() {\n  return bmTeaKind() === 'blacktea' ? 'Black' : 'Green';\n}\nfunction bmTeaSipCmd() {\n  return bmTeaKind() === 'blacktea' ? 'blacktea' : 'greentea';\n}\nfunction bmTeaKindFromSpec(spec) {\n  spec = String(spec || '').trim().toLowerCase();\n  if (!spec || spec === 'unknown' || spec === 'off' || spec === 'clear') return '';\n  if (spec === 'bonecrusher') return 'blacktea';\n  if (spec === 'pureblade') return 'blacktea';\n  if (spec === 'cavalier' || spec === 'monk' || spec === 'mage' || spec === 'blademaster' || spec === 'axelord') return 'green';\n  if (spec === 'bard') return 'green';\n  return '';\n}\nfunction bmTeaApplyForSpec(spec) {\n  var mapped = bmTeaKindFromSpec(spec);\n  var next = mapped || bmTeaUserKind();\n  next = bmTeaNormKind(next);\n  bmSet('bm_tea_kind', next);\n  bmTeaSipIfNeeded();\n  return next;\n}\nfunction bmTeaDefName(item) {\n  if (item == null) return '';\n  if (typeof item === 'string') return String(item).toLowerCase();\n  return String(item.name || item.defence || item.Name || '').toLowerCase();\n}\nfunction bmTeaFlagOn(k) {\n  var v = get_variable(k);\n  if (v === true || v === 1) return true;\n  var s = String(v == null ? '' : v).toLowerCase();\n  return s === '1' || s === 'true' || s === 'on' || s === 'yes';\n}\nfunction bmTeaMark(cmd, up) {\n  cmd = String(cmd || '').toLowerCase();\n  if (cmd === 'greentea') set_variable('bm_tea_green_up', up ? '1' : '0');\n  else if (cmd === 'blacktea') set_variable('bm_tea_black_up', up ? '1' : '0');\n}\nfunction bmTeaHasDef(cmd) {\n  cmd = String(cmd || bmTeaSipCmd()).toLowerCase();\n  if (cmd === 'greentea' && bmTeaFlagOn('bm_tea_green_up')) return true;\n  if (cmd === 'blacktea' && bmTeaFlagOn('bm_tea_black_up')) return true;\n  function listHas(list) {\n    if (!list || typeof list.length !== 'number') return false;\n    var i, n;\n    for (i = 0; i < list.length; i++) {\n      n = bmTeaDefName(list[i]);\n      if (n === cmd) return true;\n    }\n    return false;\n  }\n  try {\n    if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Defences) {\n      if (listHas(GMCP.Char.Defences.List || GMCP.Char.Defences)) return true;\n    }\n  } catch (eG) {}\n  try {\n    if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Defences) {\n      if (listHas(gmcp.Char.Defences.List || gmcp.Char.Defences)) return true;\n    }\n  } catch (eG2) {}\n  return false;\n}\nfunction bmTeaSipIfNeeded() {\n  var cmd = bmTeaSipCmd();\n  if (bmTeaHasDef(cmd)) return false;\n  send_command('sip ' + cmd, 0);\n  return true;\n}\nfunction bmTeaCycle() {\n  var next = bmTeaKind() === 'blacktea' ? 'green' : 'blacktea';\n  bmSet('bm_tea_kind', next);\n  bmSet('bm_tea_user', next);\n  bmTeaSipIfNeeded();\n  return next;\n}function bmAffNames() {\n  var names = null;\n  try {\n    if (client && client.bm_aff_list && Object.prototype.toString.call(client.bm_aff_list) === '[object Array]') {\n      names = client.bm_aff_list;\n    }\n  } catch (eA) {}\n  if (!names || !names.length) {\n    try {\n      var raw = get_variable('bm_aff_json');\n      if (raw) names = JSON.parse(raw);\n    } catch (eJ) {}\n  }\n  if (!names || !names.length) {\n    try {\n      var list = null;\n      if (typeof GMCP !== 'undefined' && GMCP && GMCP.Char && GMCP.Char.Afflictions) {\n        list = GMCP.Char.Afflictions.List || GMCP.Char.Afflictions;\n      } else if (typeof gmcp !== 'undefined' && gmcp && gmcp.Char && gmcp.Char.Afflictions) {\n        list = gmcp.Char.Afflictions.List || gmcp.Char.Afflictions;\n      }\n      if (list && typeof list.length === 'number') {\n        names = [];\n        var seen = {}, i, item, n;\n        for (i = 0; i < list.length; i++) {\n          item = list[i];\n          n = (typeof item === 'string') ? item : (item && item.name);\n          n = String(n || '').toLowerCase();\n          if (!n || seen[n]) continue;\n          seen[n] = true;\n          names.push(n);\n        }\n      }\n    } catch (eLive) {}\n  }\n  return names || [];\n}\nfunction bmEscTip(s) {\n  if (!s) return '';\n  return String(s).replace(/&/g, '&amp;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\n}\nfunction bmAffPillsHtml(names) {\n  var h = '<div style=\"margin-top:6px\">';\n  var hdrTip = ' title=\"' + bmEscTip('Your GMCP afflictions.') + '\"';\n  if (!names || !names.length) {\n    h += '<span style=\"color:#E07070;font-weight:bold\"' + hdrTip + '>Afflictions: None</span>';\n  } else {\n    h += '<span style=\"color:#E07070;font-weight:bold\"' + hdrTip + '>Afflictions: ' + names.length + '</span> ';\n    var i;\n    for (i = 0; i < names.length; i++) {\n      h += '<span style=\"display:inline-block;margin:2px 3px 0 0;padding:1px 7px;border-radius:9px;background:#3a1515;color:#FF5555;font-size:8pt;line-height:1.4;\" title=\"' + bmEscTip(names[i]) + '\">' + esc(names[i]) + '</span>';\n    }\n  }\n  return h + '</div>';\n}\nfunction esc(s) {\n  return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n}\nfunction onOff(k) {\n  return bmBool(k) ? '<span style=\"color:#7dff7d\">ON</span>' : '<span style=\"color:#888\">OFF</span>';\n}\nfunction woundWord(w) {\n  w = String(w || '').toLowerCase();\n  if (w === 'critical') return '<span style=\"color:#ff5555\">critical</span>';\n  if (w === 'heavy') return '<span style=\"color:#ff8844\">heavy</span>';\n  if (w === 'light') return '<span style=\"color:#ffcc66\">light</span>';\n  if (w === 'no' || w === 'none') return '<span style=\"color:#666\">none</span>';\n  return '<span style=\"color:#666\">—</span>';\n}\nfunction woundTag(w) {\n  w = String(w || '').toLowerCase();\n  if (w === 'critical') return '<span style=\"color:#ff5555\">C!</span>';\n  if (w === 'heavy') return '<span style=\"color:#ff8844\">H</span>';\n  if (w === 'light') return '<span style=\"color:#ffcc66\">L</span>';\n  return '<span style=\"color:#666\">0</span>';\n}\nfunction vitNum(n) {\n  n = parseInt(n, 10);\n  if (isNaN(n) || n <= 0) return '<span style=\"color:#666\">0</span>';\n  var c = n < 40 ? '#fff' : (n < 75 ? '#ffa500' : '#ff4444');\n  return '<span style=\"color:' + c + '\">' + n + '</span>';\n}\nfunction row(label, val) {\n  return '<div><span style=\"color:#8ab\">' + label + '</span> ' + val + '</div>';\n}\nfunction bmInfoBox(label, val, tip) {\n  var tipAttr = tip ? ' title=\"' + bmEscTip(tip) + '\"' : '';\n  return '<div style=\"display:flex;justify-content:center;align-items:center;min-width:2.6em;border:1px solid #555;background:#1a1a1a;padding:2px 5px;box-sizing:border-box;white-space:nowrap\"' + tipAttr + '>' +\n    '<span style=\"color:#8ab\">' + label + '</span>&nbsp;' + (val || '') + '</div>';\n}\nfunction bmInfoBoxRow(boxes) {\n  if (!boxes || !boxes.length) return '';\n  return '<div style=\"display:flex;justify-content:center;align-items:center;gap:3px;width:max-content;margin:0 auto;\">' +\n    boxes.join('') + '</div>';\n}\nfunction bmKillHinderRow() {\n  var kill = String(bmGet('bm_kill_limb', 'chest') || 'chest').toUpperCase();\n  var hinder = String(bmGet('bm_hinder_limb', 'larm') || 'larm').toUpperCase();\n  var h = bmInfoBoxRow([\n    bmInfoBox('Kill:', esc(kill), 'Kill limb for auto hits (default spec: sticky primary vital from bmPlanKillVolley).'),\n    bmInfoBox('Hinder:', esc(hinder), 'Hinder hand limb: same vital, secondary vital, or a bait arm/leg when the kill vital is parry-denied.')\n  ]);\n  if (!bmBool('bm_killmode')) return h;\n  var lines = [];\n  try { lines = killModeStatusLines(); } catch (eKs) { lines = []; }\n  if (!lines.length) return h;\n  var tip = 'KillMode parry status: primary vital + reason; effParry per vital (assay vs live parries) and DENIED state; lunge budget above the evisc reserve; phase kill/split/fallback; foe prone. Same as xkillmode status / xkillparry.';\n  h += '<div style=\"margin:3px auto 0;width:max-content;max-width:100%;text-align:left;font-size:8pt;color:#bbb;line-height:1.3\" title=\"' + bmEscTip(tip) + '\">';\n  var i, line, col;\n  for (i = 0; i < lines.length; i++) {\n    line = String(lines[i] || '');\n    col = '#bbb';\n    if (line.indexOf('DENIED') >= 0) col = '#ff8844';\n    else if (line.indexOf('phase split') >= 0 || line.indexOf('phase fallback') >= 0) col = '#ffcc66';\n    h += '<div style=\"color:' + col + '\">' + esc(line) + '</div>';\n  }\n  return h + '</div>';\n}\nfunction bmCandyOn() {\n  return bmBool('pEviscLollyPrep') || bmBool('evisc_candy');\n}\nfunction bmCheekyOn() {\n  return bmBool('evisc_cheeky');\n}\nfunction bmComboWbOn() {\n  var raw = get_variable('evisc_combo_weakblood');\n  if (raw === undefined || raw === null || raw === '') return bmCandyOn();\n  return bmBool('evisc_combo_weakblood');\n}\nfunction bmChipStyle(on) {\n  var base = 'display:inline-block;width:auto;box-sizing:border-box;text-align:center;white-space:nowrap;font-size:8pt;text-decoration:none;padding:2px 6px;border-top:1px solid #CCCCCC;border-right:1px solid #333333;border-bottom:1px solid #333333;border-left:1px solid #CCCCCC;';\n  if (on) return base + 'background-color:#23a046;color:#eaffea;';\n  return base + 'background-color:#4a4a55;color:#ccc;';\n}\nfunction bmActStyle() {\n  return 'display:inline-block;width:auto;box-sizing:border-box;text-align:center;white-space:nowrap;font-size:8pt;text-decoration:none;background-color:#b1defa;color:darkblue;padding:2px 6px;border-top:1px solid #CCCCCC;border-right:1px solid #333333;border-bottom:1px solid #333333;border-left:1px solid #CCCCCC;';\n}\nfunction bmChip(label, op, on, tip) {\n  var tipAttr = tip ? ' title=\"' + bmEscTip(tip) + '\"' : '';\n  return '<a style=\"' + bmChipStyle(on) + '\"' + tipAttr + ' href=\"#\" onClick=\"execBMfunction(\\'bm_chip\\', \\'' + op + '\\');\">' + label + '</a>';\n}\nfunction bmActChip(label, op, tip) {\n  var tipAttr = tip ? ' title=\"' + bmEscTip(tip) + '\"' : '';\n  return '<a style=\"' + bmActStyle() + '\"' + tipAttr + ' href=\"#\" onClick=\"execBMfunction(\\'bm_chip\\', \\'' + op + '\\');\">' + label + '</a>';\n}\nfunction bmChipRow(items, tight) {\n  if (!items || !items.length) return '';\n  var gapPad = tight ? 'gap:2px;padding:2px 0;' : 'gap:5px;padding:5px 0;';\n  var r = '<div style=\"display:flex;justify-content:center;align-items:center;flex-wrap:wrap;' + gapPad + 'width:100%;box-sizing:border-box\">';\n  var i;\n  for (i = 0; i < items.length; i++) {\n    r += '<span style=\"flex:0 0 auto;white-space:nowrap\">' + items[i] + '</span>';\n  }\n  return r + '</div>';\n}\nfunction bmBodyPad() {\n  function padBtn(id, label, key) {\n    return bmActChip(label, 'hit' + id, 'Same as Alt+' + key + ' (or current modifier) — needs bmt target.');\n  }\n  function cell(html) {\n    return '<div style=\"display:flex;justify-content:center;align-items:center\">' + (html || '') + '</div>';\n  }\n  var g = '<div style=\"display:grid;grid-template-columns:auto auto auto;gap:3px;justify-items:center;align-items:center;width:max-content;margin:8px auto 0;\">';\n  g += cell('') + cell(padBtn('head', 'Head', '1')) + cell('');\n  g += cell(padBtn('larm', 'Larm', '4')) + cell(padBtn('chest', 'Chest', '2')) + cell(padBtn('rarm', 'Rarm', '5'));\n  g += cell('') + cell(padBtn('gut', 'Gut', '3')) + cell('');\n  g += cell(padBtn('lleg', 'Lleg', '6')) + cell('') + cell(padBtn('rleg', 'Rleg', '7'));\n  return g + '</div>';\n}\nfunction bmEnVitalsRow(hp, ego, mana, pow) {\n  function box(prefix, val, tip) {\n    var shown = (val !== undefined && val !== null && String(val) !== '') ? (esc(val) + '%') : '--';\n    var tipAttr = tip ? ' title=\"' + bmEscTip(tip) + '\"' : '';\n    return '<div style=\"display:flex;justify-content:center;align-items:center;min-width:2.6em;border:1px solid #555;background:#1a1a1a;padding:2px 5px;box-sizing:border-box;white-space:nowrap\"' + tipAttr + '>' +\n      '<span style=\"color:#8ab\">' + prefix + '</span>&nbsp;' + shown + '</div>';\n  }\n  return '<div style=\"display:flex;justify-content:center;align-items:center;gap:3px;width:max-content;margin:4px auto;\">' +\n    box('HP:', hp, 'Target HP % (GMCP).') + box('Ego:', ego, 'Target Ego % (GMCP).') + box('Mn:', mana, 'Target Mana % (GMCP).') + box('Pw:', pow, 'Target Power % (GMCP).') +\n    '</div>';\n}\nfunction bmWoundGrid(cells, extraBottom) {\n  function spacer() {\n    return '<div style=\"display:flex;justify-content:center;align-items:center;min-width:1.8em\"></div>';\n  }\n  function cell(prefix, html, tip) {\n    var tipAttr = tip ? ' title=\"' + bmEscTip(tip) + '\"' : '';\n    return '<div style=\"display:flex;justify-content:center;align-items:center;min-width:2.6em;border:1px solid #555;background:#1a1a1a;padding:2px 5px;box-sizing:border-box;white-space:nowrap\"' + tipAttr + '>' +\n      '<span style=\"color:#8ab\">' + prefix + '</span>&nbsp;' + (html || '') + '</div>';\n  }\n  var mb = extraBottom || '0';\n  var g = '<div style=\"display:grid;grid-template-columns:auto auto auto;gap:3px;justify-items:center;align-items:center;width:max-content;margin:8px auto ' + mb + ';\">';\n  g += spacer() + cell('H:', cells.head, cells.headTip) + spacer();\n  g += cell('LA:', cells.larm, cells.larmTip) + cell('C:', cells.chest, cells.chestTip) + cell('RA:', cells.rarm, cells.rarmTip);\n  g += spacer() + cell('G:', cells.gut, cells.gutTip) + spacer();\n  g += cell('LL:', cells.lleg, cells.llegTip) + spacer() + cell('RL:', cells.rleg, cells.rlegTip);\n  return g + '</div>';\n}\nfunction foeWoundTip(limb, w) {\n  w = String(w || '').toLowerCase();\n  if (w === 'critical') return 'Foe ' + limb + ': C! critical.';\n  if (w === 'heavy') return 'Foe ' + limb + ': H heavy.';\n  if (w === 'light') return 'Foe ' + limb + ': L light.';\n  return 'Foe ' + limb + ': none.';\n}\nexecBMfunction = function(f, p) {\n  run_function(f, p, 'BladeMaster Engine');\n};\nvar wrap = 'padding:8px;color:#ddd;font:13px/1.45 sans-serif;';\n\nfunction ensureTab(name) {\n  try {\n    var lay = (typeof nexusclient !== 'undefined' && nexusclient.ui) ? nexusclient.ui().layout() : null;\n    if (lay && !lay.tab_location(name)) lay.register_custom_tab(name);\n  } catch (e) {}\n}\nfunction bmApplyTabIcons() {\n  if (typeof document === 'undefined') return;\n  var burst = 'M37.6 4.2C28-2.3 15.2-1.1 7 7s-9.4 21-2.8 30.5l112 163.3L16.6 233.2C6.7 236.4 0 245.6 0 256s6.7 19.6 16.6 22.8l103.1 33.4L66.8 412.8c-4.9 9.3-3.2 20.7 4.3 28.1s18.8 9.2 28.1 4.3l10